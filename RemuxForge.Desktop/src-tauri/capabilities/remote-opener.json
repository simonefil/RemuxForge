{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "remote-opener",
  "description": "Allows the local RemuxForge sidecar UI to open external links in the system browser",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
