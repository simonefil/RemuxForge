{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemuxForge",
  "version": "0.1.0",
  "identifier": "RemuxForge",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RemuxForge",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "LICENSE.rtf",
    "externalBin": [
      "binaries/remuxforge-web"
    ],
    "resources": {
      "resources/wwwroot": "wwwroot"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
