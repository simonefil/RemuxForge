# macOS ARM64 desktop build worker
MACOS_SSH_HOST=
MACOS_SSH_USER=
MACOS_SSH_PORT=22
MACOS_SSH_IDENTITY_FILE=
MACOS_SSH_PASSWORD=

# Windows desktop build worker
WINDOWS_SSH_HOST=
WINDOWS_SSH_USER=
WINDOWS_SSH_PORT=22
WINDOWS_SSH_IDENTITY_FILE=
WINDOWS_SSH_PASSWORD=

# Docker image built natively by the Linux release host.
DOCKER_PLATFORM=linux/amd64
