@implements IDisposable
@using System.Globalization
@using System.Threading.Tasks

@* Attesa animata dell'AI: nucleo luminoso con anelli e orbite nei colori del tema Radzen, frase in corsivo sul passo in corso *@
<div class="ai-thinking">
    <div class="ai-thinking-core" aria-hidden="true">
        <div class="ai-thinking-aurora"></div>
        <div class="ai-thinking-ring"></div>
        <div class="ai-thinking-ring-dashed"></div>
        <div class="ai-thinking-orbit ai-thinking-orbit-1"><i></i></div>
        <div class="ai-thinking-orbit ai-thinking-orbit-2"><i></i></div>
        <div class="ai-thinking-orbit ai-thinking-orbit-3"><i></i></div>
        <div class="ai-thinking-heart"><RadzenIcon Icon="auto_awesome" /></div>
    </div>
    <div class="ai-thinking-text" role="status" aria-live="polite">
        @* La chiave ricrea l'elemento a ogni frase nuova, così l'animazione di ingresso riparte *@
        <div @key="_shownPhrase" class="ai-thinking-phrase">@_shownPhrase</div>
        @if (!string.IsNullOrEmpty(_shownDetail))
        {
            TimeSpan elapsed = StartedAt.HasValue && DateTime.UtcNow > StartedAt.Value ? DateTime.UtcNow - StartedAt.Value : TimeSpan.Zero;
            @* Il tempo trascorso cambia ogni secondo: fuori dalla regione annunciata *@
            <div class="ai-thinking-detail">@_shownDetail<span aria-hidden="true">@(StartedAt.HasValue ? " · " + (int)elapsed.TotalMinutes + ":" + elapsed.Seconds.ToString("00", CultureInfo.InvariantCulture) : "")</span></div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Tempo minimo di permanenza di una frase: passi del modello ravvicinati non devono sparire prima di essere letti
    /// </summary>
    private const int MIN_PHRASE_MS = 2500;

    /// <summary>
    /// Tempo minimo di permanenza della riga secondaria: gli eventi dello stream possono cambiarla più volte al secondo
    /// </summary>
    private const int MIN_DETAIL_MS = 1500;

    /// <summary>
    /// Intervallo di aggiornamento del tempo trascorso
    /// </summary>
    private const int TICK_MS = 1000;

    /// <summary>
    /// Frase su cosa sta facendo l'AI
    /// </summary>
    [Parameter] public string Phrase { get; set; } = "";

    /// <summary>
    /// Riga secondaria, per esempio il contatore dei file letti o l'ultimo evento della chiamata in corso
    /// </summary>
    [Parameter] public string Detail { get; set; } = "";

    /// <summary>
    /// Inizio della chiamata in corso, in UTC: la riga secondaria mostra il tempo trascorso; null senza chiamata
    /// </summary>
    [Parameter] public DateTime? StartedAt { get; set; }

    /// <summary>
    /// Frase visibile
    /// </summary>
    private string _shownPhrase = "";

    /// <summary>
    /// Ultima frase ricevuta dal parametro
    /// </summary>
    private string _lastPhrase;

    /// <summary>
    /// Frasi in attesa del tempo minimo della frase visibile
    /// </summary>
    private readonly Queue<string> _pending = new Queue<string>();

    /// <summary>
    /// Istante in cui è comparsa la frase visibile
    /// </summary>
    private DateTime _shownAt = DateTime.MinValue;

    /// <summary>
    /// True mentre il ciclo di avanzamento della coda è attivo
    /// </summary>
    private bool _advancing;

    /// <summary>
    /// Riga secondaria visibile
    /// </summary>
    private string _shownDetail = "";

    /// <summary>
    /// Riga secondaria in attesa del tempo minimo di quella visibile, null se nessuna
    /// </summary>
    private string _pendingDetail;

    /// <summary>
    /// Istante in cui è comparsa la riga secondaria visibile
    /// </summary>
    private DateTime _detailShownAt = DateTime.MinValue;

    /// <summary>
    /// True mentre il ciclo del tempo trascorso è attivo
    /// </summary>
    private bool _ticking;

    /// <summary>
    /// True dopo il dispose
    /// </summary>
    private bool _disposed;

    /// <summary>
    /// Accoda la frase nuova, la prima compare subito; la riga secondaria nuova sostituisce quella in attesa e compare quando
    /// quella visibile ha avuto il suo tempo minimo
    /// </summary>
    protected override void OnParametersSet()
    {
        string detail = Detail ?? "";
        if (!string.Equals(detail, _pendingDetail ?? _shownDetail, StringComparison.Ordinal))
        {
            if ((DateTime.UtcNow - _detailShownAt).TotalMilliseconds >= MIN_DETAIL_MS)
            {
                _shownDetail = detail;
                _pendingDetail = null;
                _detailShownAt = DateTime.UtcNow;
            }
            else
            {
                _pendingDetail = detail;
            }
        }

        if ((StartedAt.HasValue || _pendingDetail != null) && !_ticking)
            _ = TickAsync();

        if (string.Equals(Phrase, _lastPhrase, StringComparison.Ordinal))
            return;

        _lastPhrase = Phrase;
        if (_shownPhrase.Length == 0)
        {
            Show(Phrase);
            return;
        }

        _pending.Enqueue(Phrase);
        if (!_advancing)
            _ = AdvanceAsync();
    }

    /// <summary>
    /// Mostra le frasi in coda rispettando il tempo minimo di ciascuna
    /// </summary>
    private async Task AdvanceAsync()
    {
        _advancing = true;
        try
        {
            while (_pending.Count > 0 && !_disposed)
            {
                int waitMs = MIN_PHRASE_MS - (int)(DateTime.UtcNow - _shownAt).TotalMilliseconds;
                if (waitMs > 0)
                    await Task.Delay(waitMs);
                if (_disposed)
                    return;

                Show(_pending.Dequeue());
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _advancing = false;
        }
    }

    /// <summary>
    /// Aggiorna ogni secondo il tempo trascorso e mostra la riga secondaria in attesa quando tocca a lei
    /// </summary>
    private async Task TickAsync()
    {
        _ticking = true;
        try
        {
            while ((StartedAt.HasValue || _pendingDetail != null) && !_disposed)
            {
                await Task.Delay(TICK_MS);
                if (_disposed)
                    return;

                if (_pendingDetail != null && (DateTime.UtcNow - _detailShownAt).TotalMilliseconds >= MIN_DETAIL_MS)
                {
                    _shownDetail = _pendingDetail;
                    _pendingDetail = null;
                    _detailShownAt = DateTime.UtcNow;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _ticking = false;
        }
    }

    /// <summary>
    /// Rende visibile una frase
    /// </summary>
    /// <param name="phrase">Frase</param>
    private void Show(string phrase)
    {
        _shownPhrase = phrase ?? "";
        _shownAt = DateTime.UtcNow;
    }

    /// <summary>
    /// Ferma il ciclo della coda
    /// </summary>
    public void Dispose()
    {
        _disposed = true;
    }
}
