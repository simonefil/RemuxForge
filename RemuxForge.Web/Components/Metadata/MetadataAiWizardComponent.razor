@inherits AppDialogContentBase
@using RemuxForge.Core.Ai
@inject MetadataOrchestrator Orchestrator
@inject AiCredentialService CredentialService
@inject OpenAiResponsesClient ResponsesClient

<div class="rf-dialog" @ref="DialogContent">
        <div class="rf-dialog-body">
            @if (_step == WizardStep.Request)
            {
                <div>@AppText.T("web.metadata.ai.requestHint")</div>
                <RadzenTextArea Style="width: 100%; min-height: 10em; margin-top: 0.5em; resize: vertical;" aria-label="@AppText.T("web.metadata.ai.requestLabel")" Placeholder="@AppText.T("web.metadata.ai.requestPlaceholder")" @bind-Value="_requestText" Immediate="true" />
                <div style="margin-top: 0.5em; color: var(--rz-text-secondary-color);">@AppText.F("web.metadata.ai.requestContext", GetSourceRecordCount(), GetModelLabel())</div>
            }
            else if (_step == WizardStep.Reading)
            {
                <AiThinkingComponent Phrase="@AppText.T("web.metadata.ai.phraseReading")" Detail="@GetReadingProgressText()" />
            }
            else if (_step == WizardStep.Generating)
            {
                @if (_generationRunning)
                {
                    <AiThinkingComponent Phrase="@_phrase" Detail="@AppText.T("web.metadata.ai.cancelHint")" />
                }
                else
                {
                    <div>@AppText.T("web.metadata.ai.generationStopped")</div>
                }
            }
            else if (_step == WizardStep.Preview && _result != null)
            {
                <div class="metadata-preview-summary">
                    <span>@AppText.F("web.metadata.ai.previewTotals", GetChangedFileCount(), _previewRecords.Count, GetTotalChangeCount(), _result.Preset.Rules.Count, _result.Rounds)</span>
                </div>
                @if (_result.Warnings.Count > 0)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Style="margin: 0.5em 0 0;">
                        @foreach (string warning in _result.Warnings)
                        {
                            <div>@warning</div>
                        }
                    </RadzenAlert>
                }
                <div style="display: flex; gap: 1em; margin-top: 0.5em; min-height: 0;">
                    <RadzenListBox TValue="int" Data="@GetPreviewIndexes()" Value="@_selectedPreviewIndex" Change="@SelectPreviewValue" class="metadata-ai-preview-files" aria-label="@AppText.T("web.metadata.ai.stepPreview")">
                        <Template Context="item">
                            @{
                                MkvMetadataRecord record = _previewRecords[(int)item];
                            }
                            <div class="metadata-ai-preview-file-name" title="@record.InputFile">@System.IO.Path.GetFileName(record.InputFile)</div>
                            <div style="color: @(string.IsNullOrEmpty(record.ErrorMessage) ? "var(--rz-text-secondary-color)" : "var(--rz-danger)"); font-size: 0.9em;">
                                @(string.IsNullOrEmpty(record.ErrorMessage) ? AppText.F("web.metadata.ai.previewFileChanges", record.ChangeCount, Utils.GetMetadataExecutionModeText(record.ExecutionMode)) : record.ErrorMessage)
                            </div>
                        </Template>
                    </RadzenListBox>
                    <div style="flex: 1; max-height: 50vh; overflow: auto;">
                        @if (GetSelectedPreviewChanges().Count == 0)
                        {
                            <div class="metadata-preview-empty">@AppText.T("web.metadata.ai.previewNoChanges")</div>
                        }
                        else
                        {
                            <RadzenTable GridLines="DataGridGridLines.Horizontal" class="metadata-preview-table">
                                <RadzenTableHeader>
                                    <RadzenTableHeaderRow>
                                        <RadzenTableHeaderCell>@AppText.T("web.metadata.ai.previewRule")</RadzenTableHeaderCell>
                                        <RadzenTableHeaderCell>@AppText.T("web.metadata.presetDialog.previewTarget")</RadzenTableHeaderCell>
                                        <RadzenTableHeaderCell>@AppText.T("web.metadata.mapped.field")</RadzenTableHeaderCell>
                                        <RadzenTableHeaderCell>@AppText.T("web.metadata.presetDialog.previewBefore")</RadzenTableHeaderCell>
                                        <RadzenTableHeaderCell>@AppText.T("web.metadata.presetDialog.previewAfter")</RadzenTableHeaderCell>
                                    </RadzenTableHeaderRow>
                                </RadzenTableHeader>
                                <RadzenTableBody>
                                    @foreach (MkvMetadataChange change in GetSelectedPreviewChanges())
                                    {
                                        <RadzenTableRow>
                                            <RadzenTableCell>@GetRuleLabel(change)</RadzenTableCell>
                                            <RadzenTableCell>@(!string.IsNullOrEmpty(change.TrackSelector) ? change.TrackSelector : AppText.T("web.metadata.mapped.general"))</RadzenTableCell>
                                            <RadzenTableCell>@(!string.IsNullOrEmpty(change.FieldKey) ? change.FieldKey : MetadataPresetUiHelper.GetOperationTypeLabel(change.OperationType))</RadzenTableCell>
                                            <RadzenTableCell class="metadata-preview-before">@change.BeforeValue</RadzenTableCell>
                                            <RadzenTableCell class="metadata-preview-after">@(!string.IsNullOrEmpty(change.AfterValue) ? change.AfterValue : change.Message)</RadzenTableCell>
                                        </RadzenTableRow>
                                    }
                                </RadzenTableBody>
                            </RadzenTable>
                        }
                    </div>
                </div>
                <RadzenPanel AllowCollapse="true" Collapsed="true" Text="@AppText.T("web.metadata.ai.previewJson")" Style="margin-top: 0.5em;">
                    <RadzenTextArea ReadOnly="true" Style="width: 100%; min-height: 16em; font-family: monospace; resize: vertical;" aria-label="@AppText.T("web.metadata.ai.previewJson")" Value="@_result.PresetJson" />
                </RadzenPanel>
            }
            else if (_step == WizardStep.Actions && _result != null)
            {
                <div class="form-row">
                    <RadzenLabel class="form-label" Text="@AppText.T("web.metadata.ai.presetName")" Component="MetadataAiPresetName" />
                    <RadzenTextBox Name="MetadataAiPresetName" Style="max-width: 40ch;" @bind-Value="_presetName" Immediate="true" />
                </div>
                <div style="margin-top: 0.5em; color: var(--rz-text-secondary-color);">@AppText.T("web.metadata.ai.actionsHint")</div>
            }
        </div>
        <div class="rf-dialog-footer">
            @if (!string.IsNullOrEmpty(_error))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rf-dialog-message" Style="max-height: 20vh; overflow: auto;">@_error</RadzenAlert>
            }
            @if (_step == WizardStep.Request)
            {
                <RadzenButton Text="@AppText.T("web.metadata.ai.generate")" Icon="auto_awesome" Disabled="@string.IsNullOrWhiteSpace(_requestText)" Click="@Generate" />
            }
            else if (_step == WizardStep.Reading)
            {
                <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@CancelReading" />
            }
            else if (_step == WizardStep.Generating)
            {
                @if (_generationRunning)
                {
                    <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@CancelGeneration" />
                }
                else
                {
                    <RadzenButton Text="@AppText.T("web.metadata.ai.retry")" Icon="refresh" Click="@Retry" />
                    <RadzenButton Text="@AppText.T("web.metadata.ai.back")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@BackToRequest" />
                }
            }
            else if (_step == WizardStep.Preview)
            {
                <RadzenButton Text="@AppText.T("web.metadata.ai.next")" Icon="arrow_forward" Click="@GoToActions" />
                <RadzenButton Text="@AppText.T("web.metadata.ai.back")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@BackToRequest" />
            }
            else if (_step == WizardStep.Actions)
            {
                <RadzenButton Text="@AppText.T("web.metadata.ai.savePreset")" Icon="save" Disabled="@(_actionRunning || string.IsNullOrWhiteSpace(_presetName))" Click="@(() => RunAction(WizardAction.Save))" />
                <RadzenButton Text="@AppText.T("web.metadata.ai.saveAndApply")" Icon="publish" Disabled="@(_actionRunning || string.IsNullOrWhiteSpace(_presetName))" Click="@(() => RunAction(WizardAction.SaveAndApply))" />
                <RadzenButton Text="@AppText.T("web.metadata.ai.applyWithoutSaving")" Icon="play_arrow" Variant="Variant.Outlined" Disabled="@_actionRunning" Click="@(() => RunAction(WizardAction.ApplyTemporary))" />
                <RadzenButton Text="@AppText.T("web.metadata.ai.back")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Disabled="@_actionRunning" Click="@BackToPreview" />
            }
            <RadzenButton Text="@AppText.T("web.common.close")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
        </div>
</div>

@code {
    /// <summary>
    /// Evento chiusura wizard
    /// </summary>

    /// <summary>
    /// Evento preset salvato da attivare, con il percorso del file
    /// </summary>
    [Parameter] public EventCallback<string> OnSaveAndActivate { get; set; }

    /// <summary>
    /// Evento preset salvato da analizzare e applicare, con il percorso del file
    /// </summary>
    [Parameter] public EventCallback<string> OnSaveAndApply { get; set; }

    /// <summary>
    /// Evento preset temporaneo da analizzare e applicare, con il percorso del file
    /// </summary>
    [Parameter] public EventCallback<string> OnApplyTemporary { get; set; }

    /// <summary>
    /// Passi del wizard
    /// </summary>
    private enum WizardStep
    {
        Request,
        Reading,
        Generating,
        Preview,
        Actions
    }

    /// <summary>
    /// Azioni finali del wizard
    /// </summary>
    private enum WizardAction
    {
        Save,
        SaveAndApply,
        ApplyTemporary
    }

    /// <summary>
    /// Passo corrente
    /// </summary>
    private WizardStep _step = WizardStep.Request;

    /// <summary>
    /// Richiesta dell'utente, conservata quando si torna al primo passo
    /// </summary>
    private string _requestText = "";

    /// <summary>
    /// True quando tag, allegati e capitoli sono già stati letti in questa apertura
    /// </summary>
    private bool _containerDataLoaded;

    /// <summary>
    /// True quando l'utente ha annullato la lettura dei file
    /// </summary>
    private bool _readingCancelled;

    /// <summary>
    /// True mentre il modello sta generando
    /// </summary>
    private bool _generationRunning;

    /// <summary>
    /// True mentre un'azione finale è in corso
    /// </summary>
    private bool _actionRunning;

    /// <summary>
    /// Frase mostrata durante la generazione, scelta in base all'ultimo passo del modello
    /// </summary>
    private string _phrase = "";

    /// <summary>
    /// Annulla la generazione in corso
    /// </summary>
    private CancellationTokenSource _generationCancellation;

    /// <summary>
    /// Esito dell'ultima generazione riuscita
    /// </summary>
    private AiPresetGenerationResult _result;

    /// <summary>
    /// Record valutati con il preset generato, copie dei record della griglia
    /// </summary>
    private List<MkvMetadataRecord> _previewRecords = new List<MkvMetadataRecord>();

    /// <summary>
    /// Indice del file selezionato nella preview
    /// </summary>
    private int _selectedPreviewIndex;

    /// <summary>
    /// Nome del preset inserito dall'utente
    /// </summary>
    private string _presetName = "";

    /// <summary>
    /// Errore corrente
    /// </summary>
    private string _error = "";

    /// <summary>
    /// Titolo mostrato nella barra del dialog, aggiornato al cambio di passo
    /// </summary>
    private string _shownTitle = "";

    /// <summary>
    /// Si iscrive agli eventi dell'orchestrator
    /// </summary>
    protected override void OnInitialized()
    {
        this.Orchestrator.OnContainerDataLoaded += this.HandleContainerDataLoaded;
        this.Orchestrator.OnProgressChanged += this.HandleProgressChanged;
    }

    /// <summary>
    /// Annulla le attività in corso e rimuove le sottoscrizioni
    /// </summary>
    public override async ValueTask DisposeAsync()
    {
        this.Orchestrator.OnContainerDataLoaded -= this.HandleContainerDataLoaded;
        this.Orchestrator.OnProgressChanged -= this.HandleProgressChanged;

        if (this._step == WizardStep.Reading)
            this.Orchestrator.Stop();

        if (this._generationCancellation != null)
            this._generationCancellation.Cancel();

        await base.DisposeAsync();
    }

    /// <summary>
    /// Porta nella barra del dialog il passo corrente
    /// </summary>
    /// <param name="firstRender">True al primo render</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string title;

        await base.OnAfterRenderAsync(firstRender);
        title = BuildTitle(this.GetStepLabel());
        if (firstRender)
            this._shownTitle = title;
        if (title == this._shownTitle)
            return;

        this._shownTitle = title;
        this.SetDialogTitle(title);
    }

    /// <summary>
    /// Titolo del wizard con il passo indicato
    /// </summary>
    /// <param name="stepLabel">Etichetta del passo</param>
    /// <returns>Titolo localizzato</returns>
    private static string BuildTitle(string stepLabel)
    {
        return AppText.F("web.metadata.ai.titleStep", AppText.T("web.metadata.ai.title"), stepLabel);
    }

    /// <summary>
    /// Titolo del wizard al primo passo, per l'apertura del dialog
    /// </summary>
    /// <returns>Titolo localizzato</returns>
    public static string GetInitialTitle()
    {
        return BuildTitle(AppText.T("web.metadata.ai.stepRequest"));
    }

    /// <summary>
    /// Etichetta del passo corrente
    /// </summary>
    private string GetStepLabel()
    {
        if (this._step == WizardStep.Reading)
            return AppText.T("web.metadata.ai.stepReading");
        if (this._step == WizardStep.Generating)
            return AppText.T("web.metadata.ai.stepGenerating");
        if (this._step == WizardStep.Preview)
            return AppText.T("web.metadata.ai.stepPreview");
        if (this._step == WizardStep.Actions)
            return AppText.T("web.metadata.ai.stepActions");
        return AppText.T("web.metadata.ai.stepRequest");
    }

    /// <summary>
    /// Numero di file utilizzabili per la generazione
    /// </summary>
    private int GetSourceRecordCount()
    {
        List<MkvMetadataRecord> records = this.Orchestrator.GetRecords();
        int count = 0;
        for (int i = 0; i < records.Count; i++)
        {
            if (records[i].OriginalFileInfo != null)
                count++;
        }

        return count;
    }

    /// <summary>
    /// Modello scelto nelle impostazioni AI
    /// </summary>
    private string GetModelLabel()
    {
        string model = this.LoadModel();
        return !string.IsNullOrEmpty(model) ? model : AppText.T("web.aiSettings.noModel");
    }

    /// <summary>
    /// Legge il modello dalla configurazione AI, vuoto se il file non è leggibile
    /// </summary>
    private string LoadModel()
    {
        return this.LoadCredentials().Model;
    }

    /// <summary>
    /// Legge la configurazione AI, vuota se il file non è leggibile
    /// </summary>
    private AiCredentials LoadCredentials()
    {
        try
        {
            return this.CredentialService.Load();
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException || ex is System.IO.IOException || ex is UnauthorizedAccessException)
        {
            return new AiCredentials();
        }
    }

    /// <summary>
    /// Testo di avanzamento della lettura dei file
    /// </summary>
    private string GetReadingProgressText()
    {
        ProcessingProgressState progress = this.Orchestrator.Progress;
        if (progress.Total <= 0)
            return "";

        return AppText.F("web.metadata.ai.readingCounter", progress.CurrentIndex, progress.Total);
    }

    /// <summary>
    /// Avvia la generazione, leggendo prima i dati di container se non ancora letti
    /// </summary>
    private void Generate()
    {
        this._error = "";

        if (string.IsNullOrEmpty(this.LoadModel()))
        {
            this._error = AppText.T("web.metadata.ai.noModel");
            return;
        }

        if (this.Orchestrator.IsBusy)
        {
            this._error = AppText.T("web.metadata.ai.orchestratorBusy");
            return;
        }

        if (this._containerDataLoaded)
        {
            _ = this.StartGenerationAsync();
            return;
        }

        this._readingCancelled = false;
        this._step = WizardStep.Reading;
        this.Orchestrator.LoadContainerDataAll();
    }

    /// <summary>
    /// Ridisegna l'avanzamento della lettura
    /// </summary>
    private void HandleProgressChanged()
    {
        if (this._step == WizardStep.Reading)
            _ = this.InvokeAsync(this.StateHasChanged);
    }

    /// <summary>
    /// Prosegue con la generazione al termine della lettura dei file
    /// </summary>
    /// <param name="loaded">File letti</param>
    /// <param name="failed">File non letti</param>
    private void HandleContainerDataLoaded(int loaded, int failed)
    {
        _ = this.InvokeAsync(async () =>
        {
            if (this._step != WizardStep.Reading)
                return;

            if (this._readingCancelled)
            {
                this._step = WizardStep.Request;
                this.StateHasChanged();
                return;
            }

            this._containerDataLoaded = true;
            if (failed > 0)
                this._error = AppText.F("web.metadata.ai.readingFailures", failed);

            await this.StartGenerationAsync();
        });
    }

    /// <summary>
    /// Annulla la lettura dei file
    /// </summary>
    private void CancelReading()
    {
        this._readingCancelled = true;
        this.Orchestrator.Stop();
    }

    /// <summary>
    /// Esegue il ciclo di generazione e prepara la preview
    /// </summary>
    private async Task StartGenerationAsync()
    {
        AiPresetGenerationResult result;
        CancellationTokenSource cancellation = new CancellationTokenSource();
        MetadataAiPresetGenerator generator = new MetadataAiPresetGenerator(this.ResponsesClient);
        SynchronousProgress progress = new SynchronousProgress(this.AppendStep);
        AiCredentials credentials = this.LoadCredentials();

        this._phrase = AppText.T("web.metadata.ai.phraseThinking");
        this._result = null;
        this._generationCancellation = cancellation;
        this._generationRunning = true;
        this._step = WizardStep.Generating;
        this.StateHasChanged();

        try
        {
            result = await generator.GenerateAsync(credentials.Model, this._requestText.Trim(), this.BuildSourceRecords(), credentials.MaxRounds, progress, cancellation.Token);
            if (result.Success)
            {
                this._result = result;
                this._presetName = result.Preset.Name != null ? result.Preset.Name : "";
                this.BuildPreview();
                this._step = WizardStep.Preview;
            }
            else
            {
                this._error = AppText.F("web.metadata.ai.maxRounds", result.Rounds) + (result.Errors.Count > 0 ? Environment.NewLine + string.Join(Environment.NewLine, result.Errors) : "");
            }
        }
        catch (OperationCanceledException)
        {
            if (!cancellation.IsCancellationRequested)
                throw;

            this._step = WizardStep.Request;
        }
        catch (AiServiceException ex)
        {
            this._error = ex.Message;
        }
        finally
        {
            this._generationRunning = false;
            if (ReferenceEquals(this._generationCancellation, cancellation))
                this._generationCancellation = null;
            cancellation.Dispose();
        }

        this.StateHasChanged();
    }

    /// <summary>
    /// Copie dei record con lo stato originale dei file: il modello non deve vedere i valori di un'analisi precedente
    /// </summary>
    private List<MkvMetadataRecord> BuildSourceRecords()
    {
        List<MkvMetadataRecord> records = this.Orchestrator.GetRecords();
        List<MkvMetadataRecord> result = new List<MkvMetadataRecord>();

        for (int i = 0; i < records.Count; i++)
        {
            if (records[i].OriginalFileInfo != null)
                result.Add(CloneOriginal(records[i]));
        }

        return result;
    }

    /// <summary>
    /// Valuta il preset generato su copie di tutti i record
    /// </summary>
    private void BuildPreview()
    {
        MetadataPipelineEvaluator evaluator = new MetadataPipelineEvaluator();
        MkvMetadataOutputPolicy policy = this.Orchestrator.CurrentOptions.Metadata.OutputPolicy;
        List<MkvMetadataRecord> records = this.BuildSourceRecords();

        for (int i = 0; i < records.Count; i++)
        {
            try
            {
                evaluator.AnalyzeRecord(records[i], this._result.Preset, policy);
            }
            catch (Exception ex)
            {
                records[i].AnalysisStatus = MkvMetadataAnalysisStatus.Error;
                records[i].ErrorMessage = ex.Message;
            }
        }

        this._previewRecords = records;
        this._selectedPreviewIndex = 0;
        for (int i = 0; i < records.Count; i++)
        {
            if (records[i].ChangeCount > 0)
            {
                this._selectedPreviewIndex = i;
                break;
            }
        }
    }

    /// <summary>
    /// Crea una copia del record ripartendo dallo stato originale del file
    /// </summary>
    /// <param name="source">Record della griglia</param>
    /// <returns>Copia indipendente</returns>
    private static MkvMetadataRecord CloneOriginal(MkvMetadataRecord source)
    {
        MkvMetadataRecord clone = new MkvMetadataRecord();
        clone.InputFile = source.InputFile;
        clone.RelativeFolder = source.RelativeFolder;
        clone.OriginalFileInfo = MetadataModelCloner.CloneFileInfo(source.OriginalFileInfo);
        clone.FileInfo = MetadataModelCloner.CloneFileInfo(clone.OriginalFileInfo);
        return clone;
    }

    /// <summary>
    /// Traduce un passo del generatore in una riga di log
    /// </summary>
    /// <param name="step">Passo notificato</param>
    private void AppendStep(AiPresetGenerationStep step)
    {
        List<string> lines = new List<string>();

        if (step.Kind == AiPresetGenerationStepKind.RequestSent)
        {
            lines.Add(AppText.F("web.metadata.ai.logRequestSent", step.Round));
            this._phrase = AppText.T(step.Round > 1 ? "web.metadata.ai.phraseThinkingAgain" : "web.metadata.ai.phraseThinking");
        }
        else if (step.Kind == AiPresetGenerationStepKind.FilesQueried)
        {
            lines.Add(AppText.F("web.metadata.ai.logFilesQueried", step.Round, Shorten(step.Detail, 300)));
            this._phrase = AppText.T("web.metadata.ai.phraseQuerying");
        }
        else if (step.Kind == AiPresetGenerationStepKind.PresetRejected)
        {
            lines.Add(AppText.F("web.metadata.ai.logPresetRejected", step.Round));
            this._phrase = AppText.T("web.metadata.ai.phraseRejected");
        }
        else if (step.Kind == AiPresetGenerationStepKind.PresetAccepted)
        {
            lines.Add(AppText.F("web.metadata.ai.logPresetAccepted", step.Round));
            this._phrase = AppText.T("web.metadata.ai.phraseAccepted");
        }
        else if (step.Kind == AiPresetGenerationStepKind.MissingSubmission)
        {
            lines.Add(AppText.F("web.metadata.ai.logMissingSubmission", step.Round, Shorten(step.Detail, 300)));
            this._phrase = AppText.T("web.metadata.ai.phraseMissingSubmission");
        }

        for (int i = 0; step.Errors != null && i < step.Errors.Count; i++)
        {
            lines.Add("  - " + step.Errors[i]);
        }

        // Il dettaglio tecnico va nella scheda Log, ispezionabile dietro il wizard
        for (int i = 0; i < lines.Count; i++)
        {
            this.Orchestrator.Log("AI · " + lines[i]);
        }

        _ = this.InvokeAsync(this.StateHasChanged);
    }

    /// <summary>
    /// Accorcia un testo per il log
    /// </summary>
    /// <param name="text">Testo</param>
    /// <param name="maxLength">Lunghezza massima</param>
    private static string Shorten(string text, int maxLength)
    {
        string value = text != null ? text.Replace('\n', ' ').Replace('\r', ' ').Trim() : "";
        return value.Length <= maxLength ? value : value.Substring(0, maxLength) + "...";
    }

    /// <summary>
    /// Annulla la generazione in corso
    /// </summary>
    private void CancelGeneration()
    {
        if (this._generationCancellation != null)
            this._generationCancellation.Cancel();
    }

    /// <summary>
    /// Rigenera da zero con la stessa richiesta
    /// </summary>
    private void Retry()
    {
        this.Generate();
    }

    /// <summary>
    /// Torna al primo passo conservando il testo della richiesta
    /// </summary>
    private void BackToRequest()
    {
        this._error = "";
        this._step = WizardStep.Request;
    }

    /// <summary>
    /// Passa alle azioni finali
    /// </summary>
    private void GoToActions()
    {
        this._error = "";
        this._step = WizardStep.Actions;
    }

    /// <summary>
    /// Torna alla preview
    /// </summary>
    private void BackToPreview()
    {
        this._error = "";
        this._step = WizardStep.Preview;
    }

    /// <summary>
    /// Seleziona il file scelto nell'elenco della preview
    /// </summary>
    /// <param name="value">Indice scelto</param>
    private void SelectPreviewValue(object value)
    {
        if (value is int index)
            this.SelectPreview(index);
    }

    /// <summary>
    /// Indici dei file mostrati nella preview
    /// </summary>
    /// <returns>Indici nell'ordine dei record</returns>
    private List<int> GetPreviewIndexes()
    {
        List<int> indexes = new List<int>();
        for (int i = 0; i < this._previewRecords.Count; i++)
            indexes.Add(i);
        return indexes;
    }

    /// <summary>
    /// Seleziona un file della preview
    /// </summary>
    /// <param name="index">Indice del file</param>
    private void SelectPreview(int index)
    {
        this._selectedPreviewIndex = index;
    }

    /// <summary>
    /// Modifiche del file selezionato nella preview
    /// </summary>
    private List<MkvMetadataChange> GetSelectedPreviewChanges()
    {
        if (this._selectedPreviewIndex < 0 || this._selectedPreviewIndex >= this._previewRecords.Count || this._previewRecords[this._selectedPreviewIndex].Changes == null)
            return new List<MkvMetadataChange>();

        return this._previewRecords[this._selectedPreviewIndex].Changes;
    }

    /// <summary>
    /// Numero di file che il preset modifica
    /// </summary>
    private int GetChangedFileCount()
    {
        int count = 0;
        for (int i = 0; i < this._previewRecords.Count; i++)
        {
            if (this._previewRecords[i].ChangeCount > 0)
                count++;
        }

        return count;
    }

    /// <summary>
    /// Numero totale di modifiche previste
    /// </summary>
    private int GetTotalChangeCount()
    {
        int count = 0;
        for (int i = 0; i < this._previewRecords.Count; i++)
        {
            count += this._previewRecords[i].ChangeCount;
        }

        return count;
    }

    /// <summary>
    /// Etichetta della regola che ha prodotto una modifica
    /// </summary>
    /// <param name="change">Modifica</param>
    private static string GetRuleLabel(MkvMetadataChange change)
    {
        string number = change.RuleIndex >= 0 ? (change.RuleIndex + 1).ToString() : "";
        if (string.IsNullOrEmpty(change.RuleDescription))
            return number;

        return string.IsNullOrEmpty(number) ? change.RuleDescription : number + ". " + change.RuleDescription;
    }

    /// <summary>
    /// Esegue un'azione finale dopo l'unica conferma
    /// </summary>
    /// <param name="action">Azione scelta</param>
    private async Task RunAction(WizardAction action)
    {
        MetadataPresetService service = new MetadataPresetService(AppSettingsService.Instance.ConfigFolder);
        bool save = action != WizardAction.ApplyTemporary;
        bool apply = action != WizardAction.Save;
        string fileName = SanitizeFileName(this._presetName);
        string presetPath;
        string message;

        this._error = "";
        if (save && string.IsNullOrEmpty(fileName))
        {
            this._error = AppText.T("web.metadata.presetDialog.presetNameRequired");
            return;
        }

        if (apply && this.Orchestrator.IsBusy)
        {
            this._error = AppText.T("web.metadata.ai.orchestratorBusy");
            return;
        }

        presetPath = save
            ? System.IO.Path.Combine(service.GetPresetFolder(), fileName + ".json")
            : System.IO.Path.Combine(AppSettingsService.Instance.GetTempFolder(), "ai-preset-" + Guid.NewGuid().ToString("N") + ".json");

        message = this.BuildConfirmationMessage(save && System.IO.File.Exists(presetPath), apply, fileName);
        this._actionRunning = true;
        try
        {
            if (!string.IsNullOrEmpty(message) && !await this.ConfirmAsync(message))
                return;

            this._result.Preset.Name = save ? fileName : AppText.T("web.metadata.ai.temporaryPresetName");
            this._result.Preset.Description = "";
            this._result.Preset.ShowAdvancedFields = MetadataUiCatalog.PresetUsesAdvancedFields(this._result.Preset);
            service.Save(this._result.Preset, presetPath);
        }
        catch (Exception ex) when (ex is System.IO.IOException || ex is UnauthorizedAccessException)
        {
            this._error = ex.Message;
            return;
        }
        finally
        {
            this._actionRunning = false;
        }

        if (action == WizardAction.Save)
            await this.OnSaveAndActivate.InvokeAsync(presetPath);
        else if (action == WizardAction.SaveAndApply)
            await this.OnSaveAndApply.InvokeAsync(presetPath);
        else
            await this.OnApplyTemporary.InvokeAsync(presetPath);
        this.CloseDialog();
    }

    /// <summary>
    /// Chiede l'unica conferma con un dialog dell'applicazione, mai con il dialog nativo del browser
    /// </summary>
    /// <param name="message">Testo della conferma, anche su più righe</param>
    /// <returns>True se l'utente conferma</returns>
    private Task<bool> ConfirmAsync(string message)
    {
        return AppDialogs.ConfirmAsync(this.DialogService, AppText.T("web.metadata.ai.title"), message, AppText.T("web.common.ok"), AppText.T("web.common.cancel"));
    }

    /// <summary>
    /// Compone l'unica conferma: sovrascrittura del preset, sovrascrittura dei file e rimozione tracce
    /// </summary>
    /// <param name="presetExists">True se il preset con lo stesso nome esiste già</param>
    /// <param name="apply">True se l'azione applica il preset ai file</param>
    /// <param name="fileName">Nome del preset</param>
    /// <returns>Testo della conferma, vuoto se non serve</returns>
    private string BuildConfirmationMessage(bool presetExists, bool apply, string fileName)
    {
        List<string> parts = new List<string>();
        MkvMetadataOptions options = this.Orchestrator.CurrentOptions.Metadata;
        bool inPlace = options.OutputPolicy == MkvMetadataOutputPolicy.Overwrite;
        int fileCount = 0;
        int trackRemovalCount = 0;

        if (presetExists)
            parts.Add(AppText.F("web.metadata.ai.confirmPresetOverwrite", fileName));

        if (apply)
        {
            // Stessa regola di NeedsApplyConfirmation, calcolata sulla preview invece che sui record analizzati
            for (int i = 0; i < this._previewRecords.Count; i++)
            {
                MkvMetadataRecord record = this._previewRecords[i];
                if (record.AnalysisStatus != MkvMetadataAnalysisStatus.Analyzed || record.ExecutionMode == MkvMetadataExecutionMode.NoOp)
                    continue;

                fileCount++;
                for (int j = 0; record.Changes != null && j < record.Changes.Count; j++)
                {
                    if (record.Changes[j].OperationType == MkvMetadataOperationType.RemoveTrack)
                        trackRemovalCount++;
                }
            }

            if (fileCount > 0 && (inPlace || trackRemovalCount > 0) && !options.DryRun)
            {
                parts.Add(inPlace ? AppText.F("web.metadata.confirmOverwrite", fileCount) : AppText.F("web.metadata.confirmApply", fileCount));
                if (trackRemovalCount > 0)
                    parts.Add(AppText.F("web.metadata.confirmTrackRemoval", trackRemovalCount));
            }
        }

        return string.Join(Environment.NewLine, parts);
    }

    /// <summary>
    /// Rimuove dal nome i caratteri non validi per un file
    /// </summary>
    /// <param name="value">Nome inserito</param>
    /// <returns>Nome utilizzabile come file</returns>
    private static string SanitizeFileName(string value)
    {
        string result = value != null ? value.Trim() : "";
        char[] invalid = System.IO.Path.GetInvalidFileNameChars();
        for (int i = 0; i < invalid.Length; i++)
        {
            result = result.Replace(invalid[i].ToString(), "");
        }

        return result;
    }

    /// <summary>
    /// Progress che consegna i passi nell'ordine in cui arrivano, senza passare dal contesto di sincronizzazione
    /// </summary>
    private sealed class SynchronousProgress : IProgress<AiPresetGenerationStep>
    {
        /// <summary>
        /// Destinatario dei passi
        /// </summary>
        private readonly Action<AiPresetGenerationStep> _handler;

        /// <summary>
        /// Costruttore
        /// </summary>
        /// <param name="handler">Destinatario dei passi</param>
        public SynchronousProgress(Action<AiPresetGenerationStep> handler)
        {
            this._handler = handler;
        }

        /// <summary>
        /// Consegna subito il passo
        /// </summary>
        /// <param name="value">Passo</param>
        public void Report(AiPresetGenerationStep value)
        {
            this._handler(value);
        }
    }
}
