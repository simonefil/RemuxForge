<RadzenSplitter class="panels-area metadata-panels metadata-workspace rf-workspace-splitter">
    <RadzenSplitterPane Size="58%">
        <div class="rf-workspace-pane rf-workspace-pane-master">
        <div class="rf-panel">
        <div class="rf-panel-title">@AppText.T("web.metadata.panel.files")</div>
        <div class="rf-panel-body split-input-body">
            <div class="metadata-toolbar">
                <div class="metadata-toolbar-row metadata-toolbar-main-row">
                    <div class="metadata-toolbar-field metadata-toolbar-preset-field">
                        <RadzenLabel class="metadata-toolbar-label" Text="@AppText.T("web.metadata.presetLabel")" Component="MetadataToolbarPreset" />
                        <RadzenDropDown TValue="string" Name="MetadataToolbarPreset" class="metadata-preset-select" Data="@PresetFiles" Value="@(string.IsNullOrEmpty(Options.Metadata.PresetPath) ? null : Options.Metadata.PresetPath)"
                                        Change="@((object value) => OnPresetChanged.InvokeAsync(value as string ?? ""))" AllowClear="true" Placeholder="@AppText.T("web.metadata.noPreset")">
                            <Template Context="file">@System.IO.Path.GetFileNameWithoutExtension((string)file)</Template>
                            <ValueTemplate Context="file">@System.IO.Path.GetFileNameWithoutExtension((string)file)</ValueTemplate>
                        </RadzenDropDown>
                    </div>
                    <div class="metadata-toolbar-field metadata-toolbar-path-field">
                        <RadzenLabel class="metadata-toolbar-label" Text="@AppText.T("web.metadata.toolbar.inputPath")" Component="MetadataToolbarSource" />
                        <span class="metadata-path-control">
                            <RadzenTextBox Name="MetadataToolbarSource" class="metadata-path-input" Value="@Options.Metadata.SourcePath" Change="@OnSourcePathChanged" />
                            <RadzenButton Icon="folder_open" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.metadata.toolbar.inputPath")" aria-label="@AppText.T("web.metadata.toolbar.inputPath")" Click="@OnBrowseSource" />
                        </span>
                    </div>
                </div>
                <div class="metadata-toolbar-row metadata-toolbar-options-row">
                    <div class="metadata-toolbar-field metadata-toolbar-policy-field">
                        <RadzenLabel class="metadata-toolbar-label" Text="@AppText.T("web.metadata.toolbar.output")" Component="MetadataToolbarPolicy" />
                        <RadzenDropDown TValue="string" Name="MetadataToolbarPolicy" class="metadata-output-policy-select" Data="@OutputPolicyValues" Value="@GetOutputPolicyValue()" Change="@((object value) => OnOutputPolicyChanged.InvokeAsync(value as string ?? ""))">
                            <Template Context="policy">@GetOutputPolicyLabel((string)policy)</Template>
                            <ValueTemplate Context="policy">@GetOutputPolicyLabel((string)policy)</ValueTemplate>
                        </RadzenDropDown>
                    </div>
                    <LabeledSwitchComponent CssClass="metadata-toolbar-toggle" Label="@AppText.T("web.metadata.toolbar.recursive")" Value="@Options.Metadata.Recursive" ValueChanged="@((bool _) => OnToggleRecursive.InvokeAsync())" />
                    @if (Options.Metadata.OutputPolicy == MkvMetadataOutputPolicy.OutputPath)
                    {
                        <LabeledSwitchComponent CssClass="metadata-toolbar-toggle" Label="@AppText.T("web.metadata.toolbar.preserveFolders")" Value="@Options.Metadata.PreserveFolderStructure" ValueChanged="@((bool _) => OnTogglePreserveFolders.InvokeAsync())" />
                        <LabeledSwitchComponent CssClass="metadata-toolbar-toggle" Label="@AppText.T("web.metadata.toolbar.overwriteOutput")" Value="@Options.Metadata.OverwriteOutput" ValueChanged="@((bool _) => OnToggleOverwriteOutput.InvokeAsync())" />
                    }
                </div>
                @if (Options.Metadata.OutputPolicy == MkvMetadataOutputPolicy.OutputPath)
                {
                    <div class="metadata-toolbar-row metadata-toolbar-output-row">
                        <div class="metadata-toolbar-field metadata-toolbar-path-field">
                            <RadzenLabel class="metadata-toolbar-label" Text="@AppText.T("web.metadata.toolbar.outputDir")" Component="MetadataToolbarOutputDir" />
                            <span class="metadata-path-control">
                                <RadzenTextBox Name="MetadataToolbarOutputDir" class="metadata-path-input" Value="@Options.Metadata.OutputDir" Change="@OnOutputPathChanged" />
                                <RadzenButton Icon="folder_open" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.metadata.toolbar.outputDir")" aria-label="@AppText.T("web.metadata.toolbar.outputDir")" Click="@OnBrowseOutput" />
                            </span>
                        </div>
                    </div>
                }
            </div>

            <RadzenDataGrid TItem="MkvMetadataRecord"
                            Data="@Records"
                            class="rf-data-grid metadata-grid"
                            AllowAlternatingRows="false"
                            AllowColumnResize="true"
                            AllowPaging="false"
                            AllowRowSelectOnRowClick="false"
                            AllowSorting="false"
                            ColumnWidth="130px"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Both"
                            RowClick="HandleRowClick"
                            RowRender="RenderRow">
                <Columns>
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Title="@AppText.T("web.dashboard.file")" Width="300px" MinWidth="180px" MaxWidth="600px">
                        <Template Context="record">@System.IO.Path.GetFileName(record.InputFile)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Title="@AppText.T("web.metadata.container")" Width="110px" MinWidth="80px" MaxWidth="200px">
                        <Template Context="record">@System.IO.Path.GetExtension(record.InputFile).TrimStart('.').ToUpperInvariant()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Title="@AppText.T("web.metadata.tracks")" Width="220px" MinWidth="140px" MaxWidth="440px">
                        <Template Context="record">@BuildTrackSummary(record)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Title="@AppText.T("web.dashboard.statusLabel")" MinWidth="90px" MaxWidth="260px">
                        <Template Context="record">@Utils.GetMetadataStatusText(record.Status)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Title="@AppText.T("web.metadata.analysis")" MinWidth="90px" MaxWidth="260px">
                        <Template Context="record">@Utils.GetMetadataAnalysisStatusText(record.AnalysisStatus)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Title="@AppText.T("web.metadata.mode")" MinWidth="90px" MaxWidth="260px">
                        <Template Context="record">@Utils.GetMetadataExecutionModeText(record.ExecutionMode)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Property="ChangeCount" Title="@AppText.T("web.metadata.changesShort")" MinWidth="80px" MaxWidth="220px" />
                    <RadzenDataGridColumn TItem="MkvMetadataRecord" Property="ErrorMessage" Title="@AppText.T("web.dashboard.warningError")" Width="180px" MinWidth="100px" MaxWidth="440px" />
                </Columns>
            </RadzenDataGrid>
        </div>
        </div>
        </div>
    </RadzenSplitterPane>

    <RadzenSplitterPane>
        <div class="rf-workspace-pane rf-workspace-pane-detail">
            <div class="rf-panel">
                <div class="rf-panel-title">@AppText.T("web.metadata.panel.preview")</div>
                <div class="rf-panel-body detail-content metadata-detail-content">
                    @if (SelectedRecord == null)
                    {
                        <div class="empty-detail">@AppText.T("web.dashboard.noFileSelected")</div>
                    }
                    else
                    {
                        <RadzenSplitter Orientation="Orientation.Vertical" class="metadata-preview-splitter">
                            <RadzenSplitterPane Size="48%" Min="135px">
                                <div class="metadata-detail-pane">
                                    <div class="metadata-detail-section">
                                        <div class="metadata-detail-section-title">@AppText.T("web.metadata.detail.currentSection")</div>
                                        <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.dashboard.fileLabel")</span> <span class="metadata-detail-value">@SelectedRecord.InputFile</span></div>
                                        <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.dashboard.statusLabel")</span> <span class="metadata-detail-value">@Utils.GetMetadataStatusText(SelectedRecord.Status)</span></div>
                                        <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.metadata.detail.size")</span> <span class="metadata-detail-value">@Utils.FormatSize(SelectedRecord.FileSize)</span></div>
                                        <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.metadata.detail.video")</span> <span class="metadata-detail-value">@BuildVideoSummary(SelectedRecord, false)</span></div>
                                        <MetadataTrackSummaryTableComponent Record="@SelectedRecord" Simulated="false" />
                                        @if (SelectedRecord.FileInfo != null && SelectedRecord.FileInfo.Attachments != null && SelectedRecord.FileInfo.Attachments.Count > 0)
                                        {
                                            <div class="metadata-attachments">
                                                <div class="detail-label">@AppText.F("web.metadata.detail.attachments", SelectedRecord.FileInfo.Attachments.Count)</div>
                                                @if (GetCoverAttachment(SelectedRecord) != null)
                                                {
                                                    <img class="metadata-attachment-cover" src="@("/api/metadata-attachment/" + SelectedIndex + "/" + GetCoverAttachment(SelectedRecord).Id)" alt="@GetCoverAttachment(SelectedRecord).FileName" />
                                                }
                                                @foreach (MkvMetadataAttachmentInfo attachment in SelectedRecord.FileInfo.Attachments)
                                                {
                                                    <div class="metadata-detail-line"><span class="metadata-detail-value">@attachment.FileName</span> <span class="detail-label">@attachment.MimeType @Utils.FormatSize(attachment.Size)</span></div>
                                                }
                                            </div>
                                        }
                                        @if (SelectedRecord.FileInfo != null && SelectedRecord.FileInfo.Chapters != null && SelectedRecord.FileInfo.Chapters.Count > 0)
                                        {
                                            <div class="metadata-attachments">
                                                <div class="detail-label">@AppText.F("web.metadata.mapped.chapters", SelectedRecord.FileInfo.Chapters.Count)</div>
                                                @foreach (MkvMetadataChapterInfo chapter in SelectedRecord.FileInfo.Chapters)
                                                {
                                                    <div class="metadata-detail-line"><span class="metadata-chapter-time">@TimeSpan.FromTicks(chapter.StartNs / 100).ToString(@"hh\:mm\:ss")</span> <span class="metadata-detail-value">@chapter.Name</span></div>
                                                }
                                            </div>
                                        }
                                        <RadzenButton Text="@AppText.T("web.metadata.detail.openMappedInfo")" Icon="open_in_new" Variant="Variant.Outlined" Click="@(() => OnShowMappedInfo.InvokeAsync(false))" />
                                    </div>
                                </div>
                            </RadzenSplitterPane>
                            <RadzenSplitterPane Min="105px">
                                <div class="metadata-detail-pane">
                                    <div class="metadata-detail-section metadata-detail-section-simulated">
                                        <div class="metadata-detail-section-title">@AppText.T("web.metadata.detail.simulatedSection")</div>
                                        @if (SelectedRecord.AnalysisStatus == MkvMetadataAnalysisStatus.Analyzed)
                                        {
                                            <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.metadata.rulesLabel")</span> <span class="metadata-detail-value">@SelectedRecord.MatchCount</span></div>
                                            <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.metadata.changesLabel")</span> <span class="metadata-detail-value">@SelectedRecord.ChangeCount</span></div>
                                            <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.metadata.executionLabel")</span> <span class="metadata-detail-value">@Utils.GetMetadataExecutionModeText(SelectedRecord.ExecutionMode)</span></div>
                                            <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.metadata.outputLabel")</span> <span class="metadata-detail-value">@MetadataExecutionService.BuildOutputFile(SelectedRecord, Options.Metadata)</span></div>
                                            <MetadataTrackSummaryTableComponent Record="@SelectedRecord" Simulated="true" />
                                            @if (GetContainerChanges(SelectedRecord).Count > 0)
                                            {
                                                <div class="metadata-attachments">
                                                    <div class="detail-label">@AppText.T("web.metadata.detail.containerChanges")</div>
                                                    @foreach (MkvMetadataChange change in GetContainerChanges(SelectedRecord))
                                                    {
                                                        <div class="metadata-detail-line"><span class="metadata-detail-value">@change.Message</span></div>
                                                    }
                                                </div>
                                            }
                                            <RadzenButton Text="@AppText.T("web.metadata.detail.openSimulationDetail")" Icon="open_in_new" Variant="Variant.Outlined" Click="@(() => OnShowMappedInfo.InvokeAsync(true))" />
                                        }
                                        else if (SelectedRecord.AnalysisStatus == MkvMetadataAnalysisStatus.Applied)
                                        {
                                            <div>@AppText.F("web.metadata.detail.applied", SelectedRecord.ChangeCount)</div>
                                        }
                                        else
                                        {
                                            <div>@AppText.T("web.metadata.detail.notAnalyzed")</div>
                                        }
                                        @if (!string.IsNullOrEmpty(SelectedRecord.ErrorMessage))
                                        {
                                            <div class="metadata-detail-line"><span class="detail-label">@AppText.T("web.dashboard.errorLabel")</span> <span class="metadata-detail-value">@SelectedRecord.ErrorMessage</span></div>
                                        }
                                    </div>
                                </div>
                            </RadzenSplitterPane>
                        </RadzenSplitter>
                    }
                </div>
            </div>
        </div>
    </RadzenSplitterPane>
</RadzenSplitter>

@code {
    /// <summary>
    /// Opzioni correnti
    /// </summary>
    [Parameter] public Options Options { get; set; }

    /// <summary>
    /// Preset disponibili
    /// </summary>
    [Parameter] public List<string> PresetFiles { get; set; }

    /// <summary>
    /// Record disponibili
    /// </summary>
    [Parameter] public List<MkvMetadataRecord> Records { get; set; }

    /// <summary>
    /// Record selezionato
    /// </summary>
    [Parameter] public MkvMetadataRecord SelectedRecord { get; set; }

    /// <summary>
    /// Indice selezionato
    /// </summary>
    [Parameter] public int SelectedIndex { get; set; }

    /// <summary>
    /// Restituisce le modifiche di contenitore che nessuna tabella per traccia mostra
    /// </summary>
    /// <param name="record">Record metadata</param>
    /// <returns>Modifiche sugli allegati</returns>
    private List<MkvMetadataChange> GetContainerChanges(MkvMetadataRecord record)
    {
        List<MkvMetadataChange> result = new List<MkvMetadataChange>();

        for (int i = 0; record.Changes != null && i < record.Changes.Count; i++)
        {
            MkvMetadataOperationType type = record.Changes[i].OperationType;
            if (type == MkvMetadataOperationType.SetAttachment || type == MkvMetadataOperationType.DeleteAttachment)
            {
                result.Add(record.Changes[i]);
            }
        }

        return result;
    }

    /// <summary>
    /// Restituisce l'allegato che vale come copertina, null se non c'e'
    /// </summary>
    /// <param name="record">Record metadata</param>
    /// <returns>Allegato copertina</returns>
    private MkvMetadataAttachmentInfo GetCoverAttachment(MkvMetadataRecord record)
    {
        List<MkvMetadataAttachmentInfo> attachments = record.FileInfo != null ? record.FileInfo.Attachments : null;
        MkvMetadataAttachmentInfo fallback = null;

        for (int i = 0; attachments != null && i < attachments.Count; i++)
        {
            string name = (attachments[i].FileName != null ? attachments[i].FileName : "").ToLowerInvariant();
            bool isImage = (attachments[i].MimeType != null ? attachments[i].MimeType : "").StartsWith("image/", StringComparison.OrdinalIgnoreCase);
            if (!isImage)
                continue;

            // La convenzione Matroska nomina la copertina cover.*, e small_cover.* e'
            // solo la sua miniatura: se c'e' quella grande vince lei
            if (name.StartsWith("cover.", StringComparison.Ordinal))
                return attachments[i];

            if (fallback == null)
                fallback = attachments[i];
        }

        return fallback;
    }

    /// <summary>
    /// Costruisce il riepilogo tracce
    /// </summary>
    [Parameter] public Func<MkvMetadataRecord, string> TrackSummaryBuilder { get; set; }

    /// <summary>
    /// Costruisce il riepilogo video
    /// </summary>
    [Parameter] public Func<MkvMetadataRecord, bool, string> VideoSummaryBuilder { get; set; }

    /// <summary>
    /// Restituisce il valore corrente della policy output
    /// </summary>
    [Parameter] public Func<string> OutputPolicyValueProvider { get; set; }

    /// <summary>
    /// Eventi della toolbar e della selezione
    /// </summary>
    [Parameter] public EventCallback<string> OnPresetChanged { get; set; }
    [Parameter] public EventCallback<string> OnSourcePathChanged { get; set; }
    [Parameter] public EventCallback<string> OnOutputPolicyChanged { get; set; }
    [Parameter] public EventCallback<string> OnOutputPathChanged { get; set; }
    [Parameter] public EventCallback OnBrowseSource { get; set; }
    [Parameter] public EventCallback OnBrowseOutput { get; set; }
    [Parameter] public EventCallback OnToggleRecursive { get; set; }
    [Parameter] public EventCallback OnTogglePreserveFolders { get; set; }
    [Parameter] public EventCallback OnToggleOverwriteOutput { get; set; }
    [Parameter] public EventCallback<int> OnRowSelected { get; set; }
    [Parameter] public EventCallback<bool> OnShowMappedInfo { get; set; }

    /// <summary>
    /// Costruisce il riepilogo tracce richiesto dal workspace
    /// </summary>
    private string BuildTrackSummary(MkvMetadataRecord record)
    {
        return this.TrackSummaryBuilder != null ? this.TrackSummaryBuilder(record) : "";
    }

    /// <summary>
    /// Costruisce il riepilogo video richiesto dal workspace
    /// </summary>
    private string BuildVideoSummary(MkvMetadataRecord record, bool simulated)
    {
        return this.VideoSummaryBuilder != null ? this.VideoSummaryBuilder(record, simulated) : "";
    }

    /// <summary>
    /// Valori serializzati della policy output
    /// </summary>
    private static readonly List<string> OutputPolicyValues = new List<string> { "overwrite", "output" };

    /// <summary>
    /// Etichetta della policy output
    /// </summary>
    /// <param name="policy">Valore policy</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetOutputPolicyLabel(string policy)
    {
        return AppText.T(policy == "output" ? "web.metadata.toolbar.outputPath" : "web.metadata.toolbar.overwrite");
    }

    /// <summary>
    /// Restituisce il valore serializzato della policy output
    /// </summary>
    /// <returns>Valore policy</returns>
    private string GetOutputPolicyValue()
    {
        return this.OutputPolicyValueProvider != null ? this.OutputPolicyValueProvider() : "overwrite";
    }

    /// <summary>
    /// Propaga la selezione della riga al coordinator
    /// </summary>
    /// <param name="args">Argomenti click riga</param>
    private void HandleRowClick(DataGridRowMouseEventArgs<MkvMetadataRecord> args)
    {
        int index = this.Records.IndexOf(args.Data);
        if (index >= 0)
            this.OnRowSelected.InvokeAsync(index);
    }

    /// <summary>
    /// Applica gli attributi di focus e selezione posseduti dall'orchestrator
    /// </summary>
    /// <param name="args">Argomenti rendering riga</param>
    private void RenderRow(RowRenderEventArgs<MkvMetadataRecord> args)
    {
        int index = this.Records.IndexOf(args.Data);
        if (index == this.SelectedIndex)
            args.Attributes["class"] = "rz-data-row selected focused";
        args.Attributes["data-metadata-row-index"] = index;
        args.Attributes["tabindex"] = index == this.SelectedIndex ? 0 : -1;
        args.Attributes["aria-selected"] = index == this.SelectedIndex ? "true" : "false";
    }
}
