@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
    <div class="rf-dialog-body">
        <div class="form-section">@AppText.T("web.audioSettings.flacSection")</div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.compression")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.flacSection") + " - " + AppText.T("web.audioSettings.compression"))" Min="@AppSettingsModel.FLAC_COMPRESSION_MIN" Max="@AppSettingsModel.FLAC_COMPRESSION_MAX" @bind-Value="_flacCompression" />
        </div>
        <div class="form-row" style="color: var(--rz-text-disabled-color);">
            @AppText.T("web.common.range"): @AppSettingsModel.FLAC_COMPRESSION_MIN-@AppSettingsModel.FLAC_COMPRESSION_MAX
        </div>

        <div class="form-section">@AppText.T("web.audioSettings.opusSection")</div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.mono")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.opusSection") + " - " + AppText.T("web.audioSettings.mono"))" Min="@AppSettingsModel.OPUS_BITRATE_MIN" Max="@AppSettingsModel.OPUS_BITRATE_MAX" @bind-Value="_opusMono" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.stereo")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.opusSection") + " - " + AppText.T("web.audioSettings.stereo"))" Min="@AppSettingsModel.OPUS_BITRATE_MIN" Max="@AppSettingsModel.OPUS_BITRATE_MAX" @bind-Value="_opusStereo" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.surround51")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.opusSection") + " - " + AppText.T("web.audioSettings.surround51"))" Min="@AppSettingsModel.OPUS_BITRATE_MIN" Max="@AppSettingsModel.OPUS_BITRATE_MAX" @bind-Value="_opusS51" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.surround71")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.opusSection") + " - " + AppText.T("web.audioSettings.surround71"))" Min="@AppSettingsModel.OPUS_BITRATE_MIN" Max="@AppSettingsModel.OPUS_BITRATE_MAX" @bind-Value="_opusS71" />
        </div>
        <div class="form-row" style="color: var(--rz-text-disabled-color);">
            @AppText.T("web.common.range"): @AppSettingsModel.OPUS_BITRATE_MIN-@AppSettingsModel.OPUS_BITRATE_MAX kbps
        </div>

        <div class="form-section">@AppText.T("web.audioSettings.aacSection")</div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.mono")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.aacSection") + " - " + AppText.T("web.audioSettings.mono"))" Min="@AppSettingsModel.AAC_BITRATE_MIN" Max="@AppSettingsModel.AAC_BITRATE_MAX" @bind-Value="_aacMono" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.stereo")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.aacSection") + " - " + AppText.T("web.audioSettings.stereo"))" Min="@AppSettingsModel.AAC_BITRATE_MIN" Max="@AppSettingsModel.AAC_BITRATE_MAX" @bind-Value="_aacStereo" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.surround51")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.aacSection") + " - " + AppText.T("web.audioSettings.surround51"))" Min="@AppSettingsModel.AAC_BITRATE_MIN" Max="@AppSettingsModel.AAC_BITRATE_MAX" @bind-Value="_aacS51" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.surround71")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.aacSection") + " - " + AppText.T("web.audioSettings.surround71"))" Min="@AppSettingsModel.AAC_BITRATE_MIN" Max="@AppSettingsModel.AAC_BITRATE_MAX" @bind-Value="_aacS71" />
        </div>
        <div class="form-row" style="color: var(--rz-text-disabled-color);">
            @AppText.T("web.common.range"): @AppSettingsModel.AAC_BITRATE_MIN-@AppSettingsModel.AAC_BITRATE_MAX kbps
        </div>

        <div class="form-section">@AppText.T("web.audioSettings.ac3Section")</div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.mono")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.ac3Section") + " - " + AppText.T("web.audioSettings.mono"))" Min="@AC3_MIN" Max="@AC3_MAX" @bind-Value="_ac3Mono" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.stereo")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.ac3Section") + " - " + AppText.T("web.audioSettings.stereo"))" Min="@AC3_MIN" Max="@AC3_MAX" @bind-Value="_ac3Stereo" />
        </div>
        <div class="form-row">
            <span class="form-label">@AppText.T("web.audioSettings.surround51")</span>
            <RadzenNumeric TValue="int" AriaLabel="@(AppText.T("web.audioSettings.ac3Section") + " - " + AppText.T("web.audioSettings.surround51"))" Min="@AC3_MIN" Max="@AC3_MAX" @bind-Value="_ac3S51" />
        </div>
        <div class="form-row" style="color: var(--rz-text-disabled-color);">
            @AppText.T("web.audioSettings.validBitrates"): @System.String.Join(", ", AppSettingsModel.AC3_VALID_BITRATES_KBPS) kbps
        </div>
    </div>
    <div class="rf-dialog-footer">
        @if (!string.IsNullOrEmpty(_validationError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rf-dialog-message">@_validationError</RadzenAlert>
        }
        <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Save" />
        <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
    </div>
</div>

@code {
    /// <summary>
    /// Bitrate AC-3 minimo ammesso
    /// </summary>
    private static readonly int AC3_MIN = AppSettingsModel.AC3_VALID_BITRATES_KBPS[0];

    /// <summary>
    /// Bitrate AC-3 massimo ammesso
    /// </summary>
    private static readonly int AC3_MAX = AppSettingsModel.AC3_VALID_BITRATES_KBPS[AppSettingsModel.AC3_VALID_BITRATES_KBPS.Length - 1];

    /// <summary>
    /// Livello compressione FLAC
    /// </summary>
    private int _flacCompression;

    /// <summary>
    /// Bitrate Opus mono
    /// </summary>
    private int _opusMono;

    /// <summary>
    /// Bitrate Opus stereo
    /// </summary>
    private int _opusStereo;

    /// <summary>
    /// Bitrate Opus surround 5.1
    /// </summary>
    private int _opusS51;

    /// <summary>
    /// Bitrate Opus surround 7.1
    /// </summary>
    private int _opusS71;

    /// <summary>
    /// Bitrate AAC mono
    /// </summary>
    private int _aacMono;

    /// <summary>
    /// Bitrate AAC stereo
    /// </summary>
    private int _aacStereo;

    /// <summary>
    /// Bitrate AAC surround 5.1
    /// </summary>
    private int _aacS51;

    /// <summary>
    /// Bitrate AAC surround 7.1
    /// </summary>
    private int _aacS71;

    /// <summary>
    /// Bitrate AC-3 mono
    /// </summary>
    private int _ac3Mono;

    /// <summary>
    /// Bitrate AC-3 stereo
    /// </summary>
    private int _ac3Stereo;

    /// <summary>
    /// Bitrate AC-3 surround 5.1
    /// </summary>
    private int _ac3S51;

    /// <summary>
    /// Messaggio errore validazione
    /// </summary>
    private string _validationError = "";

    /// <summary>
    /// Carica valori correnti da AppSettings
    /// </summary>
    protected override void OnInitialized()
    {
        this._flacCompression = AppSettingsService.Instance.Settings.Flac.CompressionLevel;
        this._opusMono = AppSettingsService.Instance.Settings.Opus.Bitrate.Mono;
        this._opusStereo = AppSettingsService.Instance.Settings.Opus.Bitrate.Stereo;
        this._opusS51 = AppSettingsService.Instance.Settings.Opus.Bitrate.Surround51;
        this._opusS71 = AppSettingsService.Instance.Settings.Opus.Bitrate.Surround71;
        this._aacMono = AppSettingsService.Instance.Settings.Aac.Bitrate.Mono;
        this._aacStereo = AppSettingsService.Instance.Settings.Aac.Bitrate.Stereo;
        this._aacS51 = AppSettingsService.Instance.Settings.Aac.Bitrate.Surround51;
        this._aacS71 = AppSettingsService.Instance.Settings.Aac.Bitrate.Surround71;
        this._ac3Mono = AppSettingsService.Instance.Settings.Ac3.Bitrate.Mono;
        this._ac3Stereo = AppSettingsService.Instance.Settings.Ac3.Bitrate.Stereo;
        this._ac3S51 = AppSettingsService.Instance.Settings.Ac3.Bitrate.Surround51;
    }

    /// <summary>
    /// Salva impostazioni audio con validazione, non chiude se errore
    /// </summary>
    private void Save()
    {
        string errorMessage;

        // Valori nel model
        AppSettingsService.Instance.Settings.Flac.CompressionLevel = this._flacCompression;
        AppSettingsService.Instance.Settings.Opus.Bitrate.Mono = this._opusMono;
        AppSettingsService.Instance.Settings.Opus.Bitrate.Stereo = this._opusStereo;
        AppSettingsService.Instance.Settings.Opus.Bitrate.Surround51 = this._opusS51;
        AppSettingsService.Instance.Settings.Opus.Bitrate.Surround71 = this._opusS71;
        AppSettingsService.Instance.Settings.Aac.Bitrate.Mono = this._aacMono;
        AppSettingsService.Instance.Settings.Aac.Bitrate.Stereo = this._aacStereo;
        AppSettingsService.Instance.Settings.Aac.Bitrate.Surround51 = this._aacS51;
        AppSettingsService.Instance.Settings.Aac.Bitrate.Surround71 = this._aacS71;
        AppSettingsService.Instance.Settings.Ac3.Bitrate.Mono = this._ac3Mono;
        AppSettingsService.Instance.Settings.Ac3.Bitrate.Stereo = this._ac3Stereo;
        AppSettingsService.Instance.Settings.Ac3.Bitrate.Surround51 = this._ac3S51;

        // Valida
        if (!AppSettingsService.Instance.ValidateAudio(out errorMessage))
        {
            this._validationError = errorMessage;
            return;
        }

        this._validationError = "";
        AppSettingsService.Instance.Save();
        this.CloseDialog();
    }
}
