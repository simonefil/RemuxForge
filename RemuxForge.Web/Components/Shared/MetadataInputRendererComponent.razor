@using System.Threading.Tasks

@if (ShouldRenderSelect())
{
    <select id="@_inputId" class="@CssClass" value="@_currentValue" @onchange="CommitChangedValue" @onfocus="HandleFocus" @onmouseenter="HandleMouseEnter">
        @if (EffectiveSchema.AllowsEmpty)
        {
            <option value=""></option>
        }
        @foreach (MetadataInputOption option in EffectiveSchema.Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
}
else if (ShouldRenderDatalist())
{
    @if (UseNativeTextEditing())
    {
        <input id="@_inputId" class="@CssClass" type="@GetHtmlInputType()" step="@EffectiveSchema.Step" list="@_listId" value="@_currentValue" placeholder="@EffectiveSchema.Placeholder" @onchange="CommitChangedValue" @onfocus="HandleFocus" @onmouseenter="HandleMouseEnter" />
    }
    else
    {
        <input id="@_inputId" class="@CssClass" type="@GetHtmlInputType()" step="@EffectiveSchema.Step" list="@_listId" value="@_currentValue" placeholder="@EffectiveSchema.Placeholder" @oninput="UpdateLocalValue" @onchange="CommitChangedValue" @onblur="CommitCurrentValue" @onfocus="HandleFocus" @onmouseenter="HandleMouseEnter" @onkeydown="HandleKeyDown" />
    }
    <datalist id="@_listId">
        @foreach (MetadataInputOption option in EffectiveSchema.Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </datalist>
}
else
{
    @if (UseNativeTextEditing())
    {
        <input id="@_inputId" class="@CssClass" type="@GetHtmlInputType()" step="@EffectiveSchema.Step" value="@_currentValue" placeholder="@EffectiveSchema.Placeholder" @onchange="CommitChangedValue" @onfocus="HandleFocus" @onmouseenter="HandleMouseEnter" />
    }
    else
    {
        <input id="@_inputId" class="@CssClass" type="@GetHtmlInputType()" step="@EffectiveSchema.Step" value="@_currentValue" placeholder="@EffectiveSchema.Placeholder" @oninput="UpdateLocalValue" @onchange="CommitChangedValue" @onblur="CommitCurrentValue" @onfocus="HandleFocus" @onmouseenter="HandleMouseEnter" @onkeydown="HandleKeyDown" />
    }
}

@code {
    /// <summary>
    /// Schema input fornito dal catalogo Core
    /// </summary>
    [Parameter] public MetadataInputSchema Schema { get; set; }

    /// <summary>
    /// Valore corrente
    /// </summary>
    [Parameter] public string Value { get; set; }

    /// <summary>
    /// Evento cambio valore
    /// </summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Classe CSS input
    /// </summary>
    [Parameter] public string CssClass { get; set; } = "form-input";

    /// <summary>
    /// Lascia la digitazione testuale al browser e propaga il valore solo alla conferma
    /// </summary>
    [Parameter] public bool NativeTextEditing { get; set; }

    /// <summary>
    /// Evento focus
    /// </summary>
    [Parameter] public EventCallback OnFocus { get; set; }

    /// <summary>
    /// Evento attivazione input testuale con identificativo DOM
    /// </summary>
    [Parameter] public EventCallback<string> OnTextActivated { get; set; }

    /// <summary>
    /// Evento hover
    /// </summary>
    [Parameter] public EventCallback OnMouseEnter { get; set; }

    /// <summary>
    /// Evento richiesta editor testo espanso
    /// </summary>
    [Parameter] public EventCallback OnExpandedEditRequested { get; set; }

    /// <summary>
    /// Identificativo datalist
    /// </summary>
    private readonly string _listId = "metadata-input-" + Guid.NewGuid().ToString("N");

    /// <summary>
    /// Identificativo DOM stabile dell'input
    /// </summary>
    private readonly string _inputId = "metadata-text-input-" + Guid.NewGuid().ToString("N");

    /// <summary>
    /// Valore locale digitato senza notificare il parent a ogni tasto
    /// </summary>
    private string _currentValue = "";

    /// <summary>
    /// Ultimo valore ricevuto o confermato dal parent
    /// </summary>
    private string _lastParameterValue = "";

    /// <summary>
    /// Sincronizza il buffer locale quando il parent cambia valore
    /// </summary>
    protected override void OnParametersSet()
    {
        string value = this.Value != null ? this.Value : "";
        if (!string.Equals(value, this._lastParameterValue, StringComparison.Ordinal))
        {
            this._currentValue = value;
            this._lastParameterValue = value;
        }
    }

    /// <summary>
    /// Schema effettivo con fallback testuale
    /// </summary>
    private MetadataInputSchema EffectiveSchema
    {
        get
        {
            return this.Schema != null ? this.Schema : new MetadataInputSchema();
        }
    }

    /// <summary>
    /// Indica se usare select chiusa
    /// </summary>
    /// <returns>Vero se serve select</returns>
    private bool ShouldRenderSelect()
    {
        if (this.EffectiveSchema.SupportsExpression)
            return false;

        return this.EffectiveSchema.InputKind == MetadataFieldInputKind.Select ||
            this.EffectiveSchema.InputKind == MetadataFieldInputKind.Boolean ||
            this.EffectiveSchema.InputKind == MetadataFieldInputKind.LanguageSelect;
    }

    /// <summary>
    /// Indica se usare input con datalist
    /// </summary>
    /// <returns>Vero se serve datalist</returns>
    private bool ShouldRenderDatalist()
    {
        return this.EffectiveSchema.Options != null &&
            this.EffectiveSchema.Options.Count > 0 &&
            (this.EffectiveSchema.SupportsExpression ||
                this.EffectiveSchema.InputKind == MetadataFieldInputKind.LanguageIetf);
    }

    /// <summary>
    /// Restituisce il tipo HTML compatibile con eventuali espressioni
    /// </summary>
    /// <returns>Tipo input HTML</returns>
    private string GetHtmlInputType()
    {
        return this.EffectiveSchema.SupportsExpression ? "text" : this.EffectiveSchema.HtmlInputType;
    }

    /// <summary>
    /// Indica se l'input corrente può usare l'editor testo espanso
    /// </summary>
    /// <returns>Vero se il valore è stringa semplice</returns>
    private bool CanUseExpandedEditor()
    {
        if (!this.OnExpandedEditRequested.HasDelegate || this.ShouldRenderSelect())
            return false;

        return this.EffectiveSchema.ValueType == MetadataFieldValueType.String &&
            this.EffectiveSchema.InputKind == MetadataFieldInputKind.Text;
    }

    /// <summary>
    /// Indica se evitare eventi server durante la digitazione
    /// </summary>
    /// <returns>Vero se il browser può gestire autonomamente il testo</returns>
    private bool UseNativeTextEditing()
    {
        return this.NativeTextEditing && !this.CanUseExpandedEditor();
    }

    /// <summary>
    /// Aggiorna il buffer locale senza invalidare l'intero preset builder
    /// </summary>
    /// <param name="args">Argomenti change/input</param>
    private void UpdateLocalValue(ChangeEventArgs args)
    {
        this._currentValue = args != null && args.Value != null ? args.Value.ToString() : "";
    }

    /// <summary>
    /// Aggiorna e propaga il valore quando l'editing del campo è confermato
    /// </summary>
    /// <param name="args">Argomenti change/input</param>
    private Task CommitChangedValue(ChangeEventArgs args)
    {
        this.UpdateLocalValue(args);
        return this.CommitCurrentValue();
    }

    /// <summary>
    /// Propaga il valore corrente al parent solo se è realmente cambiato
    /// </summary>
    private Task CommitCurrentValue()
    {
        string value = this._currentValue != null ? this._currentValue : "";
        if (string.Equals(value, this._lastParameterValue, StringComparison.Ordinal))
            return Task.CompletedTask;

        this._lastParameterValue = value;
        return this.ValueChanged.InvokeAsync(value);
    }

    /// <summary>
    /// Propaga focus
    /// </summary>
    private async Task HandleFocus()
    {
        await this.OnFocus.InvokeAsync();
        if (!this.ShouldRenderSelect())
            await this.OnTextActivated.InvokeAsync(this._inputId);
    }

    /// <summary>
    /// Propaga hover
    /// </summary>
    private Task HandleMouseEnter()
    {
        return this.OnMouseEnter.InvokeAsync();
    }

    /// <summary>
    /// Gestisce shortcut locali dell'input
    /// </summary>
    /// <param name="args">Argomenti tastiera</param>
    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args != null && args.ShiftKey && string.Equals(args.Key, "F2", StringComparison.OrdinalIgnoreCase) && this.CanUseExpandedEditor())
        {
            await this.CommitCurrentValue();
            await this.OnExpandedEditRequested.InvokeAsync();
        }
    }
}
