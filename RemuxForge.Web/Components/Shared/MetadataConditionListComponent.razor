<div class="metadata-condition-stack @(Nested ? "metadata-condition-stack-nested" : "")">
    @if (Nodes == null || Nodes.Count == 0)
    {
        <div class="metadata-sentence-card">
            <div class="metadata-sentence-row">
                <span class="metadata-sentence-kind">@AppText.T("web.metadata.presetDialog.alwaysTrue")</span>
                <span class="metadata-sentence-placeholder"></span>
            </div>
        </div>
    }
    else
    {
        @for (int i = 0; i < Nodes.Count; i++)
        {
            int nodeIndex = i;
            MkvMetadataRuleConditionNode node = Nodes[nodeIndex];

            <div class="metadata-sentence-card @(node.NodeType == MkvMetadataRuleConditionNodeType.AlternativeAny ? "metadata-alternative-card" : "") @(Nested ? "metadata-sentence-card-nested" : "")">
                @if (node.NodeType == MkvMetadataRuleConditionNodeType.AlternativeAny)
                {
                    <div class="metadata-alternative-header">
                        <div>
                            <div class="metadata-sentence-card-title">@AppText.T("web.metadata.presetDialog.alternativeTitle")</div>
                            <div class="metadata-rule-section-caption">@AppText.T("web.metadata.presetDialog.alternativeCaption")</div>
                        </div>
                        @NodeActions(Nodes, nodeIndex)
                    </div>
                    <MetadataConditionListComponent Rule="Rule" Nodes="node.Alternative.Any" Nested="true" AllowAlternative="false" IncludeAdvancedFields="IncludeAdvancedFields" OnFieldActivated="OnFieldActivated" OnInputActivated="OnInputActivated" OnHelpChanged="OnHelpChanged" OnTextEditRequested="OnTextEditRequested" />
                }
                else if (node.NodeType == MkvMetadataRuleConditionNodeType.TrackComparison)
                {
                    MkvMetadataTrackComparisonCondition condition = node.TrackComparison;
                    <div class="metadata-sentence-row">
                        <span class="metadata-sentence-kind">@AppText.T("web.metadata.presetDialog.trackComparisonShort")</span>
                        <select class="form-input metadata-sentence-field" aria-label="@AppText.T("web.metadata.presetDialog.help.conditionField.title")" value="@condition.FieldKey" @onchange="@((ChangeEventArgs e) => ChangeTrackComparisonField(condition, GetChangeValue(e)))" @onfocus="@(() => ActivateTrackComparisonFieldAsync(condition))" @onmouseenter="@(() => ActivateTrackComparisonFieldAsync(condition))">
                            @foreach (MetadataFieldDefinition field in MetadataPresetUiHelper.GetTrackComparableFields(Scope, IncludeAdvancedFields))
                            {
                                <option value="@field.Key">@field.Label</option>
                            }
                        </select>
                        <select class="form-input metadata-sentence-operator" aria-label="@AppText.T("web.metadata.presetDialog.help.conditionOperator.title")" value="@condition.Relation" @onchange="@((ChangeEventArgs e) => ChangeTrackComparisonRelation(condition, GetChangeValue(e)))" @onfocus='@(() => SetFieldHelp("trackComparison"))' @onmouseenter='@(() => SetFieldHelp("trackComparison"))'>
                            @foreach (MkvMetadataTrackComparisonRelation relation in MetadataPresetUiHelper.GetTrackComparisonRelations(condition.FieldKey))
                            {
                                <option value="@relation">@MetadataPresetUiHelper.GetTrackComparisonRelationLabel(relation)</option>
                            }
                        </select>
                        @if (condition.Relation == MkvMetadataTrackComparisonRelation.Rank)
                        {
                            <input type="number" min="1" class="form-input metadata-rank-input" aria-label="@AppText.T("web.metadata.presetDialog.trackComparisonShort")" @bind="condition.Rank" @onfocus='@(() => SetFieldHelp("trackComparison"))' @onmouseenter='@(() => SetFieldHelp("trackComparison"))' />
                        }
                        <select class="form-input metadata-sentence-group" aria-label="@AppText.T("web.metadata.presetDialog.help.trackGroup.title")" @bind="condition.Group" @onfocus='@(() => SetFieldHelp("trackGroup"))' @onmouseenter='@(() => SetFieldHelp("trackGroup"))'>
                            @foreach (MkvMetadataTrackGroup group in MetadataPresetUiHelper.GetTrackGroupOptions())
                            {
                                <option value="@group">@MetadataPresetUiHelper.GetTrackGroupLabel(group)</option>
                            }
                        </select>
                        @NodeActions(Nodes, nodeIndex)
                    </div>
                }
                else if (node.NodeType == MkvMetadataRuleConditionNodeType.TrackGroupCount)
                {
                    MkvMetadataTrackGroupCountCondition condition = node.TrackGroupCount;
                    <div class="metadata-sentence-row">
                        <span class="metadata-sentence-kind">@AppText.T("web.metadata.presetDialog.trackCountPrefix")</span>
                        <select class="form-input metadata-sentence-group" aria-label="@AppText.T("web.metadata.presetDialog.help.trackGroup.title")" @bind="condition.Group" @onfocus='@(() => SetFieldHelp("trackGroup"))' @onmouseenter='@(() => SetFieldHelp("trackGroup"))'>
                            @foreach (MkvMetadataTrackGroup group in MetadataPresetUiHelper.GetTrackGroupOptions())
                            {
                                <option value="@group">@MetadataPresetUiHelper.GetTrackGroupLabel(group)</option>
                            }
                        </select>
                        <select class="form-input metadata-sentence-operator" aria-label="@AppText.T("web.metadata.presetDialog.help.conditionOperator.title")" @bind="condition.Operator" @onfocus='@(() => SetFieldHelp("conditionOperator"))' @onmouseenter='@(() => SetFieldHelp("conditionOperator"))'>
                            @foreach (MkvMetadataConditionOperator op in MetadataPresetUiHelper.GetNumericOperatorOptions(false))
                            {
                                <option value="@op">@MetadataPresetUiHelper.GetConditionOperatorLabel(op)</option>
                            }
                        </select>
                        <input type="number" min="0" class="form-input metadata-rank-input" aria-label="@AppText.T("web.metadata.presetDialog.help.trackGroupCount.title")" @bind="condition.Value" @onfocus='@(() => SetFieldHelp("trackGroupCount"))' @onmouseenter='@(() => SetFieldHelp("trackGroupCount"))' />
                        @NodeActions(Nodes, nodeIndex)
                    </div>
                }
                else
                {
                    MkvMetadataFieldCondition condition = node.Field;
                    <div class="metadata-sentence-row">
                        <select class="form-input metadata-sentence-field" aria-label="@AppText.T("web.metadata.presetDialog.help.conditionField.title")" value="@condition.FieldKey" @onchange="@((ChangeEventArgs e) => ChangeFieldConditionField(condition, GetChangeValue(e)))" @onfocus="@(() => ActivateFieldConditionAsync(condition))" @onmouseenter="@(() => ActivateFieldConditionAsync(condition))">
                            @foreach (MetadataFieldDefinition field in MetadataPresetUiHelper.GetReadableFieldsForCondition(Scope, IncludeAdvancedFields))
                            {
                                <option value="@field.Key">@field.Label</option>
                            }
                        </select>
                        <select class="form-input metadata-sentence-operator" aria-label="@AppText.T("web.metadata.presetDialog.help.conditionOperator.title")" value="@condition.Operator" @onchange="@((ChangeEventArgs e) => ChangeFieldConditionOperator(condition, GetChangeValue(e)))" @onfocus='@(() => SetFieldHelp("conditionOperator"))' @onmouseenter='@(() => SetFieldHelp("conditionOperator"))'>
                            @foreach (MkvMetadataConditionOperator op in MetadataPresetUiHelper.GetFieldOperatorOptions(condition.FieldKey))
                            {
                                <option value="@op">@MetadataPresetUiHelper.GetConditionOperatorLabel(op)</option>
                            }
                        </select>
                        @if (MetadataPresetUiHelper.OperatorNeedsValue(condition.Operator))
                        {
                            @if (MetadataPresetUiHelper.OperatorNeedsList(condition.Operator))
                            {
                                <div class="metadata-chip-editor">
                                    @for (int j = 0; j < condition.Values.Count; j++)
                                    {
                                        int valueIndex = j;
                                        <span class="metadata-chip">
                                            <MetadataInputRendererComponent Schema="@MetadataPresetUiHelper.GetFieldInputSchema(condition.FieldKey, MetadataCatalogInputUsage.ConditionValue)" AriaLabel="@AppText.T("web.metadata.presetDialog.help.conditionValue.title")" Value="@condition.Values[valueIndex]" ValueChanged="@((string value) => ChangeListValue(condition, valueIndex, value))" CssClass="" OnFocus="@(() => SetFieldHelp("conditionValue"))" OnTextActivated="@((string inputId) => ActivateTextInputAsync(condition, MetadataConditionTextTarget.ListValue, valueIndex, inputId))" OnMouseEnter="@(() => SetFieldHelp("conditionValue"))" OnExpandedEditRequested="@(() => RequestTextEditor(condition, MetadataConditionTextTarget.ListValue, valueIndex))" />
                                            <RadzenButton Icon="close" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" aria-label="@AppText.T("web.common.delete")" title="@AppText.T("web.common.delete")" Click="@(() => RemoveListValue(condition, valueIndex))" />
                                        </span>
                                    }
                                    <RadzenButton Icon="add" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.common.new")" title="@AppText.T("web.common.new")" Click="@(() => AddListValue(condition))" />
                                </div>
                            }
                            else if (MetadataPresetUiHelper.OperatorNeedsRange(condition.Operator))
                            {
                                <div class="metadata-range-editor">
                                    <MetadataInputRendererComponent Schema="@MetadataPresetUiHelper.GetFieldInputSchema(condition.FieldKey, MetadataCatalogInputUsage.ConditionValue)" AriaLabel="@AppText.T("web.metadata.presetDialog.help.conditionValue.title")" Value="@condition.FromValue" ValueChanged="@((string value) => condition.FromValue = value)" CssClass="form-input" OnFocus="@(() => SetFieldHelp("conditionValue"))" OnTextActivated="@((string inputId) => ActivateTextInputAsync(condition, MetadataConditionTextTarget.FromValue, -1, inputId))" OnMouseEnter="@(() => SetFieldHelp("conditionValue"))" OnExpandedEditRequested="@(() => RequestTextEditor(condition, MetadataConditionTextTarget.FromValue, -1))" />
                                    <span>@AppText.T("web.metadata.presetDialog.rangeTo")</span>
                                    <MetadataInputRendererComponent Schema="@MetadataPresetUiHelper.GetFieldInputSchema(condition.FieldKey, MetadataCatalogInputUsage.ConditionValue)" AriaLabel="@AppText.T("web.metadata.presetDialog.help.conditionValue.title")" Value="@condition.ToValue" ValueChanged="@((string value) => condition.ToValue = value)" CssClass="form-input" OnFocus="@(() => SetFieldHelp("conditionValue"))" OnTextActivated="@((string inputId) => ActivateTextInputAsync(condition, MetadataConditionTextTarget.ToValue, -1, inputId))" OnMouseEnter="@(() => SetFieldHelp("conditionValue"))" OnExpandedEditRequested="@(() => RequestTextEditor(condition, MetadataConditionTextTarget.ToValue, -1))" />
                                    @UnitSelector(condition)
                                </div>
                            }
                            else
                            {
                                <div class="metadata-value-editor">
                                    <MetadataInputRendererComponent Schema="@MetadataPresetUiHelper.GetFieldInputSchema(condition.FieldKey, MetadataCatalogInputUsage.ConditionValue)" AriaLabel="@AppText.T("web.metadata.presetDialog.help.conditionValue.title")" Value="@condition.Value" ValueChanged="@((string value) => condition.Value = value)" CssClass="form-input" OnFocus="@(() => SetFieldHelp("conditionValue"))" OnTextActivated="@((string inputId) => ActivateTextInputAsync(condition, MetadataConditionTextTarget.Value, -1, inputId))" OnMouseEnter="@(() => SetFieldHelp("conditionValue"))" OnExpandedEditRequested="@(() => RequestTextEditor(condition, MetadataConditionTextTarget.Value, -1))" />
                                    @UnitSelector(condition)
                                </div>
                            }
                        }
                        else
                        {
                            <span class="metadata-sentence-placeholder"></span>
                        }
                        @NodeActions(Nodes, nodeIndex)
                    </div>
                }
            </div>
        }
    }
</div>

<div class="metadata-rule-button-row">
    <RadzenButton Text="@AppText.T("web.metadata.presetDialog.addCondition")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddFieldCondition" />
    @if (MetadataPresetUiHelper.CanUseTrackConditions(Scope))
    {
        <RadzenButton Text="@AppText.T("web.metadata.presetDialog.addTrackComparisonSentence")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddTrackComparison" />
        <RadzenButton Text="@AppText.T("web.metadata.presetDialog.addTrackCount")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddTrackCount" />
    }
    @if (AllowAlternative)
    {
        <RadzenButton Text="@AppText.T("web.metadata.presetDialog.addAlternative")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddAlternative" />
    }
</div>

@code {
    /// <summary>
    /// Regola proprietaria delle condizioni
    /// </summary>
    [Parameter] public MkvMetadataRule Rule { get; set; }

    /// <summary>
    /// Nodi condizione da renderizzare
    /// </summary>
    [Parameter] public List<MkvMetadataRuleConditionNode> Nodes { get; set; }

    /// <summary>
    /// Indica se la lista è annidata dentro un blocco OR
    /// </summary>
    [Parameter] public bool Nested { get; set; }

    /// <summary>
    /// Indica se la lista può aggiungere blocchi OR
    /// </summary>
    [Parameter] public bool AllowAlternative { get; set; } = true;

    /// <summary>
    /// Indica se includere campi avanzati
    /// </summary>
    [Parameter] public bool IncludeAdvancedFields { get; set; }

    /// <summary>
    /// Evento attivazione campo condizione per il token browser
    /// </summary>
    [Parameter] public EventCallback<MkvMetadataFieldCondition> OnFieldActivated { get; set; }

    /// <summary>
    /// Evento attivazione input testuale per il token browser
    /// </summary>
    [Parameter] public EventCallback<MetadataTextInputTarget> OnInputActivated { get; set; }

    /// <summary>
    /// Evento cambio help contestuale
    /// </summary>
    [Parameter] public EventCallback<string> OnHelpChanged { get; set; }

    /// <summary>
    /// Evento richiesta editor testo espanso
    /// </summary>
    [Parameter] public EventCallback<MetadataTextEditRequest> OnTextEditRequested { get; set; }

    /// <summary>
    /// Target valore condizione per editor espanso
    /// </summary>
    private enum MetadataConditionTextTarget
    {
        Value,
        FromValue,
        ToValue,
        ListValue
    }

    /// <summary>
    /// Ambito corrente della regola
    /// </summary>
    private MkvMetadataTargetScope Scope
    {
        get
        {
            return this.Rule != null ? this.Rule.TargetScope : MkvMetadataTargetScope.Audio;
        }
    }

    /// <summary>
    /// Normalizza i nodi prima del render
    /// </summary>
    protected override void OnParametersSet()
    {
        if (this.Nodes == null)
            return;

        for (int i = 0; i < this.Nodes.Count; i++)
            MetadataPresetUiHelper.EnsureNode(this.Rule, this.Nodes[i], this.IncludeAdvancedFields);
    }

    /// <summary>
    /// Renderizza i controlli movimento/rimozione del nodo
    /// </summary>
    /// <param name="nodes">Lista proprietaria</param>
    /// <param name="index">Indice nodo</param>
    /// <returns>Markup azioni</returns>
    private RenderFragment NodeActions(List<MkvMetadataRuleConditionNode> nodes, int index)
    {
        return @<div class="metadata-node-actions">
            <RadzenButton Icon="arrow_upward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.rename.moveUp")" title="@AppText.T("web.rename.moveUp")" Click="@(() => this.MoveNode(nodes, index, -1))" Disabled="@(index == 0)" />
            <RadzenButton Icon="arrow_downward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.rename.moveDown")" title="@AppText.T("web.rename.moveDown")" Click="@(() => this.MoveNode(nodes, index, 1))" Disabled="@(nodes == null || index >= nodes.Count - 1)" />
            <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" aria-label="@AppText.T("web.common.delete")" title="@AppText.T("web.common.delete")" Click="@(() => this.RemoveNode(nodes, index))" />
        </div>;
    }

    /// <summary>
    /// Renderizza il selettore unità quando richiesto dal campo
    /// </summary>
    /// <param name="condition">Condizione campo</param>
    /// <returns>Markup selettore unità</returns>
    private RenderFragment UnitSelector(MkvMetadataFieldCondition condition)
    {
        return @<text>
            @{
                MetadataInputSchema schema = MetadataPresetUiHelper.GetFieldInputSchema(condition.FieldKey, MetadataCatalogInputUsage.ConditionValue);
            }
            @if (schema.UnitOptions.Count > 1)
            {
                <select class="form-input metadata-rule-select-unit" aria-label="@AppText.T("web.metadata.presetDialog.help.conditionUnit.title")" @bind="condition.Unit" @onfocus='@(() => this.SetFieldHelp("conditionUnit"))' @onmouseenter='@(() => this.SetFieldHelp("conditionUnit"))'>
                    @foreach (MetadataInputOption unit in schema.UnitOptions)
                    {
                        <option value="@unit.Value">@unit.Label</option>
                    }
                </select>
            }
        </text>;
    }

    /// <summary>
    /// Aggiunge una condizione su campo
    /// </summary>
    private void AddFieldCondition()
    {
        this.AddNode(MetadataPresetUiHelper.CreateFieldConditionNode(this.Scope, this.IncludeAdvancedFields));
    }

    /// <summary>
    /// Aggiunge una condizione confronto tracce
    /// </summary>
    private void AddTrackComparison()
    {
        if (!MetadataPresetUiHelper.CanUseTrackConditions(this.Scope))
            return;

        this.AddNode(MetadataPresetUiHelper.CreateTrackComparisonNode(this.Scope, this.IncludeAdvancedFields));
    }

    /// <summary>
    /// Aggiunge una condizione conteggio tracce
    /// </summary>
    private void AddTrackCount()
    {
        if (!MetadataPresetUiHelper.CanUseTrackConditions(this.Scope))
            return;

        this.AddNode(MetadataPresetUiHelper.CreateTrackGroupCountNode());
    }

    /// <summary>
    /// Aggiunge un blocco OR
    /// </summary>
    private void AddAlternative()
    {
        if (!this.AllowAlternative || this.Nodes == null)
            return;

        MkvMetadataRuleConditionNode node = new MkvMetadataRuleConditionNode();
        node.NodeType = MkvMetadataRuleConditionNodeType.AlternativeAny;
        node.Field = null;
        node.Alternative = new MkvMetadataAlternativeAnyBlock();
        node.Alternative.Any.Add(MetadataPresetUiHelper.CreateFieldConditionNode(this.Scope, this.IncludeAdvancedFields));
        this.Nodes.Add(node);
    }

    /// <summary>
    /// Aggiunge un nodo alla lista corrente
    /// </summary>
    /// <param name="node">Nodo da aggiungere</param>
    private void AddNode(MkvMetadataRuleConditionNode node)
    {
        if (this.Nodes == null)
            return;

        this.Nodes.Add(node);
    }

    /// <summary>
    /// Sposta un nodo
    /// </summary>
    /// <param name="nodes">Lista proprietaria</param>
    /// <param name="index">Indice di partenza</param>
    /// <param name="delta">Spostamento richiesto</param>
    private void MoveNode(List<MkvMetadataRuleConditionNode> nodes, int index, int delta)
    {
        int target = index + delta;
        if (nodes == null || index < 0 || index >= nodes.Count || target < 0 || target >= nodes.Count)
            return;

        MkvMetadataRuleConditionNode node = nodes[index];
        nodes.RemoveAt(index);
        nodes.Insert(target, node);
    }

    /// <summary>
    /// Rimuove un nodo
    /// </summary>
    /// <param name="nodes">Lista proprietaria</param>
    /// <param name="index">Indice nodo</param>
    private void RemoveNode(List<MkvMetadataRuleConditionNode> nodes, int index)
    {
        if (nodes != null && index >= 0 && index < nodes.Count)
            nodes.RemoveAt(index);
    }

    /// <summary>
    /// Cambia il campo di una condizione campo
    /// </summary>
    /// <param name="condition">Condizione da aggiornare</param>
    /// <param name="value">Nuova chiave campo</param>
    private void ChangeFieldConditionField(MkvMetadataFieldCondition condition, string value)
    {
        if (condition == null)
            return;

        condition.FieldKey = value != null ? value : "";
        MetadataPresetUiHelper.EnsureFieldCondition(this.Scope, condition, this.IncludeAdvancedFields);
    }

    /// <summary>
    /// Cambia l'operatore di una condizione campo
    /// </summary>
    /// <param name="condition">Condizione da aggiornare</param>
    /// <param name="value">Nuovo operatore</param>
    private void ChangeFieldConditionOperator(MkvMetadataFieldCondition condition, string value)
    {
        MkvMetadataConditionOperator parsed;
        if (condition == null)
            return;
        if (Enum.TryParse(value, out parsed))
        {
            condition.Operator = parsed;
            MetadataPresetUiHelper.EnsureFieldCondition(this.Scope, condition, this.IncludeAdvancedFields);
        }
    }

    /// <summary>
    /// Cambia il campo di una condizione confronto tracce
    /// </summary>
    /// <param name="condition">Condizione da aggiornare</param>
    /// <param name="value">Nuova chiave campo</param>
    private void ChangeTrackComparisonField(MkvMetadataTrackComparisonCondition condition, string value)
    {
        if (condition == null)
            return;

        condition.FieldKey = value != null ? value : "";
        MetadataPresetUiHelper.EnsureTrackComparisonCondition(this.Scope, condition, this.IncludeAdvancedFields);
    }

    /// <summary>
    /// Cambia la relazione di una condizione confronto tracce
    /// </summary>
    /// <param name="condition">Condizione da aggiornare</param>
    /// <param name="value">Nuova relazione</param>
    private void ChangeTrackComparisonRelation(MkvMetadataTrackComparisonCondition condition, string value)
    {
        MkvMetadataTrackComparisonRelation parsed;
        if (condition == null)
            return;
        if (Enum.TryParse(value, out parsed))
        {
            condition.Relation = parsed;
            MetadataPresetUiHelper.EnsureTrackComparisonCondition(this.Scope, condition, this.IncludeAdvancedFields);
        }
    }

    /// <summary>
    /// Aggiunge un valore alla lista
    /// </summary>
    /// <param name="condition">Condizione lista</param>
    private void AddListValue(MkvMetadataFieldCondition condition)
    {
        if (condition != null)
            condition.Values.Add("");
    }

    /// <summary>
    /// Rimuove un valore dalla lista
    /// </summary>
    /// <param name="condition">Condizione lista</param>
    /// <param name="index">Indice valore</param>
    private void RemoveListValue(MkvMetadataFieldCondition condition, int index)
    {
        if (condition != null && index >= 0 && index < condition.Values.Count)
            condition.Values.RemoveAt(index);
    }

    /// <summary>
    /// Cambia un valore della lista
    /// </summary>
    /// <param name="condition">Condizione lista</param>
    /// <param name="index">Indice valore</param>
    /// <param name="value">Nuovo valore</param>
    private void ChangeListValue(MkvMetadataFieldCondition condition, int index, string value)
    {
        if (condition != null && index >= 0 && index < condition.Values.Count)
            condition.Values[index] = value != null ? value : "";
    }

    /// <summary>
    /// Richiede apertura editor testo espanso per una condizione
    /// </summary>
    /// <param name="condition">Condizione da modificare</param>
    /// <param name="target">Campo valore da modificare</param>
    /// <param name="index">Indice valore lista</param>
    private Task RequestTextEditor(MkvMetadataFieldCondition condition, MetadataConditionTextTarget target, int index)
    {
        MetadataFieldDefinition field;
        MetadataTextEditRequest request;
        string fieldLabel;
        string editorValue;

        if (condition == null)
            return Task.CompletedTask;

        fieldLabel = condition.FieldKey;
        if (MetadataFieldRegistry.TryGet(condition.FieldKey, out field))
            fieldLabel = field.Label;

        if (target == MetadataConditionTextTarget.FromValue)
            editorValue = condition.FromValue != null ? condition.FromValue : "";
        else if (target == MetadataConditionTextTarget.ToValue)
            editorValue = condition.ToValue != null ? condition.ToValue : "";
        else if (target == MetadataConditionTextTarget.ListValue && index >= 0 && index < condition.Values.Count)
            editorValue = condition.Values[index] != null ? condition.Values[index] : "";
        else
            editorValue = condition.Value != null ? condition.Value : "";

        request = new MetadataTextEditRequest();
        request.Title = AppText.F("web.metadata.presetDialog.textEditorConditionTitle", fieldLabel);
        request.Value = editorValue;
        request.Commit = value =>
        {
            string nextValue = value != null ? value : "";

            if (target == MetadataConditionTextTarget.FromValue)
            {
                condition.FromValue = nextValue;
                return;
            }

            if (target == MetadataConditionTextTarget.ToValue)
            {
                condition.ToValue = nextValue;
                return;
            }

            if (target == MetadataConditionTextTarget.ListValue)
            {
                if (index >= 0 && index < condition.Values.Count)
                    condition.Values[index] = nextValue;

                return;
            }

            condition.Value = nextValue;
        };
        return this.OnTextEditRequested.InvokeAsync(request);
    }

    /// <summary>
    /// Notifica la condizione campo attiva
    /// </summary>
    /// <param name="condition">Condizione attiva</param>
    private Task ActivateFieldConditionAsync(MkvMetadataFieldCondition condition)
    {
        return this.OnFieldActivated.InvokeAsync(condition);
    }

    /// <summary>
    /// Notifica il campo attivo di un confronto tra tracce
    /// </summary>
    /// <param name="condition">Confronto attivo</param>
    private Task ActivateTrackComparisonFieldAsync(MkvMetadataTrackComparisonCondition condition)
    {
        MkvMetadataFieldCondition fieldCondition = new MkvMetadataFieldCondition();
        fieldCondition.FieldKey = condition != null ? condition.FieldKey : "";
        return this.OnFieldActivated.InvokeAsync(fieldCondition);
    }

    /// <summary>
    /// Notifica il target testuale esatto attivato
    /// </summary>
    /// <param name="condition">Condizione proprietaria</param>
    /// <param name="target">Campo valore attivato</param>
    /// <param name="index">Indice valore lista</param>
    /// <param name="inputId">Identificativo DOM input</param>
    private async Task ActivateTextInputAsync(MkvMetadataFieldCondition condition, MetadataConditionTextTarget target, int index, string inputId)
    {
        MetadataTextInputTarget inputTarget = new MetadataTextInputTarget();
        inputTarget.InputId = inputId;

        if (target == MetadataConditionTextTarget.FromValue)
        {
            inputTarget.Value = condition.FromValue;
            inputTarget.Commit = value => condition.FromValue = value;
        }
        else if (target == MetadataConditionTextTarget.ToValue)
        {
            inputTarget.Value = condition.ToValue;
            inputTarget.Commit = value => condition.ToValue = value;
        }
        else if (target == MetadataConditionTextTarget.ListValue && index >= 0 && index < condition.Values.Count)
        {
            inputTarget.Value = condition.Values[index];
            inputTarget.Commit = value =>
            {
                if (index >= 0 && index < condition.Values.Count)
                    condition.Values[index] = value;
            };
        }
        else
        {
            inputTarget.Value = condition.Value;
            inputTarget.Commit = value => condition.Value = value;
        }

        await this.OnInputActivated.InvokeAsync(inputTarget);
    }

    /// <summary>
    /// Cambia help contestuale
    /// </summary>
    /// <param name="key">Chiave help</param>
    private Task SetFieldHelp(string key)
    {
        return this.OnHelpChanged.InvokeAsync(key);
    }

    /// <summary>
    /// Estrae valore stringa da evento change/input
    /// </summary>
    /// <param name="e">Evento</param>
    /// <returns>Valore stringa</returns>
    private static string GetChangeValue(ChangeEventArgs e)
    {
        return e != null && e.Value != null ? e.Value.ToString() : "";
    }
}
