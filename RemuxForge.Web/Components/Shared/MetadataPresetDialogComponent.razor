    }

    /// <summary>
    /// Costruisce le voci del browser token
    /// </summary>
    /// <returns>Token disponibili</returns>
    private List<MetadataTokenBrowserItem> GetTokenBrowserItems()
    {
        List<MetadataTokenBrowserItem> result = new List<MetadataTokenBrowserItem>();
        MkvMetadataTargetScope scope = this.SelectedRule != null ? this.SelectedRule.TargetScope : MkvMetadataTargetScope.Audio;
        List<MetadataCatalogFieldItem> fields = MetadataUiCatalog.GetTokenCatalog(scope, this._showAdvancedFields);
        string filter = this._tokenBrowserFilter != null ? this._tokenBrowserFilter.Trim() : "";
        for (int i = 0; i < fields.Count; i++)
        {
            string token = fields[i].Token;
            if (string.IsNullOrEmpty(filter) || ContainsIgnoreCase(token, filter) || ContainsIgnoreCase(fields[i].Label, filter))
            {
                result.Add(new MetadataTokenBrowserItem { Token = token, Label = fields[i].Label, Description = fields[i].Description });
            }
        }

        return result;
    }

    /// <summary>
    /// Costruisce le voci del browser funzioni
    /// </summary>
    /// <returns>Funzioni disponibili</returns>
    private List<MetadataCatalogFunctionItem> GetFunctionBrowserItems()
    {
        List<MetadataCatalogFunctionItem> result = MetadataUiCatalog.GetFunctionCatalog();

        string filter = this._functionBrowserFilter != null ? this._functionBrowserFilter.Trim() : "";
        if (string.IsNullOrEmpty(filter))
            return result;

        List<MetadataCatalogFunctionItem> filtered = new List<MetadataCatalogFunctionItem>();
        for (int i = 0; i < result.Count; i++)
        {
            if (ContainsIgnoreCase(result[i].Call, filter) || ContainsIgnoreCase(result[i].Description, filter))
            {
                filtered.Add(result[i]);
            }
        }

        return filtered;
    }

