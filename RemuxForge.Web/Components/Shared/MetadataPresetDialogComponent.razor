    private List<MetadataFieldDefinition> GetReadableFieldsForCondition()
    {
        List<MetadataFieldDefinition> all = MetadataFieldRegistry.GetAll();
        List<MetadataFieldDefinition> result = new List<MetadataFieldDefinition>();
        MkvMetadataTargetScope scope = SelectedRule != null ? SelectedRule.TargetScope : MkvMetadataTargetScope.Audio;
        for (int i = 0; i < all.Count; i++)
        {
            if (!all[i].IsReadable) { continue; }
            if (all[i].Sector == MetadataFieldSector.File || all[i].Sector == MetadataFieldSector.Container || IsSectorForScope(all[i].Sector, scope))
            {
                result.Add(all[i]);
            }
        }

        SortFieldsByLabel(result);
        return result;
    }

    private List<MetadataFieldDefinition> GetTrackComparableFields()
    {
        List<MetadataFieldDefinition> fields = GetReadableFieldsForCondition();
        List<MetadataFieldDefinition> result = new List<MetadataFieldDefinition>();
        MkvMetadataTargetScope scope = SelectedRule != null ? SelectedRule.TargetScope : MkvMetadataTargetScope.Audio;
        for (int i = 0; i < fields.Count; i++)
        {
            if (IsSectorForScope(fields[i].Sector, scope) && fields[i].ValueType != MetadataFieldValueType.Boolean)
            {
                result.Add(fields[i]);
            }
        }

        SortFieldsByLabel(result);
        return result;
    }

    private List<MetadataFieldDefinition> GetEditableFields(MkvMetadataOperation operation)
    {
        List<MetadataFieldDefinition> fields = MetadataFieldRegistry.GetEditable(SelectedRule != null ? SelectedRule.TargetScope : MkvMetadataTargetScope.Audio, this._showAdvancedFields);
        List<MetadataFieldDefinition> result = new List<MetadataFieldDefinition>();
        for (int i = 0; i < fields.Count; i++)
        {
            if (operation.Type == MkvMetadataOperationType.ClearField && !fields[i].IsClearable) { continue; }
            if (operation.Type == MkvMetadataOperationType.SetExclusiveFlag && fields[i].ValueType != MetadataFieldValueType.Boolean) { continue; }
            result.Add(fields[i]);
        }

        SortFieldsByLabel(result);
        return result;
    }

    private List<MkvMetadataConditionOperator> GetFieldOperatorOptions(MkvMetadataFieldCondition condition)
    {
        MetadataFieldDefinition field;
        if (condition == null || !MetadataFieldRegistry.TryGet(condition.FieldKey, out field))
        {
            return GetTextOperatorOptions();
        }
        if (field.ValueType == MetadataFieldValueType.Boolean)
        {
            List<MkvMetadataConditionOperator> result = new List<MkvMetadataConditionOperator> { MkvMetadataConditionOperator.IsTrue, MkvMetadataConditionOperator.IsFalse };
            SortConditionOperatorsByLabel(result);
            return result;
        }
        if (IsNumericValueType(field.ValueType))
        {
            return GetNumericOperatorOptions(true);
        }

        return GetTextOperatorOptions();
    }

