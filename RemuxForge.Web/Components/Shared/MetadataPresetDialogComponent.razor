    /// <summary>
    /// Imposta il target testuale attivo
    /// </summary>
    /// <param name="target">Target input</param>
    private void ActivateTextInput(MetadataTextInputTarget target)
    {
        this._activeTextInput = target;
    }

    /// <summary>
    /// Imposta un valore operazione come target testuale attivo
    /// </summary>
    /// <param name="operation">Operazione proprietaria</param>
    /// <param name="inputId">Identificativo DOM input</param>
    private void ActivateOperationTextInput(MkvMetadataOperation operation, string inputId)
    {
        MetadataTextInputTarget target = new MetadataTextInputTarget();
        target.InputId = inputId;
        target.Value = operation != null ? operation.Value : "";
        target.Commit = value =>
        {
            if (operation != null)
                operation.Value = value;
        };

        this.ActivateOperation(operation);
        this.ActivateTextInput(target);
    }

    /// <summary>
    /// Inserisce un token nel target attivo
    /// </summary>
    /// <param name="token">Token da inserire</param>
    private async Task InsertToken(string token)
    {
        if (string.IsNullOrEmpty(token) || this._activeTextInput == null || this._activeTextInput.Commit == null)
        {
            this.SetMessage(AppText.T("web.metadata.presetDialog.tokenTargetMissing"), AlertStyle.Danger);
            return;
        }

        (string value, int start, int end) = await this.GetActiveTextSelectionAsync();
        string result = value.Substring(0, start) + token + value.Substring(end);
        int caret = start + token.Length;

        await this.CommitActiveTextInputAsync(result, caret);
    }

    /// <summary>
    /// Appende una funzione al token o all'espressione attiva
    /// </summary>
    /// <param name="functionCall">Chiamata funzione</param>
    private async Task InsertFunction(string functionCall)
    {
        int caret;
        int end;
        int start;
        string result;
        string selected;
        string transformed;
        string value;

        if (string.IsNullOrEmpty(functionCall) || this._activeTextInput == null || this._activeTextInput.Commit == null)
        {
            this.SetMessage(AppText.T("web.metadata.presetDialog.functionTargetMissing"), AlertStyle.Danger);
            return;
        }

        (value, start, end) = await this.GetActiveTextSelectionAsync();
        if (end > start)
        {
            selected = value.Substring(start, end - start);
            if (TryAppendFunction(selected, functionCall, out transformed))
            {
                result = value.Substring(0, start) + transformed + value.Substring(end);
                caret = start + transformed.Length;
                await this.CommitActiveTextInputAsync(result, caret);
            }
            else
            {
                this.SetMessage(AppText.T("web.metadata.presetDialog.functionValueMissing"), AlertStyle.Danger);
            }
            return;
        }

        if (TryAppendFunction(value.Substring(0, start), functionCall, out transformed))
        {
            result = transformed + value.Substring(start);
            caret = transformed.Length;
            await this.CommitActiveTextInputAsync(result, caret);
            return;
        }

        this.SetMessage(AppText.T("web.metadata.presetDialog.functionValueMissing"), AlertStyle.Danger);
    }

