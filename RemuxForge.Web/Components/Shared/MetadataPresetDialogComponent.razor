    private MkvMetadataRule CloneRule(MkvMetadataRule source)
    {
        MkvMetadataRule clone = new MkvMetadataRule();
        clone.Description = source.Description;
        clone.Enabled = source.Enabled;
        clone.TargetScope = source.TargetScope;
        clone.When.All = CloneNodes(source.When.All);
        for (int i = 0; i < source.Operations.Count; i++)
        {
            clone.Operations.Add(CloneOperation(source.Operations[i]));
        }

        return clone;
    }

    private List<MkvMetadataRuleConditionNode> CloneNodes(List<MkvMetadataRuleConditionNode> source)
    {
        List<MkvMetadataRuleConditionNode> result = new List<MkvMetadataRuleConditionNode>();
        for (int i = 0; i < source.Count; i++)
        {
            result.Add(CloneNode(source[i]));
        }

        return result;
    }

    private MkvMetadataRuleConditionNode CloneNode(MkvMetadataRuleConditionNode source)
    {
        MkvMetadataRuleConditionNode clone = new MkvMetadataRuleConditionNode();
        clone.NodeType = source.NodeType;
        if (source.NodeType == MkvMetadataRuleConditionNodeType.Field)
        {
            clone.Field = new MkvMetadataFieldCondition();
            clone.Field.FieldKey = source.Field.FieldKey;
            clone.Field.Operator = source.Field.Operator;
            clone.Field.Value = source.Field.Value;
            clone.Field.Values = new List<string>(source.Field.Values);
            clone.Field.FromValue = source.Field.FromValue;
            clone.Field.ToValue = source.Field.ToValue;
            clone.Field.Unit = source.Field.Unit;
        }
        else if (source.NodeType == MkvMetadataRuleConditionNodeType.TrackComparison)
        {
            clone.Field = null;
            clone.TrackComparison = new MkvMetadataTrackComparisonCondition();
            clone.TrackComparison.FieldKey = source.TrackComparison.FieldKey;
            clone.TrackComparison.Relation = source.TrackComparison.Relation;
            clone.TrackComparison.Group = source.TrackComparison.Group;
            clone.TrackComparison.Rank = source.TrackComparison.Rank;
        }
        else if (source.NodeType == MkvMetadataRuleConditionNodeType.TrackGroupCount)
        {
            clone.Field = null;
            clone.TrackGroupCount = new MkvMetadataTrackGroupCountCondition();
            clone.TrackGroupCount.Group = source.TrackGroupCount.Group;
            clone.TrackGroupCount.Operator = source.TrackGroupCount.Operator;
            clone.TrackGroupCount.Value = source.TrackGroupCount.Value;
        }
        else if (source.NodeType == MkvMetadataRuleConditionNodeType.AlternativeAny)
        {
            clone.Field = null;
            clone.Alternative = new MkvMetadataAlternativeAnyBlock();
            clone.Alternative.Any = CloneNodes(source.Alternative.Any);
        }

        return clone;
    }

    private static MkvMetadataOperation CloneOperation(MkvMetadataOperation source)
    {
        return new MkvMetadataOperation
        {
            Type = source.Type,
            FieldKey = source.FieldKey,
            Value = source.Value,
            TagKey = source.TagKey,
            TagTarget = source.TagTarget,
            ClearTagsConfirmed = source.ClearTagsConfirmed,
            ExclusiveGroup = source.ExclusiveGroup
        };
    }

