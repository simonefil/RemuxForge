    private void InsertToken(string token)
    {
        if (token == null || token.Length == 0)
        {
            return;
        }

        if (this._activeOperation != null)
        {
            this._activeOperation.Value = AppendToken(this._activeOperation.Value, token);
            return;
        }

        if (this._activeFieldCondition != null)
        {
            this._activeFieldCondition.Value = AppendToken(this._activeFieldCondition.Value, token);
            return;
        }

        this._message = AppText.T("web.metadata.presetDialog.tokenTargetMissing");
    }

    private void InsertFunction(string functionCall)
    {
        string result;

        if (functionCall == null || functionCall.Length == 0)
        {
            return;
        }

        if (this._activeOperation != null)
        {
            if (TryAppendFunction(this._activeOperation.Value, functionCall, out result))
            {
                this._activeOperation.Value = result;
            }
            else
            {
                this._message = AppText.T("web.metadata.presetDialog.functionValueMissing");
            }
            return;
        }

        if (this._activeFieldCondition != null)
        {
            if (TryAppendFunction(this._activeFieldCondition.Value, functionCall, out result))
            {
                this._activeFieldCondition.Value = result;
            }
            else
            {
                this._message = AppText.T("web.metadata.presetDialog.functionValueMissing");
            }
            return;
        }

        this._message = AppText.T("web.metadata.presetDialog.functionTargetMissing");
    }

