    }

    /// <summary>
    /// Rivaluta l'anteprima quando cambia il file di riferimento
    /// </summary>
    private void ChangePreviewFile()
    {
        this._previewSignature = null;
        this.EvaluatePreview();
    }

    /// <summary>
    /// Valuta il preset corrente sul file di riferimento senza scrivere niente
    /// </summary>
    private void EvaluatePreview()
    {
        MkvMetadataRecord source = null;
        MkvMetadataRecord clone;
        MkvMetadataOutputPolicy policy;

        this._previewResult = null;
        this._previewError = "";

        if (string.IsNullOrEmpty(this._previewFile) || this.Records == null)
            return;

        for (int i = 0; i < this.Records.Count; i++)
        {
            if (string.Equals(this.Records[i].InputFile, this._previewFile, StringComparison.OrdinalIgnoreCase))
            {
                source = this.Records[i];
                break;
            }
        }

        if (source == null || source.OriginalFileInfo == null)
            return;

        try
        {
            // Valuta su una copia: l'anteprima non deve toccare il record della griglia,
            // e i tag sono quelli gia' letti dallo scan, senza rilanciare mkvextract dal dialog
            policy = this.Options != null && this.Options.Metadata != null ? this.Options.Metadata.OutputPolicy : MkvMetadataOutputPolicy.Overwrite;
            clone = new MkvMetadataRecord();
            clone.InputFile = source.InputFile;
            clone.RelativeFolder = source.RelativeFolder;
            clone.OriginalFileInfo = MetadataModelCloner.CloneFileInfo(source.OriginalFileInfo);
            clone.FileInfo = MetadataModelCloner.CloneFileInfo(clone.OriginalFileInfo);
            new MetadataPipelineEvaluator().AnalyzeRecord(clone, this._preset, policy);
            this._previewResult = clone;
        }
        catch (Exception ex)
        {
            this._previewError = ex.Message;
        }
    }

    /// <summary>
    /// Restituisce le modifiche prodotte dalla sola regola selezionata
    /// </summary>
    /// <returns>Modifiche attribuite alla regola corrente</returns>
    private List<MkvMetadataChange> GetSelectedRuleChanges()
    {
        List<MkvMetadataChange> result = new List<MkvMetadataChange>();

        if (this._previewResult == null || this._previewResult.Changes == null)
            return result;

        for (int i = 0; i < this._previewResult.Changes.Count; i++)
        {
            if (this._previewResult.Changes[i].RuleIndex == this._selectedRuleIndex)
                result.Add(this._previewResult.Changes[i]);
        }

        return result;
    }

    /// <summary>
    /// Restituisce la firma del preset corrente, usata per rivalutare solo quando cambia davvero
    /// </summary>
    /// <returns>Firma serializzata</returns>
    private string BuildPresetSignature()
    {
        try
        {
            return System.Text.Json.JsonSerializer.Serialize(this._preset) + "|" + this._previewFile;
        }
        catch (Exception)
        {
            return Guid.NewGuid().ToString();
        }
    }

    /// <summary>
    /// Sposta una regola nella lista
    /// </summary>
    /// <param name="index">Indice regola</param>
    /// <param name="delta">Spostamento richiesto</param>
    private void MoveRule(int index, int delta)
    {
        int target = index + delta;
        if (index < 0 || index >= this._preset.Rules.Count || target < 0 || target >= this._preset.Rules.Count)
        {
            return;
        }

        MkvMetadataRule rule = this._preset.Rules[index];
        this._preset.Rules.RemoveAt(index);
        this._preset.Rules.Insert(target, rule);
        this._selectedRuleIndex = target;
    }

    /// <summary>
    /// Duplica una regola esistente
    /// </summary>
    /// <param name="index">Indice regola</param>
    private void DuplicateRule(int index)
    {
        if (index < 0 || index >= this._preset.Rules.Count)
        {
            return;
        }

        MkvMetadataRule clone = CloneRule(this._preset.Rules[index]);
        clone.Description += AppText.T("web.metadata.presetDialog.copySuffix");
        this._preset.Rules.Insert(index + 1, clone);
        this._selectedRuleIndex = index + 1;
    }

    /// <summary>
    /// Rimuove una regola
    /// </summary>
    /// <param name="index">Indice regola</param>
    private void RemoveRule(int index)
    {
        if (index < 0 || index >= this._preset.Rules.Count)
        {
            return;
        }

        this._preset.Rules.RemoveAt(index);
        if (this._selectedRuleIndex >= this._preset.Rules.Count)
        {
            this._selectedRuleIndex = this._preset.Rules.Count - 1;
        }
    }

    /// <summary>
    /// Cambia ambito della regola selezionata
    /// </summary>
    /// <param name="value">Ambito scelto</param>
    private void ChangeSelectedRuleScope(object value)
    {
        if (this.SelectedRule == null)
            return;

        if (value is MkvMetadataTargetScope parsed)
        {
            this.SelectedRule.TargetScope = parsed;
            MetadataPresetUiHelper.EnsureRule(this.SelectedRule, this._showAdvancedFields);
        }
    }

    /// <summary>
    /// Cambia stato del toggle campi avanzati
    /// </summary>
    private void ToggleAdvancedFields(bool value)
    {
        if (!value && this._showAdvancedFields && MetadataUiCatalog.PresetUsesAdvancedFields(this._preset))
        {
            this.SetMessage(AppText.T("web.metadata.presetDialog.advancedCannotDisable"), AlertStyle.Danger);
            return;
        }

        this._showAdvancedFields = value;
        if (this._preset != null)
            this._preset.ShowAdvancedFields = this._showAdvancedFields;

        this.NormalizePresetModel();
    }

    /// <summary>
    /// Aggiunge un'operazione alla regola selezionata
    /// </summary>
    private void AddOperation()
    {
        if (this.SelectedRule == null)
            return;

        MkvMetadataOperation operation = new MkvMetadataOperation();
        MetadataPresetUiHelper.EnsureOperation(this.SelectedRule.TargetScope, operation, this._showAdvancedFields);
        this.SelectedRule.Operations.Add(operation);
    }

    /// <summary>
    /// Sposta un'operazione nella regola selezionata
    /// </summary>
    /// <param name="index">Indice operazione</param>
    /// <param name="delta">Spostamento richiesto</param>
    private void MoveOperation(int index, int delta)
    {
        int target = index + delta;
        if (this.SelectedRule == null || index < 0 || index >= this.SelectedRule.Operations.Count || target < 0 || target >= this.SelectedRule.Operations.Count)
            return;

        MkvMetadataOperation operation = this.SelectedRule.Operations[index];
        this.SelectedRule.Operations.RemoveAt(index);
        this.SelectedRule.Operations.Insert(target, operation);
    }

    /// <summary>
    /// Rimuove un'operazione dalla regola selezionata
    /// </summary>
    /// <param name="index">Indice operazione</param>
    private void RemoveOperation(int index)
    {
        if (this.SelectedRule != null && index >= 0 && index < this.SelectedRule.Operations.Count)
            this.SelectedRule.Operations.RemoveAt(index);
    }

    /// <summary>
    /// Normalizza il modello preset per la UI
    /// </summary>
    private void NormalizePresetModel()
    {
        if (MetadataUiCatalog.PresetUsesAdvancedFields(this._preset))
            this._showAdvancedFields = true;

        if (this._preset != null)
            this._preset.ShowAdvancedFields = this._showAdvancedFields;

        MetadataPresetUiHelper.EnsurePreset(this._preset, this._showAdvancedFields);
    }

    /// <summary>
    /// Cambia il tipo di un'operazione
    /// </summary>
    /// <param name="operation">Operazione da aggiornare</param>
    /// <param name="value">Nuovo tipo testuale</param>
    /// <summary>
    /// Cambia il tag di una operazione allineando il livello di target al default del tag
    /// </summary>
    /// <param name="operation">Operazione</param>
    /// <param name="value">Nome del tag</param>
    private void ChangeOperationTagKey(MkvMetadataOperation operation, string value)
    {
        MetadataTagDefinition tag;

        if (operation == null)
            return;

        operation.TagKey = value != null ? value : "";

        // Il livello segue il tag scelto: TVDB nasce a livello collezione, e chiederlo
        // ogni volta all'utente sarebbe chiedere di sapere a memoria lo standard
        if (MetadataTagRegistry.TryGet(operation.TagKey, out tag))
            operation.TagTargetTypeValue = tag.DefaultTargetTypeValue;
    }

    private void ChangeOperationType(MkvMetadataOperation operation, string value)
    {
        MkvMetadataOperationType parsed;
        if (operation == null || this.SelectedRule == null)
            return;

        if (Enum.TryParse(value, out parsed))
        {
            operation.Type = parsed;
            MetadataPresetUiHelper.EnsureOperation(this.SelectedRule.TargetScope, operation, this._showAdvancedFields);
        }
    }

    /// <summary>
    /// Cambia target tag di un'operazione
    /// </summary>
    /// <param name="operation">Operazione da aggiornare</param>
    /// <param name="value">Nuovo target tag testuale</param>
    private void ChangeOperationTagTarget(MkvMetadataOperation operation, string value)
    {
        MkvMetadataTagTarget parsed;
        if (operation == null || this.SelectedRule == null)
            return;

        if (Enum.TryParse(value, out parsed))
        {
            operation.TagTarget = parsed;
            MetadataPresetUiHelper.EnsureOperation(this.SelectedRule.TargetScope, operation, this._showAdvancedFields);
        }
    }

