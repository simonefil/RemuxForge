    /// <summary>
    /// Apre editor testo espanso per una operazione THEN
    /// </summary>
    /// <param name="operation">Operazione da modificare</param>
    private async Task OpenOperationTextEditor(MkvMetadataOperation operation)
    {
        MetadataFieldDefinition field;
        MetadataTagDefinition tag;
        MetadataTextEditRequest request;
        string label;

        if (operation == null)
            return;

        this.ActivateOperation(operation);
        label = operation.FieldKey;
        if (operation.Type == MkvMetadataOperationType.SetTagField && MetadataTagRegistry.TryGet(operation.TagKey, out tag))
            label = tag.Label;
        else if (MetadataFieldRegistry.TryGet(operation.FieldKey, out field))
            label = field.Label;

        request = new MetadataTextEditRequest();
        request.Title = AppText.F("web.metadata.presetDialog.textEditorOperationTitle", label);
        request.Value = operation.Value;
        request.Commit = value => operation.Value = value != null ? value : "";
        await this.OpenTextEditor(request);
    }

    /// <summary>
    /// Apre editor testo espanso
    /// </summary>
    /// <param name="request">Richiesta editor</param>
    private async Task OpenTextEditor(MetadataTextEditRequest request)
    {
        Dictionary<string, object> parameters;
        object result;

        if (request == null)
            return;

        parameters = new Dictionary<string, object>();
        parameters.Add(nameof(MetadataTextEditorDialogComponent.Label), request.Title);
        parameters.Add(nameof(MetadataTextEditorDialogComponent.Value), request.Value != null ? request.Value : "");
        result = await AppDialogs.OpenAsync<MetadataTextEditorDialogComponent>(this.DialogService, request.Title, parameters,
            AppDialogs.CreateOptions(AppDialogs.WIDTH_TEXT_EDITOR, null, this.JsModule), this.JsModule);

        // Solo OK restituisce il testo: Annulla, X ed Esc lasciano il valore invariato
        if (result is string value && request.Commit != null)
            request.Commit(value);
    }

    /// <summary>
    /// Costruisce le voci del browser token
    /// </summary>
    /// <returns>Token disponibili</returns>
    private List<MetadataTokenBrowserItem> GetTokenBrowserItems()
    {
        List<MetadataTokenBrowserItem> result = new List<MetadataTokenBrowserItem>();
        MkvMetadataTargetScope scope = this.SelectedRule != null ? this.SelectedRule.TargetScope : MkvMetadataTargetScope.Audio;
        List<MetadataCatalogFieldItem> fields = MetadataUiCatalog.GetTokenCatalog(scope, this._showAdvancedFields);
        string filter = this._tokenBrowserFilter != null ? this._tokenBrowserFilter.Trim() : "";
        for (int i = 0; i < fields.Count; i++)
        {
            string token = fields[i].Token;
            if (string.IsNullOrEmpty(filter) || ContainsIgnoreCase(token, filter) || ContainsIgnoreCase(fields[i].Label, filter))
            {
                result.Add(new MetadataTokenBrowserItem { Token = token, Label = fields[i].Label, Description = fields[i].Description });
            }
        }

        return result;
    }

    /// <summary>
    /// Costruisce le voci del browser funzioni
    /// </summary>
    /// <returns>Funzioni disponibili</returns>
    private List<MetadataCatalogFunctionItem> GetFunctionBrowserItems()
    {
        List<MetadataCatalogFunctionItem> result = MetadataUiCatalog.GetFunctionCatalog();

        string filter = this._functionBrowserFilter != null ? this._functionBrowserFilter.Trim() : "";
        if (string.IsNullOrEmpty(filter))
            return result;

        List<MetadataCatalogFunctionItem> filtered = new List<MetadataCatalogFunctionItem>();
        for (int i = 0; i < result.Count; i++)
        {
            if (ContainsIgnoreCase(result[i].Call, filter) || ContainsIgnoreCase(result[i].Description, filter))
            {
                filtered.Add(result[i]);
            }
        }

        return filtered;
    }

