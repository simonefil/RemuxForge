    private void ChangeSelectedRuleScope(ChangeEventArgs e)
    {
        MkvMetadataTargetScope parsed;
        if (this.SelectedRule == null)
            return;

        if (Enum.TryParse(GetChangeValue(e), out parsed))
        {
            this.SelectedRule.TargetScope = parsed;
            MetadataPresetUiHelper.EnsureRule(this.SelectedRule, this._showAdvancedFields);
        }
    }

    /// <summary>
    /// Cambia stato del toggle campi avanzati
    /// </summary>
    private void ToggleAdvancedFields()
    {
        if (this._showAdvancedFields && MetadataUiCatalog.PresetUsesAdvancedFields(this._preset))
        {
            this._message = AppText.T("web.metadata.presetDialog.advancedCannotDisable");
            return;
        }

        this._showAdvancedFields = !this._showAdvancedFields;
        if (this._preset != null)
            this._preset.ShowAdvancedFields = this._showAdvancedFields;

        this.NormalizePresetModel();
    }

    /// <summary>
    /// Aggiunge un'operazione alla regola selezionata
    /// </summary>
    private void AddOperation()
    {
        if (this.SelectedRule == null)
            return;

        MkvMetadataOperation operation = new MkvMetadataOperation();
        MetadataPresetUiHelper.EnsureOperation(this.SelectedRule.TargetScope, operation, this._showAdvancedFields);
        this.SelectedRule.Operations.Add(operation);
    }

    /// <summary>
    /// Sposta un'operazione nella regola selezionata
    /// </summary>
    /// <param name="index">Indice operazione</param>
    /// <param name="delta">Spostamento richiesto</param>
    private void MoveOperation(int index, int delta)
    {
        int target = index + delta;
        if (this.SelectedRule == null || index < 0 || index >= this.SelectedRule.Operations.Count || target < 0 || target >= this.SelectedRule.Operations.Count)
            return;

        MkvMetadataOperation operation = this.SelectedRule.Operations[index];
        this.SelectedRule.Operations.RemoveAt(index);
        this.SelectedRule.Operations.Insert(target, operation);
    }

    /// <summary>
    /// Rimuove un'operazione dalla regola selezionata
    /// </summary>
    /// <param name="index">Indice operazione</param>
    private void RemoveOperation(int index)
    {
        if (this.SelectedRule != null && index >= 0 && index < this.SelectedRule.Operations.Count)
            this.SelectedRule.Operations.RemoveAt(index);
    }

