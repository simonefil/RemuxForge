    /// <summary>
    /// File dei record disponibili come riferimento dell'anteprima
    /// </summary>
    /// <returns>Percorsi dei file</returns>
    private List<string> GetPreviewFiles()
    {
        List<string> files = new List<string>();
        for (int i = 0; this.Records != null && i < this.Records.Count; i++)
            files.Add(this.Records[i].InputFile);
        return files;
    }

    /// <summary>
    /// Cambia il file di riferimento dell'anteprima
    /// </summary>
    /// <param name="value">File scelto, null senza file</param>
    private void ChangeSelectedPreviewFile(object value)
    {
