@inject IJSRuntime JSRuntime
@inherits AppDialogContentBase

<div class="rf-dialog metadata-preset-dialog" @ref="DialogContent">
    <input type="file" accept=".json" id="metadata-preset-import-input" hidden />
        <div class="rf-dialog-body metadata-rule-dialog-body">
            <div class="metadata-rule-preset-bar">
                <RadzenLabel class="form-label" Text="@AppText.T("web.metadata.presetLabel")" Component="MetadataPresetFile" />
                <RadzenDropDown TValue="string" Name="MetadataPresetFile" class="metadata-preset-select" Data="@_presetFiles" Value="@(string.IsNullOrEmpty(_selectedPresetFile) ? null : _selectedPresetFile)" Change="@ChangeSelectedPresetFile"
                                AllowClear="true" Placeholder="@(_presetFiles.Count == 0 ? AppText.T("web.metadata.presetDialog.newPreset") : AppText.T("web.metadata.noPreset"))"
                                @onfocusin='@(() => SetFieldHelp("preset"))' @onmouseenter='@(() => SetFieldHelp("preset"))'>
                    <Template Context="file">@System.IO.Path.GetFileNameWithoutExtension((string)file)</Template>
                    <ValueTemplate Context="file">@System.IO.Path.GetFileNameWithoutExtension((string)file)</ValueTemplate>
                </RadzenDropDown>
                @if (string.IsNullOrEmpty(_selectedPresetFile))
                {
                    <RadzenTextBox class="metadata-preset-name-input" aria-label="@AppText.T("web.common.nameLabel")" @bind-Value="_preset.Name" Placeholder="@AppText.T("web.metadata.presetDialog.presetNamePlaceholder")" @onfocusin='@(() => SetFieldHelp("presetName"))' @onmouseenter='@(() => SetFieldHelp("presetName"))' />
                }
                else
                {
                    <span class="metadata-preset-current-name">@System.IO.Path.GetFileNameWithoutExtension(_selectedPresetFile)</span>
                    <RadzenButton Text="@AppText.T("web.common.new")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@NewPreset" />
                }
                <RadzenButton Text="@AppText.T("web.metadata.presetDialog.save")" Icon="save" Click="@SavePreset" />
                <RadzenButton Text="@AppText.T("web.common.delete")" Icon="delete" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Click="@DeletePreset" Disabled="@(string.IsNullOrEmpty(_selectedPresetFile))" />
                <RadzenButton Text="@AppText.T("web.metadata.presetDialog.import")" Icon="file_upload" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@ImportPreset" />
                <RadzenButton Text="@AppText.T("web.metadata.presetDialog.export")" Icon="file_download" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@ExportPreset" />
                <RadzenLabel class="form-label metadata-preview-file-label" Text="@AppText.T("web.metadata.presetDialog.previewFile")" Component="MetadataPresetPreviewFile" />
                <RadzenDropDown TValue="string" Name="MetadataPresetPreviewFile" class="metadata-preview-file-select" Data="@GetPreviewFiles()" Value="@(string.IsNullOrEmpty(_previewFile) ? null : _previewFile)" Change="@ChangeSelectedPreviewFile"
                                AllowClear="true" Placeholder="@AppText.T("web.metadata.presetDialog.previewNoFile")">
                    <Template Context="file">@System.IO.Path.GetFileName((string)file)</Template>
                    <ValueTemplate Context="file">@System.IO.Path.GetFileName((string)file)</ValueTemplate>
                </RadzenDropDown>
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <RadzenAlert AlertStyle="@_messageStyle" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="metadata-preset-message">@_message</RadzenAlert>
            }

            <div class="metadata-rule-builder">
                <aside class="metadata-rule-list-pane">
                    <div class="form-section">@AppText.T("web.metadata.presetDialog.rulesTitle")</div>
                    <div class="metadata-rule-list">
                        @for (int i = 0; i < _preset.Rules.Count; i++)
                        {
                            int idx = i;
                            MkvMetadataRule rule = _preset.Rules[idx];
                            <div class="metadata-rule-list-item @(idx == _selectedRuleIndex ? "selected" : "")">
                                <button type="button" class="metadata-rule-list-select" aria-pressed="@(idx == _selectedRuleIndex)" @onclick="() => SelectRule(idx)">
                                    <span class="metadata-rule-list-name">
                                        <span>@((idx + 1).ToString())</span>
                                        <strong>@MetadataPresetUiHelper.GetScopeLabel(rule.TargetScope)</strong>
                                        <span>@GetRuleListDescription(rule)</span>
                                    </span>
                                </button>
                                <div class="metadata-rule-list-actions">
                                    <RadzenButton Icon="arrow_upward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.rename.moveUp")" aria-label="@AppText.T("web.rename.moveUp")" Click="@(() => MoveRule(idx, -1))" Disabled="@(idx == 0)" />
                                    <RadzenButton Icon="arrow_downward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.rename.moveDown")" aria-label="@AppText.T("web.rename.moveDown")" Click="@(() => MoveRule(idx, 1))" Disabled="@(idx >= _preset.Rules.Count - 1)" />
                                    <RadzenButton Icon="content_copy" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.common.copy")" aria-label="@AppText.T("web.common.copy")" Click="@(() => DuplicateRule(idx))" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" title="@AppText.T("web.common.delete")" aria-label="@AppText.T("web.common.delete")" Click="@(() => RemoveRule(idx))" />
                                </div>
                            </div>
                        }
                    </div>
                    <RadzenButton class="metadata-rule-add-button" Text="@AppText.T("web.metadata.presetDialog.addRule")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddRule" />
                </aside>

                <main class="metadata-rule-editor-pane">
                    @if (SelectedRule == null)
                    {
                        <div class="metadata-rule-empty">@AppText.T("web.metadata.presetDialog.noRuleSelected")</div>
                    }
                    else
                    {
                        <div class="metadata-rule-header-grid">
                            <div class="form-row">
                                <RadzenLabel class="form-label" Text="@AppText.T("web.metadata.presetDialog.ruleDescription")" Component="MetadataRuleDescription" />
                                <RadzenTextBox Name="MetadataRuleDescription" @bind-Value="SelectedRule.Description" @onfocusin='@(() => SetFieldHelp("ruleDescription"))' @onmouseenter='@(() => SetFieldHelp("ruleDescription"))' />
                            </div>
                            <div class="form-row">
                                <RadzenLabel class="form-label" Text="@AppText.T("web.metadata.presetDialog.scopeLabel")" Component="MetadataRuleScope" />
                                <RadzenDropDown TValue="MkvMetadataTargetScope" Name="MetadataRuleScope" class="metadata-rule-scope-select" Data="@MetadataPresetUiHelper.GetScopeOptions()" Value="@SelectedRule.TargetScope" Change="@ChangeSelectedRuleScope" @onfocusin='@(() => SetFieldHelp("scope"))' @onmouseenter='@(() => SetFieldHelp("scope"))'>
                                    <Template Context="scope">@MetadataPresetUiHelper.GetScopeLabel((MkvMetadataTargetScope)scope)</Template>
                                    <ValueTemplate Context="scope">@MetadataPresetUiHelper.GetScopeLabel((MkvMetadataTargetScope)scope)</ValueTemplate>
                                </RadzenDropDown>
                            </div>
                            <div class="metadata-rule-toggle-row">
                                <LabeledSwitchComponent Label="@AppText.T("web.metadata.presetDialog.enabled")" @bind-Value="SelectedRule.Enabled" @onmouseenter='@(() => SetFieldHelp("ruleEnabled"))' />
                                <LabeledSwitchComponent Label="@AppText.T("web.metadata.presetDialog.advancedFields")" Value="@_showAdvancedFields" ValueChanged="@ToggleAdvancedFields" @onmouseenter='@(() => SetFieldHelp("advancedFields"))' />
                            </div>
                        </div>

                        <div class="metadata-rule-section">
                            <div class="form-section">@AppText.T("web.metadata.presetDialog.sectionWhen")</div>
                            <div class="metadata-rule-section-caption">@AppText.T("web.metadata.presetDialog.whenAllCaption")</div>
                            <MetadataConditionListComponent Rule="SelectedRule" Nodes="SelectedRule.When.All" IncludeAdvancedFields="_showAdvancedFields" OnFieldActivated="ActivateFieldCondition" OnInputActivated="ActivateTextInput" OnHelpChanged="SetFieldHelp" OnTextEditRequested="OpenTextEditor" OnChanged="StateHasChanged" />
                        </div>

                        <div class="metadata-rule-section">
                            <div class="form-section">@AppText.T("web.metadata.presetDialog.sectionThen")</div>
                            <div class="metadata-condition-stack">
                                @for (int i = 0; i < SelectedRule.Operations.Count; i++)
                                {
                                    int operationIndex = i;
                                    MkvMetadataOperation operation = SelectedRule.Operations[operationIndex];

                                    <div class="metadata-sentence-card">
                                        <div class="metadata-sentence-row">
                                            <RadzenDropDown TValue="MkvMetadataOperationType" class="metadata-sentence-operator" aria-label="@AppText.T("web.metadata.presetDialog.help.operationType.title")" Data="@MetadataPresetUiHelper.GetOperationTypeOptions(SelectedRule.TargetScope)" Value="@operation.Type" Change="@((object value) => ChangeOperationType(operation, Convert.ToString(value)))" @onfocusin='@(() => SetFieldHelp("operationType"))' @onmouseenter='@(() => SetFieldHelp("operationType"))'>
                                                <Template Context="type">@MetadataPresetUiHelper.GetOperationTypeLabel((MkvMetadataOperationType)type)</Template>
                                                <ValueTemplate Context="type">@MetadataPresetUiHelper.GetOperationTypeLabel((MkvMetadataOperationType)type)</ValueTemplate>
                                            </RadzenDropDown>
                                            @if (operation.Type == MkvMetadataOperationType.SetField || operation.Type == MkvMetadataOperationType.ClearField)
                                            {
                                                <RadzenDropDown TValue="string" class="metadata-sentence-field" aria-label="@AppText.T("web.metadata.presetDialog.help.operationField.title")" Data="@MetadataPresetUiHelper.GetEditableFields(SelectedRule.TargetScope, operation, _showAdvancedFields)" TextProperty="Label" ValueProperty="Key" @bind-Value="operation.FieldKey" @onfocusin="@(() => SetOperationFieldHelp(operation))" @onmouseenter="@(() => SetOperationFieldHelp(operation))" />
                                            }
                                            else if (operation.Type == MkvMetadataOperationType.SetExclusiveFlag)
                                            {
                                                <RadzenDropDown TValue="string" class="metadata-sentence-field" aria-label="@AppText.T("web.metadata.presetDialog.help.operationField.title")" Data="@MetadataPresetUiHelper.GetEditableFields(SelectedRule.TargetScope, operation, _showAdvancedFields)" TextProperty="Label" ValueProperty="Key" @bind-Value="operation.FieldKey" @onfocusin="@(() => SetOperationFieldHelp(operation))" @onmouseenter="@(() => SetOperationFieldHelp(operation))" />
                                                <RadzenDropDown TValue="MkvMetadataExclusiveGroup" class="metadata-sentence-group" aria-label="@AppText.T("web.metadata.presetDialog.help.exclusiveGroup.title")" Data="@MetadataPresetUiHelper.GetExclusiveGroupOptions()" @bind-Value="operation.ExclusiveGroup" @onfocusin='@(() => SetFieldHelp("exclusiveGroup"))' @onmouseenter='@(() => SetFieldHelp("exclusiveGroup"))'>
                                                    <Template Context="group">@MetadataPresetUiHelper.GetExclusiveGroupLabel((MkvMetadataExclusiveGroup)group)</Template>
                                                    <ValueTemplate Context="group">@MetadataPresetUiHelper.GetExclusiveGroupLabel((MkvMetadataExclusiveGroup)group)</ValueTemplate>
                                                </RadzenDropDown>
                                            }
                                            else if (operation.Type == MkvMetadataOperationType.SetTagField || operation.Type == MkvMetadataOperationType.ClearTagField)
                                            {
                                                <div class="metadata-operation-target">
                                                    <RadzenDropDown TValue="MkvMetadataTagTarget" class="metadata-rule-select-medium" aria-label="@AppText.T("web.metadata.presetDialog.help.tagTarget.title")" Data="@TagTargets" Value="@operation.TagTarget" Change="@((object value) => ChangeOperationTagTarget(operation, Convert.ToString(value)))" @onfocusin='@(() => SetFieldHelp("tagTarget"))' @onmouseenter='@(() => SetFieldHelp("tagTarget"))'>
                                                        <Template Context="target">@AppText.T("web.metadata.tagTarget." + target)</Template>
                                                        <ValueTemplate Context="target">@AppText.T("web.metadata.tagTarget." + target)</ValueTemplate>
                                                    </RadzenDropDown>
                                                    <RadzenDropDown TValue="string" class="metadata-rule-select-medium" aria-label="@AppText.T("web.metadata.presetDialog.help.tagKey.title")" Data="@MetadataPresetUiHelper.GetEditableTags(SelectedRule.TargetScope, operation, _showAdvancedFields)" TextProperty="Label" ValueProperty="Name" Value="@operation.TagKey" Change="@((object value) => ChangeOperationTagKey(operation, value as string ?? ""))" @onfocusin="@(() => SetOperationTagHelp(operation))" @onmouseenter="@(() => SetOperationTagHelp(operation))" />
                                                    @if (SelectedRule.TargetScope == MkvMetadataTargetScope.Container && operation.TagTarget != MkvMetadataTagTarget.CurrentTrack && operation.TagTarget != MkvMetadataTagTarget.AllTracks)
                                                    {
                                                        <RadzenDropDown TValue="int" class="metadata-rule-select-medium" aria-label="@AppText.T("web.metadata.presetDialog.help.tagLevel.title")" Data="@MetadataPresetUiHelper.GetTagTargetLevelOptions()" @bind-Value="operation.TagTargetTypeValue" @bind-Value:after="StateHasChanged" @onfocusin='@(() => SetFieldHelp("tagLevel"))' @onmouseenter='@(() => SetFieldHelp("tagLevel"))'>
                                                            <Template Context="level">@MetadataPresetUiHelper.GetTagTargetLevelLabel((int)level)</Template>
                                                            <ValueTemplate Context="level">@MetadataPresetUiHelper.GetTagTargetLevelLabel((int)level)</ValueTemplate>
                                                        </RadzenDropDown>
                                                    }
                                                </div>
                                            }
                                            else if (operation.Type == MkvMetadataOperationType.SetAttachment || operation.Type == MkvMetadataOperationType.DeleteAttachment)
                                            {
                                                <RadzenTextBox class="metadata-sentence-field" aria-label="@AppText.T("web.metadata.presetDialog.help.attachmentName.title")" Placeholder="@AppText.T("web.metadata.presetDialog.attachmentNamePlaceholder")" @bind-Value="operation.AttachmentName" @bind-Value:after="StateHasChanged" @onfocusin='@(() => SetFieldHelp("attachmentName"))' @onmouseenter='@(() => SetFieldHelp("attachmentName"))' />
                                            }
                                            else if (operation.Type == MkvMetadataOperationType.ClearTags)
                                            {
                                                <LabeledSwitchComponent Label="@AppText.T("web.metadata.presetDialog.confirmClearTags")" @bind-Value="operation.ClearTagsConfirmed" @onmouseenter='@(() => SetFieldHelp("clearTags"))' />
                                            }
                                            else
                                            {
                                                <span class="metadata-sentence-placeholder"></span>
                                            }

                                            @if (operation.Type == MkvMetadataOperationType.SetAttachment)
                                            {
                                                <div class="metadata-operation-target">
                                                    <RadzenTextBox class="metadata-operation-value" aria-label="@AppText.T("web.metadata.presetDialog.help.attachmentSource.title")" Placeholder="@AppText.T("web.metadata.presetDialog.attachmentSourcePlaceholder")" @bind-Value="operation.AttachmentSourcePath" @bind-Value:after="StateHasChanged" @onfocusin='@(() => SetFieldHelp("attachmentSource"))' @onmouseenter='@(() => SetFieldHelp("attachmentSource"))' />
                                                    <RadzenTextBox class="metadata-rule-select-medium" aria-label="@AppText.T("web.metadata.presetDialog.help.attachmentMime.title")" Placeholder="@AppText.T("web.metadata.presetDialog.attachmentMimePlaceholder")" @bind-Value="operation.AttachmentMimeType" @bind-Value:after="StateHasChanged" @onfocusin='@(() => SetFieldHelp("attachmentMime"))' @onmouseenter='@(() => SetFieldHelp("attachmentMime"))' />
                                                </div>
                                            }
                                            else if (operation.Type == MkvMetadataOperationType.SetField || operation.Type == MkvMetadataOperationType.SetTagField)
                                            {
                                                <MetadataInputRendererComponent Schema="@GetOperationInputSchema(operation)" AriaLabel="@AppText.T("web.metadata.presetDialog.help.operationValue.title")" Value="@operation.Value" ValueChanged="@((string value) => operation.Value = value)" CssClass="form-input metadata-operation-value" OnFocus="@(() => SetOperationValueHelp(operation))" OnTextActivated="@((string inputId) => ActivateOperationTextInput(operation, inputId))" OnMouseEnter="@(() => SetOperationValueHelp(operation))" OnExpandedEditRequested="@(() => OpenOperationTextEditor(operation))" />
                                            }
                                            else
                                            {
                                                <span class="metadata-sentence-placeholder"></span>
                                            }

                                            <div class="metadata-node-actions">
                                                <RadzenButton Icon="arrow_upward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.rename.moveUp")" title="@AppText.T("web.rename.moveUp")" Click="@(() => MoveOperation(operationIndex, -1))" Disabled="@(operationIndex == 0)" />
                                                <RadzenButton Icon="arrow_downward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.rename.moveDown")" title="@AppText.T("web.rename.moveDown")" Click="@(() => MoveOperation(operationIndex, 1))" Disabled="@(operationIndex >= SelectedRule.Operations.Count - 1)" />
                                                <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" aria-label="@AppText.T("web.common.delete")" title="@AppText.T("web.common.delete")" Click="@(() => RemoveOperation(operationIndex))" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <RadzenButton Text="@AppText.T("web.metadata.presetDialog.addOperation")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddOperation" />
                        </div>

                        <div class="metadata-rule-section metadata-preview-section">
                            <div class="form-section">@AppText.T("web.metadata.presetDialog.previewTitle")</div>
                            @if (string.IsNullOrEmpty(_previewFile))
                            {
                                <div class="metadata-preview-empty">@AppText.T("web.metadata.presetDialog.previewPickFile")</div>
                            }
                            else if (!string.IsNullOrEmpty(_previewError))
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="metadata-preset-message">@_previewError</RadzenAlert>
                            }
                            else if (_previewResult != null)
                            {
                                <div class="metadata-preview-summary">
                                    <span>@AppText.F("web.metadata.presetDialog.previewTotals", _previewResult.MatchCount, _previewResult.ChangeCount)</span>
                                    <span>@Utils.GetMetadataExecutionModeText(_previewResult.ExecutionMode)</span>
                                </div>
                                @if (GetSelectedRuleChanges().Count == 0)
                                {
                                    <div class="metadata-preview-empty">@AppText.T("web.metadata.presetDialog.previewRuleNoMatch")</div>
                                }
                                else
                                {
                                    <RadzenTable GridLines="DataGridGridLines.Horizontal" class="metadata-preview-table">
                                        <RadzenTableHeader>
                                            <RadzenTableHeaderRow>
                                                <RadzenTableHeaderCell>@AppText.T("web.metadata.presetDialog.previewTarget")</RadzenTableHeaderCell>
                                                <RadzenTableHeaderCell>@AppText.T("web.metadata.mapped.field")</RadzenTableHeaderCell>
                                                <RadzenTableHeaderCell>@AppText.T("web.metadata.presetDialog.previewBefore")</RadzenTableHeaderCell>
                                                <RadzenTableHeaderCell>@AppText.T("web.metadata.presetDialog.previewAfter")</RadzenTableHeaderCell>
                                            </RadzenTableHeaderRow>
                                        </RadzenTableHeader>
                                        <RadzenTableBody>
                                            @foreach (MkvMetadataChange change in GetSelectedRuleChanges())
                                            {
                                                <RadzenTableRow>
                                                    <RadzenTableCell>@(!string.IsNullOrEmpty(change.TrackSelector) ? change.TrackSelector : AppText.T("web.metadata.mapped.general"))</RadzenTableCell>
                                                    <RadzenTableCell>@(!string.IsNullOrEmpty(change.FieldKey) ? change.FieldKey : MetadataPresetUiHelper.GetOperationTypeLabel(change.OperationType))</RadzenTableCell>
                                                    <RadzenTableCell class="metadata-preview-before">@change.BeforeValue</RadzenTableCell>
                                                    <RadzenTableCell class="metadata-preview-after">@(!string.IsNullOrEmpty(change.AfterValue) ? change.AfterValue : change.Message)</RadzenTableCell>
                                                </RadzenTableRow>
                                            }
                                        </RadzenTableBody>
                                    </RadzenTable>
                                }
                            }
                        </div>
                    }
                </main>

                <aside class="metadata-rule-context-pane">
                    <div class="config-help-title">@_fieldHelpTitle</div>
                    <div class="config-help-text">@_fieldHelpText</div>

                    <div class="config-help-section">@AppText.T("web.metadata.presetDialog.tokenBrowserTitle")</div>
                    <RadzenTextBox class="metadata-token-filter" aria-label="@AppText.T("web.metadata.presetDialog.tokenFilterPlaceholder")" @bind-Value="_tokenBrowserFilter" Immediate="true" Placeholder="@AppText.T("web.metadata.presetDialog.tokenFilterPlaceholder")" />
                    <div class="metadata-token-browser">
                        @foreach (MetadataTokenBrowserItem item in GetTokenBrowserItems())
                        {
                            <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" class="metadata-token-button" title="@item.Description" Click="@(() => InsertToken(item.Token))">
                                <span class="metadata-token-value">@item.Token</span>
                                <span class="metadata-token-label">@item.Label</span>
                            </RadzenButton>
                        }
                    </div>

                    <div class="config-help-section">@AppText.T("web.metadata.presetDialog.functionsTitle")</div>
                    <RadzenTextBox class="metadata-token-filter" aria-label="@AppText.T("web.metadata.presetDialog.functionFilterPlaceholder")" @bind-Value="_functionBrowserFilter" Immediate="true" Placeholder="@AppText.T("web.metadata.presetDialog.functionFilterPlaceholder")" />
                    <div class="metadata-token-browser">
                        @foreach (MetadataCatalogFunctionItem item in GetFunctionBrowserItems())
                        {
                            <div class="metadata-function-row">
                                <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" class="metadata-token-button metadata-function-insert-button" title="@item.Description" Click="@(() => InsertFunction(item.Call))" @onmouseenter="@(() => SetFunctionHelp(item.Name))" @onfocus="@(() => SetFunctionHelp(item.Name))">
                                    <span class="metadata-token-value">@item.Call</span>
                                    <span class="metadata-token-label">@item.Description</span>
                                </RadzenButton>
                                <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" class="metadata-function-example-button" title="@AppText.T("web.metadata.presetDialog.functionExampleOpen")" Text="@AppText.T("web.metadata.presetDialog.functionExampleButton")" Click="@(() => ShowFunctionExample(item))" />
                            </div>
                        }
                    </div>
                </aside>
            </div>
        </div>
        <div class="rf-dialog-footer">
            <RadzenButton Text="@AppText.T("web.common.close")" Icon="close" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
        </div>
</div>

@code {
    /// <summary>
    /// Opzioni applicazione correnti
    /// </summary>
    [Parameter] public Options Options { get; set; }

    /// <summary>
    /// Record metadata disponibili per contesto UI
    /// </summary>
    [Parameter] public List<MkvMetadataRecord> Records { get; set; }

    /// <summary>
    /// Destinazioni dei tag selezionabili nelle operazioni
    /// </summary>
    private static readonly List<MkvMetadataTagTarget> TagTargets = new List<MkvMetadataTagTarget>
    {
        MkvMetadataTagTarget.Current, MkvMetadataTagTarget.File, MkvMetadataTagTarget.CurrentTrack, MkvMetadataTagTarget.AllTracks
    };

    /// <summary>
    /// Servizio gestione preset metadata
    /// </summary>
    private MetadataPresetService _service;

    /// <summary>
    /// File preset disponibili
    /// </summary>
    private List<string> _presetFiles;

    /// <summary>
    /// File preset selezionato
    /// </summary>
    private string _selectedPresetFile;

    /// <summary>
    /// Preset in editing
    /// </summary>
    private MkvMetadataPreset _preset;

    /// <summary>
    /// Indice regola selezionata
    /// </summary>
    private int _selectedRuleIndex;

    /// <summary>
    /// Messaggio stato o errore
    /// </summary>
    private string _message;

    /// <summary>
    /// Stile dell'avviso che mostra il messaggio
    /// </summary>
    private AlertStyle _messageStyle = AlertStyle.Danger;

    /// <summary>
    /// File di riferimento su cui valutare il preset in anteprima
    /// </summary>
    private string _previewFile;

    /// <summary>
    /// Esito della valutazione in memoria sul file di riferimento
    /// </summary>
    private MkvMetadataRecord _previewResult;

    /// <summary>
    /// Errore prodotto dalla valutazione in anteprima
    /// </summary>
    private string _previewError;

    /// <summary>
    /// Firma del preset già valutato, per non rivalutarlo a ogni render
    /// </summary>
    private string _previewSignature;

    /// <summary>
    /// Indica se mostrare campi avanzati
    /// </summary>
    private bool _showAdvancedFields;

    /// <summary>
    /// Filtro browser token
    /// </summary>
    private string _tokenBrowserFilter;

    /// <summary>
    /// Filtro browser funzioni
    /// </summary>
    private string _functionBrowserFilter;

    /// <summary>
    /// Titolo help contestuale
    /// </summary>
    private string _fieldHelpTitle;

    /// <summary>
    /// Testo help contestuale
    /// </summary>
    private string _fieldHelpText;

    /// <summary>
    /// Target testuale attivo per inserimento al caret
    /// </summary>
    private MetadataTextInputTarget _activeTextInput;

    /// <summary>
    /// Modulo JavaScript per gestione selection e focus
    /// </summary>
    private IJSObjectReference _interopModule;

    /// <summary>
    /// Riferimento .NET persistente usato dal file picker browser
    /// </summary>
    private DotNetObjectReference<MetadataPresetDialogComponent> _importReference;

    /// <summary>
    /// Inizializza preset e stato dialog
    /// </summary>
    protected override void OnInitialized()
    {
        this._service = new MetadataPresetService(AppSettingsService.Instance.ConfigFolder);
        this._presetFiles = this._service.ListPresetFiles();
        this._selectedPresetFile = this.Options != null && this.Options.Metadata != null ? this.Options.Metadata.PresetPath : "";
        this._preset = new MkvMetadataPreset();
        this._selectedRuleIndex = -1;
        this.SetMessage("", AlertStyle.Danger);
        this._showAdvancedFields = false;
        this._tokenBrowserFilter = "";
        this._functionBrowserFilter = "";
        this._activeTextInput = null;
        this._previewFile = this.Records != null && this.Records.Count > 0 ? this.Records[0].InputFile : "";
        this._previewResult = null;
        this._previewError = "";
        this._previewSignature = null;
        this.SetFieldHelp("default");

        if (!string.IsNullOrEmpty(this._selectedPresetFile) && System.IO.File.Exists(this._selectedPresetFile))
        {
            this.LoadSelectedPreset();
        }
        else
        {
            this.NewPreset();
        }
    }

    /// <summary>
    /// Importa il modulo interop dopo il primo render
    /// </summary>
    /// <param name="firstRender">True al primo render</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string signature;

        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            this._interopModule = await this.JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
            this._importReference = DotNetObjectReference.Create(this);
        }

        // Il preset viene rivalutato solo quando cambia davvero: senza la firma ogni render
        // rilancerebbe la valutazione, e con essa un altro render
        signature = this.BuildPresetSignature();
        if (string.Equals(signature, this._previewSignature, StringComparison.Ordinal))
            return;

        this._previewSignature = signature;
        this.EvaluatePreview();
        this.StateHasChanged();
    }

    /// <summary>
    /// Rilascia il modulo interop del dialog
    /// </summary>
    public override async ValueTask DisposeAsync()
    {
        this._importReference?.Dispose();
        this._importReference = null;
        await base.DisposeAsync();

        if (this._interopModule == null)
            return;

        try
        {
            await this._interopModule.DisposeAsync();
        }
        catch
        {
            // Ignora errori durante dispose del circuito
        }
    }

    /// <summary>
    /// Regola correntemente selezionata
    /// </summary>
    private MkvMetadataRule SelectedRule
    {
        get
        {
            if (this._selectedRuleIndex >= 0 && this._selectedRuleIndex < this._preset.Rules.Count)
            {
                return this._preset.Rules[this._selectedRuleIndex];
            }

            return null;
        }
    }

    /// <summary>
    /// Imposta il messaggio di stato con il colore adatto all'esito
    /// </summary>
    /// <param name="message">Testo del messaggio</param>
    /// <param name="style">Esito: riuscita, avviso o errore</param>
    private void SetMessage(string message, AlertStyle style)
    {
        this._message = message;
        this._messageStyle = style;
    }

    /// <summary>
    /// Prepara un nuovo preset vuoto
    /// </summary>
    private void NewPreset()
    {
        this._preset = new MkvMetadataPreset();
        this._preset.Name = "";
        this._preset.Description = "";
        this._preset.ShowAdvancedFields = false;
        this._selectedRuleIndex = -1;
        this._selectedPresetFile = "";
        this.SetMessage("", AlertStyle.Danger);
        this._showAdvancedFields = false;
        this._activeTextInput = null;
    }

    /// <summary>
    /// Carica il preset selezionato dal dropdown
    /// </summary>
    private void LoadSelectedPreset()
    {
        if (string.IsNullOrEmpty(this._selectedPresetFile))
        {
            this.NewPreset();
            return;
        }

        try
        {
            this._preset = this._service.Load(this._selectedPresetFile);
            this._showAdvancedFields = this._preset.ShowAdvancedFields || MetadataUiCatalog.PresetUsesAdvancedFields(this._preset);
            this.NormalizePresetModel();
            this._selectedRuleIndex = this._preset.Rules.Count > 0 ? 0 : -1;
            this._activeTextInput = null;
            this.SetMessage(string.Join(" ", this._service.LastLoadWarnings), AlertStyle.Warning);
        }
        catch (Exception ex)
        {
            this.SetMessage(ex.Message, AlertStyle.Danger);
        }
    }

    /// <summary>
    /// Salva il preset corrente
    /// </summary>
    private void SavePreset()
    {
        if (string.IsNullOrEmpty(this._selectedPresetFile))
        {
            this.SaveNewPreset();
            return;
        }

        this._preset.Name = System.IO.Path.GetFileNameWithoutExtension(this._selectedPresetFile);
        this.SaveTo(this._selectedPresetFile);
    }

    /// <summary>
    /// Salva un nuovo preset usando il nome inserito
    /// </summary>
    private void SaveNewPreset()
    {
        string fileName = this.SanitizeFileName(this._preset.Name);
        if (string.IsNullOrEmpty(fileName))
        {
            this.SetMessage(AppText.T("web.metadata.presetDialog.presetNameRequired"), AlertStyle.Danger);
            return;
        }

        this.SaveTo(System.IO.Path.Combine(this._service.GetPresetFolder(), fileName + ".json"));
    }

    /// <summary>
    /// Salva il preset su file
    /// </summary>
    /// <param name="filePath">Percorso preset destinazione</param>
    private void SaveTo(string filePath)
    {
        try
        {
            this.PreparePresetForSerialization();
            this._service.Save(this._preset, filePath);
            this._selectedPresetFile = filePath;
            this._presetFiles = this._service.ListPresetFiles();
            this.SetMessage(AppText.T("web.metadata.presetDialog.saved"), AlertStyle.Success);
        }
        catch (Exception ex)
        {
            this.SetMessage(ex.Message, AlertStyle.Danger);
        }
    }

    /// <summary>
    /// Elimina il preset selezionato
    /// </summary>
    private void DeletePreset()
    {
        try
        {
            if (!string.IsNullOrEmpty(this._selectedPresetFile) && System.IO.File.Exists(this._selectedPresetFile))
            {
                System.IO.File.Delete(this._selectedPresetFile);
            }

            this._presetFiles = this._service.ListPresetFiles();
            this.NewPreset();
            this.SetMessage(AppText.T("web.metadata.presetDialog.deleted"), AlertStyle.Success);
        }
        catch (Exception ex)
        {
            this.SetMessage(ex.Message, AlertStyle.Danger);
        }
    }

    /// <summary>
    /// Importa un preset da file JSON esterno in editing
    /// </summary>
    private async Task ImportPreset()
    {
        try
        {
            this.SetMessage("", AlertStyle.Danger);
            if (this._interopModule == null)
                return;

            if (await this._interopModule.InvokeAsync<bool>("isTauriDesktop"))
            {
                string path = await this._interopModule.InvokeAsync<string>("pickJsonFileWithTauri", AppText.T("web.metadata.presetDialog.importDialogTitle"));
                if (string.IsNullOrEmpty(path))
                    return;

                this.ApplyImportedPreset(this._service.LoadFromJson(System.IO.File.ReadAllText(path)));
            }
            else
            {
                await this._interopModule.InvokeVoidAsync("pickJsonFileViaCallback", "metadata-preset-import-input", this._importReference);
            }
        }
        catch (Exception ex)
        {
            this.SetMessage(ex.Message, AlertStyle.Danger);
        }
    }

    /// <summary>
    /// Riceve i byte del file JSON scelto dal file picker browser
    /// </summary>
    /// <param name="bytes">Contenuto file</param>
    [JSInvokable]
    public async Task OnImportedPresetFileBytes(byte[] bytes)
    {
        try
        {
            if (bytes == null || bytes.Length == 0)
                return;

            this.ApplyImportedPreset(this._service.LoadFromJson(System.Text.Encoding.UTF8.GetString(bytes)));
        }
        catch (Exception ex)
        {
            this.SetMessage(ex.Message, AlertStyle.Danger);
        }

        await this.InvokeAsync(this.StateHasChanged);
    }

    /// <summary>
    /// Mostra l'errore di lettura del file scelto nel browser
    /// </summary>
    [JSInvokable]
    public async Task OnPresetImportFailed()
    {
        this.SetMessage(AppText.T("web.metadata.presetDialog.importReadFailed"), AlertStyle.Danger);
        await this.InvokeAsync(this.StateHasChanged);
    }

    /// <summary>
    /// Esporta il preset corrente su file JSON esterno
    /// </summary>
    private async Task ExportPreset()
    {
        try
        {
            string baseName = this.GetExportBaseName();
            if (string.IsNullOrEmpty(baseName))
            {
                this.SetMessage(AppText.T("web.metadata.presetDialog.exportNameRequired"), AlertStyle.Danger);
                return;
            }

            string fileName = baseName + ".json";
            if (this._interopModule == null)
                return;

            if (await this._interopModule.InvokeAsync<bool>("isTauriDesktop"))
            {
                string path = await this._interopModule.InvokeAsync<string>("pickSavePathWithTauri", fileName, AppText.T("web.metadata.presetDialog.exportDialogTitle"));
                if (string.IsNullOrEmpty(path))
                    return;

                path = EnsureJsonExtension(path);
                this.PreparePresetForSerialization();
                this._service.Save(this._preset, path);
                this.SetMessage(AppText.T("web.metadata.presetDialog.exported"), AlertStyle.Success);
            }
            else
            {
                this.PreparePresetForSerialization();
                string json = this._service.SerializeToJson(this._preset);
                await this._interopModule.InvokeVoidAsync("downloadTextFile", fileName, json, "application/json");
                this.SetMessage(AppText.T("web.metadata.presetDialog.exported"), AlertStyle.Success);
            }
        }
        catch (Exception ex)
        {
            this.SetMessage(ex.Message, AlertStyle.Danger);
        }
    }

    /// <summary>
    /// Carica il preset importato in editing senza salvarlo ancora in libreria
    /// </summary>
    /// <param name="preset">Preset importato</param>
    private void ApplyImportedPreset(MkvMetadataPreset preset)
    {
        this._preset = preset;
        this._selectedPresetFile = "";
        this._showAdvancedFields = preset.ShowAdvancedFields || MetadataUiCatalog.PresetUsesAdvancedFields(preset);
        this.NormalizePresetModel();
        this._selectedRuleIndex = preset.Rules != null && preset.Rules.Count > 0 ? 0 : -1;
        this._activeTextInput = null;
        this._previewSignature = null;
        if (this._service.LastLoadWarnings.Count > 0)
            this.SetMessage(AppText.T("web.metadata.presetDialog.imported") + " " + string.Join(" ", this._service.LastLoadWarnings), AlertStyle.Warning);
        else
            this.SetMessage(AppText.T("web.metadata.presetDialog.imported"), AlertStyle.Success);
    }

    /// <summary>
    /// Restituisce il nome base per l'esportazione del preset corrente
    /// </summary>
    /// <returns>Nome file senza estensione</returns>
    private string GetExportBaseName()
    {
        if (!string.IsNullOrEmpty(this._preset.Name))
            return this.SanitizeFileName(this._preset.Name);

        if (!string.IsNullOrEmpty(this._selectedPresetFile))
            return System.IO.Path.GetFileNameWithoutExtension(this._selectedPresetFile);

        return "";
    }

    /// <summary>
    /// Allinea il preset allo stato corrente della UI prima della serializzazione
    /// </summary>
    private void PreparePresetForSerialization()
    {
        this.NormalizePresetModel();
        this._preset.Description = "";
        this._preset.ShowAdvancedFields = this._showAdvancedFields || MetadataUiCatalog.PresetUsesAdvancedFields(this._preset);
    }

    /// <summary>
    /// Garantisce l'estensione JSON sul percorso scelto dal dialog desktop
    /// </summary>
    /// <param name="filePath">Percorso scelto</param>
    /// <returns>Percorso con estensione JSON</returns>
    private static string EnsureJsonExtension(string filePath)
    {
        if (string.Equals(System.IO.Path.GetExtension(filePath), ".json", StringComparison.OrdinalIgnoreCase))
            return filePath;

        return filePath + ".json";
    }

