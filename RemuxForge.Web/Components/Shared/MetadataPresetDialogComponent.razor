    /// <summary>
    /// Legge valore e selection correnti dal target testuale attivo
    /// </summary>
    /// <returns>Valore, inizio e fine selection</returns>
    private async Task<(string Value, int Start, int End)> GetActiveTextSelectionAsync()
    {
        string value = this._activeTextInput != null && this._activeTextInput.Value != null ? this._activeTextInput.Value : "";
        int start = value.Length;
        int end = value.Length;

        if (this._interopModule != null && this._activeTextInput != null && !string.IsNullOrEmpty(this._activeTextInput.InputId))
        {
            try
            {
                string[] selection = await this._interopModule.InvokeAsync<string[]>("getTextInputSelection", this._activeTextInput.InputId);
                if (selection != null && selection.Length == 3)
                {
                    value = selection[0] != null ? selection[0] : "";
                    if (!int.TryParse(selection[1], out start))
                        start = value.Length;
                    if (!int.TryParse(selection[2], out end))
                        end = start;
                }
            }
            catch
            {
                start = value.Length;
                end = value.Length;
            }
        }

        start = Math.Max(0, Math.Min(start, value.Length));
        end = Math.Max(start, Math.Min(end, value.Length));
        return (value, start, end);
    }

    /// <summary>
    /// Applica il testo al modello e ripristina focus e caret
    /// </summary>
    /// <param name="value">Nuovo valore</param>
    /// <param name="caret">Nuova posizione caret</param>
    private async Task CommitActiveTextInputAsync(string value, int caret)
    {
        if (this._activeTextInput == null || this._activeTextInput.Commit == null)
            return;

        this._activeTextInput.Value = value;
        this._activeTextInput.Commit(value);
        this._message = "";

        if (this._interopModule != null && !string.IsNullOrEmpty(this._activeTextInput.InputId))
        {
            await this._interopModule.InvokeVoidAsync("setTextInputValueAndSelection", this._activeTextInput.InputId, value, caret, caret);
        }
    }

    /// <summary>
    /// Appende una funzione all'ultimo token valido
    /// </summary>
    /// <param name="value">Testo originale</param>
    /// <param name="functionCall">Chiamata funzione</param>
    /// <param name="result">Testo aggiornato</param>
    /// <returns>True se la funzione è stata applicata</returns>
    private static bool TryAppendFunction(string value, string functionCall, out string result)
    {
        string text = value != null ? value : "";
        string trimmed = text.TrimEnd();
        string suffix = text.Substring(trimmed.Length);

        result = text;
        if (string.IsNullOrEmpty(trimmed))
            return false;

        if (trimmed.EndsWith("}", StringComparison.Ordinal))
        {
            result = trimmed.Substring(0, trimmed.Length - 1) + ":" + functionCall + "}" + suffix;
            return true;
        }
        if (trimmed.EndsWith("]", StringComparison.Ordinal))
        {
            int tokenStart = trimmed.LastIndexOf("[", StringComparison.Ordinal);
            if (tokenStart >= 0)
            {
                result = trimmed.Substring(0, tokenStart) + "{" + trimmed.Substring(tokenStart) + ":" + functionCall + "}" + suffix;
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Verifica contenimento case insensitive
    /// </summary>
    /// <param name="text">Testo sorgente</param>
    /// <param name="value">Valore cercato</param>
    /// <returns>True se trovato</returns>
    private static bool ContainsIgnoreCase(string text, string value)
    {
        return text != null && value != null && text.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0;
    }

    /// <summary>
    /// Converte valore evento change in stringa
