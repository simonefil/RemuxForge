    /// <summary>
    /// Inserisce un token nel target attivo
    /// </summary>
    /// <param name="token">Token da inserire</param>
    private async Task InsertToken(string token)
    {
        if (string.IsNullOrEmpty(token) || this._activeTextInput == null || this._activeTextInput.Commit == null)
        {
            this._message = AppText.T("web.metadata.presetDialog.tokenTargetMissing");
            return;
        }

        (string value, int start, int end) = await this.GetActiveTextSelectionAsync();
        string result = value.Substring(0, start) + token + value.Substring(end);
        int caret = start + token.Length;

        await this.CommitActiveTextInputAsync(result, caret);
    }

    /// <summary>
    /// Appende una funzione al token o all'espressione attiva
    /// </summary>
    /// <param name="functionCall">Chiamata funzione</param>
    private async Task InsertFunction(string functionCall)
    {
        int caret;
        int end;
        int start;
        string result;
        string selected;
        string transformed;
        string value;

        if (string.IsNullOrEmpty(functionCall) || this._activeTextInput == null || this._activeTextInput.Commit == null)
        {
            this._message = AppText.T("web.metadata.presetDialog.functionTargetMissing");
            return;
        }

        (value, start, end) = await this.GetActiveTextSelectionAsync();
        if (end > start)
        {
            selected = value.Substring(start, end - start);
            if (TryAppendFunction(selected, functionCall, out transformed))
            {
                result = value.Substring(0, start) + transformed + value.Substring(end);
                caret = start + transformed.Length;
                await this.CommitActiveTextInputAsync(result, caret);
            }
            else
            {
                this._message = AppText.T("web.metadata.presetDialog.functionValueMissing");
            }
            return;
        }

        if (TryAppendFunction(value.Substring(0, start), functionCall, out transformed))
        {
            result = transformed + value.Substring(start);
            caret = transformed.Length;
            await this.CommitActiveTextInputAsync(result, caret);
            return;
        }

        this._message = AppText.T("web.metadata.presetDialog.functionValueMissing");
    }

