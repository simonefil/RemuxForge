    private List<MkvMetadataTrackInfo> GetContextTracks(MkvMetadataRecord record)
    {
        List<MkvMetadataTrackInfo> result = new List<MkvMetadataTrackInfo>();
        MkvMetadataTargetScope scope = SelectedRule != null ? SelectedRule.TargetScope : MkvMetadataTargetScope.Audio;
        if (record == null || record.FileInfo == null)
        {
            return result;
        }

        for (int i = 0; i < record.FileInfo.Tracks.Count; i++)
        {
            if (IsTrackScopeMatch(record.FileInfo.Tracks[i], scope))
            {
                result.Add(record.FileInfo.Tracks[i]);
                if (result.Count >= 4)
                {
                    break;
                }
            }
        }

        return result;
    }

