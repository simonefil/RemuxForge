    /// <summary>
    /// Apre editor testo espanso per una operazione THEN
    /// </summary>
    /// <param name="operation">Operazione da modificare</param>
    private void OpenOperationTextEditor(MkvMetadataOperation operation)
    {
        MetadataFieldDefinition field;
        MetadataTagDefinition tag;
        MetadataTextEditRequest request;
        string label;

        if (operation == null)
            return;

        this.ActivateOperation(operation);
        label = operation.FieldKey;
        if (operation.Type == MkvMetadataOperationType.SetTagField && MetadataTagRegistry.TryGet(operation.TagKey, out tag))
            label = tag.Label;
        else if (MetadataFieldRegistry.TryGet(operation.FieldKey, out field))
            label = field.Label;

        request = new MetadataTextEditRequest();
        request.Title = AppText.F("web.metadata.presetDialog.textEditorOperationTitle", label);
        request.Value = operation.Value;
        request.Commit = value => operation.Value = value != null ? value : "";
        this.OpenTextEditor(request);
    }

