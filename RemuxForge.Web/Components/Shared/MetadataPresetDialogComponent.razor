    private static bool IsSectorForScope(MetadataFieldSector sector, MkvMetadataTargetScope scope)
    {
        if (scope == MkvMetadataTargetScope.Video) { return sector == MetadataFieldSector.Video; }
        if (scope == MkvMetadataTargetScope.Audio) { return sector == MetadataFieldSector.Audio; }
        if (scope == MkvMetadataTargetScope.Subtitle) { return sector == MetadataFieldSector.Subtitle; }
        return sector == MetadataFieldSector.Container || sector == MetadataFieldSector.File;
    }

    private static bool IsTrackScopeMatch(MkvMetadataTrackInfo track, MkvMetadataTargetScope scope)
    {
        if (track == null) { return false; }
        if (scope == MkvMetadataTargetScope.Video) { return track.TrackKind == "video"; }
        if (scope == MkvMetadataTargetScope.Audio) { return track.TrackKind == "audio"; }
        if (scope == MkvMetadataTargetScope.Subtitle) { return track.TrackKind == "subtitles"; }
        return false;
    }

    private static bool IsNumericValueType(MetadataFieldValueType valueType)
    {
        return valueType == MetadataFieldValueType.Integer ||
            valueType == MetadataFieldValueType.Decimal ||
            valueType == MetadataFieldValueType.Bytes ||
            valueType == MetadataFieldValueType.Duration;
    }

