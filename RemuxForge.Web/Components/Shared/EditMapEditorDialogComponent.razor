@inject VideoFrameAccessService FrameAccess
@inject IJSRuntime JsRuntime
@inject NotificationService NotificationService
@implements IAsyncDisposable

<div class="dialog-overlay visible" @onclick="CloseAsync">
    <div @ref="_dialogRoot" class="dialog-box dialog-fullscreen edit-map-dialog" role="dialog" aria-modal="true" data-keyboard-owner="edit-map" tabindex="-1" aria-labelledby="edit-map-dialog-title" @onclick:stopPropagation="true">
        <div class="dialog-title edit-map-dialog-titlebar">
            <div>
                <div id="edit-map-dialog-title">@AppText.T("web.editMap.title")</div>
                <div class="edit-map-dialog-subtitle">@Record?.EpisodeId · @AppText.T("web.detail.stretchLabel") @GetStretchLabel()</div>
            </div>
            <div class="edit-map-dialog-title-actions">
                <RadzenBadge Text="@GetStateLabel()" BadgeStyle="@GetStateStyle()" />
                <RadzenButton class="dialog-close-button" Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.common.close")" aria-label="@AppText.T("web.common.close")" Click="CloseAsync" />
            </div>
        </div>

        <div class="dialog-body edit-map-dialog-body">
            <RadzenSplitter Orientation="Orientation.Vertical" class="edit-map-main-splitter">
                <RadzenSplitterPane Size="62%" Min="360px">
                    <section class="edit-map-preview-section">
                        <div class="edit-map-preview-grid">
                            <section class="edit-map-preview-pane">
                                <div class="edit-map-section-title">@AppText.T("web.editMap.source")</div>
                                <div class="edit-map-preview-canvas-host">
                                    <canvas @ref="_sourceCanvas" class="edit-map-preview-canvas" role="img" aria-label="@GetPreviewAlternative(true)"></canvas>
                                    @if (_sourceIndexing)
                                    {
                                        <div class="edit-map-preview-overlay"><span>@AppText.T("web.editMap.indexingSource")</span></div>
                                    }
                                    else if (!string.IsNullOrEmpty(_sourceError))
                                    {
                                        <div class="edit-map-preview-overlay"><span>@AppText.F("web.editMap.indexingFailed", _sourceError)</span></div>
                                    }
                                    else if (!string.IsNullOrEmpty(_sourcePreviewMessage))
                                    {
                                        <div class="edit-map-preview-overlay">
                                            <span>@_sourcePreviewMessage</span>
                                            @if (_previewFailed)
                                            {
                                                <RadzenButton Text="@AppText.T("web.editMap.retry")" Size="ButtonSize.Small" Click="RetryPreviewAsync" />
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="edit-map-preview-controls">
                                    <div class="edit-map-frame-control">
                                        <RadzenButton Icon="chevron_left" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.previousSourceFrame")" aria-label="@AppText.T("web.editMap.previousSourceFrame")" data-frame-side="source" data-frame-delta="-1" Disabled="@(!CanStepSource(-1))" />
                                        <label>@AppText.T("web.editMap.frame") <input class="form-input" inputmode="numeric" value="@_sourceFrameText" aria-label="@AppText.T("web.editMap.sourceFrame")" @oninput="UpdateSourceFrameText" @onblur="CommitSourceFrameAsync" @onkeydown="HandleSourceFrameKeyAsync" disabled="@(!IndexesReady)" /></label>
                                        <span>/ @(_sourceIndex?.FrameCount.ToString() ?? "—")</span>
                                        <RadzenButton Icon="chevron_right" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.nextSourceFrame")" aria-label="@AppText.T("web.editMap.nextSourceFrame")" data-frame-side="source" data-frame-delta="1" Disabled="@(!CanStepSource(1))" />
                                    </div>
                                    <label>@AppText.T("web.editMap.pts") <input class="form-input" value="@_sourceTimestampText" aria-label="@AppText.T("web.editMap.sourcePts")" @oninput="UpdateSourceTimestampText" @onblur="CommitSourceTimestampAsync" @onkeydown="HandleSourceTimestampKeyAsync" disabled="@(!IndexesReady)" /></label>
                                </div>
                                <div class="edit-map-preview-meta">@GetIndexMetadata(_sourceIndex)</div>
                            </section>
                            <section class="edit-map-preview-pane">
                                <div class="edit-map-section-title">@AppText.T("web.editMap.language")</div>
                                <div class="edit-map-preview-canvas-host">
                                    <canvas @ref="_languageCanvas" class="edit-map-preview-canvas" role="img" aria-label="@GetPreviewAlternative(false)"></canvas>
                                    @if (_languageIndexing)
                                    {
                                        <div class="edit-map-preview-overlay"><span>@AppText.T("web.editMap.indexingLanguage")</span></div>
                                    }
                                    else if (!string.IsNullOrEmpty(_languageError))
                                    {
                                        <div class="edit-map-preview-overlay"><span>@AppText.F("web.editMap.indexingFailed", _languageError)</span></div>
                                    }
                                    else if (!string.IsNullOrEmpty(_languagePreviewMessage))
                                    {
                                        <div class="edit-map-preview-overlay">
                                            <span>@_languagePreviewMessage</span>
                                            @if (_previewFailed)
                                            {
                                                <RadzenButton Text="@AppText.T("web.editMap.retry")" Size="ButtonSize.Small" Click="RetryPreviewAsync" />
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="edit-map-preview-controls">
                                    <div class="edit-map-frame-control">
                                        <RadzenButton Icon="chevron_left" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.previousLanguageFrame")" aria-label="@AppText.T("web.editMap.previousLanguageFrame")" data-frame-side="language" data-frame-delta="-1" Disabled="@(!CanStepLanguage(-1))" />
                                        <label>@AppText.T("web.editMap.frame") <input class="form-input" inputmode="numeric" value="@_languageFrameText" aria-label="@AppText.T("web.editMap.languageFrame")" @oninput="UpdateLanguageFrameText" @onblur="CommitLanguageFrameAsync" @onkeydown="HandleLanguageFrameKeyAsync" disabled="@(!IndexesReady)" /></label>
                                        <span>/ @(_languageIndex?.FrameCount.ToString() ?? "—")</span>
                                        <RadzenButton Icon="chevron_right" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.nextLanguageFrame")" aria-label="@AppText.T("web.editMap.nextLanguageFrame")" data-frame-side="language" data-frame-delta="1" Disabled="@(!CanStepLanguage(1))" />
                                    </div>
                                    <label>@AppText.T("web.editMap.pts") <input class="form-input" value="@_languageTimestampText" aria-label="@AppText.T("web.editMap.languagePts")" @oninput="UpdateLanguageTimestampText" @onblur="CommitLanguageTimestampAsync" @onkeydown="HandleLanguageTimestampKeyAsync" disabled="@(!IndexesReady)" /></label>
                                </div>
                                <div class="edit-map-preview-meta">@GetIndexMetadata(_languageIndex)</div>
                            </section>
                        </div>
                    </section>
                </RadzenSplitterPane>
                <RadzenSplitterPane Size="18%" Min="150px">
                    <section class="edit-map-timeline-pane">
                        <div @ref="_timelineHost" class="edit-map-timeline-host" aria-label="@AppText.T("web.editMap.timeline")">
                            <div class="edit-map-timeline-scroll-range"></div>
                            <canvas @ref="_timelineCanvas" class="edit-map-timeline-canvas" role="img" aria-label="@GetTimelineAlternative()"></canvas>
                        </div>
                    </section>
                </RadzenSplitterPane>
                <RadzenSplitterPane Min="180px">
                    <section class="edit-map-operations-pane">
                        <div class="edit-map-section-title">@AppText.T("web.detail.operationsLabel")</div>
                        <RadzenDataGrid @ref="_operationGrid" Data="@_workingMap.Operations" TItem="EditOperation" EditMode="DataGridEditMode.Single" AllowSorting="false" AllowFiltering="false" AllowColumnResize="true" AllowRowSelectOnRowClick="true" GridLines="DataGridGridLines.Both" Density="Density.Compact" RowClick="SelectOperationRowAsync" RowRender="RenderOperationRow" class="edit-map-operation-grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="EditOperation" Title="#" Width="3.5rem" Resizable="false"><Template Context="operation">@((_workingMap.Operations.IndexOf(operation) + 1).ToString())</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.type")" Width="8rem"><Template Context="operation">@GetOperationTypeLabel(operation)</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Property="Scope" Title="@AppText.T("web.editMap.scope")" Width="6rem" />
                                <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.source")" Width="10rem">
                                    <Template Context="operation">@FormatTimestamp((_sourceIndex?.FirstPtsMs ?? 0.0) + operation.SourceTimestampMs)</Template>
                                    <EditTemplate Context="operation"><input class="form-input" value="@_operationSourceText" @oninput="UpdateOperationSourceText" @onblur="@(() => CommitInlineOperationRowAsync(operation))" /></EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.sourceFrame")" Width="8rem">
                                    <Template Context="operation">@GetOperationSourceFrame(operation)</Template>
                                    <EditTemplate Context="operation"><input class="form-input" inputmode="numeric" value="@_operationSourceFrameText" @oninput="UpdateOperationSourceFrameText" @onblur="@(() => CommitInlineOperationRowAsync(operation))" /></EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.language")" Width="10rem">
                                    <Template Context="operation">@FormatTimestamp((_languageIndex?.FirstPtsMs ?? 0.0) + operation.LangTimestampMs)</Template>
                                    <EditTemplate Context="operation"><input class="form-input" value="@_operationLanguageText" @oninput="UpdateOperationLanguageText" @onblur="@(() => CommitInlineOperationRowAsync(operation))" /></EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.languageFrame")" Width="8rem">
                                    <Template Context="operation">@GetOperationLanguageFrame(operation)</Template>
                                    <EditTemplate Context="operation"><input class="form-input" inputmode="numeric" value="@_operationLanguageFrameText" @oninput="UpdateOperationLanguageFrameText" @onblur="@(() => CommitInlineOperationRowAsync(operation))" /></EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.languageDurationShort")" Width="9rem">
                                    <Template Context="operation">@FormatDuration(operation.DurationMs)</Template>
                                    <EditTemplate Context="operation"><input class="form-input" inputmode="numeric" value="@_operationLanguageDurationText" @oninput="UpdateOperationLanguageDurationText" @onblur="@(() => CommitInlineOperationRowAsync(operation))" /></EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.renderedDurationShort")" Width="9rem">
                                    <Template Context="operation">@FormatDuration(GetRenderedDurationMs(operation))</Template>
                                    <EditTemplate Context="operation"><input class="form-input" inputmode="numeric" value="@_operationRenderedDurationText" @oninput="UpdateOperationRenderedDurationText" @onblur="@(() => CommitInlineOperationRowAsync(operation))" /></EditTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="EditOperation" Width="12rem" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Resizable="false" TextAlign="TextAlign.Center">
                                    <HeaderTemplate>
                                        <RadzenButton Icon="content_cut" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addCutHelp")" Disabled="@(!CanCreateOperation())" Click="@(() => AddOperationAsync(EditOperation.CUT_SEGMENT))" @onclick:stopPropagation="true" />
                                        <RadzenButton Icon="add_to_queue" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addInsertHelp")" Disabled="@(!CanCreateOperation())" Click="@(() => AddOperationAsync(EditOperation.INSERT_SILENCE))" @onclick:stopPropagation="true" />
                                    </HeaderTemplate>
                                    <Template Context="operation">
                                        <RadzenButton Icon="content_cut" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addCutHelp")" Disabled="@(!CanCreateOperation())" Click="@(() => AddOperationAsync(EditOperation.CUT_SEGMENT))" @onclick:stopPropagation="true" />
                                        <RadzenButton Icon="add_to_queue" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addInsertHelp")" Disabled="@(!CanCreateOperation())" Click="@(() => AddOperationAsync(EditOperation.INSERT_SILENCE))" @onclick:stopPropagation="true" />
                                        <RadzenButton Icon="edit" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.common.edit")" Click="@(() => EditOperationRowAsync(operation))" @onclick:stopPropagation="true" />
                                        <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" title="@AppText.T("web.editMap.deleteHelp")" Click="@(() => DeleteOperationAsync(operation))" @onclick:stopPropagation="true" />
                                    </Template>
                                    <EditTemplate Context="operation">
                                        <RadzenButton Icon="check" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Success" title="@AppText.T("web.common.apply")" Click="@(() => SaveOperationRowAsync(operation))" @onclick:stopPropagation="true" />
                                        <RadzenButton Icon="close" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.common.cancel")" Click="@(() => CancelOperationRowAsync(operation))" @onclick:stopPropagation="true" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </section>
                </RadzenSplitterPane>
            </RadzenSplitter>
        </div>

        <div class="dialog-footer edit-map-dialog-footer">
            <span class="edit-map-validation-summary">@GetValidationSummary()</span>
            <span class="edit-map-footer-spacer"></span>
            <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.cancelHelp")" Click="CloseAsync" />
            <RadzenButton Text="@AppText.T("web.editMap.apply")" Icon="check" title="@AppText.T("web.editMap.applyHelp")" Disabled="@(!CanApply())" Click="ApplyAsync" />
        </div>
    </div>
</div>

@code {
    /// <summary>Indice del record originale</summary>
    [Parameter] public int RecordIndex { get; set; }

    /// <summary>Snapshot del record aperto</summary>
    [Parameter] public FileProcessingRecord Record { get; set; }

    /// <summary>Evento chiusura dialog</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Evento applicazione mappa validata</summary>
    [Parameter] public EventCallback<(EditMap Map, double SourceDurationMs, double LanguageDurationMs)> OnApply { get; set; }

    /// <summary>Indica che la pipeline è occupata da una operazione incompatibile</summary>
    [Parameter] public bool IsBusy { get; set; }

    private CancellationTokenSource _cancellation = new CancellationTokenSource();
    private EditMap _originalMap = new EditMap();
    private EditMap _workingMap = new EditMap();
    private EditMapProjection _projection;
    private EditOperation _selectedOperation;
    private VideoFrameIndex _sourceIndex;
    private VideoFrameIndex _languageIndex;
    private VideoFrameIndexEntry _sourceFrame;
    private VideoFrameIndexEntry _languageFrame;
    private RadzenDataGrid<EditOperation> _operationGrid;
    private ElementReference _sourceCanvas;
    private ElementReference _languageCanvas;
    private ElementReference _dialogRoot;
    private ElementReference _timelineHost;
    private ElementReference _timelineCanvas;
    private IJSObjectReference _module;
    private IJSObjectReference _previewPair;
    private IJSObjectReference _timeline;
    private IJSObjectReference _keyboard;
    private DotNetObjectReference<EditMapEditorDialogComponent> _dotNetReference;
    private string _sourceError = "";
    private string _languageError = "";
    private string _sourcePreviewMessage = "";
    private string _languagePreviewMessage = "";
    private string _sourceFrameText = "";
    private string _languageFrameText = "";
    private string _sourceTimestampText = "";
    private string _languageTimestampText = "";
    private string _operationSourceText = "";
    private string _operationLanguageText = "";
    private string _operationLanguageDurationText = "";
    private string _operationRenderedDurationText = "";
    private string _operationSourceFrameText = "";
    private string _operationLanguageFrameText = "";
    private string _timestampEditAuthority = "";
    private string _durationEditAuthority = "";
    private double _sourcePlayheadMs;
    private double _languageCursorMs;
    private bool _sourceIndexing = true;
    private bool _languageIndexing = true;
    private bool _interactiveInitialized;
    private bool _dirty;
    private bool _isApplying;
    private bool _previewFailed;

    private bool IndexesReady { get { return this._sourceIndex != null && this._languageIndex != null && string.IsNullOrEmpty(this._sourceError) && string.IsNullOrEmpty(this._languageError); } }

    /// <summary>Inizializza copia di lavoro e indicizza i due video in parallelo</summary>
    protected override async Task OnInitializedAsync()
    {
        this._workingMap = EditMapTimelineHelper.Clone(this.Record != null ? this.Record.DeepAnalysisMap : null);
        if (this.Record != null && this.Record.DeepAnalysisMap == null)
        {
            this._workingMap.InitialDelayMs = this.Record.SyncOffsetMs;
            this._workingMap.StretchFactor = this.Record.StretchFactor ?? "";
        }
        this._originalMap = EditMapTimelineHelper.Clone(this._workingMap);
        this._sourcePlayheadMs = 0.0;
        this._languageCursorMs = double.NaN;

        Task sourceTask = this.BuildIndexAsync(true);
        Task languageTask = this.BuildIndexAsync(false);
        await Task.WhenAll(sourceTask, languageTask);
        if (this.IndexesReady)
        {
            this.RebuildProjection();
            this._workingMap = this._projection.Map;
            this._originalMap = EditMapTimelineHelper.Clone(this._workingMap);
            this.NavigateFromSource(0.0);
        }
    }

    /// <summary>Inizializza canvas WebGL e timeline quando gli indici sono pronti</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            this._module = await this.JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/edit-map-timeline.js");
        if (!this.IndexesReady || this._interactiveInitialized || this._module == null)
            return;

        this._interactiveInitialized = true;
        this._dotNetReference = DotNetObjectReference.Create(this);
        this._keyboard = await this._module.InvokeAsync<IJSObjectReference>("captureEditorKeyboard", this._dialogRoot, this._dotNetReference);
        try
        {
            this._previewPair = await this._module.InvokeAsync<IJSObjectReference>("createPreviewPair", this._sourceCanvas, this._languageCanvas);
            this._timeline = await this._module.InvokeAsync<IJSObjectReference>("createTimeline", this._timelineHost, this._timelineCanvas, this._dotNetReference, this.BuildTimelineModel());
            await this.RefreshPreviewAsync();
        }
        catch (JSException exception)
        {
            this._previewFailed = true;
            this._sourcePreviewMessage = AppText.T("web.editMap.previewUnavailable");
            this._languagePreviewMessage = AppText.T("web.editMap.previewUnavailable");
            this.NotificationService.Notify(NotificationSeverity.Error, AppText.T("web.editMap.previewError"), exception.Message, 8000);
            this.StateHasChanged();
        }
    }

    /// <summary>Costruisce uno dei due indici senza bloccare il circuito</summary>
    private async Task BuildIndexAsync(bool source)
    {
        try
        {
            string path = source ? this.Record.SourceFilePath : this.Record.LangFilePath;
            VideoFrameIndex index = await Task.Run(() => this.FrameAccess.GetOrBuildIndex(path, 120000, this._cancellation.Token), this._cancellation.Token);
            if (source)
                this._sourceIndex = index;
            else
                this._languageIndex = index;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            if (source)
                this._sourceError = exception.Message;
            else
                this._languageError = exception.Message;
        }
        finally
        {
            if (source)
                this._sourceIndexing = false;
            else
                this._languageIndexing = false;
            await this.InvokeAsync(this.StateHasChanged);
        }
    }

    private string GetStretchLabel() => string.IsNullOrEmpty(this._workingMap.StretchFactor) ? "1" : this._workingMap.StretchFactor;

    private string GetStateLabel()
    {
        if (this._sourceIndexing || this._languageIndexing)
            return AppText.T("web.editMap.indexing");
        if (!string.IsNullOrEmpty(this._sourceError) || !string.IsNullOrEmpty(this._languageError))
            return AppText.T("web.editMap.error");
        if (this._projection != null && !this._projection.Validation.IsValid)
            return AppText.T("web.editMap.invalid");
        if (this._dirty)
            return AppText.T("web.editMap.unsaved");
        return AppText.T("web.editMap.ready");
    }

    private BadgeStyle GetStateStyle() => !string.IsNullOrEmpty(this._sourceError) || !string.IsNullOrEmpty(this._languageError) || (this._projection != null && !this._projection.Validation.IsValid) ? BadgeStyle.Danger : this._sourceIndexing || this._languageIndexing ? BadgeStyle.Info : this._dirty ? BadgeStyle.Warning : BadgeStyle.Success;

    private string GetValidationSummary()
    {
        if (!this.IndexesReady)
            return AppText.T("web.editMap.waitingForIndexes");
        if (this._projection == null || !this._projection.Validation.IsValid)
            return AppText.F("web.editMap.validationErrors", this._projection != null ? this._projection.Validation.Errors.Count : 1);
        return AppText.F("web.editMap.validationValid", this._workingMap.Operations.Count, this._projection.Validation.Warnings.Count);
    }

    private string GetIndexMetadata(VideoFrameIndex index)
    {
        if (index == null)
            return "—";
        return AppText.F("web.editMap.indexMetadata", index.CodedWidth, index.CodedHeight, index.SampleAspectRatio, index.FrameCount);
    }

    private string GetPreviewAlternative(bool source)
    {
        VideoFrameIndexEntry frame = source ? this._sourceFrame : this._languageFrame;
        string message = source ? this._sourcePreviewMessage : this._languagePreviewMessage;
        if (frame == null)
            return !string.IsNullOrEmpty(message) ? message : AppText.T(source ? "web.editMap.noSourceFrame" : "web.editMap.noLanguageFrame");
        return AppText.F(source ? "web.editMap.sourcePreviewAlternative" : "web.editMap.languagePreviewAlternative", frame.PresentationIndex + 1, FormatTimestamp(frame.PtsMs));
    }

    private string GetTimelineAlternative() => AppText.F("web.editMap.timelineAlternative", FormatTimestamp(this._sourcePlayheadMs), this._workingMap.Operations.Count);

    private void RebuildProjection()
    {
        this._projection = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
    }

    private void NavigateFromSource(double sourceTimeMs)
    {
        this._sourcePlayheadMs = Math.Max(0.0, Math.Min(this._sourceIndex.DurationMs, sourceTimeMs));
        this._sourceFrame = this._sourceIndex.FindContainingFrame(this._sourceIndex.FirstPtsMs + this._sourcePlayheadMs) ?? this._sourceIndex.FindNearestFrame(this._sourceIndex.FirstPtsMs + this._sourcePlayheadMs);
        EditMapMappingResult mapping = this._projection.MapSourceToLanguage(this._sourcePlayheadMs);
        if (mapping.IsMapped)
        {
            this._languageCursorMs = mapping.LanguageTimestampMs;
            this._languageFrame = this._languageIndex.FindContainingFrame(this._languageIndex.FirstPtsMs + this._languageCursorMs) ?? this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + this._languageCursorMs);
            this._languagePreviewMessage = "";
        }
        else
        {
            this._languageCursorMs = double.NaN;
            this._languageFrame = null;
            this._languagePreviewMessage = AppText.T("web.editMap.noLanguageFrame");
        }
        this._sourcePreviewMessage = "";
        this.RefreshNavigationFields();
    }

    private void NavigateFromLanguage(double languageTimeMs)
    {
        this._languageCursorMs = Math.Max(0.0, Math.Min(this._languageIndex.DurationMs, languageTimeMs));
        this._languageFrame = this._languageIndex.FindContainingFrame(this._languageIndex.FirstPtsMs + this._languageCursorMs) ?? this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + this._languageCursorMs);
        EditMapMappingResult mapping = this._projection.MapLanguageToSource(this._languageCursorMs);
        this._sourcePlayheadMs = double.IsFinite(mapping.SourceTimestampMs) ? mapping.SourceTimestampMs : 0.0;
        if (mapping.IsMapped)
        {
            this._sourceFrame = this._sourceIndex.FindContainingFrame(this._sourceIndex.FirstPtsMs + this._sourcePlayheadMs) ?? this._sourceIndex.FindNearestFrame(this._sourceIndex.FirstPtsMs + this._sourcePlayheadMs);
            this._sourcePreviewMessage = "";
        }
        else
        {
            this._sourceFrame = null;
            this._sourcePreviewMessage = AppText.T("web.editMap.noSourceFrame");
        }
        this._languagePreviewMessage = "";
        this.RefreshNavigationFields();
    }

    private void RefreshNavigationFields()
    {
        this._sourceFrameText = this._sourceFrame != null ? (this._sourceFrame.PresentationIndex + 1).ToString() : "";
        this._languageFrameText = this._languageFrame != null ? (this._languageFrame.PresentationIndex + 1).ToString() : "";
        this._sourceTimestampText = this._sourceFrame != null ? FormatTimestamp(this._sourceFrame.PtsMs) : "";
        this._languageTimestampText = this._languageFrame != null ? FormatTimestamp(this._languageFrame.PtsMs) : "";
    }

    private async Task RefreshPreviewAsync()
    {
        if (this._previewPair == null)
            return;
        string sourceUrl = this._sourceFrame != null ? "/api/edit-map-preview/" + this.RecordIndex.ToString() + "/source/" + this._sourceFrame.PresentationIndex.ToString() : null;
        string languageUrl = this._languageFrame != null ? "/api/edit-map-preview/" + this.RecordIndex.ToString() + "/language/" + this._languageFrame.PresentationIndex.ToString() : null;
        this._previewFailed = false;
        if (sourceUrl != null)
            this._sourcePreviewMessage = AppText.F("web.editMap.loadingFrame", this._sourceFrame.PresentationIndex + 1);
        if (languageUrl != null)
            this._languagePreviewMessage = AppText.F("web.editMap.loadingFrame", this._languageFrame.PresentationIndex + 1);
        this.StateHasChanged();
        try
        {
            await this._previewPair.InvokeAsync<bool>("loadPair", sourceUrl, languageUrl);
            if (sourceUrl != null)
                this._sourcePreviewMessage = "";
            if (languageUrl != null)
                this._languagePreviewMessage = "";
        }
        catch (JSException exception)
        {
            if (exception.Message.IndexOf("abort", StringComparison.OrdinalIgnoreCase) < 0)
            {
                this._previewFailed = true;
                if (exception.Message.IndexOf("Source:", StringComparison.OrdinalIgnoreCase) >= 0)
                    this._sourcePreviewMessage = AppText.T("web.editMap.previewError");
                else if (exception.Message.IndexOf("Language:", StringComparison.OrdinalIgnoreCase) >= 0)
                    this._languagePreviewMessage = AppText.T("web.editMap.previewError");
                else
                {
                    this._sourcePreviewMessage = AppText.T("web.editMap.previewError");
                    this._languagePreviewMessage = AppText.T("web.editMap.previewError");
                }
                this.NotificationService.Notify(NotificationSeverity.Error, AppText.T("web.editMap.previewError"), exception.Message, 8000);
            }
        }
        this.StateHasChanged();
    }

    private Task RetryPreviewAsync() => this.RefreshPreviewAsync();

    private object BuildTimelineModel()
    {
        List<object> segments = new List<object>();
        List<object> operations = new List<object>();
        if (this._projection != null)
        {
            for (int i = 0; i < this._projection.Segments.Count; i++)
            {
                EditMapTimelineSegment segment = this._projection.Segments[i];
                segments.Add(new { kind = segment.Kind.ToString(), sourceStartMs = segment.SourceStartMs, sourceEndMs = segment.SourceEndMs, languageStartMs = segment.LanguageStartMs, languageEndMs = segment.LanguageEndMs });
            }
        }
        for (int i = 0; i < this._workingMap.Operations.Count; i++)
        {
            EditOperation operation = this._workingMap.Operations[i];
            operations.Add(new { index = i, type = operation.Type, sourceMs = operation.SourceTimestampMs, durationMs = EditMapTimelineHelper.GetRenderedOperationDeltaMs(operation, this._projection != null ? this._projection.StretchRatio : 1.0), selected = object.ReferenceEquals(operation, this._selectedOperation) });
        }
        object labels = new
        {
            source = AppText.T("web.editMap.source").ToUpperInvariant(),
            language = AppText.T("web.editMap.language").ToUpperInvariant(),
            cut = AppText.T("web.editMap.cut").ToUpperInvariant(),
            insert = AppText.T("web.editMap.insert").ToUpperInvariant(),
            sourcePts = AppText.T("web.editMap.sourcePts"),
            languagePts = AppText.T("web.editMap.languagePts")
        };
        string sourcePlayheadLabel = this._sourceFrame != null ? FormatTimestamp(this._sourceFrame.PtsMs) : "—";
        string languagePlayheadLabel = this._languageFrame != null ? FormatTimestamp(this._languageFrame.PtsMs) : "—";
        double sourceDurationMs = this._sourceIndex != null ? this._sourceIndex.DurationMs : 0.0;
        double languageDurationMs = this._languageIndex != null ? this._languageIndex.DurationMs : 0.0;
        string sourceWaveformUrl = "/api/edit-map-waveform/" + this.RecordIndex.ToString() + "/source?durationMs=" + sourceDurationMs.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        string languageWaveformUrl = this.Record != null && this.Record.ImportedAudioTracks != null && this.Record.ImportedAudioTracks.Count > 0
            ? "/api/edit-map-waveform/" + this.RecordIndex.ToString() + "/language?durationMs=" + languageDurationMs.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)
            : null;
        return new { durationMs = sourceDurationMs, frameDurationMs = this._sourceIndex != null ? this._sourceIndex.MedianFrameDurationMs : 40.0, sourceFirstPtsMs = this._sourceIndex != null ? this._sourceIndex.FirstPtsMs : 0.0, languageFirstPtsMs = this._languageIndex != null ? this._languageIndex.FirstPtsMs : 0.0, sourceWaveformUrl = sourceWaveformUrl, languageWaveformUrl = languageWaveformUrl, playheadMs = this._sourcePlayheadMs, sourcePlayheadLabel = sourcePlayheadLabel, languagePlayheadLabel = languagePlayheadLabel, labels = labels, segments = segments, operations = operations };
    }

