            await this.CommitOperationRowAsync(operation, false);
    }

    private async Task CommitOperationRowAsync(EditOperation operation, bool finishEditing)
    {
        if (!this.TryResolveEditedLanguageTimestamp(out int languageTimestamp) || !this.TryResolveEditedLanguageDuration(languageTimestamp, out int languageDuration))
        {
            this.WarnInvalidValue();
            this.RefreshOperationFields();
            return;
        }

        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        operation.LangTimestampMs = languageTimestamp;
        operation.DurationMs = languageDuration;
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            int index = this._workingMap.Operations.IndexOf(operation);
            EditOperation restored = index >= 0 && index < backup.Operations.Count ? backup.Operations[index] : null;
            if (restored != null)
                CopyOperation(restored, operation);
            this.RebuildProjection();
            this._selectedOperation = operation;
            this.WarnInvalidValue();
            this.RefreshOperationFields();
            if (finishEditing)
                await this._operationGrid.Reload();
            return;
        }

        string type = operation.Type;
        EditOperation normalized = FindOperation(candidate.Map.Operations, type, languageTimestamp, languageDuration);
        if (finishEditing)
        {
            this._workingMap = candidate.Map;
            this._projection = candidate;
            this._selectedOperation = normalized;
            this._operationGrid.CancelEditRow(operation);
            await this.FinishMapMutationAsync();
            return;
        }

        CopyOperation(normalized, operation);
        this._workingMap.Operations.Sort((left, right) => left.LangTimestampMs.CompareTo(right.LangTimestampMs));
        this.RebuildProjection();
        this._selectedOperation = operation;
        this._timestampEditAuthority = "";
        this._durationEditAuthority = "";
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        this.NavigateFromSource(operation.SourceTimestampMs);
        this.StateHasChanged();
        await this.UpdateTimelineAsync(true);
        await this.RefreshPreviewAsync();
    }

    private bool TryResolveEditedLanguageTimestamp(out int timestampMs)
    {
        timestampMs = this._selectedOperation != null ? this._selectedOperation.LangTimestampMs : 0;
        if (this._selectedOperation == null || string.IsNullOrEmpty(this._timestampEditAuthority))
            return this._selectedOperation != null;

        VideoFrameIndexEntry languageFrame = null;
        if (string.Equals(this._timestampEditAuthority, "language-time", StringComparison.Ordinal))
        {
            if (!TryParseTimestamp(this._operationLanguageText, out double ptsMs))
                return false;
            languageFrame = this._languageIndex.FindNearestFrame(ptsMs);
        }
        else if (string.Equals(this._timestampEditAuthority, "language-frame", StringComparison.Ordinal))
        {
            if (!int.TryParse(this._operationLanguageFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._languageIndex.FrameCount)
                return false;
            languageFrame = this._languageIndex.Frames[frameNumber - 1];
        }
        else
        {
            VideoFrameIndexEntry sourceFrame;
            if (string.Equals(this._timestampEditAuthority, "source-time", StringComparison.Ordinal))
            {
                if (!TryParseTimestamp(this._operationSourceText, out double ptsMs))
                    return false;
                sourceFrame = this._sourceIndex.FindNearestFrame(ptsMs);
            }
            else
            {
                if (!int.TryParse(this._operationSourceFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._sourceIndex.FrameCount)
                    return false;
                sourceFrame = this._sourceIndex.Frames[frameNumber - 1];
            }
            if (sourceFrame == null)
                return false;
            EditMapMappingResult mapping = this._projection.MapSourceToLanguage(sourceFrame.PtsMs - this._sourceIndex.FirstPtsMs);
            if (!mapping.IsMapped)
                return false;
            languageFrame = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs);
        }

        if (languageFrame == null)
            return false;
        timestampMs = Math.Max(0, (int)Math.Round(languageFrame.PtsMs - this._languageIndex.FirstPtsMs));
        return true;
    }

    private bool TryResolveEditedLanguageDuration(int timestampMs, out int durationMs)
    {
        durationMs = this._selectedOperation != null ? this._selectedOperation.DurationMs : 0;
        if (this._selectedOperation == null || string.IsNullOrEmpty(this._durationEditAuthority))
            return this._selectedOperation != null;

        int requestedDuration;
        if (string.Equals(this._durationEditAuthority, "rendered-duration", StringComparison.Ordinal))
        {
            if (!int.TryParse(this._operationRenderedDurationText, out int renderedDuration) || renderedDuration <= 0)
                return false;
            requestedDuration = Math.Max(1, (int)Math.Round(renderedDuration / this._projection.StretchRatio));
        }
        else if (!int.TryParse(this._operationLanguageDurationText, out requestedDuration) || requestedDuration <= 0)
        {
            return false;
        }

        durationMs = this.SnapLanguageDuration(timestampMs, requestedDuration);
        return true;
    }

    private bool CanCreateOperation()
    {
        if (!this.IndexesReady || this._projection == null)
            return false;
        return this._projection.MapSourceToLanguage(this._sourcePlayheadMs).IsMapped;
    }

    private async Task AddOperationAsync(string type)
    {
        EditMapMappingResult mapping = this._projection.MapSourceToLanguage(this._sourcePlayheadMs);
        if (!mapping.IsMapped)
            return;
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindContainingFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs) ?? this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs);
        if (languageFrame == null)
            return;
        EditOperation operation = new EditOperation
        {
            Type = type,
            LangTimestampMs = Math.Max(0, (int)Math.Round(languageFrame.PtsMs - this._languageIndex.FirstPtsMs)),
            DurationMs = Math.Max(1, (int)Math.Round(languageFrame.DurationMs)),
            SourceTimestampMs = Math.Max(0, (int)Math.Round(this._sourcePlayheadMs)),
            VisualSourceTimestampMs = Math.Max(0, (int)Math.Round(this._sourcePlayheadMs)),
            Scope = EditOperation.SCOPE_BODY
        };
        this._workingMap.Operations.Add(operation);
        await this.NormalizeWorkingMapAsync(operation);
        if (this._selectedOperation != null && this._operationGrid != null)
            await this._operationGrid.EditRow(this._selectedOperation);
    }

    private async Task DeleteSelectedOperationAsync()
    {
        if (this._selectedOperation == null)
            return;
        this._workingMap.Operations.Remove(this._selectedOperation);
        this._selectedOperation = null;
        this.RebuildProjection();
        this._workingMap = this._projection.Map;
        this.UpdateDirtyState();
        this.NavigateFromSource(this._sourcePlayheadMs);
        if (this._operationGrid != null)
            await this._operationGrid.Reload();
        await this.RefreshAfterNavigationAsync();
    }

    private async Task DeleteOperationAsync(EditOperation operation)
    {
        this._selectedOperation = operation;
        await this.DeleteSelectedOperationAsync();
    }

    private void RefreshOperationFields()
    {
        if (this._selectedOperation == null)
            return;
        this._operationSourceText = FormatTimestamp(this._sourceIndex.FirstPtsMs + this._selectedOperation.SourceTimestampMs);
        this._operationLanguageText = FormatTimestamp(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs);
        this._operationLanguageDurationText = this._selectedOperation.DurationMs.ToString();
        this._operationRenderedDurationText = EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(this._selectedOperation.DurationMs, this._projection.StretchRatio).ToString();
        VideoFrameIndexEntry sourceFrame = this._sourceIndex.FindNearestFrame(this._sourceIndex.FirstPtsMs + this._selectedOperation.SourceTimestampMs);
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs);
        this._operationSourceFrameText = sourceFrame != null ? (sourceFrame.PresentationIndex + 1).ToString() : "";
        this._operationLanguageFrameText = languageFrame != null ? (languageFrame.PresentationIndex + 1).ToString() : "";
    }

    private int GetRenderedDurationMs(EditOperation operation) => EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(operation.DurationMs, this._projection != null ? this._projection.StretchRatio : 1.0);

    private string GetOperationTypeLabel(EditOperation operation) => AppText.T(string.Equals(operation.Type, EditOperation.CUT_SEGMENT, StringComparison.Ordinal) ? "web.editMap.cut" : "web.editMap.insert");

    private void UpdateOperationSourceText(ChangeEventArgs args) { this._operationSourceText = GetEventText(args); this._timestampEditAuthority = "source-time"; }
    private void UpdateOperationLanguageText(ChangeEventArgs args) { this._operationLanguageText = GetEventText(args); this._timestampEditAuthority = "language-time"; }
    private void UpdateOperationLanguageDurationText(ChangeEventArgs args) { this._operationLanguageDurationText = GetEventText(args); this._durationEditAuthority = "language-duration"; }
    private void UpdateOperationRenderedDurationText(ChangeEventArgs args) { this._operationRenderedDurationText = GetEventText(args); this._durationEditAuthority = "rendered-duration"; }
    private void UpdateOperationSourceFrameText(ChangeEventArgs args) { this._operationSourceFrameText = GetEventText(args); this._timestampEditAuthority = "source-frame"; }
    private void UpdateOperationLanguageFrameText(ChangeEventArgs args) { this._operationLanguageFrameText = GetEventText(args); this._timestampEditAuthority = "language-frame"; }

    private async Task NormalizeWorkingMapAsync(EditOperation selected)
    {
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap.Operations.Remove(selected);
            this.RebuildProjection();
            this.WarnInvalidValue();
            return;
        }
        this._workingMap = candidate.Map;
        this._projection = candidate;
        this._selectedOperation = FindOperation(this._workingMap.Operations, selected.Type, selected.LangTimestampMs, selected.DurationMs);
        await this.FinishMapMutationAsync();
    }

    private async Task FinishMapMutationAsync()
    {
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        if (this._operationGrid != null)
            await this._operationGrid.Reload();
        if (this._selectedOperation != null)
            await this.SelectOperationAsync(this._workingMap.Operations.IndexOf(this._selectedOperation), true);
        else
            await this.UpdateTimelineAsync();
        this.StateHasChanged();
    }

    private int SnapLanguageDuration(int startMs, int requestedDurationMs)
    {
        VideoFrameIndexEntry start = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + startMs);
        VideoFrameIndexEntry end = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + startMs + requestedDurationMs);
        if (start == null || end == null)
            return requestedDurationMs;
        if (end.PresentationIndex <= start.PresentationIndex && start.PresentationIndex + 1 < this._languageIndex.FrameCount)
            end = this._languageIndex.Frames[start.PresentationIndex + 1];
        if (end.PresentationIndex == start.PresentationIndex)
            return Math.Max(1, (int)Math.Round(start.DurationMs));
        return Math.Max(1, (int)Math.Round(end.PtsMs - start.PtsMs));
    }

    private void WarnInvalidValue() => this.NotificationService.Notify(NotificationSeverity.Warning, AppText.T("web.editMap.invalidValue"), AppText.T("web.editMap.valueRestored"), 5000);

    private void UpdateDirtyState() => this._dirty = !MapsEqual(this._originalMap, this._workingMap);

    private bool CanApply() => this.IndexesReady && !this.IsBusy && !this._isApplying && this._workingMap.Operations.Count > 0 && this._projection != null && this._projection.Validation.IsValid;

    private async Task ApplyAsync()
    {
        if (!this.CanApply())
            return;
        this._isApplying = true;
        try
        {
            await this.OnApply.InvokeAsync((EditMapTimelineHelper.Clone(this._workingMap), this._sourceIndex.DurationMs, this._languageIndex.DurationMs));
        }
        finally
        {
            this._isApplying = false;
        }
    }

    /// <summary>Sposta il playhead Source dalla timeline JavaScript</summary>
    /// <param name="sourceMs">Timestamp Source relativo</param>
    [JSInvokable]
    public async Task OnTimelineSeek(double sourceMs)
    {
        this.NavigateFromSource(sourceMs);
        this.SelectOperationAtPlayhead();
        await this.InvokeAsync(async () => await this.RefreshAfterNavigationAsync());
    }

    /// <summary>Naviga rapidamente i frame da tastiera o pressione prolungata</summary>
    /// <param name="side">Lato Source o Language</param>
    /// <param name="delta">Numero di frame da percorrere</param>
    [JSInvokable]
    public async Task OnFrameStep(string side, int delta)
    {
        if (string.Equals(side, "language", StringComparison.Ordinal))
            await this.StepLanguageAsync(delta);
        else
            await this.StepSourceAsync(delta);
        if (this.SelectOperationAtPlayhead())
        {
            this.StateHasChanged();
            await this.UpdateTimelineAsync();
        }
    }

    private bool SelectOperationAtPlayhead()
    {
        EditOperation selected = null;
        double tolerance = this._sourceIndex != null ? Math.Max(1.0, this._sourceIndex.MedianFrameDurationMs) : 40.0;
        for (int i = 0; i < this._workingMap.Operations.Count; i++)
        {
            EditOperation operation = this._workingMap.Operations[i];
            double end = operation.SourceTimestampMs + Math.Max(tolerance, Math.Abs(GetRenderedDurationMs(operation)));
            if (this._sourcePlayheadMs >= operation.SourceTimestampMs - tolerance * 0.5 && this._sourcePlayheadMs <= end)
            {
                selected = operation;
                break;
            }
        }
        if (object.ReferenceEquals(selected, this._selectedOperation))
            return false;
        this._selectedOperation = selected;
        this.RefreshOperationFields();
        return true;
    }

    /// <summary>Seleziona una operazione dal marker della timeline</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    [JSInvokable]
    public async Task OnTimelineOperationSelected(int operationIndex)
    {
        await this.InvokeAsync(async () => await this.SelectOperationAsync(operationIndex, false));
    }

    /// <summary>Aggiorna il boundary di una operazione durante o al termine del drag</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    /// <param name="sourceMs">Nuovo boundary Source</param>
    /// <param name="final">True al rilascio del puntatore</param>
    [JSInvokable]
    public async Task OnTimelineOperationDrag(int operationIndex, double sourceMs, bool final)
    {
        if (operationIndex < 0 || operationIndex >= this._workingMap.Operations.Count)
            return;
        if (this._selectedOperation == null)
            this._selectedOperation = this._workingMap.Operations[operationIndex];
        VideoFrameIndexEntry sourceFrame = this._sourceIndex.FindNearestFrame(this._sourceIndex.FirstPtsMs + sourceMs);
        EditMapMappingResult mapping = sourceFrame != null ? this._projection.MapSourceToLanguage(sourceFrame.PtsMs - this._sourceIndex.FirstPtsMs) : null;
        if (mapping == null || !mapping.IsMapped)
            return;
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs);
        int timestamp = Math.Max(0, (int)Math.Round(languageFrame.PtsMs - this._languageIndex.FirstPtsMs));
        string originalType = this._selectedOperation.Type;
        int originalTimestamp = this._selectedOperation.LangTimestampMs;
        int originalDuration = this._selectedOperation.DurationMs;
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        this._selectedOperation.LangTimestampMs = timestamp;
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, originalDuration);
            return;
        }
        string type = this._selectedOperation.Type;
        int duration = this._selectedOperation.DurationMs;
        this._workingMap = candidate.Map;
        this._projection = candidate;
        this._selectedOperation = FindOperation(this._workingMap.Operations, type, timestamp, duration);
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
        await this.InvokeAsync(async () =>
        {
            if (this._operationGrid != null)
                await this._operationGrid.Reload();
            this.StateHasChanged();
            if (final)
            {
                await this.UpdateTimelineAsync();
                await this.RefreshPreviewAsync();
            }
        });
    }

    /// <summary>Aggiorna la durata renderizzata durante o al termine del drag</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    /// <param name="renderedDurationMs">Durata nel dominio Source renderizzato</param>
    /// <param name="final">True al rilascio del puntatore</param>
    [JSInvokable]
    public async Task OnTimelineDurationDrag(int operationIndex, double renderedDurationMs, bool final)
    {
        if (operationIndex < 0 || operationIndex >= this._workingMap.Operations.Count)
            return;
        if (this._selectedOperation == null)
            this._selectedOperation = this._workingMap.Operations[operationIndex];

        string originalType = this._selectedOperation.Type;
        int originalTimestamp = this._selectedOperation.LangTimestampMs;
        int originalDuration = this._selectedOperation.DurationMs;
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        int languageDuration = Math.Max(1, (int)Math.Round(renderedDurationMs / this._projection.StretchRatio));
        this._selectedOperation.DurationMs = this.SnapLanguageDuration(this._selectedOperation.LangTimestampMs, languageDuration);
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, originalDuration);
            return;
        }

        int duration = this._selectedOperation.DurationMs;
        this._workingMap = candidate.Map;
        this._projection = candidate;
        this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, duration);
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
        await this.InvokeAsync(async () =>
        {
            if (this._operationGrid != null)
                await this._operationGrid.Reload();
            this.StateHasChanged();
            if (final)
            {
                await this.UpdateTimelineAsync();
                await this.RefreshPreviewAsync();
            }
        });
    }

    /// <summary>Gestisce le scorciatoie locali dell'editor prima della tastiera globale</summary>
    /// <param name="key">Tasto normalizzato dal browser</param>
    /// <param name="shift">True quando Shift è premuto</param>
    /// <param name="editing">True quando il focus è in un campo editabile</param>
    [JSInvokable]
    public async Task OnEditorKey(string key, bool shift, bool editing)
    {
        if (editing)
        {
            if (string.Equals(key, "Escape", StringComparison.Ordinal))
            {
                this.RefreshNavigationFields();
                this.RefreshOperationFields();
                this.StateHasChanged();
            }
            return;
        }

        if (string.Equals(key, "ArrowLeft", StringComparison.Ordinal))
            await this.StepSourceAsync(shift ? -10 : -1);
        else if (string.Equals(key, "ArrowRight", StringComparison.Ordinal))
            await this.StepSourceAsync(shift ? 10 : 1);
        else if (string.Equals(key, "Home", StringComparison.Ordinal) && this.IndexesReady)
        {
            this.NavigateFromSource(0.0);
            await this.RefreshAfterNavigationAsync(true);
        }
        else if (string.Equals(key, "End", StringComparison.Ordinal) && this.IndexesReady)
        {
            VideoFrameIndexEntry frame = this._sourceIndex.Frames[this._sourceIndex.FrameCount - 1];
            this.NavigateFromSource(frame.PtsMs - this._sourceIndex.FirstPtsMs);
            await this.RefreshAfterNavigationAsync(true);
        }
        else if (string.Equals(key, "Delete", StringComparison.Ordinal))
            await this.DeleteSelectedOperationAsync();
        else if (string.Equals(key, "Escape", StringComparison.Ordinal))
            await this.CloseAsync();
    }

    private static string GetEventText(ChangeEventArgs args) => args.Value != null ? args.Value.ToString() : "";

    private static EditOperation FindOperation(List<EditOperation> operations, string type, int timestamp, int duration)
    {
        for (int i = 0; i < operations.Count; i++)
        {
            if (string.Equals(operations[i].Type, type, StringComparison.Ordinal) && operations[i].LangTimestampMs == timestamp && operations[i].DurationMs == duration)
                return operations[i];
        }
        return null;
    }

    private static void CopyOperation(EditOperation source, EditOperation destination)
    {
        if (source == null || destination == null)
            return;
        destination.Type = source.Type;
        destination.LangTimestampMs = source.LangTimestampMs;
        destination.DurationMs = source.DurationMs;
        destination.SourceTimestampMs = source.SourceTimestampMs;
        destination.VisualSourceTimestampMs = source.VisualSourceTimestampMs;
        destination.Scope = source.Scope;
    }

    private static bool MapsEqual(EditMap left, EditMap right)
    {
        if (left == null || right == null || left.InitialDelayMs != right.InitialDelayMs || !string.Equals(left.StretchFactor ?? "", right.StretchFactor ?? "", StringComparison.Ordinal) || left.Operations.Count != right.Operations.Count)
            return false;
        for (int i = 0; i < left.Operations.Count; i++)
        {
            EditOperation a = left.Operations[i];
            EditOperation b = right.Operations[i];
            if (!string.Equals(a.Type, b.Type, StringComparison.Ordinal) || a.LangTimestampMs != b.LangTimestampMs || a.DurationMs != b.DurationMs || a.SourceTimestampMs != b.SourceTimestampMs || !string.Equals(a.Scope, b.Scope, StringComparison.Ordinal))
                return false;
        }
        return true;
    }

    private static bool TryParseTimestamp(string text, out double milliseconds)
    {
        milliseconds = 0.0;
        if (string.IsNullOrWhiteSpace(text))
            return false;
        if (!TimeSpan.TryParse(text.Trim(), System.Globalization.CultureInfo.InvariantCulture, out TimeSpan value) || value < TimeSpan.Zero)
            return false;
        milliseconds = value.TotalMilliseconds;
        return double.IsFinite(milliseconds);
    }

    private static string FormatTimestamp(double timestampMs)
    {
        if (!double.IsFinite(timestampMs) || timestampMs < 0.0)
            return "—";
        TimeSpan value = TimeSpan.FromMilliseconds(timestampMs);
        return ((int)value.TotalHours).ToString("00") + ":" + value.Minutes.ToString("00") + ":" + value.Seconds.ToString("00") + "." + value.Milliseconds.ToString("000");
    }

    private static string FormatDuration(int durationMs)
    {
        return durationMs.ToString(System.Globalization.CultureInfo.InvariantCulture) + " ms · " + (durationMs / 1000.0).ToString("0.000", System.Globalization.CultureInfo.InvariantCulture) + " s";
    }

    private async Task CloseAsync()
    {
        if (this._dirty && this._module != null)
        {
            bool confirmed = await this._module.InvokeAsync<bool>("confirmDiscard", AppText.T("web.editMap.discardConfirm"));
            if (!confirmed)
                return;
        }
        this._cancellation.Cancel();
        await this.OnClose.InvokeAsync();
    }

    /// <summary>Cancella indicizzazione e decode ancora in corso</summary>
    public async ValueTask DisposeAsync()
    {
        this._cancellation.Cancel();
        if (this._previewPair != null)
        {
            try { await this._previewPair.InvokeVoidAsync("dispose"); } catch { }
            try { await this._previewPair.DisposeAsync(); } catch { }
        }
        if (this._keyboard != null)
        {
            try { await this._keyboard.InvokeVoidAsync("dispose"); } catch { }
            try { await this._keyboard.DisposeAsync(); } catch { }
        }
        if (this._timeline != null)
        {
            try { await this._timeline.InvokeVoidAsync("dispose"); } catch { }
            try { await this._timeline.DisposeAsync(); } catch { }
        }
        if (this._module != null)
        {
            try { await this._module.DisposeAsync(); } catch { }
        }
        if (this._dotNetReference != null)
            this._dotNetReference.Dispose();
        this._cancellation.Dispose();
    }
}
