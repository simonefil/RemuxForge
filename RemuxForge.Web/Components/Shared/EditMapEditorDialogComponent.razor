    private async Task MutateSelectedOperationAsync(Action<EditOperation> mutation)
    {
        int selectedIndex = this._workingMap.Operations.IndexOf(this._selectedOperation);
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        mutation(this._selectedOperation);
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = selectedIndex >= 0 && selectedIndex < this._workingMap.Operations.Count ? this._workingMap.Operations[selectedIndex] : null;
            this.RollbackOperationField();
            return;
        }

        string type = this._selectedOperation.Type;
        int timestamp = this._selectedOperation.LangTimestampMs;
        int duration = this._selectedOperation.DurationMs;
        this._workingMap = candidate.Map;
        this._projection = candidate;
        this._selectedOperation = FindOperation(this._workingMap.Operations, type, timestamp, duration);
        await this.FinishMapMutationAsync();
    }

    private async Task NormalizeWorkingMapAsync(EditOperation selected)
    {
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap.Operations.Remove(selected);
            this.RebuildProjection();
            this.WarnInvalidValue();
            return;
        }
        this._workingMap = candidate.Map;
        this._projection = candidate;
        this._selectedOperation = FindOperation(this._workingMap.Operations, selected.Type, selected.LangTimestampMs, selected.DurationMs);
        await this.FinishMapMutationAsync();
    }

    private async Task FinishMapMutationAsync()
    {
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        if (this._operationGrid != null)
            await this._operationGrid.Reload();
        if (this._selectedOperation != null)
            await this.SelectOperationAsync(this._workingMap.Operations.IndexOf(this._selectedOperation), true);
        else
            await this.UpdateTimelineAsync();
        this.StateHasChanged();
    }

    private int SnapLanguageDuration(int startMs, int requestedDurationMs)
    {
        VideoFrameIndexEntry start = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + startMs);
        VideoFrameIndexEntry end = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + startMs + requestedDurationMs);
        if (start == null || end == null)
            return requestedDurationMs;
        if (end.PresentationIndex <= start.PresentationIndex && start.PresentationIndex + 1 < this._languageIndex.FrameCount)
            end = this._languageIndex.Frames[start.PresentationIndex + 1];
        if (end.PresentationIndex == start.PresentationIndex)
            return Math.Max(1, (int)Math.Round(start.DurationMs));
        return Math.Max(1, (int)Math.Round(end.PtsMs - start.PtsMs));
    }

    private void RollbackOperationField()
    {
        this.WarnInvalidValue();
        this.RefreshOperationFields();
        this.StateHasChanged();
    }

    private void WarnInvalidValue() => this.NotificationService.Notify(NotificationSeverity.Warning, AppText.T("web.editMap.invalidValue"), AppText.T("web.editMap.valueRestored"), 5000);

    private void UpdateDirtyState() => this._dirty = !MapsEqual(this._originalMap, this._workingMap);

    private bool CanApply() => this.IndexesReady && !this.IsBusy && !this._isApplying && this._workingMap.Operations.Count > 0 && this._projection != null && this._projection.Validation.IsValid;

    private async Task ApplyAsync()
    {
        if (!this.CanApply())
            return;
        this._isApplying = true;
        try
        {
            await this.OnApply.InvokeAsync((EditMapTimelineHelper.Clone(this._workingMap), this._sourceIndex.DurationMs, this._languageIndex.DurationMs));
        }
        finally
        {
            this._isApplying = false;
        }
    }

    /// <summary>Sposta il playhead Source dalla timeline JavaScript</summary>
    /// <param name="sourceMs">Timestamp Source relativo</param>
    [JSInvokable]
    public async Task OnTimelineSeek(double sourceMs)
    {
        this.NavigateFromSource(sourceMs);
        await this.InvokeAsync(async () => await this.RefreshAfterNavigationAsync());
    }

    /// <summary>Seleziona una operazione dal marker della timeline</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    [JSInvokable]
    public async Task OnTimelineOperationSelected(int operationIndex)
    {
        await this.InvokeAsync(async () => await this.SelectOperationAsync(operationIndex, false));
    }

    /// <summary>Aggiorna il boundary di una operazione durante o al termine del drag</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    /// <param name="sourceMs">Nuovo boundary Source</param>
    /// <param name="final">True al rilascio del puntatore</param>
    [JSInvokable]
    public async Task OnTimelineOperationDrag(int operationIndex, double sourceMs, bool final)
    {
        if (operationIndex < 0 || operationIndex >= this._workingMap.Operations.Count)
            return;
        if (this._selectedOperation == null)
            this._selectedOperation = this._workingMap.Operations[operationIndex];
        VideoFrameIndexEntry sourceFrame = this._sourceIndex.FindNearestFrame(this._sourceIndex.FirstPtsMs + sourceMs);
        EditMapMappingResult mapping = sourceFrame != null ? this._projection.MapSourceToLanguage(sourceFrame.PtsMs - this._sourceIndex.FirstPtsMs) : null;
        if (mapping == null || !mapping.IsMapped)
            return;
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs);
        int timestamp = Math.Max(0, (int)Math.Round(languageFrame.PtsMs - this._languageIndex.FirstPtsMs));
        string originalType = this._selectedOperation.Type;
        int originalTimestamp = this._selectedOperation.LangTimestampMs;
        int originalDuration = this._selectedOperation.DurationMs;
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        this._selectedOperation.LangTimestampMs = timestamp;
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, originalDuration);
            return;
        }
        string type = this._selectedOperation.Type;
        int duration = this._selectedOperation.DurationMs;
        this._workingMap = candidate.Map;
        this._projection = candidate;
        this._selectedOperation = FindOperation(this._workingMap.Operations, type, timestamp, duration);
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
        await this.InvokeAsync(async () =>
        {
            if (this._operationGrid != null)
                await this._operationGrid.Reload();
            this.StateHasChanged();
            if (final)
            {
                await this.UpdateTimelineAsync();
                await this.RefreshPreviewAsync();
            }
        });
    }

    /// <summary>Aggiorna la durata renderizzata durante o al termine del drag</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    /// <param name="renderedDurationMs">Durata nel dominio Source renderizzato</param>
    /// <param name="final">True al rilascio del puntatore</param>
    [JSInvokable]
    public async Task OnTimelineDurationDrag(int operationIndex, double renderedDurationMs, bool final)
    {
        if (operationIndex < 0 || operationIndex >= this._workingMap.Operations.Count)
            return;
        if (this._selectedOperation == null)
            this._selectedOperation = this._workingMap.Operations[operationIndex];

        string originalType = this._selectedOperation.Type;
        int originalTimestamp = this._selectedOperation.LangTimestampMs;
        int originalDuration = this._selectedOperation.DurationMs;
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        int languageDuration = Math.Max(1, (int)Math.Round(renderedDurationMs / this._projection.StretchRatio));
        this._selectedOperation.DurationMs = this.SnapLanguageDuration(this._selectedOperation.LangTimestampMs, languageDuration);
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.DurationMs, this._languageIndex.DurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, originalDuration);
            return;
        }

        int duration = this._selectedOperation.DurationMs;
        this._workingMap = candidate.Map;
        this._projection = candidate;
        this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, duration);
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
        await this.InvokeAsync(async () =>
        {
            if (this._operationGrid != null)
                await this._operationGrid.Reload();
            this.StateHasChanged();
            if (final)
            {
                await this.UpdateTimelineAsync();
                await this.RefreshPreviewAsync();
            }
        });
    }

    /// <summary>Gestisce le scorciatoie locali dell'editor prima della tastiera globale</summary>
    /// <param name="key">Tasto normalizzato dal browser</param>
    /// <param name="shift">True quando Shift è premuto</param>
    /// <param name="editing">True quando il focus è in un campo editabile</param>
    [JSInvokable]
    public async Task OnEditorKey(string key, bool shift, bool editing)
    {
        if (editing)
        {
            if (string.Equals(key, "Escape", StringComparison.Ordinal))
            {
                this.RefreshNavigationFields();
                this.RefreshOperationFields();
                this.StateHasChanged();
            }
            return;
        }

        if (string.Equals(key, "ArrowLeft", StringComparison.Ordinal))
            await this.StepSourceAsync(shift ? -10 : -1);
        else if (string.Equals(key, "ArrowRight", StringComparison.Ordinal))
            await this.StepSourceAsync(shift ? 10 : 1);
        else if (string.Equals(key, "PageUp", StringComparison.Ordinal))
            await this.SelectAdjacentOperationAsync(-1);
        else if (string.Equals(key, "PageDown", StringComparison.Ordinal))
            await this.SelectAdjacentOperationAsync(1);
        else if (string.Equals(key, "Home", StringComparison.Ordinal) && this.IndexesReady)
        {
            this.NavigateFromSource(0.0);
            await this.RefreshAfterNavigationAsync(true);
        }
        else if (string.Equals(key, "End", StringComparison.Ordinal) && this.IndexesReady)
        {
            VideoFrameIndexEntry frame = this._sourceIndex.Frames[this._sourceIndex.FrameCount - 1];
            this.NavigateFromSource(frame.PtsMs - this._sourceIndex.FirstPtsMs);
            await this.RefreshAfterNavigationAsync(true);
        }
        else if (string.Equals(key, "Delete", StringComparison.Ordinal))
            await this.DeleteSelectedOperationAsync();
        else if (string.Equals(key, "Escape", StringComparison.Ordinal))
            await this.CloseAsync();
    }

    private Task ChangeZoomAsync(double factor) => this._timeline != null ? this._timeline.InvokeVoidAsync("zoomBy", factor).AsTask() : Task.CompletedTask;
    private Task SetZoomAsync(string preset) => this._timeline != null ? this._timeline.InvokeVoidAsync("setZoom", preset).AsTask() : Task.CompletedTask;

    private static string GetEventText(ChangeEventArgs args) => args.Value != null ? args.Value.ToString() : "";

    private static EditOperation FindOperation(List<EditOperation> operations, string type, int timestamp, int duration)
    {
        for (int i = 0; i < operations.Count; i++)
        {
            if (string.Equals(operations[i].Type, type, StringComparison.Ordinal) && operations[i].LangTimestampMs == timestamp && operations[i].DurationMs == duration)
                return operations[i];
        }
        return null;
    }

    private static bool MapsEqual(EditMap left, EditMap right)
    {
        if (left == null || right == null || left.InitialDelayMs != right.InitialDelayMs || !string.Equals(left.StretchFactor ?? "", right.StretchFactor ?? "", StringComparison.Ordinal) || left.Operations.Count != right.Operations.Count)
            return false;
        for (int i = 0; i < left.Operations.Count; i++)
        {
            EditOperation a = left.Operations[i];
            EditOperation b = right.Operations[i];
            if (!string.Equals(a.Type, b.Type, StringComparison.Ordinal) || a.LangTimestampMs != b.LangTimestampMs || a.DurationMs != b.DurationMs || a.SourceTimestampMs != b.SourceTimestampMs || !string.Equals(a.Scope, b.Scope, StringComparison.Ordinal))
                return false;
        }
        return true;
    }

    private static bool TryParseTimestamp(string text, out double milliseconds)
    {
        milliseconds = 0.0;
        if (string.IsNullOrWhiteSpace(text))
            return false;
        if (!TimeSpan.TryParse(text.Trim(), System.Globalization.CultureInfo.InvariantCulture, out TimeSpan value) || value < TimeSpan.Zero)
            return false;
        milliseconds = value.TotalMilliseconds;
        return double.IsFinite(milliseconds);
    }

    private static string FormatTimestamp(double timestampMs)
    {
        if (!double.IsFinite(timestampMs) || timestampMs < 0.0)
            return "—";
        TimeSpan value = TimeSpan.FromMilliseconds(timestampMs);
        return ((int)value.TotalHours).ToString("00") + ":" + value.Minutes.ToString("00") + ":" + value.Seconds.ToString("00") + "." + value.Milliseconds.ToString("000");
    }

    private static string FormatDuration(int durationMs)
    {
        return durationMs.ToString(System.Globalization.CultureInfo.InvariantCulture) + " ms · " + (durationMs / 1000.0).ToString("0.000", System.Globalization.CultureInfo.InvariantCulture) + " s";
    }

    private async Task CloseAsync()
    {
        if (this._dirty && this._module != null)
        {
            bool confirmed = await this._module.InvokeAsync<bool>("confirmDiscard", AppText.T("web.editMap.discardConfirm"));
            if (!confirmed)
                return;
        }
        this._cancellation.Cancel();
        await this.OnClose.InvokeAsync();
    }

    /// <summary>Cancella indicizzazione e decode ancora in corso</summary>
    public async ValueTask DisposeAsync()
    {
        this._cancellation.Cancel();
        if (this._previewPair != null)
        {
            try { await this._previewPair.InvokeVoidAsync("dispose"); } catch { }
            try { await this._previewPair.DisposeAsync(); } catch { }
        }
        if (this._keyboard != null)
        {
            try { await this._keyboard.InvokeVoidAsync("dispose"); } catch { }
            try { await this._keyboard.DisposeAsync(); } catch { }
        }
        if (this._timeline != null)
        {
            try { await this._timeline.InvokeVoidAsync("dispose"); } catch { }
            try { await this._timeline.DisposeAsync(); } catch { }
        }
        if (this._module != null)
        {
            try { await this._module.DisposeAsync(); } catch { }
        }
        if (this._dotNetReference != null)
            this._dotNetReference.Dispose();
        this._cancellation.Dispose();
    }
}
