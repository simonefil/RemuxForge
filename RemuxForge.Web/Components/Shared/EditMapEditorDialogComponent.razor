    private async Task CommitOperationSourceAsync()
    {
        if (this._selectedOperation == null || !TryParseTimestamp(this._operationSourceText, out double ptsMs))
        {
            this.RollbackOperationField();
            return;
        }
        VideoFrameIndexEntry sourceFrame = this._sourceIndex.FindNearestFrame(ptsMs);
        EditMapMappingResult mapping = sourceFrame != null ? this._projection.MapSourceToLanguage(sourceFrame.PtsMs - this._sourceIndex.FirstPtsMs) : null;
        if (sourceFrame == null || mapping == null || !mapping.IsMapped)
        {
            this.RollbackOperationField();
            return;
        }
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs);
        await this.MutateSelectedOperationAsync(operation => operation.LangTimestampMs = Math.Max(0, (int)Math.Round(languageFrame.PtsMs - this._languageIndex.FirstPtsMs)));
    }

