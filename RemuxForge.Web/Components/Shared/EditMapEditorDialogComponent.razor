    private async Task SelectOperationAsync(int index, bool center)
    {
        if (index < 0 || index >= this._workingMap.Operations.Count)
            return;
        this._selectedOperation = this._workingMap.Operations[index];
        this.RefreshOperationFields();
        if (string.Equals(this._selectedOperation.Type, EditOperation.CUT_SEGMENT, StringComparison.Ordinal))
            this.NavigateFromLanguage(Math.Min(this._languageIndex.DurationMs, this._selectedOperation.LangTimestampMs + this._selectedOperation.DurationMs));
        else
        {
            this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
            this._languageFrame = null;
            this._languagePreviewMessage = AppText.T("web.editMap.noLanguageFrame");
            this.RefreshNavigationFields();
        }
        if (this._operationGrid != null)
            await this._operationGrid.Reload();
        await this.RefreshAfterNavigationAsync(center);
    }

    private async Task SelectAdjacentOperationAsync(int direction)
    {
        int index = this._selectedOperation != null ? this._workingMap.Operations.IndexOf(this._selectedOperation) : direction > 0 ? -1 : this._workingMap.Operations.Count;
        index = Math.Max(0, Math.Min(this._workingMap.Operations.Count - 1, index + direction));
        await this.SelectOperationAsync(index, true);
    }

    private bool CanCreateOperation()
    {
        if (!this.IndexesReady || this._projection == null)
            return false;
        return this._projection.MapSourceToLanguage(this._sourcePlayheadMs).IsMapped;
    }

    private async Task AddOperationAsync(string type)
    {
        EditMapMappingResult mapping = this._projection.MapSourceToLanguage(this._sourcePlayheadMs);
        if (!mapping.IsMapped)
            return;
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindContainingFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs) ?? this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + mapping.LanguageTimestampMs);
        if (languageFrame == null)
            return;
        EditOperation operation = new EditOperation
        {
            Type = type,
            LangTimestampMs = Math.Max(0, (int)Math.Round(languageFrame.PtsMs - this._languageIndex.FirstPtsMs)),
            DurationMs = Math.Max(1, (int)Math.Round(languageFrame.DurationMs)),
            SourceTimestampMs = Math.Max(0, (int)Math.Round(this._sourcePlayheadMs)),
            VisualSourceTimestampMs = Math.Max(0, (int)Math.Round(this._sourcePlayheadMs)),
            Scope = EditOperation.SCOPE_BODY
        };
        this._workingMap.Operations.Add(operation);
        this._focusDurationAfterRender = true;
        await this.NormalizeWorkingMapAsync(operation);
    }

    private async Task DeleteSelectedOperationAsync()
    {
        if (this._selectedOperation == null)
            return;
        this._workingMap.Operations.Remove(this._selectedOperation);
        this._selectedOperation = null;
        this.RebuildProjection();
        this._workingMap = this._projection.Map;
        this.UpdateDirtyState();
        this.NavigateFromSource(this._sourcePlayheadMs);
        if (this._operationGrid != null)
            await this._operationGrid.Reload();
        await this.RefreshAfterNavigationAsync();
    }

    private void RefreshOperationFields()
    {
        if (this._selectedOperation == null)
            return;
        this._operationSourceText = FormatTimestamp(this._sourceIndex.FirstPtsMs + this._selectedOperation.SourceTimestampMs);
        this._operationLanguageText = FormatTimestamp(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs);
        this._operationLanguageDurationText = this._selectedOperation.DurationMs.ToString();
        this._operationRenderedDurationText = EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(this._selectedOperation.DurationMs, this._projection.StretchRatio).ToString();
        VideoFrameIndexEntry sourceFrame = this._sourceIndex.FindNearestFrame(this._sourceIndex.FirstPtsMs + this._selectedOperation.SourceTimestampMs);
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs);
        this._operationSourceFrameText = sourceFrame != null ? (sourceFrame.PresentationIndex + 1).ToString() : "";
        this._operationLanguageFrameText = languageFrame != null ? (languageFrame.PresentationIndex + 1).ToString() : "";
        this.RefreshCutInspectionFields();
    }

    private bool IsSelectedCut() => this._selectedOperation != null && string.Equals(this._selectedOperation.Type, EditOperation.CUT_SEGMENT, StringComparison.Ordinal);

    private int GetRenderedDurationMs(EditOperation operation) => EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(operation.DurationMs, this._projection != null ? this._projection.StretchRatio : 1.0);

    private void RefreshCutInspectionFields()
    {
        this._cutBeforeFrameText = "";
        this._cutFirstRemovedFrameText = "";
        this._cutLastRemovedFrameText = "";
        this._cutResumeFrameText = "";
        if (!this.IsSelectedCut())
            return;

        VideoFrameIndexEntry first = this._languageIndex.FindContainingFrame(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs) ?? this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs);
        VideoFrameIndexEntry resume = this._languageIndex.FindContainingFrame(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs + this._selectedOperation.DurationMs) ?? this._languageIndex.FindNearestFrame(this._languageIndex.FirstPtsMs + this._selectedOperation.LangTimestampMs + this._selectedOperation.DurationMs);
        if (first == null || resume == null)
            return;

        int beforeIndex = first.PresentationIndex - 1;
        int lastIndex = Math.Max(first.PresentationIndex, resume.PresentationIndex - 1);
        this._cutBeforeFrameText = beforeIndex >= 0 ? (beforeIndex + 1).ToString() : "—";
        this._cutFirstRemovedFrameText = (first.PresentationIndex + 1).ToString();
        this._cutLastRemovedFrameText = (lastIndex + 1).ToString();
        this._cutResumeFrameText = (resume.PresentationIndex + 1).ToString();
    }

    private string GetSelectedIssueSummary()
    {
        if (this._selectedOperation == null || this._projection == null)
            return "";
        int operationIndex = this._workingMap.Operations.IndexOf(this._selectedOperation);
        List<string> messages = new List<string>();
        for (int i = 0; i < this._projection.Validation.Errors.Count; i++)
        {
            EditMapValidationIssue issue = this._projection.Validation.Errors[i];
            if (issue.OperationIndex == operationIndex)
                messages.Add(AppText.T("web.editMap.issue." + issue.Code));
        }
        for (int i = 0; i < this._projection.Validation.Warnings.Count; i++)
        {
            EditMapValidationIssue issue = this._projection.Validation.Warnings[i];
            if (issue.OperationIndex == operationIndex)
                messages.Add(AppText.T("web.editMap.issue." + issue.Code));
        }
        return string.Join(" · ", messages);
    }

