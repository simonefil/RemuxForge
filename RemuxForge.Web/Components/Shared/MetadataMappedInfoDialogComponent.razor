<div class="dialog-overlay visible" @onclick="OnClose">
    <div class="dialog-box dialog-fullscreen metadata-mapped-dialog-box" @onclick:stopPropagation="true">
        <div class="dialog-title">@GetTitle()</div>
        <div class="dialog-body metadata-mapped-dialog-body @(Editable ? "metadata-mapped-dialog-body-editable" : "")">
            <div class="metadata-mapped-content">
                @if (Record == null)
                {
                    <div class="empty-detail">@AppText.T("web.dashboard.noFileSelected")</div>
                }
                else
                {
                    MkvMetadataFileInfo info = GetInfo();
                    List<MkvMetadataTrackInfo> videoTracks = GetTracksByKind("video");
                    List<MkvMetadataTrackInfo> audioTracks = GetTracksByKind("audio");
                    List<MkvMetadataTrackInfo> textTracks = GetTracksByKind("subtitles");

                    <div class="metadata-sheet-stack">
                        <div class="metadata-sheet-selectors">
                            <div class="metadata-sheet-selector-row">
                                <span class="metadata-sheet-selector-label">@AppText.T("web.metadata.mapped.containerStream")</span>
                                <select class="form-input metadata-sheet-select" value="@CONTAINER_SELECTOR" @onfocus="ActivateContainerTags" @onchange="ChangeContainerSelection">
                                    <option value="@CONTAINER_SELECTOR">@BuildContainerOptionLabel(info)</option>
                                </select>
                            </div>

                            @if (videoTracks.Count > 0)
                            {
                                <div class="metadata-sheet-selector-row">
                                    <span class="metadata-sheet-selector-label">@AppText.T("web.metadata.mapped.videoStream")</span>
                                    <select class="form-input metadata-sheet-select" value="@_selectedVideoSelector" @onfocus="ActivateVideoTags" @onchange="ChangeVideoSelection">
                                        @for (int i = 0; i < videoTracks.Count; i++)
                                        {
                                            MkvMetadataTrackInfo track = videoTracks[i];
                                            <option value="@GetSheetTrackSelector(track)">@BuildTrackOptionLabel(track)</option>
                                        }
                                    </select>
                                </div>
                            }

                            @if (audioTracks.Count > 0)
                            {
                                <div class="metadata-sheet-selector-row">
                                    <span class="metadata-sheet-selector-label">@AppText.T("web.metadata.mapped.audioStream")</span>
                                    <select class="form-input metadata-sheet-select" value="@_selectedAudioSelector" @onfocus="ActivateAudioTags" @onchange="ChangeAudioSelection">
                                        @for (int i = 0; i < audioTracks.Count; i++)
                                        {
                                            MkvMetadataTrackInfo track = audioTracks[i];
                                            <option value="@GetSheetTrackSelector(track)">@BuildTrackOptionLabel(track)</option>
                                        }
                                    </select>
                                </div>
                            }

                            @if (textTracks.Count > 0)
                            {
                                <div class="metadata-sheet-selector-row">
                                    <span class="metadata-sheet-selector-label">@AppText.T("web.metadata.mapped.textStream")</span>
                                    <select class="form-input metadata-sheet-select" value="@_selectedTextSelector" @onfocus="ActivateTextTags" @onchange="ChangeTextSelection">
                                        @for (int i = 0; i < textTracks.Count; i++)
                                        {
                                            MkvMetadataTrackInfo track = textTracks[i];
                                            <option value="@GetSheetTrackSelector(track)">@BuildTrackOptionLabel(track)</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <div class="metadata-sheet-block">
                            <div class="metadata-sheet-section-title">@AppText.T("web.metadata.mapped.fields") - @GetActiveTagContextLabel()</div>
                            @FieldSheet(GetActiveMetadataRows(), AppText.T("web.metadata.mapped.noFields"))
                        </div>

                        <div class="metadata-sheet-block">
                            <div class="metadata-sheet-section-title">@AppText.T("web.metadata.mapped.tags") - @GetActiveTagContextLabel()</div>
                            @FieldSheet(GetActiveTagRows(), AppText.T("web.metadata.mapped.noTags"))
                        </div>
                    </div>
                }
            </div>

            @if (Simulated && !Editable)
            {
                <div class="metadata-mapped-helper">
                    <div class="config-help-title">@_helpTitle</div>
                    <div class="config-help-text">@_helpText</div>
                </div>
            }
        </div>
        <div class="dialog-footer">
            @if (Editable)
            {
                <span class="metadata-manual-message">@_editMessage</span>
                <button @onclick="ApplyManualEdit">@AppText.T("web.metadata.manualEdit.apply")</button>
            }
            <button @onclick="OnClose">@AppText.T("web.common.close")</button>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Selettore sintetico per i metadata container
    /// </summary>
    private const string CONTAINER_SELECTOR = "container";

    /// <summary>
    /// Record metadata visualizzato
    /// </summary>
    [Parameter] public MkvMetadataRecord Record { get; set; }

    /// <summary>
    /// Indica se mostrare il risultato simulato
    /// </summary>
    [Parameter] public bool Simulated { get; set; }

    /// <summary>
    /// Indica se abilitare la modifica manuale
    /// </summary>
    [Parameter] public bool Editable { get; set; }

    /// <summary>
    /// Evento chiusura dialog
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Evento applicazione modifiche manuali
    /// </summary>
    [Parameter] public EventCallback<List<MkvMetadataChange>> OnApply { get; set; }

    /// <summary>
    /// Titolo helper contestuale
    /// </summary>
    private string _helpTitle = "";

    /// <summary>
    /// Testo helper contestuale
    /// </summary>
    private string _helpText = "";

    /// <summary>
    /// File del record in editing manuale
    /// </summary>
    private string _editRecordPath = "";

    /// <summary>
    /// Messaggio stato editing manuale
    /// </summary>
    private string _editMessage = "";

    /// <summary>
    /// Selettore traccia video selezionata
    /// </summary>
    private string _selectedVideoSelector = "";

    /// <summary>
    /// Selettore traccia audio selezionata
    /// </summary>
    private string _selectedAudioSelector = "";

    /// <summary>
    /// Selettore traccia sottotitoli selezionata
    /// </summary>
    private string _selectedTextSelector = "";

    /// <summary>
    /// Selettore contesto tag attivo
    /// </summary>
    private string _activeTagSelector = CONTAINER_SELECTOR;

    /// <summary>
    /// Valori modificati manualmente indicizzati per riga
    /// </summary>
    private Dictionary<string, string> _editValues = new Dictionary<string, string>();

    /// <summary>
    /// Aggiorna stato derivato dai parametri
    /// </summary>
    protected override void OnParametersSet()
    {
        this._helpTitle = AppText.T("web.metadata.mapped.helperTitle");
        this._helpText = AppText.T("web.metadata.mapped.helperText");
        this.EnsureManualEditState();
        this.EnsureSelections();
    }

    /// <summary>
    /// Restituisce titolo dialog in base alla modalità
    /// </summary>
    /// <returns>Titolo localizzato</returns>
    private string GetTitle()
    {
        string fileName = this.Record != null ? System.IO.Path.GetFileName(this.Record.InputFile) : "";
        if (this.Editable)
        {
            return AppText.F("web.metadata.manualEdit.title", fileName);
        }

        return this.Simulated
            ? AppText.F("web.metadata.mapped.simulatedTitle", fileName)
            : AppText.F("web.metadata.mapped.currentTitle", fileName);
    }

    /// <summary>
    /// Allinea lo stato di editing al record corrente
    /// </summary>
    private void EnsureManualEditState()
    {
        string recordPath = this.Record != null ? this.Record.InputFile : "";
        if (!this.Editable)
        {
            this._editValues.Clear();
            this._editRecordPath = "";
            this._editMessage = "";
            return;
        }

        if (this._editRecordPath == recordPath)
        {
            return;
        }

        this._editValues.Clear();
        this._editRecordPath = recordPath;
        this._editMessage = "";
    }

    /// <summary>
    /// Restituisce il file info da mostrare
    /// </summary>
    /// <returns>File info corrente o simulato</returns>
    private MkvMetadataFileInfo GetInfo()
    {
        if (this.Record == null)
        {
            return new MkvMetadataFileInfo();
        }

        if (this.Simulated)
        {
            return this.Record.FileInfo != null ? this.Record.FileInfo : new MkvMetadataFileInfo();
        }

        return this.Record.OriginalFileInfo != null && this.Record.OriginalFileInfo.Tracks != null && this.Record.OriginalFileInfo.Tracks.Count > 0
            ? this.Record.OriginalFileInfo
            : this.Record.FileInfo != null ? this.Record.FileInfo : new MkvMetadataFileInfo();
    }

    /// <summary>
    /// Restituisce il file info originale
    /// </summary>
    /// <returns>File info prima della simulazione</returns>
    private MkvMetadataFileInfo GetBeforeInfo()
    {
        if (this.Record == null)
        {
            return new MkvMetadataFileInfo();
        }

        return this.Record.OriginalFileInfo != null ? this.Record.OriginalFileInfo : new MkvMetadataFileInfo();
    }

    /// <summary>
    /// Garantisce selezioni traccia e contesto tag valide
    /// </summary>
    private void EnsureSelections()
    {
        this.EnsureTrackSelection(ref this._selectedVideoSelector, "video");
        this.EnsureTrackSelection(ref this._selectedAudioSelector, "audio");
        this.EnsureTrackSelection(ref this._selectedTextSelector, "subtitles");

        if (!this.IsActiveTagSelectorValid(this._activeTagSelector))
        {
            this._activeTagSelector = CONTAINER_SELECTOR;
        }
    }

    /// <summary>
    /// Garantisce selezione valida per un tipo traccia
    /// </summary>
    /// <param name="selector">Selettore da validare</param>
    /// <param name="trackKind">Tipo traccia</param>
    private void EnsureTrackSelection(ref string selector, string trackKind)
    {
        if (!string.IsNullOrEmpty(selector) && this.FindTrackBySelector(selector) != null)
        {
            return;
        }

        List<MkvMetadataTrackInfo> tracks = this.GetTracksByKind(trackKind);
        selector = tracks.Count > 0 ? GetSheetTrackSelector(tracks[0]) : "";
    }

    /// <summary>
    /// Verifica se il selettore tag attivo è valido
    /// </summary>
    /// <param name="selector">Selettore da verificare</param>
    /// <returns>True se valido</returns>
    private bool IsActiveTagSelectorValid(string selector)
    {
        if (selector == CONTAINER_SELECTOR)
        {
            return true;
        }

        return !string.IsNullOrEmpty(selector) && this.FindTrackBySelector(selector) != null;
    }

    /// <summary>
    /// Restituisce tracce del tipo richiesto
    /// </summary>
    /// <param name="trackKind">Tipo traccia</param>
    /// <returns>Tracce ordinate</returns>
    private List<MkvMetadataTrackInfo> GetTracksByKind(string trackKind)
    {
        List<MkvMetadataTrackInfo> result = new List<MkvMetadataTrackInfo>();
        MkvMetadataFileInfo info = this.GetInfo();
        MkvMetadataFileInfo before = this.GetBeforeInfo();

        this.AddTracksByKind(result, info.Tracks, trackKind);
        if (this.Simulated)
        {
            this.AddTracksByKind(result, before.Tracks, trackKind);
        }

        result.Sort(CompareTracks);
        return result;
    }

    /// <summary>
    /// Aggiunge tracce non duplicate per tipo
    /// </summary>
    /// <param name="result">Lista destinazione</param>
    /// <param name="tracks">Tracce sorgente</param>
    /// <param name="trackKind">Tipo traccia</param>
    private void AddTracksByKind(List<MkvMetadataTrackInfo> result, List<MkvMetadataTrackInfo> tracks, string trackKind)
    {
        if (tracks == null)
        {
            return;
        }

        for (int i = 0; i < tracks.Count; i++)
        {
            MkvMetadataTrackInfo track = tracks[i];
            if (track == null || track.TrackKind != trackKind || this.ContainsTrack(result, GetSheetTrackSelector(track)))
            {
                continue;
            }

            result.Add(track);
        }
    }

    /// <summary>
    /// Verifica se una traccia è già presente
    /// </summary>
    /// <param name="tracks">Tracce correnti</param>
    /// <param name="selector">Selettore traccia</param>
    /// <returns>True se presente</returns>
    private bool ContainsTrack(List<MkvMetadataTrackInfo> tracks, string selector)
    {
        for (int i = 0; i < tracks.Count; i++)
        {
            if (GetSheetTrackSelector(tracks[i]) == selector)
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Confronta due tracce per indice e ordine stream
    /// </summary>
    /// <param name="left">Traccia sinistra</param>
    /// <param name="right">Traccia destra</param>
    /// <returns>Risultato confronto</returns>
    private static int CompareTracks(MkvMetadataTrackInfo left, MkvMetadataTrackInfo right)
    {
        int leftIndex = left != null ? left.TypeIndex : 0;
        int rightIndex = right != null ? right.TypeIndex : 0;
        if (leftIndex > 0 && rightIndex > 0 && leftIndex != rightIndex)
        {
            return leftIndex.CompareTo(rightIndex);
        }

        int leftOrder = left != null ? left.StreamOrder : 0;
        int rightOrder = right != null ? right.StreamOrder : 0;
        return leftOrder.CompareTo(rightOrder);
    }

    /// <summary>
    /// Costruisce righe metadata container
    /// </summary>
    /// <returns>Righe sheet container</returns>
    private List<MetadataMappedSheetRow> GetContainerRows()
    {
        List<MetadataMappedSheetRow> rows = new List<MetadataMappedSheetRow>();
        if (!this.Editable)
        {
            this.AddFieldRows(rows, null, MetadataFieldSector.File);
        }

        this.AddFieldRows(rows, null, MetadataFieldSector.Container);
        return rows;
    }

    /// <summary>
    /// Costruisce righe metadata per una traccia
    /// </summary>
    /// <param name="track">Traccia sorgente</param>
    /// <returns>Righe sheet traccia</returns>
    private List<MetadataMappedSheetRow> GetTrackRows(MkvMetadataTrackInfo track)
    {
        List<MetadataMappedSheetRow> rows = new List<MetadataMappedSheetRow>();
        if (track == null)
        {
            return rows;
        }

        if (track.TrackKind == "video")
        {
            this.AddFieldRows(rows, track, MetadataFieldSector.Video);
        }
        else if (track.TrackKind == "audio")
        {
            this.AddFieldRows(rows, track, MetadataFieldSector.Audio);
        }
        else if (track.TrackKind == "subtitles")
        {
            this.AddFieldRows(rows, track, MetadataFieldSector.Subtitle);
        }

        return rows;
    }

    /// <summary>
    /// Restituisce righe tag del contesto attivo
    /// </summary>
    /// <returns>Righe tag attive</returns>
    private List<MetadataMappedSheetRow> GetActiveTagRows()
    {
        MkvMetadataTrackInfo track = this._activeTagSelector == CONTAINER_SELECTOR ? null : this.FindTrackBySelector(this._activeTagSelector);
        return this.GetTagRows(track);
    }

    /// <summary>
    /// Restituisce righe metadata del contesto attivo
    /// </summary>
    /// <returns>Righe metadata attive</returns>
    private List<MetadataMappedSheetRow> GetActiveMetadataRows()
    {
        if (this._activeTagSelector == CONTAINER_SELECTOR)
        {
            return this.GetContainerRows();
        }

        return this.GetTrackRows(this.FindTrackBySelector(this._activeTagSelector));
    }

    /// <summary>
    /// Costruisce righe tag per container o traccia
    /// </summary>
    /// <param name="track">Traccia sorgente o null per container</param>
    /// <returns>Righe tag</returns>
    private List<MetadataMappedSheetRow> GetTagRows(MkvMetadataTrackInfo track)
    {
        List<MetadataMappedSheetRow> rows = new List<MetadataMappedSheetRow>();
        List<string> tags = this.Editable ? MetadataTagRegistry.GetEditableTagNames() : this.GetTagKeys(track);
        for (int i = 0; i < tags.Count; i++)
        {
            rows.Add(this.CreateTagRow(track, tags[i]));
        }

        return rows;
    }

    /// <summary>
    /// Aggiunge righe campo filtrate per settore
    /// </summary>
    /// <param name="rows">Lista destinazione</param>
    /// <param name="track">Traccia sorgente o null per container</param>
    /// <param name="sector">Settore campi</param>
    private void AddFieldRows(List<MetadataMappedSheetRow> rows, MkvMetadataTrackInfo track, MetadataFieldSector sector)
    {
        List<MetadataFieldDefinition> fields = this.Editable ? MetadataFieldRegistry.GetEditable(GetScopeFromSector(sector), true) : MetadataFieldRegistry.GetAll();
        for (int i = 0; i < fields.Count; i++)
        {
            MetadataFieldDefinition field = fields[i];
            if (!field.IsReadable || field.Sector != sector)
            {
                continue;
            }

            rows.Add(this.CreateFieldRow(track, field));
        }
    }

    /// <summary>
    /// Crea una riga campo metadata
    /// </summary>
    /// <param name="track">Traccia sorgente o null per container</param>
    /// <param name="field">Definizione campo</param>
    /// <returns>Riga sheet</returns>
    private MetadataMappedSheetRow CreateFieldRow(MkvMetadataTrackInfo track, MetadataFieldDefinition field)
    {
        MetadataMappedSheetRow row = new MetadataMappedSheetRow();
        row.Token = "[" + field.Key + "]";
        row.Label = field.Label;
        row.FieldKey = field.Key;
        row.Track = track;
        row.IsTag = false;
        row.FieldDefinition = field;
        return row;
    }

    /// <summary>
    /// Crea una riga tag metadata
    /// </summary>
    /// <param name="track">Traccia sorgente o null per container</param>
    /// <param name="tagKey">Chiave tag</param>
    /// <returns>Riga sheet</returns>
    private MetadataMappedSheetRow CreateTagRow(MkvMetadataTrackInfo track, string tagKey)
    {
        MetadataMappedSheetRow row = new MetadataMappedSheetRow();
        row.Token = "[tag:" + tagKey + "]";
        row.Label = AppText.F("web.metadata.mapped.tagLabel", tagKey);
        row.FieldKey = tagKey;
        row.Track = track;
        row.IsTag = true;
        return row;
    }

    /// <summary>
    /// Renderizza una sheet metadata
    /// </summary>
    /// <param name="rows">Righe da renderizzare</param>
    /// <param name="emptyText">Testo per lista vuota</param>
    /// <returns>Markup sheet</returns>
    private RenderFragment FieldSheet(List<MetadataMappedSheetRow> rows, string emptyText)
    {
        List<MetadataMappedSheetDisplayRow> displayRows = this.BuildDisplayRows(rows);

        return @<div class="metadata-sheet-table-wrap">
            @if (displayRows.Count == 0)
            {
                <div class="metadata-sheet-empty">@emptyText</div>
            }
            else
            {
                <table class="metadata-mapped-sheet-table">
                    @if (this.Editable)
                    {
                        <colgroup>
                            <col class="metadata-manual-field-col" />
                            <col class="metadata-manual-token-col" />
                            <col class="metadata-manual-separator-col" />
                            <col class="metadata-manual-current-col" />
                            <col class="metadata-manual-new-col" />
                        </colgroup>
                    }
                    <tbody>
                        @if (this.Editable)
                        {
                            <tr class="metadata-manual-header-row">
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="metadata-manual-header-cell">@AppText.T("web.metadata.manualEdit.current")</td>
                                <td class="metadata-manual-header-cell">@AppText.T("web.metadata.manualEdit.newValue")</td>
                            </tr>
                        }
                        @for (int r = 0; r < displayRows.Count; r++)
                        {
                            MetadataMappedSheetRow row = displayRows[r].Row;
                            MetadataMappedSheetCell cell = displayRows[r].Cell;
                            <tr class="@cell.RowCssClass">
                                <td class="metadata-sheet-field-cell">@row.Label</td>
                                <td class="metadata-sheet-token-cell">@row.Token</td>
                                <td class="metadata-sheet-separator">:</td>
                                @if (this.Editable)
                                {
                                    <td class="metadata-sheet-value-cell metadata-manual-current-cell">@FormatSheetValue(cell)</td>
                                    <td class="metadata-manual-edit-cell">@ManualEditInput(row, cell)</td>
                                }
                                else
                                {
                                    <td class="metadata-sheet-value-cell @cell.CssClass" @onmouseenter="@(() => SetCellHelp(cell))">@FormatSheetValue(cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>;
    }

    /// <summary>
    /// Costruisce righe visualizzabili filtrando valori vuoti
    /// </summary>
    /// <param name="rows">Righe sorgente</param>
    /// <returns>Righe con cella calcolata</returns>
    private List<MetadataMappedSheetDisplayRow> BuildDisplayRows(List<MetadataMappedSheetRow> rows)
    {
        List<MetadataMappedSheetDisplayRow> result = new List<MetadataMappedSheetDisplayRow>();
        if (rows == null)
        {
            return result;
        }

        for (int i = 0; i < rows.Count; i++)
        {
            MetadataMappedSheetCell cell = this.BuildCell(rows[i]);
            if (!this.ShouldDisplayCell(cell))
            {
                continue;
            }

            MetadataMappedSheetDisplayRow displayRow = new MetadataMappedSheetDisplayRow();
            displayRow.Row = rows[i];
            displayRow.Cell = cell;
            result.Add(displayRow);
        }

        return result;
    }

    /// <summary>
    /// Verifica se una cella deve essere mostrata
    /// </summary>
    /// <param name="cell">Cella calcolata</param>
    /// <returns>True se visualizzabile</returns>
    private bool ShouldDisplayCell(MetadataMappedSheetCell cell)
    {
        if (cell == null)
        {
            return false;
        }

        if (this.Editable)
        {
            return true;
        }

        if (!string.IsNullOrEmpty(cell.Value))
        {
            return true;
        }

        return this.Simulated && cell.HasFieldChange;
    }

    /// <summary>
    /// Renderizza input per editing manuale
    /// </summary>
    /// <param name="row">Riga sheet</param>
    /// <param name="cell">Cella corrente</param>
    /// <returns>Markup input</returns>
    private RenderFragment ManualEditInput(MetadataMappedSheetRow row, MetadataMappedSheetCell cell)
    {
        MetadataFieldValueType valueType = row.FieldDefinition != null ? row.FieldDefinition.ValueType : MetadataFieldValueType.String;
        string cssClass = "form-input metadata-manual-input" + (IsManualValueChanged(row, cell) ? " metadata-manual-input-changed" : "");
        string value = this.GetManualEditValue(row, cell);
        string inputType = valueType == MetadataFieldValueType.Integer || valueType == MetadataFieldValueType.Decimal ? "number" : "text";
        string inputStep = valueType == MetadataFieldValueType.Decimal ? "any" : valueType == MetadataFieldValueType.Integer ? "1" : "";

        if (!row.IsTag && valueType == MetadataFieldValueType.Boolean)
        {
            return @<select class="@cssClass" value="@value" @onchange="@((ChangeEventArgs args) => ChangeManualEditValue(row, args))">
                <option value=""></option>
                <option value="true">true</option>
                <option value="false">false</option>
            </select>;
        }

        return @<input class="@cssClass" type="@inputType" step="@inputStep" value="@value" @onchange="@((ChangeEventArgs args) => ChangeManualEditValue(row, args))" />;
    }

    /// <summary>
    /// Restituisce valore manuale corrente
    /// </summary>
    /// <param name="row">Riga sheet</param>
    /// <param name="cell">Cella corrente</param>
    /// <returns>Valore manuale o valore corrente</returns>
    private string GetManualEditValue(MetadataMappedSheetRow row, MetadataMappedSheetCell cell)
    {
        string key = BuildEditKey(row);
        string value;

        if (this._editValues.TryGetValue(key, out value))
        {
            return value != null ? value : "";
        }

        return cell != null && cell.Value != null ? cell.Value : "";
    }

    /// <summary>
    /// Aggiorna un valore manuale
    /// </summary>
    /// <param name="row">Riga sheet</param>
    /// <param name="args">Argomenti change</param>
    private void ChangeManualEditValue(MetadataMappedSheetRow row, ChangeEventArgs args)
    {
        this._editValues[BuildEditKey(row)] = args.Value != null ? args.Value.ToString() : "";
        this._editMessage = "";
    }

    /// <summary>
    /// Verifica se il valore manuale differisce da quello corrente
    /// </summary>
    /// <param name="row">Riga sheet</param>
    /// <param name="cell">Cella corrente</param>
    /// <returns>True se modificato</returns>
    private bool IsManualValueChanged(MetadataMappedSheetRow row, MetadataMappedSheetCell cell)
    {
        return !string.Equals(this.GetManualEditValue(row, cell), cell != null && cell.Value != null ? cell.Value : "", StringComparison.Ordinal);
    }

    /// <summary>
    /// Applica modifiche manuali validate
    /// </summary>
    private async System.Threading.Tasks.Task ApplyManualEdit()
    {
        List<MkvMetadataChange> changes = this.BuildManualChanges();
        if (changes.Count == 0)
        {
            if (string.IsNullOrEmpty(this._editMessage))
            {
                this._editMessage = AppText.T("web.metadata.manualEdit.noChanges");
            }

            return;
        }

        await this.OnApply.InvokeAsync(changes);
    }

    /// <summary>
    /// Costruisce le modifiche manuali da applicare
    /// </summary>
    /// <returns>Lista modifiche metadata</returns>
    private List<MkvMetadataChange> BuildManualChanges()
    {
        List<MkvMetadataChange> changes = new List<MkvMetadataChange>();

        foreach (KeyValuePair<string, string> pair in this._editValues)
        {
            string selector;
            string rowType;
            string fieldKey;
            MkvMetadataTrackInfo track;
            string before;
            string after = pair.Value != null ? pair.Value : "";

            if (!TryParseEditKey(pair.Key, out selector, out rowType, out fieldKey))
            {
                continue;
            }

            track = !string.IsNullOrEmpty(selector) ? this.FindTrackBySelector(selector) : null;
            before = this.GetCurrentValueFromEditKey(pair.Key);
            if (string.Equals(before, after, StringComparison.Ordinal))
            {
                continue;
            }

            MkvMetadataChange change = new MkvMetadataChange();
            change.RuleDescription = AppText.T("web.metadata.manualEdit.ruleDescription");
            change.TrackSelector = selector;
            change.TrackKind = track != null ? track.TrackKind : "";
            change.TrackUniqueId = track != null ? track.TrackUniqueId : "";
            change.FieldKey = fieldKey;
            change.BeforeValue = before;
            change.AfterValue = after;
            change.RequiresRemux = false;

            if (rowType == "tag")
            {
                if (!MetadataTagRegistry.IsAllowed(fieldKey))
                {
                    this._editMessage = AppText.F("web.metadata.manualEdit.tagNotAllowed", fieldKey);
                    return new List<MkvMetadataChange>();
                }

                if (track == null)
                {
                    change.Scope = MkvMetadataTargetScope.Container;
                }
                else if (track.TrackKind == "video")
                {
                    change.Scope = MkvMetadataTargetScope.Video;
                }
                else if (track.TrackKind == "audio")
                {
                    change.Scope = MkvMetadataTargetScope.Audio;
                }
                else if (track.TrackKind == "subtitles")
                {
                    change.Scope = MkvMetadataTargetScope.Subtitle;
                }

                change.OperationType = string.IsNullOrEmpty(after) ? MkvMetadataOperationType.ClearTagField : MkvMetadataOperationType.SetTagField;
                changes.Add(change);
            }
            else
            {
                MetadataFieldDefinition field;
                string errorMessage = "";
                if (!MetadataFieldRegistry.TryGet(fieldKey, out field))
                {
                    this._editMessage = AppText.F("metadata.validation.unknownField", fieldKey);
                    return new List<MkvMetadataChange>();
                }

                if (!MetadataFieldRegistry.ValidateWritable(fieldKey, out errorMessage))
                {
                    this._editMessage = !string.IsNullOrEmpty(errorMessage) ? errorMessage : AppText.F("metadata.validation.unknownField", fieldKey);
                    return new List<MkvMetadataChange>();
                }

                if (string.IsNullOrEmpty(after) && !string.IsNullOrEmpty(before) && !field.IsClearable)
                {
                    this._editMessage = AppText.F("web.metadata.manualEdit.fieldNotClearable", field.Label);
                    return new List<MkvMetadataChange>();
                }

                change.Scope = GetScopeFromSector(field.Sector);
                change.MkvPropEditProperty = field.MkvPropEditProperty;
                change.OperationType = string.IsNullOrEmpty(after) ? MkvMetadataOperationType.ClearField : MkvMetadataOperationType.SetField;
                changes.Add(change);
            }
        }

        return changes;
    }

    /// <summary>
    /// Legge il valore corrente per una chiave editing
    /// </summary>
    /// <param name="key">Chiave editing</param>
    /// <returns>Valore corrente</returns>
    private string GetCurrentValueFromEditKey(string key)
    {
        string selector;
        string rowType;
        string fieldKey;
        MkvMetadataTrackInfo track;

        if (!TryParseEditKey(key, out selector, out rowType, out fieldKey))
        {
            return "";
        }

        track = !string.IsNullOrEmpty(selector) ? this.FindTrackBySelector(selector) : null;
        if (rowType == "tag")
        {
            return track == null ? GetValue(this.GetInfo().Tags, fieldKey) : GetValue(track.Tags, fieldKey);
        }

        return track == null ? GetValue(this.GetInfo().Fields, fieldKey) : GetValue(track.Fields, fieldKey);
    }

    /// <summary>
    /// Decodifica una chiave editing
    /// </summary>
    /// <param name="key">Chiave serializzata</param>
    /// <param name="selector">Selettore estratto</param>
    /// <param name="rowType">Tipo riga estratto</param>
    /// <param name="fieldKey">Chiave campo estratta</param>
    /// <returns>True se valida</returns>
    private static bool TryParseEditKey(string key, out string selector, out string rowType, out string fieldKey)
    {
        string[] parts = (key != null ? key : "").Split(new string[] { "||" }, StringSplitOptions.None);
        selector = "";
        rowType = "";
        fieldKey = "";

        if (parts.Length != 3)
        {
            return false;
        }

        selector = parts[0];
        rowType = parts[1];
        fieldKey = parts[2];
        return !string.IsNullOrEmpty(rowType) && !string.IsNullOrEmpty(fieldKey);
    }

    /// <summary>
    /// Costruisce chiave editing per una riga
    /// </summary>
    /// <param name="row">Riga sheet</param>
    /// <returns>Chiave editing</returns>
    private static string BuildEditKey(MetadataMappedSheetRow row)
    {
        return GetSheetTrackSelector(row.Track) + "||" + (row.IsTag ? "tag" : "field") + "||" + row.FieldKey;
    }

    /// <summary>
    /// Costruisce la cella sheet per una riga
    /// </summary>
    /// <param name="row">Riga sheet</param>
    /// <returns>Cella calcolata</returns>
    private MetadataMappedSheetCell BuildCell(MetadataMappedSheetRow row)
    {
        MetadataMappedSheetCell cell = new MetadataMappedSheetCell();
        string trackSelector = GetSheetTrackSelector(row.Track);
        string before;
        string current;
        List<MkvMetadataChange> changes;

        cell.Token = row.Token;
        cell.Label = row.Label;

        if (row.IsTag)
        {
            current = row.Track == null ? GetValue(this.GetInfo().Tags, row.FieldKey) : GetValue(row.Track.Tags, row.FieldKey);
            before = row.Track == null ? GetValue(this.GetBeforeInfo().Tags, row.FieldKey) : GetValue(this.FindBeforeTrack(row.Track)?.Tags, row.FieldKey);
        }
        else if (row.Track == null)
        {
            current = GetValue(this.GetInfo().Fields, row.FieldKey);
            before = GetValue(this.GetBeforeInfo().Fields, row.FieldKey);
        }
        else
        {
            current = GetValue(row.Track.Fields, row.FieldKey);
            before = GetValue(this.FindBeforeTrack(row.Track)?.Fields, row.FieldKey);
        }

        cell.Value = current != null ? current : "";

        if (this.IsTrackRemoved(trackSelector))
        {
            cell.CssClass = "metadata-diff-removed";
            cell.RowCssClass = "metadata-diff-removed";
            cell.HelpText = this.BuildRemoveTrackHelp(trackSelector);
            cell.IsTrackRemoved = true;
            return cell;
        }

        changes = this.GetChanges(trackSelector, row.FieldKey);
        cell.HasFieldChange = this.Simulated && changes.Count > 0;
        cell.CssClass = this.Simulated ? this.GetChangeClass(changes, before, current) : "";
        cell.HelpText = this.BuildChangeHelp(trackSelector, row.FieldKey);
        return cell;
    }

    /// <summary>
    /// Restituisce chiavi tag presenti o simulate
    /// </summary>
    /// <param name="track">Traccia sorgente o null per container</param>
    /// <returns>Chiavi tag ordinate</returns>
    private List<string> GetTagKeys(MkvMetadataTrackInfo track)
    {
        List<string> result = new List<string>();
        MkvMetadataTrackInfo beforeTrack = this.FindBeforeTrack(track);
        string trackSelector = GetSheetTrackSelector(track);

        AddTagKeys(result, track == null ? this.GetInfo().Tags : track.Tags);
        AddTagKeys(result, track == null ? this.GetBeforeInfo().Tags : beforeTrack != null ? beforeTrack.Tags : null);

        if (this.Record != null && this.Record.Changes != null)
        {
            for (int i = 0; i < this.Record.Changes.Count; i++)
            {
                if (IsTagOperation(this.Record.Changes[i].OperationType) && this.Record.Changes[i].TrackSelector == trackSelector)
                {
                    AddKey(result, this.Record.Changes[i].FieldKey);
                }
            }
        }

        result.Sort(StringComparer.OrdinalIgnoreCase);
        return result;
    }

    /// <summary>
    /// Aggiunge chiavi tag da dizionario
    /// </summary>
    /// <param name="keys">Lista destinazione</param>
    /// <param name="tags">Dizionario tag</param>
    private static void AddTagKeys(List<string> keys, Dictionary<string, string> tags)
    {
        if (tags == null)
        {
            return;
        }

        foreach (KeyValuePair<string, string> pair in tags)
        {
            AddKey(keys, pair.Key);
        }
    }

    /// <summary>
    /// Aggiunge una chiave unica
    /// </summary>
    /// <param name="keys">Lista destinazione</param>
    /// <param name="key">Chiave da aggiungere</param>
    private static void AddKey(List<string> keys, string key)
    {
        string value = key != null ? key.Trim() : "";
        if (string.IsNullOrEmpty(value))
            return;

        for (int i = 0; i < keys.Count; i++)
        {
            if (string.Equals(keys[i], value, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }
        }

        keys.Add(value);
    }

    /// <summary>
    /// Restituisce classe CSS differenziale
    /// </summary>
    /// <param name="changes">Modifiche associate</param>
    /// <param name="before">Valore prima</param>
    /// <param name="after">Valore dopo</param>
    /// <returns>Classe CSS</returns>
    private string GetChangeClass(List<MkvMetadataChange> changes, string before, string after)
    {
        if (!this.Simulated || changes == null || changes.Count == 0)
            return "";

        if (string.IsNullOrEmpty(before) && !string.IsNullOrEmpty(after))
            return "metadata-diff-added";

        if (!string.IsNullOrEmpty(before) && string.IsNullOrEmpty(after))
            return "metadata-diff-removed";

        return "metadata-diff-modified";
    }

    /// <summary>
    /// Restituisce modifiche associate a selettore e campo
    /// </summary>
    /// <param name="trackSelector">Selettore traccia</param>
    /// <param name="fieldKey">Chiave campo</param>
    /// <returns>Lista modifiche</returns>
    private List<MkvMetadataChange> GetChanges(string trackSelector, string fieldKey)
    {
        List<MkvMetadataChange> result = new List<MkvMetadataChange>();
        string selector = trackSelector != null ? trackSelector : "";
        if (this.Record == null || this.Record.Changes == null)
            return result;

        for (int i = 0; i < this.Record.Changes.Count; i++)
        {
            MkvMetadataChange change = this.Record.Changes[i];
            if (change.TrackSelector == selector && change.FieldKey == fieldKey)
            {
                result.Add(change);
            }
        }

        return result;
    }

    /// <summary>
    /// Verifica se una traccia è rimossa nella simulazione
    /// </summary>
    /// <param name="trackSelector">Selettore traccia</param>
    /// <returns>True se rimossa</returns>
    private bool IsTrackRemoved(string trackSelector)
    {
        string selector = trackSelector != null ? trackSelector : "";
        if (!this.Simulated || string.IsNullOrEmpty(selector) || this.Record == null || this.Record.Changes == null)
            return false;

        for (int i = 0; i < this.Record.Changes.Count; i++)
        {
            if (this.Record.Changes[i].OperationType == MkvMetadataOperationType.RemoveTrack && this.Record.Changes[i].TrackSelector == selector)
                return true;
        }

        return false;
    }

    /// <summary>
    /// Costruisce testo helper per una modifica campo
    /// </summary>
    /// <param name="trackSelector">Selettore traccia</param>
    /// <param name="fieldKey">Chiave campo</param>
    /// <returns>Testo helper</returns>
    private string BuildChangeHelp(string trackSelector, string fieldKey)
    {
        List<MkvMetadataChange> changes = this.GetChanges(trackSelector, fieldKey);
        if (changes.Count == 0)
        {
            return AppText.T("web.metadata.mapped.noChangeHelp");
        }

        System.Text.StringBuilder sb = new System.Text.StringBuilder();
        for (int i = 0; i < changes.Count; i++)
        {
            MkvMetadataChange change = changes[i];
            sb.Append(i + 1).Append(". ").Append(change.RuleDescription).Append('\n');
            sb.Append("   ").Append(AppText.T("web.metadata.mapped.before")).Append(' ').Append(FormatMappedValue(change.BeforeValue)).Append('\n');
            sb.Append("   ").Append(AppText.T("web.metadata.mapped.after")).Append(' ').Append(FormatMappedValue(change.AfterValue)).Append('\n');
            if (!string.IsNullOrEmpty(change.Message))
                sb.Append("   ").Append(change.Message).Append('\n');
        }

        return sb.ToString();
    }

    /// <summary>
    /// Costruisce testo helper per traccia rimossa
    /// </summary>
    /// <param name="trackSelector">Selettore traccia</param>
    /// <returns>Testo helper</returns>
    private string BuildRemoveTrackHelp(string trackSelector)
    {
        if (this.Record == null || this.Record.Changes == null)
            return AppText.T("web.metadata.mapped.noChangeHelp");

        for (int i = 0; i < this.Record.Changes.Count; i++)
        {
            MkvMetadataChange change = this.Record.Changes[i];
            if (change.OperationType == MkvMetadataOperationType.RemoveTrack && change.TrackSelector == trackSelector)
            {
                return AppText.F("web.metadata.mapped.removedBy", change.RuleDescription);
            }
        }

        return AppText.T("web.metadata.mapped.noChangeHelp");
    }

