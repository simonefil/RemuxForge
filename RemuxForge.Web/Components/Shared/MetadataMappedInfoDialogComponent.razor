    /// <summary>
    /// Restituisce etichetta del contesto tag attivo
    /// </summary>
    /// <returns>Etichetta contesto</returns>
    private string GetActiveTagContextLabel()
    {
        if (this._activeTagSelector == CONTAINER_SELECTOR)
        {
            return AppText.T("web.metadata.mapped.container");
        }

        MkvMetadataTrackInfo track = this.FindTrackBySelector(this._activeTagSelector);
        return track != null ? this.BuildTrackOptionLabel(track) : AppText.T("web.metadata.mapped.container");
    }

    /// <summary>
    /// Cerca una traccia per selettore nei dati correnti e originali
    /// </summary>
    /// <param name="selector">Selettore traccia</param>
    /// <returns>Traccia trovata o null</returns>
    private MkvMetadataTrackInfo FindTrackBySelector(string selector)
    {
        MkvMetadataTrackInfo track;

        track = this.FindTrackBySelector(this.GetInfo().Tracks, selector);
        if (track != null)
        {
            return track;
        }

        return this.FindTrackBySelector(this.GetBeforeInfo().Tracks, selector);
    }

    /// <summary>
    /// Cerca una traccia per selettore in una lista
    /// </summary>
    /// <param name="tracks">Lista tracce</param>
    /// <param name="selector">Selettore traccia</param>
    /// <returns>Traccia trovata o null</returns>
    private MkvMetadataTrackInfo FindTrackBySelector(List<MkvMetadataTrackInfo> tracks, string selector)
    {
        string value = selector != null ? selector : "";
        if (tracks == null || string.IsNullOrEmpty(value))
            return null;

        for (int i = 0; i < tracks.Count; i++)
        {
            if (GetSheetTrackSelector(tracks[i]) == value)
            {
                return tracks[i];
            }
        }

        return null;
    }

    /// <summary>
    /// Cerca la traccia originale corrispondente
    /// </summary>
    /// <param name="track">Traccia corrente</param>
    /// <returns>Traccia originale o null</returns>
    private MkvMetadataTrackInfo FindBeforeTrack(MkvMetadataTrackInfo track)
    {
        MkvMetadataFileInfo before = this.GetBeforeInfo();
        string selector = GetSheetTrackSelector(track);
        if (track == null || string.IsNullOrEmpty(selector))
            return null;

        if (before.Tracks != null)
        {
            for (int i = 0; i < before.Tracks.Count; i++)
            {
                if (before.Tracks[i].TrackSelector == selector)
                {
                    return before.Tracks[i];
                }
            }
        }

        if (before.OtherStreams != null)
        {
            for (int i = 0; i < before.OtherStreams.Count; i++)
            {
                if (before.OtherStreams[i].StreamOrder == track.StreamOrder && before.OtherStreams[i].MediaInfoType == track.MediaInfoType)
                {
                    return before.OtherStreams[i];
                }
            }
        }

        return null;
    }

    /// <summary>
    /// Costruisce etichetta dropdown container
    /// </summary>
    /// <param name="info">File info sorgente</param>
    /// <returns>Etichetta container</returns>
    private string BuildContainerOptionLabel(MkvMetadataFileInfo info)
    {
        string result = AppText.T("web.metadata.mapped.container");
        string format = GetValue(info.Fields, "general_format");
        string size = info.FileSize > 0 ? Utils.FormatSize(info.FileSize) : "";

        AddOptionPart(ref result, format);
        AddOptionPart(ref result, size);
        return result;
    }

    /// <summary>
    /// Costruisce etichetta dropdown traccia
    /// </summary>
    /// <param name="track">Traccia sorgente</param>
    /// <returns>Etichetta traccia</returns>
    private string BuildTrackOptionLabel(MkvMetadataTrackInfo track)
    {
        string result = BuildSheetTrackTitle(track);

        if (track == null)
        {
            return result;
        }

        if (track.TrackKind == "video")
        {
            AddOptionPart(ref result, GetBestValue(track, "video_format", track.Format));
            AddOptionPart(ref result, BuildResolutionLabel(track));
            AddOptionPart(ref result, BuildFpsLabel(track));
        }
        else if (track.TrackKind == "audio")
        {
            AddOptionPart(ref result, GetBestValue(track, "audio_language", track.Language));
            AddOptionPart(ref result, GetBestValue(track, "audio_format", track.Format));
            AddOptionPart(ref result, GetValue(track.Fields, "audio_channels_label"));
            AddOptionPart(ref result, BuildAudioRateLabel(track));
        }
        else if (track.TrackKind == "subtitles")
        {
            AddOptionPart(ref result, GetBestValue(track, "subtitle_language", track.Language));
            AddOptionPart(ref result, GetBestValue(track, "subtitle_format", track.Format));
            AddOptionPart(ref result, GetBestValue(track, "subtitle_title", track.Title));
        }

        if (this.IsTrackRemoved(GetSheetTrackSelector(track)))
        {
            AddOptionPart(ref result, AppText.T("web.metadata.mapped.removedOption"));
        }

        return result;
    }

    /// <summary>
    /// Costruisce etichetta risoluzione video
    /// </summary>
    /// <param name="track">Traccia video</param>
    /// <returns>Etichetta risoluzione</returns>
    private static string BuildResolutionLabel(MkvMetadataTrackInfo track)
    {
        string width = GetValue(track.Fields, "video_width");
        string height = GetValue(track.Fields, "video_height");
        return !string.IsNullOrEmpty(width) && !string.IsNullOrEmpty(height) ? width + "x" + height : "";
    }

    /// <summary>
    /// Costruisce etichetta framerate
    /// </summary>
    /// <param name="track">Traccia video</param>
    /// <returns>Etichetta framerate</returns>
    private static string BuildFpsLabel(MkvMetadataTrackInfo track)
    {
        string fps = GetValue(track.Fields, "video_fps");
        return !string.IsNullOrEmpty(fps) ? fps + " fps" : "";
    }

    /// <summary>
    /// Costruisce etichetta profondità/campionamento audio
    /// </summary>
    /// <param name="track">Traccia audio</param>
    /// <returns>Etichetta audio</returns>
    private static string BuildAudioRateLabel(MkvMetadataTrackInfo track)
    {
        string bitDepth = GetValue(track.Fields, "audio_bitdepth");
        string sampleRate = GetValue(track.Fields, "audio_sampling_rate_khz");
        if (string.IsNullOrEmpty(bitDepth) && string.IsNullOrEmpty(sampleRate))
            return "";

        if (!string.IsNullOrEmpty(bitDepth) && !string.IsNullOrEmpty(sampleRate))
            return bitDepth + "bit/" + sampleRate + "kHz";

        return !string.IsNullOrEmpty(bitDepth) ? bitDepth + "bit" : sampleRate + "kHz";
    }

    /// <summary>
    /// Legge valore campo con fallback
    /// </summary>
    /// <param name="track">Traccia sorgente</param>
    /// <param name="fieldKey">Chiave campo</param>
    /// <param name="fallback">Fallback</param>
    /// <returns>Valore migliore</returns>
    private static string GetBestValue(MkvMetadataTrackInfo track, string fieldKey, string fallback)
    {
        string value = GetValue(track.Fields, fieldKey);
        return !string.IsNullOrEmpty(value) ? value : fallback != null ? fallback : "";
    }

    /// <summary>
    /// Aggiunge parte a etichetta dropdown
    /// </summary>
    /// <param name="value">Etichetta corrente</param>
    /// <param name="part">Parte da aggiungere</param>
    private static void AddOptionPart(ref string value, string part)
    {
        if (string.IsNullOrEmpty(part))
            return;

        value += " - " + part;
    }

    /// <summary>
    /// Verifica se un tipo operazione agisce sui tag
    /// </summary>
    /// <param name="type">Tipo operazione</param>
    /// <returns>True se operazione tag</returns>
    private static bool IsTagOperation(MkvMetadataOperationType type)
    {
        return type == MkvMetadataOperationType.SetTagField ||
            type == MkvMetadataOperationType.ClearTagField ||
            type == MkvMetadataOperationType.ClearTags ||
            type == MkvMetadataOperationType.AddOrUpdateTrackStatisticsTags ||
            type == MkvMetadataOperationType.DeleteTrackStatisticsTags;
    }

    /// <summary>
    /// Converte settore campo in ambito metadata
    /// </summary>
    /// <param name="sector">Settore campo</param>
    /// <returns>Ambito metadata</returns>
    private static MkvMetadataTargetScope GetScopeFromSector(MetadataFieldSector sector)
    {
        if (sector == MetadataFieldSector.Video)
        {
            return MkvMetadataTargetScope.Video;
        }

        if (sector == MetadataFieldSector.Audio)
        {
            return MkvMetadataTargetScope.Audio;
        }

        if (sector == MetadataFieldSector.Subtitle)
        {
            return MkvMetadataTargetScope.Subtitle;
        }

        return MkvMetadataTargetScope.Container;
    }

    /// <summary>
    /// Legge valore da dizionario
    /// </summary>
    /// <param name="values">Dizionario valori</param>
    /// <param name="key">Chiave valore</param>
    /// <returns>Valore o stringa vuota</returns>
    private static string GetValue(Dictionary<string, string> values, string key)
    {
        string result;
        if (values != null && values.TryGetValue(key, out result))
        {
            return result != null ? result : "";
        }

        return "";
    }

    /// <summary>
    /// Formatta valore nel pannello helper
    /// </summary>
    /// <param name="value">Valore sorgente</param>
    /// <returns>Valore visualizzabile</returns>
    private static string FormatMappedValue(string value)
    {
        return !string.IsNullOrEmpty(value) ? value : AppText.T("web.metadata.mapped.empty");
    }

    /// <summary>
    /// Formatta valore cella sheet
    /// </summary>
    /// <param name="cell">Cella sorgente</param>
    /// <returns>Valore visualizzabile</returns>
    private static string FormatSheetValue(MetadataMappedSheetCell cell)
    {
        if (cell == null)
        {
            return "";
        }

        if (!string.IsNullOrEmpty(cell.Value))
            return cell.Value;

        return !string.IsNullOrEmpty(cell.CssClass) ? AppText.T("web.metadata.mapped.empty") : "";
    }

    /// <summary>
    /// Costruisce titolo sintetico traccia
    /// </summary>
    /// <param name="track">Traccia sorgente</param>
    /// <returns>Titolo traccia</returns>
    private static string BuildSheetTrackTitle(MkvMetadataTrackInfo track)
    {
        string type;

        if (track == null)
        {
            return "";
        }

        if (track.TrackKind == "video")
        {
            type = AppText.T("web.metadata.mapped.video");
        }
        else if (track.TrackKind == "audio")
        {
            type = AppText.T("web.metadata.mapped.audio");
        }
        else if (track.TrackKind == "subtitles")
        {
            type = AppText.T("web.metadata.mapped.text");
        }
        else
        {
            type = !string.IsNullOrEmpty(track.MediaInfoType) ? track.MediaInfoType : track.TrackKind;
        }

        if (track.TypeIndex > 0)
        {
            return type + " #" + track.TypeIndex.ToString();
        }

        if (track.StreamOrder > 0)
        {
            return type + " #" + track.StreamOrder.ToString();
        }

        return type;
    }

    /// <summary>
    /// Restituisce selettore sheet per una traccia
    /// </summary>
    /// <param name="track">Traccia sorgente</param>
    /// <returns>Selettore traccia</returns>
    private static string GetSheetTrackSelector(MkvMetadataTrackInfo track)
    {
        if (track == null)
        {
            return "";
        }

        if (!string.IsNullOrEmpty(track.TrackSelector))
            return track.TrackSelector;

        return "stream:" + track.StreamOrder.ToString();
    }

    /// <summary>
    /// Riga logica della sheet metadata
    /// </summary>
    private class MetadataMappedSheetRow
    {
        /// <summary>
        /// Inizializza riga vuota
        /// </summary>
        public MetadataMappedSheetRow()
        {
            this.Token = "";
            this.Label = "";
            this.FieldKey = "";
            this.Track = null;
            this.FieldDefinition = null;
        }

        /// <summary>
        /// Token campo
        /// </summary>
        public string Token { get; set; }

        /// <summary>
        /// Etichetta campo
        /// </summary>
        public string Label { get; set; }

        /// <summary>
        /// Chiave campo o tag
        /// </summary>
        public string FieldKey { get; set; }

        /// <summary>
        /// Traccia associata o null per container
        /// </summary>
        public MkvMetadataTrackInfo Track { get; set; }

        /// <summary>
        /// Definizione campo associata
        /// </summary>
        public MetadataFieldDefinition FieldDefinition { get; set; }

        /// <summary>
        /// Indica se la riga rappresenta un tag
        /// </summary>
        public bool IsTag { get; set; }
    }

    /// <summary>
    /// Cella calcolata della sheet metadata
    /// </summary>
    private class MetadataMappedSheetCell
    {
        /// <summary>
        /// Inizializza cella vuota
        /// </summary>
        public MetadataMappedSheetCell()
        {
            this.Token = "";
            this.Label = "";
            this.Value = "";
            this.CssClass = "";
            this.RowCssClass = "";
            this.HelpText = "";
            this.HasFieldChange = false;
            this.IsTrackRemoved = false;
        }

        /// <summary>
        /// Token campo
        /// </summary>
        public string Token { get; set; }

        /// <summary>
        /// Etichetta campo
        /// </summary>
        public string Label { get; set; }

        /// <summary>
        /// Valore campo
        /// </summary>
        public string Value { get; set; }

        /// <summary>
        /// Classe CSS della cella
        /// </summary>
        public string CssClass { get; set; }

        /// <summary>
        /// Classe CSS della riga
        /// </summary>
        public string RowCssClass { get; set; }

        /// <summary>
        /// Testo helper associato
        /// </summary>
        public string HelpText { get; set; }

        /// <summary>
        /// Indica se il campo ha una modifica
        /// </summary>
        public bool HasFieldChange { get; set; }

        /// <summary>
        /// Indica se la traccia risulta rimossa
        /// </summary>
        public bool IsTrackRemoved { get; set; }
    }

    /// <summary>
    /// Coppia riga/cella pronta per render
    /// </summary>
    private class MetadataMappedSheetDisplayRow
    {
        /// <summary>
        /// Inizializza display row vuota
        /// </summary>
        public MetadataMappedSheetDisplayRow()
        {
            this.Row = null;
            this.Cell = null;
        }

        /// <summary>
        /// Riga sheet
        /// </summary>
        public MetadataMappedSheetRow Row { get; set; }

        /// <summary>
        /// Cella calcolata
        /// </summary>
        public MetadataMappedSheetCell Cell { get; set; }
    }
}
