@inject NotificationService NotificationService

<div class="dialog-overlay visible" @onclick="OnClose">
    <div class="dialog-box config-dialog-box" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="config-dialog-title" @onclick:stopPropagation="true">
        <div id="config-dialog-title" class="dialog-title">@AppText.T("web.config.title")</div>
        <div class="dialog-body config-dialog-body">
            <div class="config-form-pane">
            @if (_isSplitMode)
            {
                @* Sorgente Split *@
                <div class="form-section">@AppText.T("web.config.section.splitSource")</div>
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.sourceRequired")</span>
                    <input class="form-input" aria-label="@AppText.T("web.config.label.sourceRequired")" @bind="_splitSource" @onfocus="@(() => SetFieldHelp("split.source"))" @onmouseenter="@(() => SetFieldHelp("split.source"))" />
                    <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.config.label.sourceRequired")" Click="@(() => BrowseSplit(10, true, true))" />
                </div>
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.output")</span>
                    <input class="form-input" aria-label="@AppText.T("web.config.label.output")" @bind="_splitOutputDir" @onfocus="@(() => SetFieldHelp("split.output"))" @onmouseenter="@(() => SetFieldHelp("split.output"))" />
                    <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.config.label.output")" Click="@(() => BrowseSplit(11, false, true))" />
                </div>
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.sourceRaw")</span>
                    <input class="form-input" aria-label="@AppText.T("web.config.label.sourceRaw")" @bind="_splitSourceRaw" @onfocus="@(() => SetFieldHelp("split.sourceRaw"))" @onmouseenter="@(() => SetFieldHelp("split.sourceRaw"))" />
                    <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.config.label.sourceRaw")" Click="@(() => BrowseSplit(12, true, false))" />
                </div>
                <div class="form-row">
                    <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("split.recursive"))"><RadzenSwitch TValue="bool" @bind-Value="@_recursive" /><span>@AppText.T("web.config.toggle.recursive")</span></div>
                    <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("split.force"))"><RadzenSwitch TValue="bool" @bind-Value="@_splitForce" /><span>@AppText.T("web.config.toggle.force")</span></div>
                    <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("split.dryRun"))"><RadzenSwitch TValue="bool" @bind-Value="@_splitDryRun" /><span>@AppText.T("web.config.toggle.dryRun")</span></div>
                </div>

                @* Modalita taglio *@
                <div class="form-section">@AppText.T("web.config.section.cutting")</div>
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.modeRequired")</span>
                    <select class="form-input" style="width: 22ch;" aria-label="@AppText.T("web.config.label.modeRequired")" @bind="_splitCutMode" @onfocus="@(() => SetFieldHelp("split.mode"))" @onmouseenter="@(() => SetFieldHelp("split.mode"))">
                        <option value="">@AppText.T("web.common.choose")</option>
                        <option value="@SPLIT_CUT_PATTERN">@AppText.T("web.config.option.chapterPattern")</option>
                        <option value="@SPLIT_CUT_RANGES">@AppText.T("web.config.option.ranges")</option>
                        <option value="@SPLIT_CUT_SPLIT_AT">@AppText.T("web.config.option.splitAt")</option>
                        <option value="@SPLIT_CUT_TRIM">@AppText.T("web.config.option.trim")</option>
                        <option value="@SPLIT_CUT_CHAPTERS_EACH">@AppText.T("web.config.option.chaptersEach")</option>
                    </select>
                </div>
                @if (_splitCutMode == SPLIT_CUT_PATTERN)
                {
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.config.label.patternRequired")</span>
                        <input class="form-input" aria-label="@AppText.T("web.config.label.patternRequired")" @bind="_splitPattern" placeholder="5,5,5" @onfocus="@(() => SetFieldHelp("split.pattern"))" @onmouseenter="@(() => SetFieldHelp("split.pattern"))" />
                    </div>
                }
                else if (_splitCutMode == SPLIT_CUT_RANGES)
                {
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.config.label.rangesRequired")</span>
                        <input class="form-input" aria-label="@AppText.T("web.config.label.rangesRequired")" @bind="_splitRanges" placeholder="0-00:24:00.000,00:24:00.000-END" @onfocus="@(() => SetFieldHelp("split.ranges"))" @onmouseenter="@(() => SetFieldHelp("split.ranges"))" />
                    </div>
                }
                else if (_splitCutMode == SPLIT_CUT_SPLIT_AT)
                {
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.config.label.splitAtRequired")</span>
                        <input class="form-input" aria-label="@AppText.T("web.config.label.splitAtRequired")" @bind="_splitAt" placeholder="00:24:00.000" @onfocus="@(() => SetFieldHelp("split.splitAt"))" @onmouseenter="@(() => SetFieldHelp("split.splitAt"))" />
                    </div>
                }
                else if (_splitCutMode == SPLIT_CUT_TRIM)
                {
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.config.label.trimStart")</span>
                        <input class="form-input" aria-label="@AppText.T("web.config.label.trimStart")" @bind="_splitTrimStart" @onfocus="@(() => SetFieldHelp("split.trimStart"))" @onmouseenter="@(() => SetFieldHelp("split.trimStart"))" />
                    </div>
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.config.label.trimEnd")</span>
                        <input class="form-input" aria-label="@AppText.T("web.config.label.trimEnd")" @bind="_splitTrimEnd" @onfocus="@(() => SetFieldHelp("split.trimEnd"))" @onmouseenter="@(() => SetFieldHelp("split.trimEnd"))" />
                    </div>
                }
                else if (_splitCutMode == SPLIT_CUT_CHAPTERS_EACH)
                {
                }

                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.snap")</span>
                    <select class="form-input" style="width: 14ch;" aria-label="@AppText.T("web.config.label.snap")" @bind="_splitSnap" @onfocus="@(() => SetFieldHelp("split.snap"))" @onmouseenter="@(() => SetFieldHelp("split.snap"))">
                        <option value="@RemuxForge.Core.Models.MkvSplitSnapMode.Off">off</option>
                        <option value="@RemuxForge.Core.Models.MkvSplitSnapMode.Before">before</option>
                        <option value="@RemuxForge.Core.Models.MkvSplitSnapMode.After">after</option>
                        <option value="@RemuxForge.Core.Models.MkvSplitSnapMode.Nearest">nearest</option>
                    </select>
                </div>

                @* Naming *@
                <div class="form-section">@AppText.T("web.config.section.naming")</div>
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.template")</span>
                    <input class="form-input" aria-label="@AppText.T("web.config.label.template")" @bind="_splitOutputTemplate" placeholder="{source_name}.part{n:02d}.mkv" @onfocus="@(() => SetFieldHelp("split.template"))" @onmouseenter="@(() => SetFieldHelp("split.template"))" />
                </div>

                @* Opzioni *@
                <div class="form-section">@AppText.T("web.config.section.options")</div>
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.extensions")</span>
                    <input class="form-input" aria-label="@AppText.T("web.config.label.extensions")" @bind="_extensions" @onfocus="@(() => SetFieldHelp("split.extensions"))" @onmouseenter="@(() => SetFieldHelp("split.extensions"))" />
                </div>
            }
            else
            {
            @* Cartelle *@
            <div class="form-section">@AppText.T("web.config.section.folders")</div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.sourceRequired")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.sourceRequired")" @bind="_sourceFolder" @onfocus="@(() => SetFieldHelp("remux.source"))" @onmouseenter="@(() => SetFieldHelp("remux.source"))" />
                <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.config.label.sourceRequired")" Click="@(() => BrowseFolder(0))" />
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.language")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.language")" @bind="_languageFolder" @onfocus="@(() => SetFieldHelp("remux.language"))" @onmouseenter="@(() => SetFieldHelp("remux.language"))" />
                <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.config.label.language")" Click="@(() => BrowseFolder(1))" />
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.destination")@(_overwrite ? "" : "*"):</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.destination")" @bind="_destFolder" @onfocus="@(() => SetFieldHelp("remux.destination"))" @onmouseenter="@(() => SetFieldHelp("remux.destination"))" />
                <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="@AppText.T("web.config.label.destination")" Click="@(() => BrowseFolder(2))" />
            </div>
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.overwrite"))"><RadzenSwitch TValue="bool" @bind-Value="@_overwrite" /><span>@AppText.T("web.config.toggle.overwrite")</span></div>
            </div>
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.recursive"))"><RadzenSwitch TValue="bool" @bind-Value="@_recursive" /><span>@AppText.T("web.config.toggle.recursive")</span></div>
            </div>

            @* Lingua e Tracce *@
            <div class="form-section">@AppText.T("web.config.section.languageTracks")</div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.targetLanguage")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.targetLanguage")" @bind="_targetLang" @onfocus="@(() => SetFieldHelp("remux.target"))" @onmouseenter="@(() => SetFieldHelp("remux.target"))" />
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.audioCodec")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.audioCodec")" @bind="_audioCodec" @onfocus="@(() => SetFieldHelp("remux.audioCodec"))" @onmouseenter="@(() => SetFieldHelp("remux.audioCodec"))" />
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.keepAudio")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.keepAudio")" @bind="_keepSrcAudio" @onfocus="@(() => SetFieldHelp("remux.keepAudio"))" @onmouseenter="@(() => SetFieldHelp("remux.keepAudio"))" />
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.keepCodec")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.keepCodec")" @bind="_keepSrcCodec" @onfocus="@(() => SetFieldHelp("remux.keepCodec"))" @onmouseenter="@(() => SetFieldHelp("remux.keepCodec"))" />
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.keepSub")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.keepSub")" @bind="_keepSrcSub" @onfocus="@(() => SetFieldHelp("remux.keepSub"))" @onmouseenter="@(() => SetFieldHelp("remux.keepSub"))" />
            </div>
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.subOnly"))"><RadzenSwitch TValue="bool" Value="@_subOnly" Change="@ToggleSubOnly" /><span>@AppText.T("web.config.toggle.subOnly")</span></div>
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.audioOnly"))"><RadzenSwitch TValue="bool" @bind-Value="@_audioOnly" /><span>@AppText.T("web.config.toggle.audioOnly")</span></div>
            </div>

            @* Sincronizzazione *@
            <div class="form-section">@AppText.T("web.config.section.sync")</div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.speed")</span>
                <select class="form-input" style="width: 34ch;" aria-label="@AppText.T("web.config.label.speed")" value="@_speedCorrectionPreset" @onchange="OnSpeedCorrectionChanged" @onfocus="@(() => SetFieldHelp("remux.speed"))" @onmouseenter="@(() => SetFieldHelp("remux.speed"))">
                    <option value="">@AppText.T("web.config.option.off")</option>
                    @if (!string.IsNullOrEmpty(_customSpeedCorrectionFactor))
                    {
                        <option value="@_customSpeedCorrectionFactor">@AppText.F("web.config.option.speedCustom", _customSpeedCorrectionFactor)</option>
                    }
                    <option value="1001/1000">@AppText.T("web.config.option.speed23976To24")</option>
                    <option value="1000/1001">@AppText.T("web.config.option.speed24To23976")</option>
                    <option value="1001/960">@AppText.T("web.config.option.speed23976To25")</option>
                    <option value="960/1001">@AppText.T("web.config.option.speed25To23976")</option>
                    <option value="5/4">@AppText.T("web.config.option.speed23976To2997")</option>
                    <option value="4/5">@AppText.T("web.config.option.speed2997To23976")</option>
                    <option value="25/24">@AppText.T("web.config.option.speed24To25")</option>
                    <option value="24/25">@AppText.T("web.config.option.speed25To24")</option>
                    <option value="1250/1001">@AppText.T("web.config.option.speed24To2997")</option>
                    <option value="1001/1250">@AppText.T("web.config.option.speed2997To24")</option>
                    <option value="1200/1001">@AppText.T("web.config.option.speed25To2997")</option>
                    <option value="1001/1200">@AppText.T("web.config.option.speed2997To25")</option>
                </select>
            </div>
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.framesync"))"><RadzenSwitch TValue="bool" Value="@_frameSync" Change="@ToggleFrameSync" /><span>@AppText.T("web.config.toggle.frameSync")</span></div>
            </div>
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.deep"))"><RadzenSwitch TValue="bool" Value="@_deepAnalysis" Change="@ToggleDeepAnalysis" /><span>@AppText.T("web.config.toggle.deepAnalysis")</span></div>
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.cropSource")</span>
                <input class="form-input" style="width: 18ch;" aria-label="@AppText.T("web.config.label.cropSource")" @bind="_analysisCropSourcePx" placeholder="L:R:T:B" @onfocus="@(() => SetFieldHelp("remux.cropSource"))" @onmouseenter="@(() => SetFieldHelp("remux.cropSource"))" />
                <span style="margin-left: 2ch;">@AppText.T("web.config.label.langShort")</span>
                <input class="form-input" style="width: 18ch;" aria-label="@AppText.T("web.config.label.langShort")" @bind="_analysisCropLanguagePx" placeholder="L:R:T:B" @onfocus="@(() => SetFieldHelp("remux.cropLang"))" @onmouseenter="@(() => SetFieldHelp("remux.cropLang"))" />
            </div>
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.subCanvas"))"><RadzenSwitch TValue="bool" @bind-Value="@_subtitleCanvasRewrite" /><span>@AppText.T("web.config.toggle.subtitleCanvasRewrite")</span></div>
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.audioDelay")</span>
                <input class="form-input" style="width: 8ch;" aria-label="@AppText.T("web.config.label.audioDelay")" @bind="_audioDelay" @onfocus="@(() => SetFieldHelp("remux.audioDelay"))" @onmouseenter="@(() => SetFieldHelp("remux.audioDelay"))" /> <span style="margin-left: 0.5ch;">ms</span>
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.subDelay")</span>
                <input class="form-input" style="width: 8ch;" aria-label="@AppText.T("web.config.label.subDelay")" @bind="_subDelay" @onfocus="@(() => SetFieldHelp("remux.subDelay"))" @onmouseenter="@(() => SetFieldHelp("remux.subDelay"))" /> <span style="margin-left: 0.5ch;">ms</span>
            </div>

            @* Matching *@
            <div class="form-section">@AppText.T("web.config.section.matching")</div>
            @if (!IsSingleFileSelection())
            {
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.config.label.matchPattern")</span>
                    <input class="form-input" aria-label="@AppText.T("web.config.label.matchPattern")" @bind="_matchPattern" @onfocus="@(() => SetFieldHelp("remux.match"))" @onmouseenter="@(() => SetFieldHelp("remux.match"))" />
                </div>
            }
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.extensions")</span>
                <input class="form-input" aria-label="@AppText.T("web.config.label.extensions")" @bind="_extensions" @onfocus="@(() => SetFieldHelp("remux.extensions"))" @onmouseenter="@(() => SetFieldHelp("remux.extensions"))" />
            </div>

            @* Post-Processing audio *@
            <div class="form-section">@AppText.T("web.config.section.audioPost")</div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.audioFormat")@((_audioSourceFillEnabled || RequiresTimelineAudioProcessing()) ? "*" : ""):</span>
                <select class="form-input" style="width: 12ch;" aria-label="@AppText.T("web.config.label.audioFormat")" value="@_audioFormat" @onchange="OnAudioFormatChanged" @onfocus="@(() => SetFieldHelp("remux.audioFormat"))" @onmouseenter="@(() => SetFieldHelp("remux.audioFormat"))">
                    <option value="">@AppText.T("web.common.no")</option>
                    <option value="flac">FLAC</option>
                    <option value="lpcm">LPCM</option>
                    <option value="aac">AAC</option>
                    <option value="opus">Opus</option>
                    <option value="ac3">AC-3</option>
                </select>
            </div>
            @if (!string.IsNullOrEmpty(_audioFormat))
            {
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.audioScope")@((_audioSourceFillEnabled || RequiresTimelineAudioProcessing()) ? "*" : ""):</span>
                <select class="form-input" style="width: 14ch;" aria-label="@AppText.T("web.config.label.audioScope")" @bind="_audioProcessingScope" @onfocus="@(() => SetFieldHelp("remux.audioScope"))" @onmouseenter="@(() => SetFieldHelp("remux.audioScope"))">
                    @if (!RequiresTimelineAudioProcessing())
                    {
                    <option value="disabled">@AppText.T("web.config.option.disabled")</option>
                    }
                    <option value="lang">Lang</option>
                    <option value="all">@AppText.T("web.config.option.all")</option>
                </select>
            </div>
            }
            @if (!string.IsNullOrEmpty(_audioFormat))
            {
                <div class="form-row">
                    <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.audioSourceFill"))"><RadzenSwitch TValue="bool" Value="@_audioSourceFillEnabled" Change="@ToggleAudioSourceFill" /><span>@AppText.T("web.config.toggle.audioSourceFill")</span></div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_audioFormat) && _audioSourceFillEnabled)
            {
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.thresholdRequired")</span>
                <input class="form-input" style="width: 8ch;" aria-label="@AppText.T("web.config.label.thresholdRequired")" @bind="_audioSourceFillThresholdMs" @onfocus="@(() => SetFieldHelp("remux.audioSourceFillThreshold"))" @onmouseenter="@(() => SetFieldHelp("remux.audioSourceFillThreshold"))" /> <span style="margin-left: 0.5ch;">ms</span>
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.sourceLanguageRequired")</span>
                <input class="form-input" style="width: 10ch;" aria-label="@AppText.T("web.config.label.sourceLanguageRequired")" @bind="_audioSourceFillLanguage" @onfocus="@(() => SetFieldHelp("remux.audioSourceFillLang"))" @onmouseenter="@(() => SetFieldHelp("remux.audioSourceFillLang"))" />
            </div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.modeRequired")</span>
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.audioSourceFillStart"))"><RadzenSwitch TValue="bool" @bind-Value="@_audioSourceFillStart" /><span>@AppText.T("web.config.toggle.start")</span></div>
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.audioSourceFillEnd"))"><RadzenSwitch TValue="bool" @bind-Value="@_audioSourceFillEnd" /><span>@AppText.T("web.config.toggle.end")</span></div>
                @if (_deepAnalysis)
                {
                    <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.audioSourceFillInsert"))"><RadzenSwitch TValue="bool" @bind-Value="@_audioSourceFillInsertSilence" /><span>@AppText.T("web.config.toggle.insertSilence")</span></div>
                }
            </div>
            }
            @if ((_audioFormat == "flac" || _audioFormat == "lpcm") && _audioProcessingScope != "disabled")
            {
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.audio24"))"><RadzenSwitch TValue="bool" @bind-Value="@_audioDownsample24To16" /><span>@AppText.T("web.config.toggle.audio24")</span></div>
            </div>
            }
            @if (!string.IsNullOrEmpty(_audioFormat) && _audioProcessingScope != "disabled")
            {
            <div class="form-row">
                <div class="ui-switch" @onmouseenter="@(() => SetFieldHelp("remux.audioNormalize"))"><RadzenSwitch TValue="bool" @bind-Value="@_audioPeakNormalize" /><span>@AppText.T("web.config.toggle.normalization")</span></div>
                @if (_audioPeakNormalize)
                {
                    <input class="form-input" style="width: 8ch;" aria-label="@AppText.T("web.config.toggle.normalization")" @bind="_audioPeakTargetDb" @onfocus="@(() => SetFieldHelp("remux.audioNormalize"))" @onmouseenter="@(() => SetFieldHelp("remux.audioNormalize"))" />
                    <span>dB</span>
                }
            </div>
            }
            @* Post-Processing video *@
            <div class="form-section">@AppText.T("web.config.section.videoPost")</div>
            <div class="form-row">
                <span class="form-label">@AppText.T("web.config.label.videoEncoding")</span>
                <select class="form-input" style="width: 30ch;" aria-label="@AppText.T("web.config.label.videoEncoding")" @bind="_encodingProfile" @onfocus="@(() => SetFieldHelp("remux.encoding"))" @onmouseenter="@(() => SetFieldHelp("remux.encoding"))">
                    <option value="">@AppText.T("web.common.none")</option>
                    @for (int i = 0; i < AppSettingsService.Instance.Settings.EncodingProfiles.Count; i++)
                    {
                        <option value="@AppSettingsService.Instance.Settings.EncodingProfiles[i].Name">@AppSettingsService.Instance.Settings.EncodingProfiles[i].Name</option>
                    }
                </select>
            </div>
            }
            </div>
            <div class="config-help-pane">
                <div class="config-help-title">@_fieldHelpTitle</div>
                <div class="config-help-text">@_fieldHelpText</div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_validationError))
        {
            <div style="padding: 0.5em 1em; color: var(--rz-danger); white-space: pre-line;">@_validationError</div>
        }
        <div class="dialog-footer">
            <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Apply" />
            <RadzenButton class="dialog-close-button" Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@OnClose" />
        </div>
    </div>
</div>

@* Dialog browse cartella *@
@if (_showBrowse)
{
    <FolderBrowserDialog InitialPath="@_browseInitialPath"
                          ShowFiles="@_browseShowFiles"
                          AllowCurrentFolderSelection="@_browseAllowCurrentFolderSelection"
                          AllowedExtensions="@_browseAllowedExtensions"
                          OnClose="CloseBrowse"
                          OnSelect="ApplyBrowse" />
}

@code {
    #region Costanti

    /// <summary>
    /// Split per pattern capitoli
    /// </summary>
    private const string SPLIT_CUT_PATTERN = "pattern";

    /// <summary>
    /// Split per range espliciti
    /// </summary>
    private const string SPLIT_CUT_RANGES = "ranges";

    /// <summary>
    /// Split per punti di taglio
    /// </summary>
    private const string SPLIT_CUT_SPLIT_AT = "split-at";

    /// <summary>
    /// Trim singolo segmento
    /// </summary>
    private const string SPLIT_CUT_TRIM = "trim";

    /// <summary>
    /// Split capitolo per capitolo
    /// </summary>
    private const string SPLIT_CUT_CHAPTERS_EACH = "chapters-each";

    #endregion

    /// <summary>
    /// Opzioni correnti da precompilare
    /// </summary>
    [Parameter] public Options Options { get; set; }

    /// <summary>
    /// Evento chiusura dialog
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Evento applicazione opzioni
    /// </summary>
    [Parameter] public EventCallback<Options> OnApply { get; set; }

    /// <summary>
    /// Flag: mostra dialog browse cartella
    /// </summary>
    private bool _showBrowse;

    /// <summary>
    /// Percorso iniziale per il dialog browse
    /// </summary>
    private string _browseInitialPath = "";

    /// <summary>
    /// Flag: il dialog browse deve mostrare file selezionabili
    /// </summary>
    private bool _browseShowFiles;

    /// <summary>
    /// Flag: il dialog browse può confermare la cartella corrente
    /// </summary>
    private bool _browseAllowCurrentFolderSelection = true;

    /// <summary>
    /// Estensioni ammesse dal browser corrente
    /// </summary>
    private List<string> _browseAllowedExtensions = new List<string>();

    /// <summary>
    /// Indice campo destinazione del browse: 0=source, 1=lingua, 2=dest
    /// </summary>
    private int _browseFieldIndex = -1;

    /// <summary>
    /// Flag: configurazione modalità split
    /// </summary>
    private bool _isSplitMode;

    /// <summary>
    /// Cartella sorgente
    /// </summary>
    private string _sourceFolder = "";

    /// <summary>
    /// Cartella lingua
    /// </summary>
    private string _languageFolder = "";

    /// <summary>
    /// Cartella destinazione
    /// </summary>
    private string _destFolder = "";

    /// <summary>
    /// Flag sovrascrivi sorgente
    /// </summary>
    private bool _overwrite;

    /// <summary>
    /// Flag ricorsivo
    /// </summary>
    private bool _recursive = true;

    /// <summary>
    /// Lingua target (CSV)
    /// </summary>
    private string _targetLang = "";

    /// <summary>
    /// Codec audio (CSV)
    /// </summary>
    private string _audioCodec = "";

    /// <summary>
    /// Lingue audio sorgente da mantenere (CSV)
    /// </summary>
    private string _keepSrcAudio = "";

    /// <summary>
    /// Codec audio sorgente da mantenere (CSV)
    /// </summary>
    private string _keepSrcCodec = "";

    /// <summary>
    /// Sottotitoli sorgente da mantenere (CSV)
    /// </summary>
    private string _keepSrcSub = "";

    /// <summary>
    /// Flag solo sottotitoli
    /// </summary>
    private bool _subOnly;

    /// <summary>
    /// Flag solo audio
    /// </summary>
    private bool _audioOnly;

    /// <summary>
    /// Preset speed correction selezionato
    /// </summary>
    private string _speedCorrectionPreset = "";

    /// <summary>
    /// Fattore manuale CLI valido ma non modificabile tramite i preset UI
    /// </summary>
    private string _customSpeedCorrectionFactor = "";

    /// <summary>
    /// Flag frame-sync
    /// </summary>
    private bool _frameSync;

    /// <summary>
    /// Flag deep analysis
    /// </summary>
    private bool _deepAnalysis;

    /// <summary>
    /// Crop manuale source per analisi visuale
    /// </summary>
    private string _analysisCropSourcePx = "";

    /// <summary>
    /// Crop manuale lingua per analisi visuale
    /// </summary>
    private string _analysisCropLanguagePx = "";

    /// <summary>
    /// Riscrittura canvas sottotitoli importati
    /// </summary>
    private bool _subtitleCanvasRewrite;

    /// <summary>
    /// Delay audio in ms (stringa per binding input)
    /// </summary>
    private string _audioDelay = "0";

    /// <summary>
    /// Delay sottotitoli in ms (stringa per binding input)
    /// </summary>
    private string _subDelay = "0";

    /// <summary>
    /// Abilita UI audio source fill
    /// </summary>
    private bool _audioSourceFillEnabled;

    /// <summary>
    /// Soglia audio source fill in ms (stringa per binding input)
    /// </summary>
    private string _audioSourceFillThresholdMs = "0";

    /// <summary>
    /// Lingua source per audio source fill
    /// </summary>
    private string _audioSourceFillLanguage = "";

    /// <summary>
    /// Audio source fill: inizio file
    /// </summary>
    private bool _audioSourceFillStart;

    /// <summary>
    /// Audio source fill: fine file
    /// </summary>
    private bool _audioSourceFillEnd;

    /// <summary>
    /// Audio source fill: INSERT_SILENCE DeepAnalysis
    /// </summary>
    private bool _audioSourceFillInsertSilence;

    /// <summary>
    /// Pattern matching episodi
    /// </summary>
    private string _matchPattern = @"S(\d+)E(\d+)";

    /// <summary>
    /// Estensioni file (CSV)
    /// </summary>
    private string _extensions = "mkv";

    /// <summary>
    /// Formato audio post-processing
    /// </summary>
    private string _audioFormat = "";

    /// <summary>
    /// Tracce da processare nel formato audio scelto
    /// </summary>
    private string _audioProcessingScope = "disabled";

    /// <summary>
    /// Flag 24bit -> 16bit
    /// </summary>
    private bool _audioDownsample24To16;

    /// <summary>
    /// Flag peak normalization
    /// </summary>
    private bool _audioPeakNormalize;

    /// <summary>
    /// Target peak normalization
    /// </summary>
    private string _audioPeakTargetDb = "-1.0";

    /// <summary>
    /// Nome profilo encoding selezionato, vuoto = nessuno
    /// </summary>
    private string _encodingProfile = "";

    /// <summary>
    /// Sorgente split: file MKV o cartella
    /// </summary>
    private string _splitSource = "";

    /// <summary>
    /// Source raw split
    /// </summary>
    private string _splitSourceRaw = "";

    /// <summary>
    /// Cartella output split
    /// </summary>
    private string _splitOutputDir = "";

    /// <summary>
    /// Pattern capitoli split
    /// </summary>
    private string _splitPattern = "";

    /// <summary>
    /// Modalità di taglio split selezionata
    /// </summary>
    private string _splitCutMode = "";

    /// <summary>
    /// Ranges split
    /// </summary>
    private string _splitRanges = "";

    /// <summary>
    /// Split-at split
    /// </summary>
    private string _splitAt = "";

    /// <summary>
    /// Trim start split
    /// </summary>
    private string _splitTrimStart = "";

    /// <summary>
    /// Trim end split
    /// </summary>
    private string _splitTrimEnd = "";

    /// <summary>
    /// Template output split
    /// </summary>
    private string _splitOutputTemplate = "";

    /// <summary>
    /// Modalita snap split
    /// </summary>
    private MkvSplitSnapMode _splitSnap = MkvSplitSnapMode.Off;

    /// <summary>
    /// Flag force split
    /// </summary>
    private bool _splitForce;

    /// <summary>
    /// Flag dry-run split
    /// </summary>
    private bool _splitDryRun;

    /// <summary>
    /// File log split
    /// </summary>
    private string _splitLog = "";

    /// <summary>
    /// Errore di validazione configurazione
    /// </summary>
    private string _validationError = "";

    /// <summary>
    /// Titolo help campo corrente
    /// </summary>
    private string _fieldHelpTitle = "";

    /// <summary>
    /// Testo help campo corrente
    /// </summary>
    private string _fieldHelpText = "";

    /// <summary>
    /// Precompila campi dalle opzioni correnti
    /// </summary>
    protected override void OnInitialized()
    {
        if (Options != null)
        {
            _isSplitMode = Options.Mode == RemuxForge.Core.Models.Options.MODE_SPLIT;
            _sourceFolder = Options.SourceFolder;
            _languageFolder = Options.LanguageFolder;
            _destFolder = Options.DestinationFolder;
            _overwrite = Options.Overwrite;
            _recursive = Options.Recursive;
            _targetLang = string.Join(",", Options.TargetLanguage);
            _audioCodec = string.Join(",", Options.AudioCodec);
            _keepSrcAudio = string.Join(",", Options.KeepSourceAudioLangs);
            _keepSrcCodec = string.Join(",", Options.KeepSourceAudioCodec);
            _keepSrcSub = string.Join(",", Options.KeepSourceSubtitleLangs);
            _subOnly = Options.SubOnly;
            _audioOnly = Options.AudioOnly;
            _speedCorrectionPreset = Options.SpeedCorrectionMode == Options.SPEED_CORRECTION_MANUAL ? NormalizeSpeedCorrectionPreset(Options.ManualStretchFactor) : "";
            if (Options.SpeedCorrectionMode == Options.SPEED_CORRECTION_MANUAL && string.IsNullOrEmpty(_speedCorrectionPreset) && SpeedCorrectionService.TryParseStretchFactor(Options.ManualStretchFactor, out _, out string normalizedCustomFactor))
            {
                _customSpeedCorrectionFactor = normalizedCustomFactor;
                _speedCorrectionPreset = normalizedCustomFactor;
            }
            _frameSync = Options.FrameSync;
            _deepAnalysis = Options.DeepAnalysis;
            _analysisCropSourcePx = Options.AnalysisCropSourcePx;
            _analysisCropLanguagePx = Options.AnalysisCropLanguagePx;
            _subtitleCanvasRewrite = Options.SubtitleCanvasRewrite;
            _audioDelay = Options.AudioDelay.ToString();
            _subDelay = Options.SubtitleDelay.ToString();
            _audioSourceFillEnabled = Options.AudioSourceFillThresholdMs > 0 ||
                !string.IsNullOrEmpty(Options.AudioSourceFillLanguage) ||
                Options.AudioSourceFillStart ||
                Options.AudioSourceFillEnd ||
                Options.AudioSourceFillInsertSilence;
            _audioSourceFillThresholdMs = Options.AudioSourceFillThresholdMs.ToString();
            _audioSourceFillLanguage = Options.AudioSourceFillLanguage;
            _audioSourceFillStart = Options.AudioSourceFillStart;
            _audioSourceFillEnd = Options.AudioSourceFillEnd;
            _audioSourceFillInsertSilence = Options.AudioSourceFillInsertSilence;
            _matchPattern = Options.MatchPattern;
            _extensions = string.Join(",", Options.FileExtensions);

            _audioFormat = Options.AudioFormat;
            _audioProcessingScope = Options.AudioProcessingScope;
            _audioDownsample24To16 = Options.AudioDownsample24To16;
            _audioPeakNormalize = Options.AudioPeakNormalize;
            _audioPeakTargetDb = Options.AudioPeakTargetDb.ToString(System.Globalization.CultureInfo.InvariantCulture);

            _encodingProfile = Options.EncodingProfileName;

            if (_isSplitMode)
            {
                _splitSource = !string.IsNullOrEmpty(Options.SourceFolder) ? Options.SourceFolder : Options.Split.SourcePath;
                _splitSourceRaw = Options.Split.SourceRaw;
                _splitOutputDir = Options.Split.OutputDir;
                _splitPattern = Options.Split.Pattern;
                _splitRanges = Options.Split.Ranges;
                _splitAt = Options.Split.SplitAt;
                _splitTrimStart = Options.Split.TrimStart;
                _splitTrimEnd = Options.Split.TrimEnd;
                _splitCutMode = DetectSplitCutMode(Options.Split);
                _splitOutputTemplate = Options.Split.OutputTemplate;
                _splitSnap = Options.Split.Snap;
                _splitForce = Options.Split.Force;
                _splitDryRun = Options.Split.DryRun || Options.DryRun;
                _splitLog = Options.Split.Log;
            }

            SetFieldHelp(_isSplitMode ? "split.source" : "remux.source");
        }
    }

    /// <summary>
    /// Applica le opzioni compilate e notifica il parent
    /// </summary>
    private void Apply()
    {
        Options opts = new Options();
        int audioDelay;
        int subDelay;
        int audioSourceFillThresholdMs;
        double audioPeakTargetDb;
        string[] parts;
        string trimmed;
        OptionsValidationResult validation;

        _validationError = "";

        if (_isSplitMode)
        {
            ApplySplit();
            return;
        }

        if (!ValidateInput())
            return;

        opts.Mode = Options.MODE_REMUX;
        opts.SourceFolder = _sourceFolder;
        opts.LanguageFolder = _languageFolder;
        opts.DestinationFolder = _destFolder;
        opts.Overwrite = _overwrite;
        opts.Recursive = _recursive;

        // Parsing CSV
        ParseCsv(_targetLang, opts.TargetLanguage);
        ParseCsv(_audioCodec, opts.AudioCodec);
        ParseCsv(_keepSrcAudio, opts.KeepSourceAudioLangs);
        ParseCsv(_keepSrcCodec, opts.KeepSourceAudioCodec);
        ParseCsv(_keepSrcSub, opts.KeepSourceSubtitleLangs);

        opts.SubOnly = _subOnly;
        opts.AudioOnly = _audioOnly;
        opts.SpeedCorrectionMode = string.IsNullOrEmpty(_speedCorrectionPreset) ? Options.SPEED_CORRECTION_OFF : Options.SPEED_CORRECTION_MANUAL;
        opts.ManualStretchFactor = _speedCorrectionPreset;
        opts.FrameSync = _frameSync;
        opts.DeepAnalysis = _deepAnalysis;
        opts.AnalysisCropSourcePx = Options.NormalizeAnalysisCropPx(_analysisCropSourcePx);
        opts.AnalysisCropLanguagePx = Options.NormalizeAnalysisCropPx(_analysisCropLanguagePx);
        opts.SubtitleCanvasRewrite = _subtitleCanvasRewrite;

        int.TryParse(_audioDelay, out audioDelay);
        opts.AudioDelay = audioDelay;
        int.TryParse(_subDelay, out subDelay);
        opts.SubtitleDelay = subDelay;
        if (_audioSourceFillEnabled)
        {
            int.TryParse(_audioSourceFillThresholdMs, out audioSourceFillThresholdMs);
            opts.AudioSourceFillThresholdMs = audioSourceFillThresholdMs;
            opts.AudioSourceFillLanguage = _audioSourceFillLanguage.Trim();
            opts.AudioSourceFillStart = _audioSourceFillStart;
            opts.AudioSourceFillEnd = _audioSourceFillEnd;
            opts.AudioSourceFillInsertSilence = _deepAnalysis && _audioSourceFillInsertSilence;
        }

        opts.MatchPattern = _matchPattern;

        // Estensioni
        opts.FileExtensions.Clear();
        parts = _extensions.Split(',');
        for (int i = 0; i < parts.Length; i++)
        {
            trimmed = parts[i].Trim().TrimStart('.');
            if (!string.IsNullOrEmpty(trimmed))
                opts.FileExtensions.Add(trimmed);
        }

        opts.AudioFormat = _audioFormat.Trim().ToLowerInvariant();
        opts.AudioProcessingScope = !string.IsNullOrEmpty(opts.AudioFormat) ? (RequiresTimelineAudioProcessing() && _audioProcessingScope == "disabled" ? "lang" : _audioProcessingScope) : "disabled";
        opts.AudioDownsample24To16 = (opts.AudioFormat == "flac" || opts.AudioFormat == "lpcm") && opts.AudioProcessingScope != "disabled" && _audioDownsample24To16;
        opts.AudioPeakNormalize = !string.IsNullOrEmpty(opts.AudioFormat) && opts.AudioProcessingScope != "disabled" && _audioPeakNormalize;
        if (!double.TryParse(_audioPeakTargetDb, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out audioPeakTargetDb))
        {
            audioPeakTargetDb = -1.0;
        }
        opts.AudioPeakTargetDb = audioPeakTargetDb;

        // Path mkvmerge da AppSettings (gestito nel dialog Percorsi tool)
        opts.MkvMergePath = !string.IsNullOrEmpty(AppSettingsService.Instance.Settings.Tools.MkvMergePath) ? AppSettingsService.Instance.Settings.Tools.MkvMergePath : "mkvmerge";
        opts.EncodingProfileName = _encodingProfile;

        validation = OptionsValidator.Validate(opts, false, false);
        if (!validation.IsValid)
        {
            ShowValidationError(validation.ErrorMessage);
            return;
        }

        OnApply.InvokeAsync(opts);
    }

    /// <summary>
    /// Applica configurazione split e notifica il parent
    /// </summary>
    private void ApplySplit()
    {
        Options opts = new Options();
        OptionsValidationResult validation;
        string[] parts;
        string trimmed;

        if (!ValidateSplitInput())
            return;

        opts.Mode = RemuxForge.Core.Models.Options.MODE_SPLIT;
        opts.SourceFolder = _splitSource.Trim();
        opts.Recursive = _recursive;
        opts.DryRun = _splitDryRun;
        opts.Split.SourcePath = opts.SourceFolder;
        opts.Split.SourceRaw = _splitSourceRaw.Trim();
        opts.Split.OutputDir = _splitOutputDir.Trim();
        if (_splitCutMode == SPLIT_CUT_PATTERN)
        {
            opts.Split.Pattern = _splitPattern.Trim();
        }
        else if (_splitCutMode == SPLIT_CUT_RANGES)
        {
            opts.Split.Ranges = _splitRanges.Trim();
        }
        else if (_splitCutMode == SPLIT_CUT_SPLIT_AT)
        {
            opts.Split.SplitAt = _splitAt.Trim();
        }
        else if (_splitCutMode == SPLIT_CUT_TRIM)
        {
            opts.Split.TrimStart = _splitTrimStart.Trim();
            opts.Split.TrimEnd = _splitTrimEnd.Trim();
        }
        else if (_splitCutMode == SPLIT_CUT_CHAPTERS_EACH)
        {
            opts.Split.ChaptersEach = true;
        }
        opts.Split.OutputTemplate = _splitOutputTemplate.Trim();
        opts.Split.Snap = _splitSnap;
        opts.Split.Force = _splitForce;
        opts.Split.DryRun = _splitDryRun;
        opts.Split.Log = _splitLog.Trim();

        opts.FileExtensions.Clear();
        parts = _extensions.Split(',');
        for (int i = 0; i < parts.Length; i++)
        {
            trimmed = parts[i].Trim().TrimStart('.');
            if (!string.IsNullOrEmpty(trimmed))
                opts.FileExtensions.Add(trimmed);
        }

        validation = OptionsValidator.Validate(opts, false, false);
        if (!validation.IsValid)
        {
            ShowValidationError(validation.ErrorMessage);
            return;
        }

        OnApply.InvokeAsync(opts);
    }

    /// <summary>
    /// Valida i campi prima di costruire Options
    /// </summary>
    /// <returns>True se i campi sono validi</returns>
    private bool ValidateInput()
    {
        List<string> errors = new List<string>();
        int audioSourceFillThresholdMs = 0;

        if (!int.TryParse(_audioDelay, out _))
        {
            errors.Add(AppText.T("web.config.validation.audioDelayInt"));
        }

        if (!int.TryParse(_subDelay, out _))
        {
            errors.Add(AppText.T("web.config.validation.subDelayInt"));
        }

        if (_audioSourceFillEnabled && !int.TryParse(_audioSourceFillThresholdMs, out audioSourceFillThresholdMs))
        {
            errors.Add(AppText.T("web.config.validation.audioSourceThresholdInt"));
        }
        else if (_audioSourceFillEnabled && audioSourceFillThresholdMs <= 0)
        {
            errors.Add(AppText.T("web.config.validation.audioSourceThresholdPositive"));
        }

        if (_audioSourceFillEnabled && string.IsNullOrEmpty(_audioSourceFillLanguage.Trim()))
        {
            errors.Add(AppText.T("web.config.validation.audioSourceLanguageRequired"));
        }

        if (_audioSourceFillEnabled && !_audioSourceFillStart && !_audioSourceFillEnd && !(_deepAnalysis && _audioSourceFillInsertSilence))
        {
            errors.Add(AppText.T("web.config.validation.audioSourceModeRequired"));
        }

        if (_audioSourceFillEnabled && string.IsNullOrEmpty(_audioFormat))
        {
            errors.Add(AppText.T("web.config.validation.audioSourceFormatRequired"));
        }

        if (_audioSourceFillEnabled && _audioProcessingScope == "disabled")
        {
            errors.Add(AppText.T("web.config.validation.audioSourceScopeRequired"));
        }

        if (RequiresTimelineAudioProcessing() && string.IsNullOrEmpty(_audioFormat))
        {
            errors.Add(AppText.T("web.config.validation.timelineAudioFormatRequired"));
        }

        if (RequiresTimelineAudioProcessing() && _audioProcessingScope == "disabled")
        {
            errors.Add(AppText.T("web.config.validation.timelineAudioScopeRequired"));
        }

        if (!Options.TryParseAnalysisCropPx(_analysisCropSourcePx, out _, out _, out _, out _))
        {
            errors.Add(AppText.T("web.config.validation.cropSourceInvalid"));
        }

        if (!Options.TryParseAnalysisCropPx(_analysisCropLanguagePx, out _, out _, out _, out _))
        {
            errors.Add(AppText.T("web.config.validation.cropLangInvalid"));
        }

        if (!string.IsNullOrEmpty(_audioFormat) && _audioProcessingScope != "disabled" && _audioPeakNormalize && !double.TryParse(_audioPeakTargetDb, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _))
        {
            errors.Add(AppText.T("web.config.validation.normalizationTargetInvalid"));
        }

        if (IsMixedSingleFileSelection())
        {
            errors.Add(AppText.T("web.config.validation.singleFilePairRequired"));
        }

        if (errors.Count > 0)
        {
            ShowValidationError(string.Join("\n", errors));
            return false;
        }

        return true;
    }

    /// <summary>
    /// Valida i campi split prima di costruire Options
    /// </summary>
    /// <returns>True se i campi sono validi</returns>
    private bool ValidateSplitInput()
    {
        List<string> errors = new List<string>();
        if (string.IsNullOrEmpty(_splitSource.Trim()))
        {
            errors.Add(AppText.T("web.config.validation.sourceRequired"));
        }

        if (!string.IsNullOrEmpty(_splitSourceRaw.Trim()) && System.IO.Directory.Exists(_splitSourceRaw.Trim()))
        {
            errors.Add(AppText.T("web.config.validation.sourceRawMustBeFile"));
        }

        if (string.IsNullOrEmpty(_splitCutMode))
        {
            errors.Add(AppText.T("web.config.validation.cutModeRequired"));
        }

        if (_splitCutMode == SPLIT_CUT_PATTERN && string.IsNullOrEmpty(_splitPattern.Trim()))
        {
            errors.Add(AppText.T("web.config.validation.patternRequired"));
        }

        if (_splitCutMode == SPLIT_CUT_RANGES && string.IsNullOrEmpty(_splitRanges.Trim()))
        {
            errors.Add(AppText.T("web.config.validation.rangesRequired"));
        }

        if (_splitCutMode == SPLIT_CUT_SPLIT_AT && string.IsNullOrEmpty(_splitAt.Trim()))
        {
            errors.Add(AppText.T("web.config.validation.splitAtRequired"));
        }

        if (_splitCutMode == SPLIT_CUT_TRIM && string.IsNullOrEmpty(_splitTrimStart.Trim()) && string.IsNullOrEmpty(_splitTrimEnd.Trim()))
        {
            errors.Add(AppText.T("web.config.validation.trimRequired"));
        }

        if (errors.Count > 0)
        {
            ShowValidationError(string.Join("\n", errors));
            return false;
        }

        return true;
    }

    /// <summary>
    /// Mostra l'errore di validazione nella dialog e come notifica Radzen
    /// </summary>
    /// <param name="errorMessage">Errore da mostrare</param>
    private void ShowValidationError(string errorMessage)
    {
        _validationError = errorMessage;
        NotificationService.Notify(NotificationSeverity.Error, AppText.T("validation.invalidConfig"), errorMessage, 8000);
    }

    /// <summary>
    /// Parsa stringa CSV e popola lista
    /// </summary>
    /// <param name="text">Testo CSV</param>
    /// <param name="list">Lista destinazione</param>
    private void ParseCsv(string text, List<string> list)
    {
        string[] parts;
        string trimmed;

        list.Clear();
        if (!string.IsNullOrEmpty(text))
        {
            parts = text.Split(',');
            for (int i = 0; i < parts.Length; i++)
            {
                trimmed = parts[i].Trim();
                if (!string.IsNullOrEmpty(trimmed))
                    list.Add(trimmed);
            }
        }
    }

    /// <summary>
    /// Aggiorna il pane help contestuale
    /// </summary>
    /// <param name="key">Chiave campo</param>
    private void SetFieldHelp(string key)
    {
        string titleKey = "web.config.help." + key + ".title";
        string textKey = "web.config.help." + key + ".text";
        _fieldHelpTitle = AppText.T(titleKey);
        _fieldHelpText = AppText.T(textKey);
    }

    /// <summary>
    /// Determina la modalità di taglio configurata
    /// </summary>
    /// <param name="split">Opzioni split</param>
    /// <returns>Identificativo modalità di taglio</returns>
    private string DetectSplitCutMode(MkvSplitOptions split)
    {
        if (split == null)
            return "";

        if (!string.IsNullOrEmpty(split.Pattern))
            return SPLIT_CUT_PATTERN;

        if (!string.IsNullOrEmpty(split.Ranges))
            return SPLIT_CUT_RANGES;

        if (!string.IsNullOrEmpty(split.SplitAt))
            return SPLIT_CUT_SPLIT_AT;

        if (!string.IsNullOrEmpty(split.TrimStart) || !string.IsNullOrEmpty(split.TrimEnd))
            return SPLIT_CUT_TRIM;

        if (split.ChaptersEach)
            return SPLIT_CUT_CHAPTERS_EACH;

        return "";
    }

    /// <summary>
    /// Apre il dialog browse cartella per il campo specificato
    /// </summary>
    /// <param name="fieldIndex">Indice campo: 0=source, 1=lingua, 2=dest</param>
    private void BrowseFolder(int fieldIndex)
    {
        _browseFieldIndex = fieldIndex;
        _browseShowFiles = fieldIndex == 0 || fieldIndex == 1;
        _browseAllowCurrentFolderSelection = true;
        _browseAllowedExtensions = _browseShowFiles ? GetConfiguredExtensions() : new List<string>();

        // Determina percorso iniziale dal campo corrente
        if (fieldIndex == 0)
            _browseInitialPath = _sourceFolder;
        else if (fieldIndex == 1)
            _browseInitialPath = _languageFolder;
        else if (fieldIndex == 2)
            _browseInitialPath = _destFolder;

        _showBrowse = true;
    }

    /// <summary>
    /// Apre il dialog browse per un campo split
    /// </summary>
    /// <param name="fieldIndex">Indice campo split</param>
    /// <param name="showFiles">Flag: mostra file selezionabili</param>
    /// <param name="allowCurrentFolderSelection">True per consentire la selezione della cartella corrente</param>
    private void BrowseSplit(int fieldIndex, bool showFiles, bool allowCurrentFolderSelection)
    {
        _browseFieldIndex = fieldIndex;
        _browseShowFiles = showFiles;
        _browseAllowCurrentFolderSelection = allowCurrentFolderSelection;
        _browseAllowedExtensions = showFiles ? GetConfiguredExtensions() : new List<string>();

        if (fieldIndex == 10)
            _browseInitialPath = _splitSource;
        else if (fieldIndex == 11)
            _browseInitialPath = _splitOutputDir;
        else if (fieldIndex == 12)
            _browseInitialPath = _splitSourceRaw;

        _showBrowse = true;
    }

    /// <summary>
    /// Chiude il dialog browse cartella
    /// </summary>
    private void CloseBrowse()
    {
        _showBrowse = false;
    }

    /// <summary>
    /// Applica il percorso selezionato dal dialog browse
    /// </summary>
    /// <param name="selectedPath">Percorso selezionato</param>
    private void ApplyBrowse(string selectedPath)
    {
        _showBrowse = false;

        if (string.IsNullOrEmpty(selectedPath))
            return;

        // Applica al campo corretto
        if (_browseFieldIndex == 0)
            _sourceFolder = selectedPath;
        else if (_browseFieldIndex == 1)
            _languageFolder = selectedPath;
        else if (_browseFieldIndex == 2)
            _destFolder = selectedPath;
        else if (_browseFieldIndex == 10)
            _splitSource = selectedPath;
        else if (_browseFieldIndex == 11)
            _splitOutputDir = selectedPath;
        else if (_browseFieldIndex == 12)
            _splitSourceRaw = selectedPath;
    }

    /// <summary>
    /// Verifica se almeno uno dei due input Remux è un file
    /// </summary>
    /// <returns>True se è attiva una selezione file singolo</returns>
    private bool IsSingleFileSelection()
    {
        return System.IO.File.Exists(_sourceFolder) || System.IO.File.Exists(_languageFolder);
    }

    /// <summary>
    /// Verifica se Source e Language combinano file e cartella
    /// </summary>
    /// <returns>True se la combinazione non è valida</returns>
    private bool IsMixedSingleFileSelection()
    {
        bool sourceIsFile = System.IO.File.Exists(_sourceFolder);
        bool languageIsFile = System.IO.File.Exists(_languageFolder);
        bool languageIsFolder = System.IO.Directory.Exists(_languageFolder);
        bool needsMerge = !string.IsNullOrEmpty(_targetLang.Trim());

        if (sourceIsFile)
            return needsMerge ? !languageIsFile : languageIsFile || languageIsFolder;

        return languageIsFile;
    }

    /// <summary>
    /// Parsa le estensioni configurate per il filtro del browser
    /// </summary>
    /// <returns>Lista estensioni senza punto</returns>
    private List<string> GetConfiguredExtensions()
    {
        List<string> result = new List<string>();
        string[] parts = _extensions.Split(',');

        for (int i = 0; i < parts.Length; i++)
        {
            string extension = parts[i].Trim().TrimStart('.');
            if (!string.IsNullOrEmpty(extension))
                result.Add(extension);
        }

        return result;
    }

    /// <summary>
    /// Gestisce cambio formato audio e pulisce opzioni dipendenti non più applicabili
    /// </summary>
    private void OnAudioFormatChanged(ChangeEventArgs args)
    {
        string audioFormat = args.Value != null ? args.Value.ToString() : null;
        _audioFormat = audioFormat != null ? audioFormat.Trim().ToLowerInvariant() : "";
        if (string.IsNullOrEmpty(_audioFormat))
        {
            _audioProcessingScope = "disabled";
            _audioDownsample24To16 = false;
            _audioPeakNormalize = false;
            ResetAudioSourceFill();
        }
        else if (_audioFormat != "flac" && _audioFormat != "lpcm")
        {
            _audioDownsample24To16 = false;
        }

        NormalizeMandatoryAudioScope();
    }

    /// <summary>
    /// Gestisce il cambio Speed Correction e mantiene valido lo scope audio obbligatorio
    /// </summary>
    private void OnSpeedCorrectionChanged(ChangeEventArgs args)
    {
        string selectedValue = args.Value != null ? args.Value.ToString() : "";
        if (!string.IsNullOrEmpty(_customSpeedCorrectionFactor) && string.Equals(selectedValue, _customSpeedCorrectionFactor, StringComparison.Ordinal))
        {
            _speedCorrectionPreset = _customSpeedCorrectionFactor;
        }
        else
        {
            _customSpeedCorrectionFactor = "";
            _speedCorrectionPreset = NormalizeSpeedCorrectionPreset(selectedValue);
        }
        NormalizeMandatoryAudioScope();
    }

    /// <summary>
    /// Limita la configurazione UI ai rapporti di playback supportati dalla tendina
    /// </summary>
    /// <param name="value">Valore da normalizzare</param>
    /// <returns>Preset supportato oppure stringa vuota</returns>
    private static string NormalizeSpeedCorrectionPreset(string value)
    {
        string preset = value != null ? value.Trim() : "";
        if (preset == "1001/1000" || preset == "1000/1001" || preset == "1001/960" || preset == "960/1001" || preset == "5/4" || preset == "4/5" || preset == "25/24" || preset == "24/25" || preset == "1250/1001" || preset == "1001/1250" || preset == "1200/1001" || preset == "1001/1200")
            return preset;
        return "";
    }

    /// <summary>
    /// Toggle SubOnly e riallinea la policy audio della timeline
    /// </summary>
    private void ToggleSubOnly(bool value)
    {
        _subOnly = value;
        NormalizeMandatoryAudioScope();
    }

    /// <summary>
    /// Toggle frame-sync con mutua esclusione deep analysis
    /// </summary>
    private void ToggleFrameSync(bool value)
    {
        _frameSync = value;
        if (_frameSync && _deepAnalysis)
        {
            _deepAnalysis = false;
        }
    }

    /// <summary>
    /// Toggle deep analysis con mutua esclusione frame-sync
    /// </summary>
    private void ToggleDeepAnalysis(bool value)
    {
        _deepAnalysis = value;
        if (_deepAnalysis && _frameSync)
        {
            _frameSync = false;
        }

        if (!_deepAnalysis)
        {
            _audioSourceFillInsertSilence = false;
        }

        NormalizeMandatoryAudioScope();
    }

    /// <summary>
    /// True se Speed Correction o DeepAnalysis richiedono audio Language processato
    /// </summary>
    private bool RequiresTimelineAudioProcessing()
    {
        return !_subOnly &&
            !string.IsNullOrEmpty(_targetLang.Trim()) &&
            (!string.IsNullOrEmpty(_speedCorrectionPreset) || _deepAnalysis);
    }

    /// <summary>
    /// Imposta Language come scope minimo senza scegliere automaticamente il codec
    /// </summary>
    private void NormalizeMandatoryAudioScope()
    {
        if (RequiresTimelineAudioProcessing() && !string.IsNullOrEmpty(_audioFormat) && _audioProcessingScope == "disabled")
        {
            _audioProcessingScope = "lang";
        }
    }

    /// <summary>
    /// Toggle audio source fill e azzera lo stato nascosto quando viene disabilitato
    /// </summary>
    private void ToggleAudioSourceFill(bool value)
    {
        _audioSourceFillEnabled = value;
        if (!_audioSourceFillEnabled)
        {
            ResetAudioSourceFill();
        }
    }

    /// <summary>
    /// Azzera opzioni audio source fill
    /// </summary>
    private void ResetAudioSourceFill()
    {
        _audioSourceFillEnabled = false;
        _audioSourceFillThresholdMs = "0";
        _audioSourceFillLanguage = "";
        _audioSourceFillStart = false;
        _audioSourceFillEnd = false;
        _audioSourceFillInsertSilence = false;
    }

}
