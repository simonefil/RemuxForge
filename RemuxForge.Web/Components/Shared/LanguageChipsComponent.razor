@using System.Linq
@using System.Threading.Tasks

@if (Multiple)
{
    <RadzenDropDown TValue="IEnumerable<string>" Data="@Catalog" TextProperty="Label" ValueProperty="Code"
                    Value="@Values" Change="@ChangeMultiple" Multiple="true" Chips="true" MaxSelectedLabels="@int.MaxValue" Disabled="@IsBlocked" AllowClear="true"
                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    FilterOperator="StringFilterOperator.Contains" Placeholder="@AppText.T("web.remux.searchLanguage")"
                    aria-label="@Label" Style="width:100%" />
}
else
{
    <RadzenDropDown TValue="string" Data="@Catalog" TextProperty="Label" ValueProperty="Code" Value="@Value"
                    Change="@ChangeSingle" Disabled="@IsBlocked" AllowClear="false" AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains"
                    Placeholder="@AppText.T("web.remux.searchLanguage")" aria-label="@Label" Style="width:100%">
        @* Niente AllowClear: con il valore impostato Radzen tratta il tasto Canc nel filtro come "svuota il valore"; si rimuove con la X del chip *@
        <ValueTemplate Context="language">
            <span @onclick:stopPropagation="true">
                <RadzenChip Text="@((language as LanguageItem)?.Label ?? Presentation(Value))" Close="RemoveSingle" Disabled="@IsBlocked"
                            RemoveChipTitle="@AppText.T("web.common.delete")" />
            </span>
        </ValueTemplate>
    </RadzenDropDown>
}

@code {
    [Parameter] public bool Multiple { get; set; } = true;
    [Parameter] public List<string> Values { get; set; } = new List<string>();
    [Parameter] public EventCallback<List<string>> ValuesChanged { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Func<bool> IsReadOnly { get; set; }
    private bool IsBlocked => Disabled || (IsReadOnly?.Invoke() ?? false);
    private sealed record LanguageItem(string Code, string Label);
    // Il catalogo selezionabile è quello ridotto del Core. I codici già impostati fuori elenco restano nei Data,
    // altrimenti Radzen non li risolve: niente chip, e al primo cambio sparirebbero dal valore. Le risorse sono esclusivamente presentazione.
    // Il riferimento resta stabile finché non cambiano i codici fuori elenco: a ogni Data nuovo Radzen azzera la selezione
    // e la ricerca nella vista filtrata, perdendo i valori che il filtro attivo nasconde.
    private List<LanguageItem> Catalog { get; set; } = new List<LanguageItem>();
    private string _catalogExtraCodes;
    protected override void OnParametersSet()
    {
        List<string> selectable = LanguageValidator.GetSelectable();
        List<string> extra = (Multiple ? Values ?? new List<string>() : new List<string> { Value })
            .Where(code => !string.IsNullOrEmpty(code) && !selectable.Contains(code, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        string extraCodes = string.Join(",", extra);
        if (extraCodes == _catalogExtraCodes) return;
        _catalogExtraCodes = extraCodes;
        Catalog = selectable.Concat(extra).Select(code => new LanguageItem(code, Presentation(code))).ToList();
    }
    private static string Presentation(string code)
    {
        string key = "web.remux.language." + code;
        string name = AppText.T(key);
        return name == "[" + key + "]" ? code : name + " · " + code;
    }
    private Task ChangeMultiple(object value)
    {
        if (IsBlocked) return Task.CompletedTask;
        List<string> codes = ((IEnumerable<string>)value ?? Array.Empty<string>()).Select(LanguageValidator.NormalizeToIso6392).Distinct().ToList();
        return ValuesChanged.InvokeAsync(codes);
    }
    private Task ChangeSingle(object value) => IsBlocked ? Task.CompletedTask : ValueChanged.InvokeAsync(string.IsNullOrEmpty(value as string) ? "" : LanguageValidator.NormalizeToIso6392((string)value));
    private Task RemoveSingle() => IsBlocked ? Task.CompletedTask : ValueChanged.InvokeAsync("");
}
