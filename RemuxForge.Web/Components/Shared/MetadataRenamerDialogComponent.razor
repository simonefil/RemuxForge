@inject DialogService DialogService

<div class="renamer-content">
    <div class="renamer-body">
        <div class="renamer-file-list">
            <RadzenDataGrid TItem="RenamePreviewItem"
                            Data="@this._previewItems"
                            class="rf-data-grid renamer-preview-grid"
                            AllowAlternatingRows="false"
                            AllowColumnResize="true"
                            AllowPaging="false"
                            AllowSorting="false"
                            ColumnWidth="360px"
                            GridLines="DataGridGridLines.Both"
                            RowRender="this.RenderPreviewRow">
                <Columns>
                    <RadzenDataGridColumn TItem="RenamePreviewItem"
                                          Property="OriginalName"
                                          Title="@AppText.T("web.rename.originalName")"
                                          MinWidth="160px"
                                          MaxWidth="720px" />
                    <RadzenDataGridColumn TItem="RenamePreviewItem"
                                          Title="@AppText.T("web.rename.newName")"
                                          MinWidth="160px"
                                          MaxWidth="720px">
                        <Template Context="item">
                            <span title="@(!string.IsNullOrEmpty(item.ErrorMessage) ? item.ErrorMessage : item.NewName)">@item.NewName</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>

        <div class="renamer-config">
            <div class="renamer-method-selector">
                <RadzenLabel Text="@AppText.T("web.rename.methodLabel")" Component="RenamerMethodType" />
                <RadzenDropDown TValue="RenameMethodType" Name="RenamerMethodType" Data="@MethodTypes" @bind-Value="this._selectedMethodType" @bind-Value:after="this.HandleMethodTypeChanged">
                    <Template Context="type">@GetRenameMethodTypeLabel((RenameMethodType)type)</Template>
                    <ValueTemplate Context="type">@GetRenameMethodTypeLabel((RenameMethodType)type)</ValueTemplate>
                </RadzenDropDown>
                <RadzenButton class="renamer-add-btn" Text="@AppText.T("web.rename.add")" Icon="add" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@this.HandleAddMethod" />
            </div>

            <div class="renamer-params">
                @if (!string.IsNullOrEmpty(this._paramsError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="renamer-params-error">@this._paramsError</RadzenAlert>
                }

                @if (this._selectedMethodType == RenameMethodType.Replace)
                {
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.searchLabel")" Component="RenamerSearchText" />
                        <RadzenTextBox Name="RenamerSearchText" @bind-Value="this._editingMethod.SearchText" @bind-Value:after="this.RecalculatePreview" Immediate="true" />
                    </div>
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.replaceLabel")" Component="RenamerReplaceText" />
                        <RadzenTextBox Name="RenamerReplaceText" @bind-Value="this._editingMethod.ReplaceText" @bind-Value:after="this.RecalculatePreview" Immediate="true" />
                    </div>
                    <LabeledSwitchComponent CssClass="renamer-checkbox-row" Label="@AppText.T("web.rename.caseSensitive")" Value="@this._editingMethod.CaseSensitive" ValueChanged="@((bool value) => { this._editingMethod.CaseSensitive = value; this.RecalculatePreview(); })" />
                    <LabeledSwitchComponent CssClass="renamer-checkbox-row" Label="@AppText.T("web.rename.useRegex")" Value="@this._editingMethod.UseRegex" ValueChanged="@((bool value) => { this._editingMethod.UseRegex = value; this.RecalculatePreview(); })" />
                }
                else if (this._selectedMethodType == RenameMethodType.Add)
                {
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.textLabel")" Component="RenamerInsertText" />
                        <RadzenTextBox Name="RenamerInsertText" @bind-Value="this._editingMethod.InsertText" @bind-Value:after="this.RecalculatePreview" Immediate="true" />
                    </div>
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.positionLabel")" Component="RenamerInsertPosition" />
                        <RadzenNumeric TValue="int" Name="RenamerInsertPosition" @bind-Value="this._editingMethod.InsertPosition" @bind-Value:after="this.RecalculatePreview" />
                    </div>
                    <LabeledSwitchComponent CssClass="renamer-checkbox-row" Label="@AppText.T("web.rename.fromEnd")" Value="@this._editingMethod.FromEnd" ValueChanged="@((bool value) => { this._editingMethod.FromEnd = value; this.RecalculatePreview(); })" />
                }
                else if (this._selectedMethodType == RenameMethodType.Remove)
                {
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.modeLabel")" Component="RenamerRemoveByPattern" />
                        <RadzenDropDown TValue="bool" Name="RenamerRemoveByPattern" Data="@RemoveModes" @bind-Value="this._editingMethod.RemoveByPattern" @bind-Value:after="this.RecalculatePreview">
                            <Template Context="value">@GetRemoveModeLabel((bool)value)</Template>
                            <ValueTemplate Context="value">@GetRemoveModeLabel((bool)value)</ValueTemplate>
                        </RadzenDropDown>
                    </div>

                    @if (!this._editingMethod.RemoveByPattern)
                    {
                        <div class="renamer-param-row">
                            <RadzenLabel Text="@AppText.T("web.rename.startLabel")" Component="RenamerRemoveStartIndex" />
                            <RadzenNumeric TValue="int" Name="RenamerRemoveStartIndex" @bind-Value="this._editingMethod.RemoveStartIndex" @bind-Value:after="this.RecalculatePreview" />
                        </div>
                        <div class="renamer-param-row">
                            <RadzenLabel Text="@AppText.T("web.rename.countLabel")" Component="RenamerRemoveCount" />
                            <RadzenNumeric TValue="int" Name="RenamerRemoveCount" @bind-Value="this._editingMethod.RemoveCount" @bind-Value:after="this.RecalculatePreview" />
                        </div>
                        <LabeledSwitchComponent CssClass="renamer-checkbox-row" Label="@AppText.T("web.rename.fromEnd")" Value="@this._editingMethod.RemoveFromEnd" ValueChanged="@((bool value) => { this._editingMethod.RemoveFromEnd = value; this.RecalculatePreview(); })" />
                    }
                    else
                    {
                        <div class="renamer-param-row">
                            <RadzenLabel Text="@AppText.T("web.rename.patternLabel")" Component="RenamerRemovePattern" />
                            <RadzenTextBox Name="RenamerRemovePattern" @bind-Value="this._editingMethod.RemovePattern" @bind-Value:after="this.RecalculatePreview" Immediate="true" />
                        </div>
                        <LabeledSwitchComponent CssClass="renamer-checkbox-row" Label="@AppText.T("web.rename.caseSensitive")" Value="@this._editingMethod.RemovePatternCaseSensitive" ValueChanged="@((bool value) => { this._editingMethod.RemovePatternCaseSensitive = value; this.RecalculatePreview(); })" />
                        <LabeledSwitchComponent CssClass="renamer-checkbox-row" Label="@AppText.T("web.rename.useRegex")" Value="@this._editingMethod.RemovePatternUseRegex" ValueChanged="@((bool value) => { this._editingMethod.RemovePatternUseRegex = value; this.RecalculatePreview(); })" />
                    }
                }
                else if (this._selectedMethodType == RenameMethodType.NewCase)
                {
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.modeLabel")" Component="RenamerCaseMode" />
                        <RadzenDropDown TValue="int" Name="RenamerCaseMode" Data="@CaseModeOptions" @bind-Value="this._editingMethod.CaseMode" @bind-Value:after="this.RecalculatePreview">
                            <Template Context="value">@GetCaseModeLabel((int)value)</Template>
                            <ValueTemplate Context="value">@GetCaseModeLabel((int)value)</ValueTemplate>
                        </RadzenDropDown>
                    </div>
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.scopeLabel")" Component="RenamerCaseScope" />
                        <RadzenDropDown TValue="int" Name="RenamerCaseScope" Data="@CaseScopeOptions" @bind-Value="this._editingMethod.CaseScope" @bind-Value:after="this.RecalculatePreview">
                            <Template Context="value">@GetCaseScopeLabel((int)value)</Template>
                            <ValueTemplate Context="value">@GetCaseScopeLabel((int)value)</ValueTemplate>
                        </RadzenDropDown>
                    </div>
                }
                else if (this._selectedMethodType == RenameMethodType.NewName)
                {
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.patternLabel")" Component="RenamerNamePattern" />
                        <RadzenTextBox Name="RenamerNamePattern" @bind-Value="this._editingMethod.NamePattern" @bind-Value:after="this.RecalculatePreview" Immediate="true" />
                    </div>
                    <div class="renamer-tag-help">
                        @AppText.T("web.rename.tagsLabel") &lt;Name&gt; &lt;Ext&gt; &lt;Folder&gt;
                        &lt;Inc:start:step:pad&gt;
                        &lt;Date:format&gt;
                        &lt;Rand:min:max&gt;
                    </div>
                }
                else if (this._selectedMethodType == RenameMethodType.Trim)
                {
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.charsLabel")" Component="RenamerTrimCharacters" />
                        <RadzenTextBox Name="RenamerTrimCharacters" @bind-Value="this._editingMethod.TrimCharacters" @bind-Value:after="this.RecalculatePreview" Immediate="true" />
                    </div>
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.locationLabel")" Component="RenamerTrimLocation" />
                        <RadzenDropDown TValue="int" Name="RenamerTrimLocation" Data="@TrimLocationOptions" @bind-Value="this._editingMethod.TrimLocation" @bind-Value:after="this.RecalculatePreview">
                            <Template Context="value">@GetTrimLocationLabel((int)value)</Template>
                            <ValueTemplate Context="value">@GetTrimLocationLabel((int)value)</ValueTemplate>
                        </RadzenDropDown>
                    </div>
                    <div class="renamer-param-row">
                        <RadzenLabel Text="@AppText.T("web.rename.scopeLabel")" Component="RenamerTrimScope" />
                        <RadzenDropDown TValue="int" Name="RenamerTrimScope" Data="@TrimScopeOptions" @bind-Value="this._editingMethod.TrimScope" @bind-Value:after="this.RecalculatePreview">
                            <Template Context="value">@GetTrimScopeLabel((int)value)</Template>
                            <ValueTemplate Context="value">@GetTrimScopeLabel((int)value)</ValueTemplate>
                        </RadzenDropDown>
                    </div>
                }
            </div>

            <div class="renamer-stack-header">@AppText.F("web.rename.methodsHeader", this._methodStack.Count)</div>

            <div class="renamer-stack">
                @for (int idx = 0; idx < this._methodStack.Count; idx++)
                {
                    int i = idx;
                    RenameMethod method = this._methodStack[i];
                    <div class="renamer-stack-item">
                        <span class="renamer-stack-item-name" title="@method.GetDisplayName()">@method.GetDisplayName()</span>
                        <div class="renamer-stack-item-actions">
                            @if (i > 0)
                            {
                                <RadzenButton Icon="arrow_upward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => this.HandleMoveUp(i))" title="@AppText.T("web.rename.moveUp")" aria-label="@AppText.T("web.rename.moveUp")" />
                            }
                            @if (i < this._methodStack.Count - 1)
                            {
                                <RadzenButton Icon="arrow_downward" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => this.HandleMoveDown(i))" title="@AppText.T("web.rename.moveDown")" aria-label="@AppText.T("web.rename.moveDown")" />
                            }
                            <RadzenButton Icon="content_copy" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => this.HandleDuplicateMethod(i))" title="@AppText.T("web.rename.duplicate")" aria-label="@AppText.T("web.rename.duplicate")" />
                            <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Click="@(() => this.HandleRemoveMethod(i))" title="@AppText.T("web.rename.remove")" aria-label="@AppText.T("web.rename.remove")" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="renamer-statusbar">
        <span>@this._statusText</span>
        <div class="renamer-statusbar-actions">
            <RadzenButton Text="@AppText.T("web.rename.rename")" Icon="drive_file_rename_outline" Click="@this.HandleRename" Disabled="@(!this.CanRename())" />
            <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@this.HandleClose" />
        </div>
    </div>

</div>

@code {
    /// <summary>
    /// Metodi rename selezionabili
    /// </summary>
    private static readonly List<RenameMethodType> MethodTypes = new List<RenameMethodType>
    {
        RenameMethodType.Replace, RenameMethodType.Add, RenameMethodType.Remove, RenameMethodType.NewCase, RenameMethodType.NewName, RenameMethodType.Trim
    };

    /// <summary>
    /// Modalità di rimozione: per posizione o per pattern
    /// </summary>
    private static readonly List<bool> RemoveModes = new List<bool> { false, true };

    /// <summary>
    /// Valori delle tendine a tre opzioni di maiuscole, ambito e posizione
    /// </summary>
    private static readonly List<int> ThreeOptions = new List<int> { 0, 1, 2 };

    /// <summary>
    /// Valori della modalità maiuscole
    /// </summary>
    private static readonly List<int> CaseModeOptions = ThreeOptions;

    /// <summary>
    /// Valori dell'ambito delle maiuscole
    /// </summary>
    private static readonly List<int> CaseScopeOptions = ThreeOptions;

    /// <summary>
    /// Valori della posizione del trim
    /// </summary>
    private static readonly List<int> TrimLocationOptions = ThreeOptions;

    /// <summary>
    /// Valori dell'ambito del trim
    /// </summary>
    private static readonly List<int> TrimScopeOptions = ThreeOptions;

    /// <summary>
    /// Record metadata correnti
    /// </summary>
    [Parameter] public List<MkvMetadataRecord> Records { get; set; }

    /// <summary>
    /// File sorgente da rinominare
    /// </summary>
    private List<RenameFileEntry> _entries;

    /// <summary>
    /// Pipeline metodi rename applicata
    /// </summary>
    private List<RenameMethod> _methodStack;

    /// <summary>
    /// Anteprima rinomina corrente
    /// </summary>
    private List<RenamePreviewItem> _previewItems;

    /// <summary>
    /// Metodo in editing prima dell'aggiunta alla pipeline
    /// </summary>
    private RenameMethod _editingMethod;

    /// <summary>
    /// Tipo metodo selezionato
    /// </summary>
    private RenameMethodType _selectedMethodType;

    /// <summary>
    /// Errore parametri metodo corrente
    /// </summary>
    private string _paramsError;

    /// <summary>
    /// Testo barra stato
    /// </summary>
    private string _statusText;

    /// <summary>
    /// Indica se la rinomina è stata eseguita
    /// </summary>
    private bool _didRename;

    /// <summary>
    /// Inizializza stato finestra
    /// </summary>
    protected override void OnInitialized()
    {
        this._entries = this.BuildEntries();
        this._methodStack = new List<RenameMethod>();
        this._previewItems = new List<RenamePreviewItem>();
        this._editingMethod = new RenameMethod();
        this._selectedMethodType = RenameMethodType.Replace;
        this._paramsError = "";
        this._statusText = "";
        this._didRename = false;
        this.RecalculatePreview();
    }

    /// <summary>
    /// Restituisce l'etichetta localizzata del metodo rename
    /// </summary>
    /// <param name="methodType">Tipo metodo rename</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetRenameMethodTypeLabel(RenameMethodType methodType)
    {
        return AppText.T("web.rename.method." + methodType.ToString());
    }

    /// <summary>
    /// Etichetta della modalità di rimozione
    /// </summary>
    /// <param name="byPattern">True per pattern</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetRemoveModeLabel(bool byPattern)
    {
        return AppText.T(byPattern ? "web.rename.byPattern" : "web.rename.byPosition");
    }

    /// <summary>
    /// Etichetta della modalità maiuscole
    /// </summary>
    /// <param name="value">Valore</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetCaseModeLabel(int value)
    {
        if (value == 1)
            return AppText.T("web.rename.case.uppercase");
        if (value == 2)
            return AppText.T("web.rename.case.title");
        return AppText.T("web.rename.case.lowercase");
    }

    /// <summary>
    /// Etichetta dell'ambito di applicazione
    /// </summary>
    /// <param name="value">Valore</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetScopeLabel(int value)
    {
        if (value == 1)
            return AppText.T("web.rename.scope.extensionOnly");
        if (value == 2)
            return AppText.T("web.rename.scope.fullName");
        return AppText.T("web.rename.scope.nameOnly");
    }

    /// <summary>
    /// Etichetta dell'ambito delle maiuscole
    /// </summary>
    /// <param name="value">Valore</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetCaseScopeLabel(int value)
    {
        return GetScopeLabel(value);
    }

    /// <summary>
    /// Etichetta dell'ambito del trim
    /// </summary>
    /// <param name="value">Valore</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetTrimScopeLabel(int value)
    {
        return GetScopeLabel(value);
    }

    /// <summary>
    /// Etichetta della posizione del trim
    /// </summary>
    /// <param name="value">Valore</param>
    /// <returns>Etichetta localizzata</returns>
    private static string GetTrimLocationLabel(int value)
    {
        if (value == 1)
            return AppText.T("web.rename.location.end");
        if (value == 2)
            return AppText.T("web.rename.location.both");
        return AppText.T("web.rename.location.start");
    }

    /// <summary>
    /// Costruisce gli entry file dai record metadata
    /// </summary>
    /// <returns>Lista file rinominabili</returns>
    private List<RenameFileEntry> BuildEntries()
    {
        List<RenameFileEntry> entries = new List<RenameFileEntry>();
        if (this.Records == null)
            return entries;

        for (int i = 0; i < this.Records.Count; i++)
        {
            MkvMetadataRecord record = this.Records[i];
            if (record == null || string.IsNullOrEmpty(record.InputFile))
                continue;

            RenameFileEntry entry = new RenameFileEntry();
            entry.FullPath = record.InputFile;
            entry.Name = System.IO.Path.GetFileName(record.InputFile);
            entry.LastModified = System.IO.File.Exists(record.InputFile) ? System.IO.File.GetLastWriteTime(record.InputFile) : DateTime.MinValue;
            entries.Add(entry);
        }

        return entries;
    }

    /// <summary>
    /// Resetta il metodo in editing al cambio tipo
    /// </summary>
    private void HandleMethodTypeChanged()
    {
        this._editingMethod = new RenameMethod();
        this._paramsError = "";
        this.RecalculatePreview();
    }

    /// <summary>
    /// Ricalcola anteprima includendo il metodo in editing
    /// </summary>
    private void RecalculatePreview()
    {
        List<RenameMethod> previewStack = new List<RenameMethod>(this._methodStack);

        if (this.HasEditingMethodInput())
        {
            RenameMethod editCopy = this._editingMethod.Clone();
            editCopy.MethodType = this._selectedMethodType;
            previewStack.Add(editCopy);
        }

        this._previewItems = RenameEngine.GeneratePreview(this._entries, previewStack);
        this._paramsError = this.ValidateEditingMethod();
        this.UpdateStatusText();
    }

    /// <summary>
    /// Verifica se il metodo in editing contiene input applicabile
    /// </summary>
    /// <returns>True se il metodo può entrare in anteprima</returns>
    private bool HasEditingMethodInput()
    {
        bool result = false;

        if (this._selectedMethodType == RenameMethodType.Replace)
        {
            result = !string.IsNullOrEmpty(this._editingMethod.SearchText);
        }
        else if (this._selectedMethodType == RenameMethodType.Add)
        {
            result = !string.IsNullOrEmpty(this._editingMethod.InsertText);
        }
        else if (this._selectedMethodType == RenameMethodType.Remove)
        {
            if (this._editingMethod.RemoveByPattern)
            {
                result = !string.IsNullOrEmpty(this._editingMethod.RemovePattern);
            }
            else
            {
                result = this._editingMethod.RemoveCount > 0;
            }
        }
        else if (this._selectedMethodType == RenameMethodType.NewCase)
        {
            result = true;
        }
        else if (this._selectedMethodType == RenameMethodType.NewName)
        {
            result = !string.IsNullOrEmpty(this._editingMethod.NamePattern);
        }
        else if (this._selectedMethodType == RenameMethodType.Trim)
        {
            result = !string.IsNullOrEmpty(this._editingMethod.TrimCharacters);
        }

        return result;
    }

    /// <summary>
    /// Valida il metodo in editing
    /// </summary>
    /// <returns>Messaggio errore o stringa vuota</returns>
    private string ValidateEditingMethod()
    {
        string error = "";

        if (this._selectedMethodType == RenameMethodType.Replace && this._editingMethod.UseRegex && !string.IsNullOrEmpty(this._editingMethod.SearchText))
        {
            try
            {
                System.Text.RegularExpressions.Regex.Match("", this._editingMethod.SearchText);
            }
            catch (ArgumentException ex)
            {
                error = AppText.F("web.rename.invalidRegex", ex.Message);
            }
        }
        else if (this._selectedMethodType == RenameMethodType.Remove && this._editingMethod.RemoveByPattern && this._editingMethod.RemovePatternUseRegex && !string.IsNullOrEmpty(this._editingMethod.RemovePattern))
        {
            try
            {
                System.Text.RegularExpressions.Regex.Match("", this._editingMethod.RemovePattern);
            }
            catch (ArgumentException ex)
            {
                error = AppText.F("web.rename.invalidRegex", ex.Message);
            }
        }

        return error;
    }

    /// <summary>
    /// Aggiorna il testo riepilogo della barra stato
    /// </summary>
    private void UpdateStatusText()
    {
        int fileCount = this._previewItems.Count;
        int conflictCount = 0;
        int errorCount = 0;
        int changedCount = 0;

        for (int i = 0; i < this._previewItems.Count; i++)
        {
            if (this._previewItems[i].HasConflict)
            {
                conflictCount++;
            }
            if (this._previewItems[i].HasError)
            {
                errorCount++;
            }
            if (this._previewItems[i].OriginalName != this._previewItems[i].NewName)
            {
                changedCount++;
            }
        }

        this._statusText = AppText.F("web.rename.statusBase", fileCount, changedCount);
        if (conflictCount > 0)
        {
            this._statusText = this._statusText + AppText.F("web.rename.statusConflictsSuffix", conflictCount);
        }
        if (errorCount > 0)
        {
            this._statusText = this._statusText + AppText.F("web.rename.statusErrorsSuffix", errorCount);
        }
    }

    /// <summary>
    /// Applica lo stato visuale alle righe dell'anteprima
    /// </summary>
    /// <param name="args">Argomenti rendering riga</param>
    private void RenderPreviewRow(RowRenderEventArgs<RenamePreviewItem> args)
    {
        if (args.Data.HasConflict)
            args.Attributes["class"] = "rz-data-row conflict";
        else if (args.Data.HasError)
            args.Attributes["class"] = "rz-data-row error";
        else if (args.Data.OriginalName != args.Data.NewName)
            args.Attributes["class"] = "rz-data-row changed";
    }

    /// <summary>
    /// Verifica se la rinomina può essere eseguita
    /// </summary>
    /// <returns>True se sono presenti modifiche senza conflitti</returns>
    private bool CanRename()
    {
        if (this._methodStack.Count == 0)
        {
            return false;
        }

        for (int i = 0; i < this._previewItems.Count; i++)
        {
            if (this._previewItems[i].HasConflict || this._previewItems[i].HasError)
            {
                return false;
            }
        }

        for (int i = 0; i < this._previewItems.Count; i++)
        {
            if (this._previewItems[i].OriginalName != this._previewItems[i].NewName)
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Aggiunge il metodo in editing alla pipeline
    /// </summary>
    private void HandleAddMethod()
    {
        if (!this.HasEditingMethodInput())
        {
            return;
        }

        string error = this.ValidateEditingMethod();
        if (!string.IsNullOrEmpty(error))
        {
            this._paramsError = error;
            return;
        }

        RenameMethod method = this._editingMethod.Clone();
        method.MethodType = this._selectedMethodType;
        this._methodStack.Add(method);

        this._editingMethod = new RenameMethod();
        this._paramsError = "";
        this._previewItems = RenameEngine.GeneratePreview(this._entries, this._methodStack);
        this.UpdateStatusText();
    }

    /// <summary>
    /// Rimuove un metodo dalla pipeline
    /// </summary>
    /// <param name="index">Indice metodo</param>
    private void HandleRemoveMethod(int index)
    {
        if (index >= 0 && index < this._methodStack.Count)
        {
            this._methodStack.RemoveAt(index);
            this.RecalculatePreview();
        }
    }

    /// <summary>
    /// Duplica un metodo nella posizione immediatamente successiva
    /// </summary>
    /// <param name="index">Indice metodo</param>
    private void HandleDuplicateMethod(int index)
    {
        if (index >= 0 && index < this._methodStack.Count)
        {
            this._methodStack.Insert(index + 1, this._methodStack[index].Clone());
            this.RecalculatePreview();
        }
    }

    /// <summary>
    /// Sposta un metodo verso l'alto
    /// </summary>
    /// <param name="index">Indice metodo</param>
    private void HandleMoveUp(int index)
    {
        if (index > 0 && index < this._methodStack.Count)
        {
            RenameMethod temp = this._methodStack[index];
            this._methodStack[index] = this._methodStack[index - 1];
            this._methodStack[index - 1] = temp;
            this.RecalculatePreview();
        }
    }

    /// <summary>
    /// Sposta un metodo verso il basso
    /// </summary>
    /// <param name="index">Indice metodo</param>
    private void HandleMoveDown(int index)
    {
        if (index >= 0 && index < this._methodStack.Count - 1)
        {
            RenameMethod temp = this._methodStack[index];
            this._methodStack[index] = this._methodStack[index + 1];
            this._methodStack[index + 1] = temp;
            this.RecalculatePreview();
        }
    }

    /// <summary>
    /// Esegue la rinomina dei file
    /// </summary>
    private void HandleRename()
    {
        if (!this.CanRename())
        {
            return;
        }

        this._previewItems = RenameEngine.GeneratePreview(this._entries, this._methodStack);

        RenameExecutionService service = new RenameExecutionService();
        RenameExecutionResult result = service.Execute(this._previewItems);
        if (result.Success)
        {
            this._didRename = result.SuccessCount > 0;
            this._statusText = AppText.F("web.rename.renamedFiles", result.SuccessCount);
            this.DialogService.Close(this._didRename);
        }
        else
        {
            this._statusText = AppText.F("web.rename.errorStatus", result.ErrorMessage);
        }
    }

    /// <summary>
    /// Chiude la finestra rename
    /// </summary>
    private void HandleClose()
    {
        this.DialogService.Close(this._didRename);
    }
}
