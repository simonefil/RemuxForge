<div class="form-row">
    <div class="ui-switch">
        <RadzenSwitch TValue="bool" Value="@Value" Change="@ValueChanged" Disabled="@Disabled" AriaLabel="@Label" />
        <span>@Label</span>
    </div>
</div>

@code {
    /// <summary>
    /// Etichetta toggle
    /// </summary>
    [Parameter] public string Label { get; set; } = "";

    /// <summary>
    /// Stato toggle
    /// </summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>
    /// Callback cambio stato
    /// </summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// True quando il toggle non accetta modifiche
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

}
