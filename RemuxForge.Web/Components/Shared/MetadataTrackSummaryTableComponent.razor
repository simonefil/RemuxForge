<table class="metadata-detail-track-table" divide-="none">
    <colgroup>
        <col class="metadata-track-col-selector" />
        <col class="metadata-track-col-type" />
        <col class="metadata-track-col-language" />
        <col class="metadata-track-col-format" />
        <col class="metadata-track-col-title" />
        <col class="metadata-track-col-size" />
        <col class="metadata-track-col-extra" />
    </colgroup>
    <thead>
        <tr>
            <th>@AppText.T("web.metadata.detail.selector")</th>
            <th>@AppText.T("web.metadata.detail.type")</th>
            <th>@AppText.T("web.metadata.detail.languageHeader")</th>
            <th>@AppText.T("web.metadata.detail.format")</th>
            <th>@AppText.T("web.metadata.detail.title")</th>
            <th>@AppText.T("web.metadata.detail.sizeHeader")</th>
            <th>@AppText.T("web.metadata.detail.extra")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (MkvMetadataTrackInfo track in GetTracks())
        {
            string rowClass = IsTrackRemoved(track.TrackSelector) ? "metadata-diff-removed" : "";
            <tr class="@rowClass">
                <td>@track.TrackSelector</td>
                <td>@track.TrackKind</td>
                <td class="@GetFieldClass(track.TrackSelector, GetDomainFieldKey(track, "language"))">@FormatValue(track.Language)</td>
                <td>@FormatValue(track.Format)</td>
                <td class="@GetFieldClass(track.TrackSelector, GetDomainFieldKey(track, "title"))">@FormatValue(track.Title)</td>
                <td>@FormatSize(track.StreamSize)</td>
                <td>@BuildExtra(track)</td>
            </tr>
        }
    </tbody>
</table>

@code {
    /// <summary>
    /// Record metadata da mostrare
    /// </summary>
    [Parameter] public MkvMetadataRecord Record { get; set; }

    /// <summary>
    /// Indica se usare i dati simulati post analisi
    /// </summary>
    [Parameter] public bool Simulated { get; set; }

    /// <summary>
    /// Restituisce le tracce da visualizzare
    /// </summary>
    /// <returns>Lista tracce</returns>
    private List<MkvMetadataTrackInfo> GetTracks()
    {
        MkvMetadataFileInfo info = this.GetInfo();
        return info != null && info.Tracks != null ? info.Tracks : new List<MkvMetadataTrackInfo>();
    }

    /// <summary>
    /// Restituisce il file info corrente o simulato
    /// </summary>
    /// <returns>Informazioni metadata del file</returns>
    private MkvMetadataFileInfo GetInfo()
    {
        if (this.Record == null)
            return new MkvMetadataFileInfo();

        if (this.Simulated)
            return this.Record.FileInfo != null ? this.Record.FileInfo : new MkvMetadataFileInfo();

        return this.Record.OriginalFileInfo != null && this.Record.OriginalFileInfo.Tracks != null && this.Record.OriginalFileInfo.Tracks.Count > 0
            ? this.Record.OriginalFileInfo
            : this.Record.FileInfo != null ? this.Record.FileInfo : new MkvMetadataFileInfo();
    }

    /// <summary>
    /// Restituisce la classe CSS del campo in base alla modifica simulata
    /// </summary>
    /// <param name="trackSelector">Selettore traccia</param>
    /// <param name="fieldKey">Chiave campo</param>
    /// <returns>Classe CSS differenziale</returns>
    private string GetFieldClass(string trackSelector, string fieldKey)
    {
        MkvMetadataChange change = this.FindLastChange(trackSelector, fieldKey);
        if (!this.Simulated || change == null)
            return "";

        if (string.IsNullOrEmpty(change.BeforeValue) && !string.IsNullOrEmpty(change.AfterValue))
            return "metadata-diff-added";

        if (!string.IsNullOrEmpty(change.BeforeValue) && string.IsNullOrEmpty(change.AfterValue))
            return "metadata-diff-removed";

        return "metadata-diff-modified";
    }

    /// <summary>
    /// Cerca l'ultima modifica registrata per campo
    /// </summary>
    /// <param name="trackSelector">Selettore traccia</param>
    /// <param name="fieldKey">Chiave campo</param>
    /// <returns>Modifica trovata o null</returns>
    private MkvMetadataChange FindLastChange(string trackSelector, string fieldKey)
    {
        MkvMetadataChange result = null;
        if (this.Record == null || this.Record.Changes == null)
            return result;

        for (int i = 0; i < this.Record.Changes.Count; i++)
        {
            if (this.Record.Changes[i].TrackSelector == trackSelector && this.Record.Changes[i].FieldKey == fieldKey)
                result = this.Record.Changes[i];
        }

        return result;
    }

    /// <summary>
    /// Verifica se la traccia risulta rimossa nella simulazione
    /// </summary>
    /// <param name="trackSelector">Selettore traccia</param>
    /// <returns>True se rimossa</returns>
    private bool IsTrackRemoved(string trackSelector)
    {
        if (!this.Simulated || this.Record == null || this.Record.Changes == null)
            return false;

        for (int i = 0; i < this.Record.Changes.Count; i++)
        {
            if (this.Record.Changes[i].OperationType == MkvMetadataOperationType.RemoveTrack && this.Record.Changes[i].TrackSelector == trackSelector)
                return true;
        }

        return false;
    }

    /// <summary>
    /// Costruisce la colonna extra del riepilogo traccia
    /// </summary>
    /// <param name="track">Traccia metadata</param>
    /// <returns>Testo riepilogo extra</returns>
    private static string BuildExtra(MkvMetadataTrackInfo track)
    {
        string width = GetValue(track.Fields, "video_width");
        string height = GetValue(track.Fields, "video_height");
        string channels = GetValue(track.Fields, "audio_channels_label");
        string bitDepth = GetValue(track.Fields, "audio_bitdepth");
        string sampleRate = GetValue(track.Fields, "audio_sampling_rate_khz");
        string forced = GetValue(track.Fields, GetDomainFieldKey(track, "forced"));
        string result = "";

        if (track.TrackKind == "video")
        {
            if (!string.IsNullOrEmpty(width) && !string.IsNullOrEmpty(height))
                result = width + "x" + height;
            AddPart(ref result, GetValue(track.Fields, "video_hdr_format"));
            AddPart(ref result, GetValue(track.Fields, "video_fps"));
        }
        else if (track.TrackKind == "audio")
        {
            AddPart(ref result, channels);
            if (!string.IsNullOrEmpty(bitDepth) || !string.IsNullOrEmpty(sampleRate))
                AddPart(ref result, bitDepth + "bit/" + sampleRate + "kHz");
        }
        else if (track.TrackKind == "subtitles")
        {
            AddPart(ref result, GetValue(track.Fields, "subtitle_format"));
            if (forced == "true")
                AddPart(ref result, AppText.T("web.metadata.detail.forced"));
        }

        return !string.IsNullOrEmpty(result) ? result : "-";
    }

    /// <summary>
    /// Costruisce la chiave campo specifica per dominio traccia
    /// </summary>
    /// <param name="track">Traccia metadata</param>
    /// <param name="suffix">Suffisso campo</param>
    /// <returns>Chiave campo specifica</returns>
    private static string GetDomainFieldKey(MkvMetadataTrackInfo track, string suffix)
    {
        if (track != null && track.TrackKind == "video")
            return "video_" + suffix;

        if (track != null && track.TrackKind == "audio")
            return "audio_" + suffix;

        if (track != null && track.TrackKind == "subtitles")
            return "subtitle_" + suffix;

        return suffix;
    }

    /// <summary>
    /// Aggiunge una parte testuale separata da spazio
    /// </summary>
    /// <param name="value">Valore aggregato</param>
    /// <param name="part">Parte da aggiungere</param>
    private static void AddPart(ref string value, string part)
    {
        if (string.IsNullOrEmpty(part))
            return;

        if (!string.IsNullOrEmpty(value))
            value += " ";

        value += part;
    }

    /// <summary>
    /// Legge un valore dal dizionario campi
    /// </summary>
    /// <param name="values">Dizionario valori</param>
    /// <param name="key">Chiave campo</param>
    /// <returns>Valore letto o stringa vuota</returns>
    private static string GetValue(Dictionary<string, string> values, string key)
    {
        string result;
        if (values != null && values.TryGetValue(key, out result))
            return result != null ? result : "";

        return "";
    }

    /// <summary>
    /// Formatta un valore testuale vuoto
    /// </summary>
    /// <param name="value">Valore originale</param>
    /// <returns>Valore visualizzabile</returns>
    private static string FormatValue(string value)
    {
        return !string.IsNullOrEmpty(value) ? value : "-";
    }

    /// <summary>
    /// Formatta dimensione stream
    /// </summary>
    /// <param name="size">Dimensione in byte</param>
    /// <returns>Dimensione visualizzabile</returns>
    private static string FormatSize(long size)
    {
        return size > 0 ? Utils.FormatSize(size) : "-";
    }
}
