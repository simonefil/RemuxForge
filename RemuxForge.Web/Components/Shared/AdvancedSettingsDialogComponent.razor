@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
    <div class="rf-dialog-body">

        <AdvancedSettingsSection Title="@AppText.T("web.advanced.section.analysis")">
            <AdvancedSettingsToggleRow Label="@AppText.T("web.advanced.deepAnalysisDiagnostics")" Value="_deepAnalysisDiagnostics" ValueChanged="ChangeDeepAnalysisDiagnostics" />
            <AdvancedSettingsToggleRow Label="@AppText.T("web.advanced.hardwareAcceleration")" Value="_ffHardwareAcceleration" ValueChanged="ChangeHardwareAcceleration" Disabled="_ffHardwareProbeRunning" />
            @if (_ffHardwareProbeRunning)
            {
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.advanced.hardwareBackend")</span>
                    <span>@AppText.T("web.advanced.probeRunning")</span>
                </div>
            }
            else if (_ffHardwareAcceleration && _ffHardwareAccelerationMethods.Count > 0)
            {
                <div class="form-row">
                    <RadzenLabel class="form-label" Text="@AppText.T("web.advanced.hardwareBackend")" Component="AdvancedHardwareBackend" />
                    <RadzenDropDown TValue="string" Name="AdvancedHardwareBackend" Data="@_ffHardwareAccelerationMethods" Value="@(string.IsNullOrEmpty(_ffHardwareAccelerationMethod) ? null : _ffHardwareAccelerationMethod)" Change="@ChangeHardwareAccelerationMethod" AllowClear="true" Placeholder="@AppText.T("web.advanced.select")" Style="max-width: 18rem;" />
                </div>
            }
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.advanced.visionBackend")" Component="AdvancedVisionBackend" />
                <RadzenDropDown TValue="VisionBackendKind" Name="AdvancedVisionBackend" Data="@VisionBackends" Value="@_visionBackend" Change="@ChangeVisionBackend" Disabled="@_siftVulkanProbeRunning" Style="max-width: 18rem;">
                    <Template Context="backend">@GetVisionBackendLabel((VisionBackendKind)backend)</Template>
                    <ValueTemplate Context="backend">@GetVisionBackendLabel((VisionBackendKind)backend)</ValueTemplate>
                </RadzenDropDown>
                @if (_siftVulkanProbeRunning)
                {
                    <span style="margin-left: 0.5ch;">@AppText.T("web.advanced.probeRunning")</span>
                }
                else if (_visionBackend == VisionBackendKind.Vulkan && !string.IsNullOrEmpty(_siftVulkanDeviceName))
                {
                    <span style="margin-left: 0.5ch;">@_siftVulkanDeviceName</span>
                }
            </div>
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.advanced.offsetSearchRadius")" Component="AdvancedOffsetSearchRadius" />
                <RadzenNumeric TValue="int" Name="AdvancedOffsetSearchRadius" Min="@OFFSET_SEARCH_RADIUS_MIN_MS" Max="@OFFSET_SEARCH_RADIUS_MAX_MS" @bind-Value="_offsetSearchRadiusMs" Style="max-width: 12rem;" /> <span style="margin-left: 0.5ch;">ms</span>
            </div>
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.advanced.minimumCoverage")" Component="AdvancedMinimumCoverage" />
                <RadzenNumeric TValue="double" Name="AdvancedMinimumCoverage" Min="0" Max="100" Step="0.1" @bind-Value="_minimumCoveragePercent" Style="max-width: 12rem;" /> <span style="margin-left: 0.5ch;">%</span>
            </div>
        </AdvancedSettingsSection>

    </div>
    <div class="rf-dialog-footer">
        @if (!string.IsNullOrEmpty(_validationError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rf-dialog-message">@_validationError</RadzenAlert>
        }
        <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Save" Disabled="@ProbeRunning" />
        <RadzenButton Text="@AppText.T("web.advanced.resetDefault")" Icon="restart_alt" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@ResetDefaults" Disabled="@ProbeRunning" />
        <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" Disabled="@ProbeRunning" />
    </div>
</div>

@code {
    /// <summary>
    /// Raggio minimo di ricerca dell'offset in ms, come nella validazione del Core
    /// </summary>
    private const int OFFSET_SEARCH_RADIUS_MIN_MS = 5000;

    /// <summary>
    /// Raggio massimo di ricerca dell'offset in ms, come nella validazione del Core
    /// </summary>
    private const int OFFSET_SEARCH_RADIUS_MAX_MS = 600000;

    /// <summary>
    /// Backend visuali selezionabili
    /// </summary>
    private static readonly List<VisionBackendKind> VisionBackends = new List<VisionBackendKind> { VisionBackendKind.Cpu, VisionBackendKind.Vulkan };

    /// <summary>
    /// True durante un probe: il dialog resta aperto fino al suo esito
    /// </summary>
    private bool ProbeRunning => _ffHardwareProbeRunning || _siftVulkanProbeRunning;

    #region Campi backend visuale

    /// <summary>
    /// Backend visuale condiviso dal dHash e dal bootstrap SIFT/RANSAC
    /// </summary>
    private VisionBackendKind _visionBackend = VisionBackendKind.Cpu;

    /// <summary>
    /// True durante il probe Vulkan del backend visuale condiviso
    /// </summary>
    private bool _siftVulkanProbeRunning;

    /// <summary>
    /// Device Vulkan confermato dal probe del backend visuale condiviso
    /// </summary>
    private string _siftVulkanDeviceName = "";

    #endregion

    #region Ffmpeg

    /// <summary>
    /// Accelerazione hardware ffmpeg
    /// </summary>
    private bool _ffHardwareAcceleration;

    /// <summary>
    /// Metodo hardware ffmpeg selezionato
    /// </summary>
    private string _ffHardwareAccelerationMethod = "";

    /// <summary>
    /// Metodi hardware verificati e disponibili nella sessione corrente
    /// </summary>
    private List<string> _ffHardwareAccelerationMethods = new List<string>();

    /// <summary>
    /// True durante il probe ffmpeg avviato dal toggle
    /// </summary>
    private bool _ffHardwareProbeRunning;

    #endregion

    /// <summary>
    /// Raggio di ricerca dell'offset in ms
    /// </summary>
    private int _offsetSearchRadiusMs;

    /// <summary>
    /// Copertura minima Deep Analysis in percentuale
    /// </summary>
    private double _minimumCoveragePercent;

    /// <summary>
    /// Abilita la diagnostica JSON Deep Analysis per episodio
    /// </summary>
    private bool _deepAnalysisDiagnostics;

    /// <summary>
    /// Messaggio errore validazione
    /// </summary>
    private string _validationError = "";

    /// <summary>
    /// Carica valori correnti da AppSettings
    /// </summary>
    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        // Esc e la X restano inattivi durante un probe, come il pulsante Annulla
        if (this.HostOptions != null)
            this.HostOptions.CanClose = () => System.Threading.Tasks.Task.FromResult(!this.ProbeRunning);
        this.LoadFields();
        await this.ProbePersistedBackends();
    }

    /// <summary>
    /// Carica tutti i campi dal model corrente
    /// </summary>
    private void LoadFields()
    {
        AdvancedConfig adv = AppSettingsService.Instance.Settings.Advanced;
        this.LoadFieldsFrom(adv);
    }

    /// <summary>
    /// Carica tutti i campi dal model indicato
    /// </summary>
    private void LoadFieldsFrom(AdvancedConfig adv)
    {
        this._visionBackend = adv.GetVisionBackendKind();
        this._siftVulkanDeviceName = "";
        this._offsetSearchRadiusMs = adv.DeepAnalysis.OffsetSearchRadiusMs;
        this._minimumCoveragePercent = Math.Round(adv.DeepAnalysis.MinimumCoverage * 100.0, 3);
        this._deepAnalysisDiagnostics = adv.DeepAnalysis.DiagnosticsEnabled;

        // Ffmpeg: booleani
        this._ffHardwareAcceleration = adv.Ffmpeg.HardwareAcceleration;
        this._ffHardwareAccelerationMethod = adv.Ffmpeg.HardwareAccelerationMethod;
        this._ffHardwareAccelerationMethods.Clear();
        if (this._ffHardwareAcceleration && FfmpegConfig.IsValidHardwareAccelerationMethod(this._ffHardwareAccelerationMethod))
            this._ffHardwareAccelerationMethods.Add(this._ffHardwareAccelerationMethod);
    }

    /// <summary>
    /// Verifica i backend accelerati caricati dalla configurazione persistita
    /// </summary>
    private async System.Threading.Tasks.Task ProbePersistedBackends()
    {
        if (this._visionBackend == VisionBackendKind.Vulkan)
        {
            this._siftVulkanProbeRunning = true;
            try
            {
                VulkanSiftBackendProbeResult probeResult = await System.Threading.Tasks.Task.Run(() => new VulkanSiftBackendProbe().Probe());
                if (!probeResult.Available)
                {
                    this._visionBackend = VisionBackendKind.Cpu;
                    this.AppendValidationError(AppText.F("web.advanced.vulkanUnavailable", probeResult.ErrorMessage));
                }
                else
                {
                    this._siftVulkanDeviceName = probeResult.DeviceName;
                }
            }
            catch (Exception ex)
            {
                this._visionBackend = VisionBackendKind.Cpu;
                this.AppendValidationError(AppText.F("web.advanced.vulkanProbeFailed", ex.Message));
            }
            finally
            {
                this._siftVulkanProbeRunning = false;
            }
        }

        if (this._ffHardwareAcceleration)
        {
            string selectedMethod = this._ffHardwareAccelerationMethod;
            this._ffHardwareProbeRunning = true;
            this._ffHardwareAccelerationMethods.Clear();
            try
            {
                string ffmpegPath = AppSettingsService.Instance.Settings.Tools.FfmpegPath;
                FfmpegHardwareAccelerationProbeResult probeResult = await System.Threading.Tasks.Task.Run(() => new FfmpegHardwareAccelerationProbe(ffmpegPath).Probe());
                this._ffHardwareAccelerationMethods.AddRange(probeResult.Methods);
                bool selectedMethodAvailable = this._ffHardwareAccelerationMethods.Exists(method => string.Equals(method, selectedMethod, StringComparison.OrdinalIgnoreCase));
                if (!selectedMethodAvailable)
                {
                    this._ffHardwareAcceleration = false;
                    this._ffHardwareAccelerationMethod = "";
                    this.AppendValidationError(AppText.F("web.advanced.hardwareUnavailable", selectedMethod));
                }
            }
            catch (Exception ex)
            {
                this._ffHardwareAcceleration = false;
                this._ffHardwareAccelerationMethod = "";
                this.AppendValidationError(AppText.F("web.advanced.hardwareProbeFailed", ex.Message));
            }
            finally
            {
                this._ffHardwareProbeRunning = false;
            }
        }
    }

    /// <summary>
    /// Accoda un errore di validazione preservando quelli già rilevati
    /// </summary>
    /// <param name="message">Messaggio da aggiungere</param>
    private void AppendValidationError(string message)
    {
        if (string.IsNullOrEmpty(message))
            return;

        this._validationError = string.IsNullOrEmpty(this._validationError) ? message : this._validationError + "\n" + message;
    }

    /// <summary>
    /// Salva impostazioni avanzate con validazione, non chiude se errore
    /// </summary>
    private void Save()
    {
        this._validationError = "";
        AdvancedConfig original = AppSettingsService.Instance.Settings.Advanced;
        AdvancedConfig adv = System.Text.Json.JsonSerializer.Deserialize<AdvancedConfig>(System.Text.Json.JsonSerializer.Serialize(original));

        if (!this.ValidateAdvancedFields())
            return;

        adv.SetVisionBackendKind(this._visionBackend);
        adv.DeepAnalysis.OffsetSearchRadiusMs = this._offsetSearchRadiusMs;
        adv.DeepAnalysis.MinimumCoverage = this._minimumCoveragePercent / 100.0;
        adv.DeepAnalysis.DiagnosticsEnabled = this._deepAnalysisDiagnostics;

        // Parsing Ffmpeg: booleani
        adv.Ffmpeg.HardwareAcceleration = this._ffHardwareAcceleration;
        adv.Ffmpeg.HardwareAccelerationMethod = this._ffHardwareAcceleration ? this._ffHardwareAccelerationMethod : "";

        AppSettingsService.Instance.Settings.Advanced = adv;
        if (!AppSettingsService.Instance.Save())
        {
            AppSettingsService.Instance.Settings.Advanced = original;
            this._validationError = AppText.T("web.advanced.saveFailed");
            return;
        }
        this._validationError = "";
        this.CloseDialog();
    }

    /// <summary>
    /// Ripristina valori di default per tutte le sezioni avanzate
    /// </summary>
    private void ResetDefaults()
    {
        this._validationError = "";
        this.LoadFieldsFrom(new AdvancedConfig());
    }

    /// <summary>
    /// Valida tutti i campi avanzati con gli stessi range del Core
    /// </summary>
    private bool ValidateAdvancedFields()
    {
        List<string> errors = new List<string>();

        if (!Enum.IsDefined(typeof(VisionBackendKind), this._visionBackend) || this._visionBackend == VisionBackendKind.Unknown)
            errors.Add(AppText.T("web.advanced.invalidVisionBackend"));
        else if (this._visionBackend == VisionBackendKind.Vulkan && string.IsNullOrEmpty(this._siftVulkanDeviceName))
            errors.Add(AppText.T("web.advanced.unverifiedVulkanBackend"));

        if (this._ffHardwareAcceleration && !this._ffHardwareAccelerationMethods.Contains(this._ffHardwareAccelerationMethod))
            errors.Add(AppText.T("web.advanced.invalidHardwareBackend"));

        if (this._offsetSearchRadiusMs < OFFSET_SEARCH_RADIUS_MIN_MS || this._offsetSearchRadiusMs > OFFSET_SEARCH_RADIUS_MAX_MS)
            errors.Add(AppText.T("web.advanced.invalidOffsetSearchRadius"));

        if (this._minimumCoveragePercent < 0.0 || this._minimumCoveragePercent > 100.0)
            errors.Add(AppText.T("web.advanced.invalidMinimumCoverage"));

        if (errors.Count > 0)
        {
            this._validationError = string.Join("\n", errors);
            return false;
        }

        return true;
    }

    /// <summary>
    /// Aggiorna l'abilitazione della diagnostica Deep Analysis
    /// </summary>
    /// <param name="enabled">Nuovo stato richiesto</param>
    private void ChangeDeepAnalysisDiagnostics(bool enabled)
    {
        this._deepAnalysisDiagnostics = enabled;
    }

    /// <summary>
    /// Etichetta di un backend visuale
    /// </summary>
    /// <param name="backend">Backend</param>
    /// <returns>Etichetta mostrata nella tendina</returns>
    private static string GetVisionBackendLabel(VisionBackendKind backend)
    {
        return backend == VisionBackendKind.Vulkan ? "Vulkan" : "CPU";
    }

    /// <summary>
    /// Aggiorna il backend visuale condiviso selezionato
    /// </summary>
    /// <param name="value">Backend scelto nella tendina</param>
    private async System.Threading.Tasks.Task ChangeVisionBackend(object value)
    {
        this._validationError = "";
        this._siftVulkanDeviceName = "";
        if (value is not VisionBackendKind selectedBackend || !VisionBackends.Contains(selectedBackend))
        {
            this._visionBackend = VisionBackendKind.Cpu;
            this._validationError = AppText.T("web.advanced.invalidVisionBackend");
            return;
        }

        this._visionBackend = selectedBackend;
        if (selectedBackend != VisionBackendKind.Vulkan)
            return;

        this._siftVulkanProbeRunning = true;
        try
        {
            VulkanSiftBackendProbeResult probeResult = await System.Threading.Tasks.Task.Run(() => new VulkanSiftBackendProbe().Probe());
            if (!probeResult.Available)
            {
                this._visionBackend = VisionBackendKind.Cpu;
                this._validationError = AppText.F("web.advanced.vulkanUnavailable", probeResult.ErrorMessage);
                return;
            }

            this._siftVulkanDeviceName = probeResult.DeviceName;
        }
        catch (Exception ex)
        {
            this._visionBackend = VisionBackendKind.Cpu;
            this._validationError = AppText.F("web.advanced.vulkanProbeFailed", ex.Message);
        }
        finally
        {
            this._siftVulkanProbeRunning = false;
        }
    }

    /// <summary>
    /// Esegue il probe quando l'accelerazione hardware passa da disabilitata ad abilitata
    /// </summary>
    /// <param name="enabled">Nuovo stato richiesto</param>
    private async System.Threading.Tasks.Task ChangeHardwareAcceleration(bool enabled)
    {
        FfmpegHardwareAccelerationProbeResult probeResult;

        if (this._ffHardwareProbeRunning)
            return;

        this._validationError = "";
        if (!enabled)
        {
            this._ffHardwareAcceleration = false;
            this._ffHardwareAccelerationMethod = "";
            this._ffHardwareAccelerationMethods.Clear();
            return;
        }

        this._ffHardwareAcceleration = true;
        this._ffHardwareAccelerationMethod = "";
        this._ffHardwareAccelerationMethods.Clear();
        this._ffHardwareProbeRunning = true;

        try
        {
            string ffmpegPath = AppSettingsService.Instance.Settings.Tools.FfmpegPath;
            probeResult = await System.Threading.Tasks.Task.Run(() => new FfmpegHardwareAccelerationProbe(ffmpegPath).Probe());
            if (probeResult.Methods.Count == 0)
            {
                this._validationError = probeResult.ErrorMessage;
                return;
            }

            this._ffHardwareAccelerationMethods.AddRange(probeResult.Methods);
            this._ffHardwareAcceleration = true;
        }
        catch (Exception ex)
        {
            this._validationError = AppText.F("web.advanced.hardwareProbeFailed", ex.Message);
        }
        finally
        {
            this._ffHardwareProbeRunning = false;
        }
    }

    /// <summary>
    /// Aggiorna il backend hardware selezionato nella tendina
    /// </summary>
    /// <param name="value">Valore selezionato, null quando la scelta viene rimossa</param>
    private void ChangeHardwareAccelerationMethod(object value)
    {
        this._ffHardwareAccelerationMethod = value as string ?? "";
    }

}
