<RadzenPanel AllowCollapse="true" Collapsed="true" Text="@Title" class="rf-settings-section">
    @ChildContent
</RadzenPanel>

@code {
    /// <summary>
    /// Titolo sezione
    /// </summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>
    /// Contenuto della sezione
    /// </summary>
    [Parameter] public RenderFragment ChildContent { get; set; }
}
