<div class="dialog-overlay visible" @onclick="OnClose">
    <div class="dialog-box" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="encoding-profiles-dialog-title" style="min-width: 65ch;" @onclick:stopPropagation="true">
        <div id="encoding-profiles-dialog-title" class="dialog-title">@AppText.T("web.encodingProfiles.title")</div>
        <div class="dialog-body">

            @* Lista profili *@
            <div class="form-section">@AppText.T("web.encodingProfiles.profilesSection")</div>
            <div class="form-row">
                <select class="form-input" style="width: 30ch;" aria-label="@AppText.T("web.encodingProfiles.profilesSection")" @onchange="OnProfileSelected">
                    @for (int i = 0; i < _profiles.Count; i++)
                    {
                        int idx = i;
                        <option value="@idx" selected="@(idx == _selectedIdx)">@_profiles[i].Name</option>
                    }
                </select>
                <RadzenButton style="margin-left: 1ch;" Text="@AppText.T("web.common.new")" Icon="add" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddProfile" />
                <RadzenButton style="margin-left: 1ch;" Text="@AppText.T("web.common.delete")" Icon="delete" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Click="@DeleteProfile" />
            </div>

            @if (_editing != null)
            {
                @* Nome profilo *@
                <div class="form-section">@AppText.T("web.encodingProfiles.settingsSection")</div>
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.common.nameLabel")</span>
                    <input class="form-input" aria-label="@AppText.T("web.common.nameLabel")" @bind="_editing.Name" />
                </div>

                @* Codec *@
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.encodingProfiles.codec")</span>
                    <select class="form-input" style="width: 20ch;" aria-label="@AppText.T("web.encodingProfiles.codec")" value="@_editing.Codec" @onchange="OnCodecChanged">
                        @for (int i = 0; i < EncodingDefaults.CODECS.Length; i++)
                        {
                            <option value="@EncodingDefaults.CODECS[i]">@EncodingDefaults.CODECS[i]</option>
                        }
                    </select>
                </div>

                @* Preset *@
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.encodingProfiles.preset")</span>
                    <select class="form-input" style="width: 20ch;" aria-label="@AppText.T("web.encodingProfiles.preset")" @bind="_editing.Preset">
                        @foreach (string p in EncodingDefaults.GetPresets(_editing.Codec))
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>

                @* Tune *@
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.encodingProfiles.tune")</span>
                    <select class="form-input" style="width: 30ch;" aria-label="@AppText.T("web.encodingProfiles.tune")" @bind="_editing.Tune">
                        @foreach (string t in EncodingDefaults.GetTunes(_editing.Codec))
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>

                @* Profile (solo x264/x265) *@
                @if (EncodingDefaults.HasProfile(_editing.Codec))
                {
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.encodingProfiles.profile")</span>
                        <select class="form-input" style="width: 20ch;" aria-label="@AppText.T("web.encodingProfiles.profile")" @bind="_editing.Profile">
                            @foreach (string pr in EncodingDefaults.GetProfiles(_editing.Codec))
                            {
                                <option value="@pr">@pr</option>
                            }
                        </select>
                    </div>
                }

                @* Bit depth *@
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.encodingProfiles.bitDepth")</span>
                    <select class="form-input" style="width: 30ch;" aria-label="@AppText.T("web.encodingProfiles.bitDepth")" @bind="_editing.BitDepth">
                        @foreach (string bd in EncodingDefaults.GetBitDepths(_editing.Codec))
                        {
                            <option value="@bd">@bd</option>
                        }
                    </select>
                </div>

                @* Rate mode *@
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.encodingProfiles.rateMode")</span>
                    <select class="form-input" style="width: 12ch;" aria-label="@AppText.T("web.encodingProfiles.rateMode")" value="@_editing.RateMode" @onchange="OnRateModeChanged">
                        @foreach (string rm in EncodingDefaults.GetRateModes(_editing.Codec))
                        {
                            <option value="@rm">@rm</option>
                        }
                    </select>
                </div>

                @* CRF/QP (solo se rate mode = crf o qp) *@
                @if (_editing.RateMode == "crf" || _editing.RateMode == "qp")
                {
                    <div class="form-row">
                        <span class="form-label">@(_editing.RateMode == "qp" ? "QP:" : "CRF:")</span>
                        <input class="form-input" style="width: 6ch;" aria-label="@(_editing.RateMode == "qp" ? "QP" : "CRF")" @bind="_crfQpStr" />
                        <span style="margin-left: 1ch; color: var(--rz-text-disabled-color);">@AppText.T("web.common.range"): @EncodingDefaults.GetMinCrf(_editing.Codec)-@EncodingDefaults.GetMaxCrf(_editing.Codec)</span>
                    </div>
                }

                @* Bitrate (solo se rate mode = bitrate) *@
                @if (_editing.RateMode == "bitrate")
                {
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.encodingProfiles.bitrate")</span>
                        <input class="form-input" style="width: 10ch;" aria-label="@AppText.T("web.encodingProfiles.bitrate")" @bind="_bitrateStr" />
                    </div>

                    @* Passes (solo x264/x265 in bitrate) *@
                    @if (EncodingDefaults.HasMultiPass(_editing.Codec))
                    {
                        <div class="form-row">
                            <span class="form-label">@AppText.T("web.encodingProfiles.passes")</span>
                            <select class="form-input" style="width: 6ch;" aria-label="@AppText.T("web.encodingProfiles.passes")" @bind="_editing.Passes">
                                <option value="1">1</option>
                                <option value="2">2</option>
                            </select>
                        </div>
                    }
                }

                @* Film grain (solo svtav1) *@
                @if (EncodingDefaults.HasFilmGrain(_editing.Codec))
                {
                    <div class="form-row">
                        <span class="form-label">@AppText.T("web.encodingProfiles.filmGrain")</span>
                        <input class="form-input" style="width: 6ch;" aria-label="@AppText.T("web.encodingProfiles.filmGrain")" @bind="_filmGrainStr" />
                        <span style="margin-left: 1ch; color: var(--rz-text-disabled-color);">@AppText.F("web.encodingProfiles.filmGrainHint", EncodingDefaults.SVTAV1_FILM_GRAIN_MIN, EncodingDefaults.SVTAV1_FILM_GRAIN_MAX)</span>
                    </div>
                    <div class="form-row">
                        <div class="ui-switch"><RadzenSwitch TValue="bool" @bind-Value="@_editing.FilmGrainDenoise" /><span>@AppText.T("web.encodingProfiles.filmGrainDenoise")</span></div>
                    </div>
                }

                @* Extra params *@
                <div class="form-row">
                    <span class="form-label">@AppText.T("web.encodingProfiles.extraParams")</span>
                    <textarea class="form-input" rows="3" aria-label="@AppText.T("web.encodingProfiles.extraParams")" @bind="_editing.ExtraParams"></textarea>
                </div>
            }
            else
            {
                <div class="form-row" style="color: var(--rz-text-disabled-color);">@AppText.T("web.encodingProfiles.noProfiles")</div>
            }
        </div>
        <div class="dialog-footer">
            <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Save" />
            <RadzenButton class="dialog-close-button" Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@OnClose" />
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Evento chiusura dialog
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Lista profili in modifica
    /// </summary>
    private List<EncodingProfile> _profiles;

    /// <summary>
    /// Indice profilo selezionato
    /// </summary>
    private int _selectedIdx;

    /// <summary>
    /// Profilo in modifica (riferimento al profilo clonato)
    /// </summary>
    private EncodingProfile _editing;

    /// <summary>
    /// CRF/QP come stringa per binding input
    /// </summary>
    private string _crfQpStr;

    /// <summary>
    /// Bitrate come stringa per binding input
    /// </summary>
    private string _bitrateStr;

    /// <summary>
    /// Film grain come stringa per binding input
    /// </summary>
    private string _filmGrainStr;

    /// <summary>
    /// Carica profili clonati da AppSettings
    /// </summary>
    protected override void OnInitialized()
    {
        // Clona profili per editing locale
        this._profiles = new List<EncodingProfile>();
        for (int i = 0; i < AppSettingsService.Instance.Settings.EncodingProfiles.Count; i++)
        {
            this._profiles.Add(AppSettingsService.Instance.Settings.EncodingProfiles[i].Clone());
        }

        this._selectedIdx = -1;
        this._editing = null;
        this._crfQpStr = "";
        this._bitrateStr = "";
        this._filmGrainStr = "";

        // Seleziona primo profilo se esiste
        if (this._profiles.Count > 0)
        {
            this._selectedIdx = 0;
            this.LoadEditing();
        }
    }

    /// <summary>
    /// Gestisce cambio profilo selezionato nel dropdown
    /// </summary>
    /// <param name="e">Argomenti evento change</param>
    private void OnProfileSelected(ChangeEventArgs e)
    {
        int idx;
        string value;

        // Salva profilo corrente prima di cambiare
        this.SaveEditing();

        value = Convert.ToString(e.Value);
        if (int.TryParse(value, out idx))
        {
            this._selectedIdx = idx;
            this.LoadEditing();
        }
    }

    /// <summary>
    /// Gestisce cambio codec: resetta campi ai default del nuovo codec
    /// </summary>
    /// <param name="e">Argomenti evento change</param>
    private void OnCodecChanged(ChangeEventArgs e)
    {
        string newCodec = Convert.ToString(e.Value);
        if (string.IsNullOrEmpty(newCodec))
        {
            return;
        }

        this._editing.Codec = newCodec;
        this._editing.Preset = EncodingDefaults.GetPresets(newCodec)[0];
        this._editing.Tune = EncodingDefaults.GetTunes(newCodec)[0];
        this._editing.BitDepth = EncodingDefaults.GetBitDepths(newCodec)[0];
        this._editing.RateMode = EncodingDefaults.GetRateModes(newCodec)[0];
        this._editing.CrfQp = EncodingDefaults.GetDefaultCrf(newCodec);
        this._editing.Bitrate = 0;
        this._editing.Passes = 1;
        this._editing.FilmGrain = 0;
        this._editing.FilmGrainDenoise = false;

        // Resetta profile per codec che lo supportano
        if (EncodingDefaults.HasProfile(newCodec))
        {
            this._editing.Profile = "default";
        }
        else
        {
            this._editing.Profile = "";
        }

        this._crfQpStr = this._editing.CrfQp.ToString();
        this._bitrateStr = "0";
        this._filmGrainStr = "0";
    }

    /// <summary>
    /// Gestisce cambio rate mode: resetta valori correlati
    /// </summary>
    /// <param name="e">Argomenti evento change</param>
    private void OnRateModeChanged(ChangeEventArgs e)
    {
        string rateMode = Convert.ToString(e.Value);
        if (string.IsNullOrEmpty(rateMode))
        {
            return;
        }

        this._editing.RateMode = rateMode;

        if (this._editing.RateMode == "crf" || this._editing.RateMode == "qp")
        {
            this._editing.CrfQp = EncodingDefaults.GetDefaultCrf(this._editing.Codec);
            this._crfQpStr = this._editing.CrfQp.ToString();
        }
        else
        {
            this._editing.Bitrate = 0;
            this._bitrateStr = "0";
        }
    }

    /// <summary>
    /// Carica i campi del profilo selezionato nell'editor
    /// </summary>
    private void LoadEditing()
    {
        if (this._selectedIdx >= 0 && this._selectedIdx < this._profiles.Count)
        {
            this._editing = this._profiles[this._selectedIdx];
            this._crfQpStr = this._editing.CrfQp.ToString();
            this._bitrateStr = this._editing.Bitrate.ToString();
            this._filmGrainStr = this._editing.FilmGrain.ToString();
        }
        else
        {
            this._editing = null;
        }
    }

    /// <summary>
    /// Salva i valori stringa nel profilo corrente
    /// </summary>
    private void SaveEditing()
    {
        int val;
        int min;
        int max;

        if (this._editing == null)
        {
            return;
        }

        if (int.TryParse(this._crfQpStr, out val))
        {
            min = EncodingDefaults.GetMinCrf(this._editing.Codec);
            max = EncodingDefaults.GetMaxCrf(this._editing.Codec);
            if (val < min)
                val = min;
            else if (val > max)
                val = max;
            this._editing.CrfQp = val;
            this._crfQpStr = val.ToString();
        }
        if (int.TryParse(this._bitrateStr, out val))
            this._editing.Bitrate = val;
        if (int.TryParse(this._filmGrainStr, out val))
        {
            if (val < EncodingDefaults.SVTAV1_FILM_GRAIN_MIN)
                val = EncodingDefaults.SVTAV1_FILM_GRAIN_MIN;
            else if (val > EncodingDefaults.SVTAV1_FILM_GRAIN_MAX)
                val = EncodingDefaults.SVTAV1_FILM_GRAIN_MAX;
            this._editing.FilmGrain = val;
            this._filmGrainStr = val.ToString();
        }
    }

    /// <summary>
    /// Aggiunge un nuovo profilo con valori di default
    /// </summary>
    private void AddProfile()
    {
        // Salva profilo corrente
        this.SaveEditing();

        EncodingProfile newProfile = new EncodingProfile();
        newProfile.Name = AppText.F("web.encodingProfiles.newProfileName", this._profiles.Count + 1);
        this._profiles.Add(newProfile);
        this._selectedIdx = this._profiles.Count - 1;
        this.LoadEditing();
    }

    /// <summary>
    /// Elimina il profilo selezionato
    /// </summary>
    private void DeleteProfile()
    {
        if (this._selectedIdx < 0 || this._selectedIdx >= this._profiles.Count)
        {
            return;
        }

        this._profiles.RemoveAt(this._selectedIdx);

        // Riposiziona selezione
        if (this._profiles.Count == 0)
        {
            this._selectedIdx = -1;
            this._editing = null;
        }
        else if (this._selectedIdx >= this._profiles.Count)
        {
            this._selectedIdx = this._profiles.Count - 1;
        }

        this.LoadEditing();
    }

    /// <summary>
    /// Salva tutti i profili in AppSettings e chiude il dialog
    /// </summary>
    private void Save()
    {
        // Salva profilo corrente
        this.SaveEditing();

        // Sostituisci lista profili in AppSettings
        AppSettingsService.Instance.Settings.EncodingProfiles.Clear();
        for (int i = 0; i < this._profiles.Count; i++)
        {
            // Ignora profili senza nome
            if (!string.IsNullOrEmpty(this._profiles[i].Name))
            {
                AppSettingsService.Instance.Settings.EncodingProfiles.Add(this._profiles[i]);
            }
        }

        AppSettingsService.Instance.Save();
        this.OnClose.InvokeAsync();
    }
}
