@using System.Linq
@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
    <div class="rf-dialog-body">

        @* Lista profili *@
        <div class="form-section">@AppText.T("web.encodingProfiles.profilesSection")</div>
        <div class="form-row">
            <RadzenDropDown TValue="int" Data="@ProfileIndexes" Value="@_selectedIdx" Change="@OnProfileSelected" Style="max-width: 30ch;" aria-label="@AppText.T("web.encodingProfiles.profilesSection")">
                <Template Context="index">@GetProfileName(index)</Template>
                <ValueTemplate Context="index">@GetProfileName(index)</ValueTemplate>
            </RadzenDropDown>
            <RadzenButton style="margin-left: 1ch;" Text="@AppText.T("web.common.new")" Icon="add" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@AddProfile" />
            <RadzenButton style="margin-left: 1ch;" Text="@AppText.T("web.common.delete")" Icon="delete" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Click="@DeleteProfile" />
        </div>

        @if (_editing != null)
        {
            @* Nome profilo *@
            <div class="form-section">@AppText.T("web.encodingProfiles.settingsSection")</div>
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.common.nameLabel")" Component="EncodingProfileName" />
                <RadzenTextBox Name="EncodingProfileName" @bind-Value="_editing.Name" />
            </div>

            @* Codec *@
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.codec")" Component="EncodingProfileCodec" />
                <RadzenDropDown TValue="string" Name="EncodingProfileCodec" Data="@EncodingDefaults.CODECS" Value="@_editing.Codec" Change="@OnCodecChanged" Style="max-width: 20ch;" />
            </div>

            @* Preset *@
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.preset")" Component="EncodingProfilePreset" />
                <RadzenDropDown TValue="string" Name="EncodingProfilePreset" Data="@EncodingDefaults.GetPresets(_editing.Codec)" @bind-Value="_editing.Preset" Style="max-width: 20ch;" />
            </div>

            @* Tune *@
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.tune")" Component="EncodingProfileTune" />
                <RadzenDropDown TValue="string" Name="EncodingProfileTune" Data="@EncodingDefaults.GetTunes(_editing.Codec)" @bind-Value="_editing.Tune" Style="max-width: 30ch;" />
            </div>

            @* Profile (solo x264/x265) *@
            @if (EncodingDefaults.HasProfile(_editing.Codec))
            {
                <div class="form-row">
                    <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.profile")" Component="EncodingProfileProfile" />
                    <RadzenDropDown TValue="string" Name="EncodingProfileProfile" Data="@EncodingDefaults.GetProfiles(_editing.Codec)" @bind-Value="_editing.Profile" Style="max-width: 20ch;" />
                </div>
            }

            @* Bit depth *@
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.bitDepth")" Component="EncodingProfileBitDepth" />
                <RadzenDropDown TValue="string" Name="EncodingProfileBitDepth" Data="@EncodingDefaults.GetBitDepths(_editing.Codec)" @bind-Value="_editing.BitDepth" Style="max-width: 30ch;" />
            </div>

            @* Rate mode *@
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.rateMode")" Component="EncodingProfileRateMode" />
                <RadzenDropDown TValue="string" Name="EncodingProfileRateMode" Data="@EncodingDefaults.GetRateModes(_editing.Codec)" Value="@_editing.RateMode" Change="@OnRateModeChanged" Style="max-width: 16ch;" />
            </div>

            @* CRF/QP (solo se rate mode = crf o qp) *@
            @if (_editing.RateMode == "crf" || _editing.RateMode == "qp")
            {
                <div class="form-row">
                    <RadzenLabel class="form-label" Text="@(_editing.RateMode == "qp" ? "QP:" : "CRF:")" Component="EncodingProfileCrfQp" />
                    <RadzenNumeric TValue="int" Name="EncodingProfileCrfQp" Min="@EncodingDefaults.GetMinCrf(_editing.Codec)" Max="@EncodingDefaults.GetMaxCrf(_editing.Codec)" @bind-Value="_editing.CrfQp" Style="max-width: 10ch;" />
                    <span style="margin-left: 1ch; color: var(--rz-text-disabled-color);">@AppText.T("web.common.range"): @EncodingDefaults.GetMinCrf(_editing.Codec)-@EncodingDefaults.GetMaxCrf(_editing.Codec)</span>
                </div>
            }

            @* Bitrate (solo se rate mode = bitrate) *@
            @if (_editing.RateMode == "bitrate")
            {
                <div class="form-row">
                    <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.bitrate")" Component="EncodingProfileBitrate" />
                    <RadzenNumeric TValue="int" Name="EncodingProfileBitrate" Min="0" @bind-Value="_editing.Bitrate" Style="max-width: 14ch;" />
                </div>

                @* Passes (solo x264/x265 in bitrate) *@
                @if (EncodingDefaults.HasMultiPass(_editing.Codec))
                {
                    <div class="form-row">
                        <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.passes")" Component="EncodingProfilePasses" />
                        <RadzenDropDown TValue="int" Name="EncodingProfilePasses" Data="@PassValues" @bind-Value="_editing.Passes" Style="max-width: 10ch;" />
                    </div>
                }
            }

            @* Film grain (solo svtav1) *@
            @if (EncodingDefaults.HasFilmGrain(_editing.Codec))
            {
                <div class="form-row">
                    <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.filmGrain")" Component="EncodingProfileFilmGrain" />
                    <RadzenNumeric TValue="int" Name="EncodingProfileFilmGrain" Min="@EncodingDefaults.SVTAV1_FILM_GRAIN_MIN" Max="@EncodingDefaults.SVTAV1_FILM_GRAIN_MAX" @bind-Value="_editing.FilmGrain" Style="max-width: 10ch;" />
                    <span style="margin-left: 1ch; color: var(--rz-text-disabled-color);">@AppText.F("web.encodingProfiles.filmGrainHint", EncodingDefaults.SVTAV1_FILM_GRAIN_MIN, EncodingDefaults.SVTAV1_FILM_GRAIN_MAX)</span>
                </div>
                <div class="form-row">
                    <LabeledSwitchComponent Label="@AppText.T("web.encodingProfiles.filmGrainDenoise")" @bind-Value="_editing.FilmGrainDenoise" />
                </div>
            }

            @* Extra params *@
            <div class="form-row">
                <RadzenLabel class="form-label" Text="@AppText.T("web.encodingProfiles.extraParams")" Component="EncodingProfileExtraParams" />
                <RadzenTextArea Name="EncodingProfileExtraParams" Rows="3" @bind-Value="_editing.ExtraParams" />
            </div>
        }
        else
        {
            <div class="form-row" style="color: var(--rz-text-disabled-color);">@AppText.T("web.encodingProfiles.noProfiles")</div>
        }
    </div>
    <div class="rf-dialog-footer">
        @if (!string.IsNullOrEmpty(_saveError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">@_saveError</RadzenAlert>
        }
        <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Save" />
        <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
    </div>
</div>

@code {
    /// <summary>
    /// Numero di passate selezionabili in bitrate
    /// </summary>
    private static readonly List<int> PassValues = new List<int> { 1, 2 };

    /// <summary>
    /// Lista profili in modifica
    /// </summary>
    private List<EncodingProfile> _profiles;
    private List<EncodingProfile> _createdProfiles = new List<EncodingProfile>();
    private string _saveError = "";

    /// <summary>
    /// Indice profilo selezionato
    /// </summary>
    private int _selectedIdx;

    /// <summary>
    /// Profilo in modifica (riferimento al profilo clonato)
    /// </summary>
    private EncodingProfile _editing;

    /// <summary>
    /// Indici dei profili mostrati nella tendina
    /// </summary>
    private List<int> ProfileIndexes => Enumerable.Range(0, this._profiles.Count).ToList();

    /// <summary>
    /// Nome del profilo all'indice indicato, vuoto quando nessun profilo è selezionato
    /// </summary>
    /// <param name="index">Indice del profilo</param>
    /// <returns>Nome del profilo</returns>
    private string GetProfileName(object index)
    {
        if (index is int position && position >= 0 && position < this._profiles.Count)
            return this._profiles[position].Name;
        return "";
    }

    /// <summary>
    /// Carica profili clonati da AppSettings
    /// </summary>
    protected override void OnInitialized()
    {
        // Clona profili per editing locale
        this._profiles = new List<EncodingProfile>();
        for (int i = 0; i < AppSettingsService.Instance.Settings.EncodingProfiles.Count; i++)
        {
            this._profiles.Add(AppSettingsService.Instance.Settings.EncodingProfiles[i].Clone());
        }

        this._selectedIdx = -1;
        this._editing = null;

        // Seleziona primo profilo se esiste
        if (this._profiles.Count > 0)
        {
            this._selectedIdx = 0;
            this.LoadEditing();
        }
    }

    /// <summary>
    /// Gestisce cambio profilo selezionato nella tendina
    /// </summary>
    /// <param name="value">Indice selezionato</param>
    private void OnProfileSelected(object value)
    {
        if (value is int idx)
        {
            this._selectedIdx = idx;
            this.LoadEditing();
        }
    }

    /// <summary>
    /// Gestisce cambio codec: resetta campi ai default del nuovo codec
    /// </summary>
    /// <param name="value">Codec selezionato</param>
    private void OnCodecChanged(object value)
    {
        string newCodec = value as string;
        if (string.IsNullOrEmpty(newCodec))
        {
            return;
        }

        this._editing.Codec = newCodec;
        this._editing.Preset = EncodingDefaults.GetPresets(newCodec)[0];
        this._editing.Tune = EncodingDefaults.GetTunes(newCodec)[0];
        this._editing.BitDepth = EncodingDefaults.GetBitDepths(newCodec)[0];
        this._editing.RateMode = EncodingDefaults.GetRateModes(newCodec)[0];
        this._editing.CrfQp = EncodingDefaults.GetDefaultCrf(newCodec);
        this._editing.Bitrate = 0;
        this._editing.Passes = 1;
        this._editing.FilmGrain = 0;
        this._editing.FilmGrainDenoise = false;

        // Resetta profile per codec che lo supportano
        if (EncodingDefaults.HasProfile(newCodec))
        {
            this._editing.Profile = "default";
        }
        else
        {
            this._editing.Profile = "";
        }
    }

    /// <summary>
    /// Gestisce cambio rate mode: resetta valori correlati
    /// </summary>
    /// <param name="value">Rate mode selezionato</param>
    private void OnRateModeChanged(object value)
    {
        string rateMode = value as string;
        if (string.IsNullOrEmpty(rateMode))
        {
            return;
        }

        this._editing.RateMode = rateMode;

        if (this._editing.RateMode == "crf" || this._editing.RateMode == "qp")
        {
            this._editing.CrfQp = EncodingDefaults.GetDefaultCrf(this._editing.Codec);
        }
        else
        {
            this._editing.Bitrate = 0;
        }
    }

    /// <summary>
    /// Carica il profilo selezionato nell'editor
    /// </summary>
    private void LoadEditing()
    {
        if (this._selectedIdx >= 0 && this._selectedIdx < this._profiles.Count)
        {
            this._editing = this._profiles[this._selectedIdx];
        }
        else
        {
            this._editing = null;
        }
    }

    /// <summary>
    /// Aggiunge un nuovo profilo con valori di default
    /// </summary>
    private void AddProfile()
    {
        EncodingProfile newProfile = new EncodingProfile();
        newProfile.Name = AppText.F("web.encodingProfiles.newProfileName", this._profiles.Count + 1);
        this._profiles.Add(newProfile);
        this._createdProfiles.Add(newProfile);
        this._selectedIdx = this._profiles.Count - 1;
        this.LoadEditing();
    }

    /// <summary>
    /// Elimina il profilo selezionato
    /// </summary>
    private void DeleteProfile()
    {
        if (this._selectedIdx < 0 || this._selectedIdx >= this._profiles.Count)
        {
            return;
        }

        this._profiles.RemoveAt(this._selectedIdx);

        // Riposiziona selezione
        if (this._profiles.Count == 0)
        {
            this._selectedIdx = -1;
            this._editing = null;
        }
        else if (this._selectedIdx >= this._profiles.Count)
        {
            this._selectedIdx = this._profiles.Count - 1;
        }

        this.LoadEditing();
    }

    /// <summary>
    /// Salva tutti i profili in AppSettings e chiude il dialog restituendo il profilo da selezionare
    /// </summary>
    private void Save()
    {
        AppSettingsService settings = AppSettingsService.Instance;
        List<EncodingProfile> previous = settings.Settings.EncodingProfiles;
        settings.Settings.EncodingProfiles = this._profiles.Where(profile => !string.IsNullOrEmpty(profile.Name)).Select(profile => profile.Clone()).ToList();
        this._saveError = "";
        if (settings.Save())
        {
            EncodingProfile saved = this._createdProfiles.LastOrDefault(profile => this._profiles.Contains(profile) && !string.IsNullOrWhiteSpace(profile.Name)) ?? this._editing;
            this.CloseDialog(saved != null && !string.IsNullOrWhiteSpace(saved.Name) ? saved.Name : null);
        }
        else
        {
            settings.Settings.EncodingProfiles = previous;
            this._saveError = AppText.T("web.encoding.saveFailed");
        }
    }
}
