<div class="dialog-overlay visible" @onclick="OnClose">
    <div class="dialog-box dialog-browse" @onclick:stopPropagation="true">
        <div class="dialog-title">@GetDialogTitle()</div>
        <div class="dialog-body" style="display: flex; flex-direction: column; padding: 0;">

            @* Barra percorso con autocomplete (pattern Bivium) *@
            <div class="browse-path-bar">
                <div class="path-bar-edit">
                    <input type="text"
                           id="browse-path-input"
                           class="path-bar-input"
                           value="@_editPath"
                           @oninput="HandlePathInput"
                           @onkeydown="HandlePathKeyDown" />
                    @if (_autocompleteMatches.Count > 1)
                    {
                        <div class="path-autocomplete">
                            @for (int i = 0; i < _autocompleteMatches.Count; i++)
                            {
                                int idx = i;
                                <div class="path-autocomplete-item @(idx == _autocompleteIndex ? "active" : "")"
                                     @onmousedown="() => SelectAutocompleteItem(idx)">
                                    @_autocompleteMatches[idx]
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Tabella 4 colonne come dialog browser *@
            <div class="browse-list">
                <table class="browse-table" divide-="none">
                    <thead>
                        <tr>
                            <th class="browse-col-name" @onclick="() => ToggleSort(BrowserSortColumn.Name)">@AppText.T("web.folder.filename") @GetSortIndicator(BrowserSortColumn.Name)</th>
                            <th class="browse-col-size" @onclick="() => ToggleSort(BrowserSortColumn.Size)">@AppText.T("web.folder.size") @GetSortIndicator(BrowserSortColumn.Size)</th>
                            <th class="browse-col-date" @onclick="() => ToggleSort(BrowserSortColumn.Modified)">@AppText.T("web.folder.modified") @GetSortIndicator(BrowserSortColumn.Modified)</th>
                            <th class="browse-col-type" @onclick="() => ToggleSort(BrowserSortColumn.Type)">@AppText.T("web.folder.type") @GetSortIndicator(BrowserSortColumn.Type)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Cartella parent *@
                        @if (!string.IsNullOrEmpty(_parentPath) || _canNavigateToDriveRoots)
                        {
                            <tr class="browse-row" @ondblclick="NavigateToParent">
                                <td class="browse-col-name">..</td>
                                <td class="browse-col-size"></td>
                                <td class="browse-col-date"></td>
                                <td class="browse-col-type">@AppText.T("web.folder.directory")</td>
                            </tr>
                        }

                        @* Entries *@
                        @for (int i = 0; i < _entries.Count; i++)
                        {
                            int idx = i;
                            DirEntry entry = _entries[idx];
                            <tr class="browse-row @(idx == _selectedIndex ? "selected" : "")"
                                @onclick="() => SelectEntry(idx)"
                                @ondblclick="() => ActivateEntry(idx)">
                                <td class="browse-col-name">@(entry.IsDirectory ? "/" : "")@entry.Name</td>
                                <td class="browse-col-size">@entry.SizeText</td>
                                <td class="browse-col-date">@entry.ModifiedText</td>
                                <td class="browse-col-type">@entry.TypeText</td>
                            </tr>
                        }

                        @if (_entries.Count == 0 && string.IsNullOrEmpty(_parentPath))
                        {
                            <tr>
                                <td colspan="4" style="color: var(--foreground2); text-align: center;">@AppText.T("web.common.empty")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Campo Find *@
            <div class="browse-find-bar">
                <span class="browse-find-label">@AppText.T("web.folder.find")</span>
                <input class="form-input" value="@_filterText" @oninput="HandleFilterInput" />
            </div>

            @* Messaggio errore *@
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="browse-error">@_errorMessage</div>
            }
        </div>
        <div class="dialog-footer">
            <button @onclick="OnClose">@AppText.T("web.common.cancel")</button>
            @if (this.ShowFiles && this.AllowCurrentFolderSelection)
            {
                <button @onclick="ConfirmFolder" disabled="@_showingDriveRoots">@AppText.T("web.folder.selectFolderButton")</button>
                <button @onclick="ConfirmFile" disabled="@(!CanSelectFile())">@AppText.T("web.folder.selectFileButton")</button>
            }
            else if (this.ShowFiles)
            {
                <button @onclick="ConfirmFile" disabled="@(!CanSelectFile())">@AppText.T("web.folder.selectFileButton")</button>
            }
            else
            {
                <button @onclick="ConfirmFolder" disabled="@_showingDriveRoots">@AppText.T("web.folder.selectFolderButton")</button>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Percorso iniziale da cui partire
    /// </summary>
    [Parameter] public string InitialPath { get; set; }

    /// <summary>
    /// Evento chiusura dialog
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Evento selezione cartella/file (restituisce percorso selezionato)
    /// </summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>
    /// Se true mostra anche i file e permette la selezione di un file
    /// </summary>
    [Parameter] public bool ShowFiles { get; set; }

    /// <summary>
    /// Se true permette di confermare la cartella corrente
    /// </summary>
    [Parameter] public bool AllowCurrentFolderSelection { get; set; } = true;

    /// <summary>
    /// Estensioni file ammesse senza punto; null per mostrare tutti i file
    /// </summary>
    [Parameter] public List<string> AllowedExtensions { get; set; }

    #region Variabili di classe

    /// <summary>
    /// Percorso corrente
    /// </summary>
    private string _currentPath = "";

    /// <summary>
    /// Testo editabile nella barra percorso
    /// </summary>
    private string _editPath = "";

    /// <summary>
    /// Percorso cartella parent
    /// </summary>
    private string _parentPath = "";

    /// <summary>
    /// Lista entries visibili (dopo filtro)
    /// </summary>
    private List<DirEntry> _entries = new List<DirEntry>();

    /// <summary>
    /// Lista entries completa (prima del filtro)
    /// </summary>
    private List<DirEntry> _allEntries = new List<DirEntry>();

    /// <summary>
    /// Indice entry selezionata
    /// </summary>
    private int _selectedIndex = -1;

    /// <summary>
    /// Messaggio errore
    /// </summary>
    private string _errorMessage = "";

    /// <summary>
    /// Testo filtro Find
    /// </summary>
    private string _filterText = "";

    /// <summary>
    /// Flag ordinamento crescente
    /// </summary>
    private bool _sortAsc = true;

    /// <summary>
    /// Colonna di ordinamento corrente
    /// </summary>
    private BrowserSortColumn _sortColumn = BrowserSortColumn.Name;

    /// <summary>
    /// Flag: il browser mostra l'elenco virtuale dei drive Windows
    /// </summary>
    private bool _showingDriveRoots;

    /// <summary>
    /// Flag: dalla cartella corrente è possibile tornare all'elenco drive
    /// </summary>
    private bool _canNavigateToDriveRoots;

    /// <summary>
    /// Match autocomplete correnti
    /// </summary>
    private List<string> _autocompleteMatches = new List<string>();

    /// <summary>
    /// Indice corrente nell'autocomplete
    /// </summary>
    private int _autocompleteIndex;

    /// <summary>
    /// Directory parent usata per la sessione autocomplete corrente
    /// </summary>
    private string _autocompleteParentDir = "";

    /// <summary>
    /// Flag: directory iniziale già caricata
    /// </summary>
    private bool _loaded;

    #endregion

    #region Enumerazioni

    /// <summary>
    /// Colonne ordinabili del browser
    /// </summary>
    private enum BrowserSortColumn
    {
        Name,
        Size,
        Modified,
        Type
    }

    #endregion

    #region Classe DirEntry

    /// <summary>
    /// Entry directory per la tabella
    /// </summary>
    private class DirEntry
    {
        /// <summary>
        /// Nome cartella
        /// </summary>
        public string Name = "";

        /// <summary>
        /// Percorso completo
        /// </summary>
        public string FullPath = "";

        /// <summary>
        /// Dimensione formattata
        /// </summary>
        public string SizeText = "";

        /// <summary>
        /// Dimensione file in byte
        /// </summary>
        public long SizeBytes;

        /// <summary>
        /// Data modifica formattata
        /// </summary>
        public string ModifiedText = "";

        /// <summary>
        /// Data ultima modifica
        /// </summary>
        public DateTime LastModified;

        /// <summary>
        /// Tipo entry
        /// </summary>
        public string TypeText = "";

        /// <summary>
        /// Flag: true se directory, false se file
        /// </summary>
        public bool IsDirectory = true;
    }

    #endregion

    #region Ciclo di vita

    /// <summary>
    /// Inizializza il dialog con il percorso iniziale (solo al primo caricamento)
    /// </summary>
    protected override void OnParametersSet()
    {
        // Evita reinizializzazione su ogni re-render del parent
        if (this._loaded)
            return;

        this._loaded = true;

        if (!string.IsNullOrEmpty(this.InitialPath))
        {
            if (System.IO.Directory.Exists(this.InitialPath))
            {
                this._currentPath = this.InitialPath;
            }
            else if (System.IO.File.Exists(this.InitialPath))
            {
                // Percorso file: usa la cartella parent
                string dir = System.IO.Path.GetDirectoryName(this.InitialPath);
                if (!string.IsNullOrEmpty(dir))
                {
                    this._currentPath = dir;
                }
                else
                {
                    this.LoadDefaultRoot();
                    return;
                }
            }
            else
            {
                this.LoadDefaultRoot();
                return;
            }
        }
        else
        {
            this.LoadDefaultRoot();
            return;
        }

        this._editPath = this._currentPath;
        this.LoadDirectory(this._currentPath);
    }

    #endregion

    #region Navigazione directory

    /// <summary>
    /// Carica il contenuto della cartella specificata
    /// </summary>
    /// <param name="path">Percorso cartella</param>
    private void LoadDirectory(string path)
    {
        this._errorMessage = "";
        this._selectedIndex = -1;
        this._filterText = "";
        this._allEntries.Clear();
        this._entries.Clear();

        try
        {
            System.IO.DirectoryInfo dirInfo = new System.IO.DirectoryInfo(path);

            if (!dirInfo.Exists)
            {
                this._errorMessage = AppText.F("web.folder.folderNotFound", path);
                return;
            }

            this._currentPath = dirInfo.FullName;
            this._editPath = this._currentPath;
            this._showingDriveRoots = false;
            this._canNavigateToDriveRoots = System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows) && dirInfo.Parent == null;

            // Percorso parent
            if (dirInfo.Parent != null)
            {
                this._parentPath = dirInfo.Parent.FullName;
            }
            else
            {
                this._parentPath = "";
            }

            // Elenca sottocartelle
            System.IO.DirectoryInfo[] subDirs = dirInfo.GetDirectories();
            for (int i = 0; i < subDirs.Length; i++)
            {
                // Nascondi cartelle di sistema/nascoste
                if ((subDirs[i].Attributes & System.IO.FileAttributes.Hidden) != 0)
                    continue;

                if ((subDirs[i].Attributes & System.IO.FileAttributes.System) != 0)
                    continue;

                DirEntry entry = new DirEntry();
                entry.Name = subDirs[i].Name;
                entry.FullPath = subDirs[i].FullName;
                entry.SizeText = "";
                entry.ModifiedText = subDirs[i].LastWriteTime.ToString("yyyy-MM-ddTHH:mm:ss");
                entry.LastModified = subDirs[i].LastWriteTime;
                entry.TypeText = AppText.T("web.folder.directory");
                entry.IsDirectory = true;

                this._allEntries.Add(entry);
            }

            // Elenca file (solo se ShowFiles è attivo)
            if (this.ShowFiles)
            {
                System.IO.FileInfo[] files = dirInfo.GetFiles();
                for (int i = 0; i < files.Length; i++)
                {
                    if ((files[i].Attributes & System.IO.FileAttributes.Hidden) != 0)
                        continue;

                    if ((files[i].Attributes & System.IO.FileAttributes.System) != 0)
                        continue;

                    if (!this.IsAllowedFile(files[i]))
                        continue;

                    DirEntry fileEntry = new DirEntry();
                    fileEntry.Name = files[i].Name;
                    fileEntry.FullPath = files[i].FullName;
                    fileEntry.SizeText = FormatFileSize(files[i].Length);
                    fileEntry.SizeBytes = files[i].Length;
                    fileEntry.ModifiedText = files[i].LastWriteTime.ToString("yyyy-MM-ddTHH:mm:ss");
                    fileEntry.LastModified = files[i].LastWriteTime;
                    fileEntry.TypeText = !string.IsNullOrEmpty(files[i].Extension) ? files[i].Extension : AppText.T("web.folder.fileType");
                    fileEntry.IsDirectory = false;

                    this._allEntries.Add(fileEntry);
                }
            }

            // Ordina
            this.SortEntries();
            this._entries = new List<DirEntry>(this._allEntries);
        }
        catch (UnauthorizedAccessException)
        {
            this._errorMessage = AppText.F("web.folder.accessDenied", path);
        }
        catch (Exception ex)
        {
            this._errorMessage = AppText.F("cli.error", ex.Message);
        }
    }

    /// <summary>
    /// Naviga alla cartella parent o all'elenco drive Windows
    /// </summary>
    private void NavigateToParent()
    {
        if (!string.IsNullOrEmpty(this._parentPath))
        {
            this.LoadDirectory(this._parentPath);
        }
        else if (this._canNavigateToDriveRoots)
        {
            this.LoadDriveRoots();
        }
    }

    /// <summary>
    /// Seleziona una entry nella lista
    /// </summary>
    /// <param name="index">Indice nella lista filtrata</param>
    private void SelectEntry(int index)
    {
        _selectedIndex = index;
    }

    /// <summary>
    /// Attiva una entry (doppio click) - naviga nella cartella o conferma file
    /// </summary>
    /// <param name="index">Indice nella lista filtrata</param>
    private void ActivateEntry(int index)
    {
        if (index >= 0 && index < _entries.Count)
        {
            if (_entries[index].IsDirectory)
            {
                this.LoadDirectory(_entries[index].FullPath);
            }
            else
            {
                // Doppio click su file: conferma selezione
                this.OnSelect.InvokeAsync(_entries[index].FullPath);
            }
        }
    }

    /// <summary>
    /// Conferma selezione e notifica il parent
    /// </summary>
    private void ConfirmFile()
    {
        if (this.CanSelectFile())
        {
            this.OnSelect.InvokeAsync(_entries[_selectedIndex].FullPath);
        }
        else
        {
            _errorMessage = AppText.T("web.folder.selectFileError");
        }
    }

    /// <summary>
    /// Conferma la cartella corrente
    /// </summary>
    private void ConfirmFolder()
    {
        if (!this._showingDriveRoots && (!this.ShowFiles || this.AllowCurrentFolderSelection))
        {
            this.OnSelect.InvokeAsync(this._currentPath);
        }
    }

    /// <summary>
    /// Verifica se è selezionato un file confermabile
    /// </summary>
    /// <returns>True se la selezione corrente è un file</returns>
    private bool CanSelectFile()
    {
        return this.ShowFiles && this._selectedIndex >= 0 && this._selectedIndex < this._entries.Count && !this._entries[this._selectedIndex].IsDirectory;
    }

    /// <summary>
    /// Restituisce il titolo del dialog in base alla modalità
    /// </summary>
    /// <returns>Titolo dialog</returns>
    private string GetDialogTitle()
    {
        if (this.ShowFiles && this.AllowCurrentFolderSelection)
            return AppText.T("web.folder.selectFileOrFolderTitle");

        if (this.ShowFiles)
            return AppText.T("web.folder.selectFileTitle");

        return AppText.T("web.folder.selectFolderTitle");
    }

    #endregion

    #region Ordinamento e filtro

    /// <summary>
    /// Ordina le entries secondo la colonna corrente
    /// </summary>
    private void SortEntries()
    {
        this._allEntries.Sort(this.CompareEntries);
    }

    /// <summary>
    /// Imposta o inverte l'ordinamento della colonna selezionata
    /// </summary>
    /// <param name="column">Colonna selezionata</param>
    private void ToggleSort(BrowserSortColumn column)
    {
        if (this._sortColumn == column)
        {
            this._sortAsc = !this._sortAsc;
        }
        else
        {
            this._sortColumn = column;
            this._sortAsc = true;
        }

        this.SortEntries();
        this.ApplyFilterInternal();
    }

    /// <summary>
    /// Restituisce l'indicatore della colonna ordinata
    /// </summary>
    /// <param name="column">Colonna</param>
    /// <returns>Indicatore corrente o stringa vuota</returns>
    private string GetSortIndicator(BrowserSortColumn column)
    {
        if (this._sortColumn != column)
            return "";

        return this._sortAsc ? "(▲)" : "(▼)";
    }

    /// <summary>
    /// Confronta due entries secondo l'ordinamento corrente
    /// </summary>
    /// <param name="left">Prima entry</param>
    /// <param name="right">Seconda entry</param>
    /// <returns>Risultato confronto</returns>
    private int CompareEntries(DirEntry left, DirEntry right)
    {
        int result;
        int direction = this._sortAsc ? 1 : -1;

        if (this._sortColumn == BrowserSortColumn.Type)
        {
            result = right.IsDirectory.CompareTo(left.IsDirectory) * direction;
            if (result != 0)
                return result;

            return string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase) * direction;
        }

        if (this._sortColumn == BrowserSortColumn.Size)
        {
            result = left.SizeBytes.CompareTo(right.SizeBytes) * direction;
        }
        else if (this._sortColumn == BrowserSortColumn.Modified)
        {
            result = left.LastModified.CompareTo(right.LastModified) * direction;
        }
        else
        {
            result = string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase) * direction;
        }

        if (result == 0 && this._sortColumn != BrowserSortColumn.Name)
            result = string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase);

        return result;
    }

    /// <summary>
    /// Gestisce input nel campo Find
    /// </summary>
    /// <param name="args">Evento change</param>
    private void HandleFilterInput(ChangeEventArgs args)
    {
        _filterText = args.Value != null ? args.Value.ToString() : "";
        this.ApplyFilterInternal();
    }

    /// <summary>
    /// Filtra la lista entries in base al testo Find
    /// </summary>
    private void ApplyFilterInternal()
    {
        _selectedIndex = -1;

        if (string.IsNullOrEmpty(_filterText))
        {
            _entries = new List<DirEntry>(_allEntries);
            return;
        }

        _entries = new List<DirEntry>();
        string filter = _filterText.ToLowerInvariant();

        for (int i = 0; i < _allEntries.Count; i++)
        {
            if (_allEntries[i].Name.ToLowerInvariant().Contains(filter))
            {
                _entries.Add(_allEntries[i]);
            }
        }
    }

    #endregion

    #region Autocomplete percorso (pattern Bivium)

    /// <summary>
    /// Gestisce input testo nella barra percorso
    /// </summary>
    /// <param name="args">Evento change</param>
    private void HandlePathInput(ChangeEventArgs args)
    {
        _editPath = args.Value != null ? args.Value.ToString() : "";

        // Azzera autocomplete quando l'utente digita
        _autocompleteMatches.Clear();
        _autocompleteIndex = 0;
    }

    /// <summary>
    /// Gestisce pressione tasti nella barra percorso
    /// </summary>
    /// <param name="args">Evento tastiera</param>
    private void HandlePathKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            // Naviga al percorso digitato
            _autocompleteMatches.Clear();
            string path = _editPath.Trim();

            if (!string.IsNullOrEmpty(path) && System.IO.Directory.Exists(path))
            {
                this.LoadDirectory(path);
            }
            else
            {
                _errorMessage = AppText.F("web.folder.invalidPath", path);
            }
        }
        else if (args.Key == "Tab")
        {
            // Autocomplete
            this.HandlePathAutocomplete();
        }
        else if (args.Key == "Escape")
        {
            // Azzera autocomplete
            _autocompleteMatches.Clear();
            _autocompleteIndex = 0;
        }
    }

    /// <summary>
    /// Gestisce Tab per autocomplete percorso
    /// </summary>
    private void HandlePathAutocomplete()
    {
        // Cicla match esistenti
        if (_autocompleteMatches.Count > 1)
        {
            _autocompleteIndex = (_autocompleteIndex + 1) % _autocompleteMatches.Count;
            string selected = _autocompleteMatches[_autocompleteIndex];
            _editPath = _autocompleteParentDir + selected + System.IO.Path.DirectorySeparatorChar;
            return;
        }

        // Parsa input: separa directory parent e prefisso
        string input = _editPath.TrimEnd('/', '\\');
        string parentDir;
        string prefix;
        int lastSep = input.LastIndexOfAny(new char[] { '/', '\\' });

        if (lastSep >= 0)
        {
            parentDir = input.Substring(0, lastSep + 1);
            prefix = input.Substring(lastSep + 1);
        }
        else
        {
            parentDir = _currentPath;
            if (!parentDir.EndsWith(System.IO.Path.DirectorySeparatorChar))
            {
                parentDir += System.IO.Path.DirectorySeparatorChar;
            }
            prefix = input;
        }

        if (!System.IO.Directory.Exists(parentDir))
            return;

        // Cerca sottocartelle che matchano il prefisso
        List<string> matches = new List<string>();

        try
        {
            System.IO.DirectoryInfo[] subDirs = new System.IO.DirectoryInfo(parentDir).GetDirectories();
            string prefixLower = prefix.ToLowerInvariant();

            for (int i = 0; i < subDirs.Length; i++)
            {
                if ((subDirs[i].Attributes & System.IO.FileAttributes.Hidden) != 0)
                    continue;

                if ((subDirs[i].Attributes & System.IO.FileAttributes.System) != 0)
                    continue;

                if (subDirs[i].Name.ToLowerInvariant().StartsWith(prefixLower))
                {
                    matches.Add(subDirs[i].Name);
                }
            }
        }
        catch
        {
            return;
        }

        if (matches.Count == 0)
            return;

        // Salva parent per il cycling
        _autocompleteParentDir = parentDir;

        if (matches.Count == 1)
        {
            // Match singolo: completa e chiudi dropdown
            _editPath = parentDir + matches[0] + System.IO.Path.DirectorySeparatorChar;
            _autocompleteMatches.Clear();
            _autocompleteIndex = 0;
        }
        else
        {
            // Match multipli: completa prefisso comune, mostra dropdown
            string commonPrefix = this.GetCommonPrefix(matches);
            _autocompleteMatches = matches;
            _autocompleteIndex = 0;
            _editPath = parentDir + commonPrefix;
        }
    }

    /// <summary>
    /// Trova il prefisso comune più lungo tra una lista di stringhe
    /// </summary>
    /// <param name="strings">Lista stringhe</param>
    /// <returns>Prefisso comune</returns>
    private string GetCommonPrefix(List<string> strings)
    {
        string result = strings[0];

        for (int i = 1; i < strings.Count; i++)
        {
            int len = Math.Min(result.Length, strings[i].Length);
            int j = 0;
            while (j < len && char.ToLowerInvariant(result[j]) == char.ToLowerInvariant(strings[i][j]))
            {
                j++;
            }

            result = result.Substring(0, j);
        }

        return result;
    }

    /// <summary>
    /// Seleziona un item dall'autocomplete dropdown
    /// </summary>
    /// <param name="index">Indice item selezionato</param>
    private void SelectAutocompleteItem(int index)
    {
        if (index >= 0 && index < _autocompleteMatches.Count)
        {
            string selected = _autocompleteMatches[index];
            _editPath = _autocompleteParentDir + selected + System.IO.Path.DirectorySeparatorChar;
            _autocompleteMatches.Clear();
            _autocompleteIndex = 0;

            // Naviga direttamente
            string path = _editPath.Trim();
            if (!string.IsNullOrEmpty(path) && System.IO.Directory.Exists(path))
            {
                this.LoadDirectory(path);
            }
        }
    }

    #endregion

    #region Utility

    /// <summary>
    /// Carica la vista iniziale appropriata al sistema operativo
    /// </summary>
    private void LoadDefaultRoot()
    {
        if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows))
        {
            this.LoadDriveRoots();
        }
        else
        {
            this._currentPath = "/";
            this._editPath = this._currentPath;
            this.LoadDirectory(this._currentPath);
        }
    }

    /// <summary>
    /// Carica l'elenco dei drive Windows disponibili
    /// </summary>
    private void LoadDriveRoots()
    {
        this._errorMessage = "";
        this._selectedIndex = -1;
        this._filterText = "";
        this._parentPath = "";
        this._currentPath = "";
        this._editPath = AppText.T("web.folder.computer");
        this._showingDriveRoots = true;
        this._canNavigateToDriveRoots = false;
        this._allEntries.Clear();
        this._entries.Clear();

        System.IO.DriveInfo[] drives = System.IO.DriveInfo.GetDrives();
        for (int i = 0; i < drives.Length; i++)
        {
            if (!drives[i].IsReady)
                continue;

            DirEntry entry = new DirEntry();
            entry.Name = drives[i].Name;
            entry.FullPath = drives[i].RootDirectory.FullName;
            entry.TypeText = AppText.T("web.folder.drive");
            entry.IsDirectory = true;
            this._allEntries.Add(entry);
        }

        this.SortEntries();
        this._entries = new List<DirEntry>(this._allEntries);
    }

    /// <summary>
    /// Verifica se un file rispetta il filtro estensioni
    /// </summary>
    /// <param name="file">File da verificare</param>
    /// <returns>True se il file è ammesso</returns>
    private bool IsAllowedFile(System.IO.FileInfo file)
    {
        if (this.AllowedExtensions == null)
            return true;

        string extension = file.Extension.TrimStart('.');
        for (int i = 0; i < this.AllowedExtensions.Count; i++)
        {
            string allowed = this.AllowedExtensions[i] != null ? this.AllowedExtensions[i].Trim().TrimStart('.') : "";
            if (!string.IsNullOrEmpty(allowed) && string.Equals(extension, allowed, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    /// <summary>
    /// Formatta dimensione file in formato leggibile
    /// </summary>
    /// <param name="bytes">Dimensione in byte</param>
    /// <returns>Stringa formattata</returns>
    private static string FormatFileSize(long bytes)
    {
        string result;

        if (bytes >= 1073741824)
        {
            result = (bytes / 1073741824.0).ToString("0.0") + " GB";
        }
        else if (bytes >= 1048576)
        {
            result = (bytes / 1048576.0).ToString("0.0") + " MB";
        }
        else if (bytes >= 1024)
        {
            result = (bytes / 1024.0).ToString("0.0") + " KB";
        }
        else
        {
            result = bytes + " B";
        }

        return result;
    }

