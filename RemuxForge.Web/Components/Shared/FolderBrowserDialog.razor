@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
        <div class="rf-dialog-body browse-dialog-body">

            <div class="browse-path-bar">
                <div class="browse-navigation" role="toolbar" aria-label="@AppText.T("web.folder.navigation")">
                    <RadzenButton Icon="arrow_back"
                                  Size="ButtonSize.Small"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Base"
                                  Disabled="@(!CanNavigateBack())"
                                  title="@AppText.T("web.folder.back")"
                                  aria-label="@AppText.T("web.folder.back")"
                                  Click="@NavigateBack" />
                    <RadzenButton Icon="arrow_upward"
                                  Size="ButtonSize.Small"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Base"
                                  Disabled="@(!CanNavigateUp())"
                                  title="@AppText.T("web.folder.up")"
                                  aria-label="@AppText.T("web.folder.up")"
                                  Click="@NavigateToParent" />
                    <RadzenButton Icon="home"
                                  Size="ButtonSize.Small"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Base"
                                  title="@AppText.T("web.folder.root")"
                                  aria-label="@AppText.T("web.folder.root")"
                                  Click="@LoadDefaultRoot" />
                    <RadzenButton Icon="refresh"
                                  Size="ButtonSize.Small"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Base"
                                  title="@AppText.T("web.folder.refresh")"
                                  aria-label="@AppText.T("web.folder.refresh")"
                                  Click="@RefreshDirectory" />
                </div>
                <div class="path-bar-edit">
                    <input type="text"
                           id="browse-path-input"
                           class="path-bar-input"
                           aria-label="@AppText.T("web.folder.path")"
                           value="@_editPath"
                           @oninput="HandlePathInput"
                           @onkeydown="HandlePathKeyDown" />
                    @if (_autocompleteMatches.Count > 1)
                    {
                        <div class="path-autocomplete" role="listbox" aria-label="@AppText.T("web.folder.pathSuggestions")">
                            @for (int i = 0; i < _autocompleteMatches.Count; i++)
                            {
                                int idx = i;
                                <button type="button"
                                        class="path-autocomplete-item @(idx == _autocompleteIndex ? "active" : "")"
                                        role="option"
                                        aria-selected="@(idx == _autocompleteIndex)"
                                        @onmousedown="() => SelectAutocompleteItem(idx)">
                                    @_autocompleteMatches[idx]
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="browse-content">
                <aside class="browse-roots" aria-label="@AppText.T("web.folder.roots")">
                    <div class="browse-roots-title">@AppText.T("web.folder.roots")</div>
                    @for (int i = 0; i < _rootEntries.Count; i++)
                    {
                        int rootIndex = i;
                        DirEntry root = _rootEntries[rootIndex];
                        <button type="button"
                                class="browse-root-item @(IsCurrentRoot(root) ? "active" : "")"
                                aria-current="@(IsCurrentRoot(root) ? "location" : null)"
                                @onclick="() => NavigateToRoot(rootIndex)">
                            <RadzenIcon Icon="@GetRootIcon(root)" />
                            <span>@root.Name</span>
                        </button>
                    }
                </aside>

                @* Tabella 4 colonne come dialog browser *@
                <div class="browse-list">
                <table class="browse-table @(AllowMultipleFiles ? "browse-table-multiple" : "")">
                    <thead>
                        <tr>
                            @if (AllowMultipleFiles)
                            {
                                <th class="browse-col-check"></th>
                            }
                            <th class="browse-col-name"><button type="button" class="browse-sort-button" @onclick="() => ToggleSort(BrowserSortColumn.Name)">@AppText.T("web.folder.filename") @GetSortIndicator(BrowserSortColumn.Name)</button></th>
                            <th class="browse-col-size"><button type="button" class="browse-sort-button" @onclick="() => ToggleSort(BrowserSortColumn.Size)">@AppText.T("web.folder.size") @GetSortIndicator(BrowserSortColumn.Size)</button></th>
                            <th class="browse-col-date"><button type="button" class="browse-sort-button" @onclick="() => ToggleSort(BrowserSortColumn.Modified)">@AppText.T("web.folder.modified") @GetSortIndicator(BrowserSortColumn.Modified)</button></th>
                            <th class="browse-col-type"><button type="button" class="browse-sort-button" @onclick="() => ToggleSort(BrowserSortColumn.Type)">@AppText.T("web.folder.type") @GetSortIndicator(BrowserSortColumn.Type)</button></th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Cartella parent *@
                        @if (!string.IsNullOrEmpty(_parentPath) || _canNavigateToDriveRoots)
                        {
                            <tr class="browse-row" tabindex="0" @ondblclick="NavigateToParent" @onkeydown="HandleParentKeyDown">
                                @if (AllowMultipleFiles)
                                {
                                    <td class="browse-col-check"></td>
                                }
                                <td class="browse-col-name">
                                    <span class="browse-name-content"><RadzenIcon Icon="folder_open" /><span>..</span></span>
                                </td>
                                <td class="browse-col-size"></td>
                                <td class="browse-col-date"></td>
                                <td class="browse-col-type">@AppText.T("web.folder.directory")</td>
                            </tr>
                        }

                        @* Entries *@
                        @for (int i = 0; i < _entries.Count; i++)
                        {
                            int idx = i;
                            DirEntry entry = _entries[idx];
                            bool selected = _selectedPaths.Contains(entry.FullPath);
                            <tr class="browse-row @(selected ? "selected" : "")"
                                tabindex="0"
                                aria-selected="@selected"
                                @onclick="args => SelectEntry(idx, args.CtrlKey || args.MetaKey, args.ShiftKey)"
                                @ondblclick="() => ActivateEntry(idx)"
                                @onkeydown="args => HandleEntryKeyDown(args, idx)">
                                @if (AllowMultipleFiles)
                                {
                                    @* La casella vale come Ctrl-clic: aggiunge o toglie il file senza toccare il resto della selezione *@
                                    <td class="browse-col-check" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
                                        @if (!entry.IsDirectory)
                                        {
                                            <RadzenCheckBox TValue="bool" Value="@selected" AriaLabel="@entry.Name" Change="@(_ => SelectEntry(idx, true, false))" />
                                        }
                                    </td>
                                }
                                <td class="browse-col-name">
                                    <span class="browse-name-content"><RadzenIcon Icon="@GetEntryIcon(entry)" /><span>@entry.Name</span></span>
                                </td>
                                <td class="browse-col-size">@entry.SizeText</td>
                                <td class="browse-col-date">@entry.ModifiedText</td>
                                <td class="browse-col-type">@entry.TypeText</td>
                            </tr>
                        }

                        @if (_entries.Count == 0 && string.IsNullOrEmpty(_parentPath))
                        {
                            <tr>
                                <td colspan="@(AllowMultipleFiles ? 5 : 4)" style="color: var(--rz-text-disabled-color); text-align: center;">@AppText.T("web.common.empty")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>

            @* Campo Find *@
            <div class="browse-find-bar">
                <RadzenLabel class="browse-find-label" Text="@AppText.T("web.folder.find")" Component="FolderBrowserFind" />
                <RadzenTextBox Name="FolderBrowserFind" Immediate="true" Value="@_filterText" Change="@HandleFilterInput" />
            </div>

            @* Messaggio errore *@
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="browse-error">@_errorMessage</RadzenAlert>
            }
        </div>
        <div class="rf-dialog-footer">
            @if (this.AllowMultipleFiles)
            {
                <span class="browse-selection-count" role="status">@AppText.Count("web.folder.selectedFiles", _selectedPaths.Count)</span>
            }
            <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
            @if (this.AllowMultipleFiles)
            {
                <RadzenButton Text="@AppText.T("web.folder.addFilesButton")" Icon="add" Click="@ConfirmFiles" Disabled="@(_selectedPaths.Count == 0)" />
            }
            else if (this.ShowFiles && this.AllowCurrentFolderSelection)
            {
                <RadzenButton Text="@AppText.T("web.folder.selectFolderButton")" Icon="folder" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@ConfirmFolder" Disabled="@_showingDriveRoots" />
                <RadzenButton Text="@AppText.T("web.folder.selectFileButton")" Icon="description" Click="@ConfirmFile" Disabled="@(!CanSelectFile())" />
            }
            else if (this.ShowFiles)
            {
                <RadzenButton Text="@AppText.T("web.folder.selectFileButton")" Icon="description" Click="@ConfirmFile" Disabled="@(!CanSelectFile())" />
            }
            else
            {
                <RadzenButton Text="@AppText.T("web.folder.selectFolderButton")" Icon="folder" Click="@ConfirmFolder" Disabled="@_showingDriveRoots" />
            }
        </div>
</div>

@code {
    /// <summary>
    /// Percorso iniziale da cui partire
    /// </summary>
    [Parameter] public string InitialPath { get; set; }

    /// <summary>
    /// Se true mostra anche i file e permette la selezione di un file
    /// </summary>
    [Parameter] public bool ShowFiles { get; set; }

    /// <summary>
    /// Se true permette di confermare la cartella corrente
    /// </summary>
    [Parameter] public bool AllowCurrentFolderSelection { get; set; } = true;

    /// <summary>
    /// Estensioni file ammesse senza punto; null per mostrare tutti i file
    /// </summary>
    [Parameter] public List<string> AllowedExtensions { get; set; }

    /// <summary>
    /// Se true seleziona più file della cartella corrente e restituisce la lista dei percorsi; le cartelle non si selezionano
    /// </summary>
    [Parameter] public bool AllowMultipleFiles { get; set; }

    #region Variabili di classe

    /// <summary>
    /// Percorso corrente
    /// </summary>
    private string _currentPath = "";

    /// <summary>
    /// Testo editabile nella barra percorso
    /// </summary>
    private string _editPath = "";

    /// <summary>
    /// Percorso cartella parent
    /// </summary>
    private string _parentPath = "";

    /// <summary>
    /// Lista entries visibili (dopo filtro)
    /// </summary>
    private List<DirEntry> _entries = new List<DirEntry>();

    /// <summary>
    /// Lista entries completa (prima del filtro)
    /// </summary>
    private List<DirEntry> _allEntries = new List<DirEntry>();

    /// <summary>
    /// Root e drive disponibili nella sidebar
    /// </summary>
    private List<DirEntry> _rootEntries = new List<DirEntry>();

    /// <summary>
    /// Posizioni visitate nella sessione del browser
    /// </summary>
    private List<string> _history = new List<string>();

    /// <summary>
    /// Indice della posizione corrente nella cronologia
    /// </summary>
    private int _historyIndex = -1;

    /// <summary>
    /// Percorsi completi delle entry selezionate della cartella corrente; senza selezione multipla al più uno.
    /// Tenuti per percorso, non per riga, così restano selezionati anche quando «Trova» li nasconde o l'ordinamento li sposta
    /// </summary>
    private HashSet<string> _selectedPaths = new HashSet<string>(StringComparer.Ordinal);

    /// <summary>
    /// Percorso della riga da cui parte un intervallo con Maiuscolo-clic
    /// </summary>
    private string _anchorPath = "";

    /// <summary>
    /// Messaggio errore
    /// </summary>
    private string _errorMessage = "";

    /// <summary>
    /// Testo filtro Find
    /// </summary>
    private string _filterText = "";

    /// <summary>
    /// Flag ordinamento crescente
    /// </summary>
    private bool _sortAsc = true;

    /// <summary>
    /// Colonna di ordinamento corrente
    /// </summary>
    private BrowserSortColumn _sortColumn = BrowserSortColumn.Name;

    /// <summary>
    /// Flag: il browser mostra l'elenco virtuale dei drive Windows
    /// </summary>
    private bool _showingDriveRoots;

    /// <summary>
    /// Flag: dalla cartella corrente è possibile tornare all'elenco drive
    /// </summary>
    private bool _canNavigateToDriveRoots;

    /// <summary>
    /// Match autocomplete correnti
    /// </summary>
    private List<string> _autocompleteMatches = new List<string>();

    /// <summary>
    /// Indice corrente nell'autocomplete
    /// </summary>
    private int _autocompleteIndex;

    /// <summary>
    /// Directory parent usata per la sessione autocomplete corrente
    /// </summary>
    private string _autocompleteParentDir = "";

    /// <summary>
    /// Flag: directory iniziale già caricata
    /// </summary>
    private bool _loaded;

    #endregion

    #region Enumerazioni

    /// <summary>
    /// Colonne ordinabili del browser
    /// </summary>
    private enum BrowserSortColumn
    {
        Name,
        Size,
        Modified,
        Type
    }

    #endregion

    #region Classe DirEntry

    /// <summary>
    /// Entry directory per la tabella
    /// </summary>
    private class DirEntry
    {
        /// <summary>
        /// Nome cartella
        /// </summary>
        public string Name = "";

        /// <summary>
        /// Percorso completo
        /// </summary>
        public string FullPath = "";

        /// <summary>
        /// Dimensione formattata
        /// </summary>
        public string SizeText = "";

        /// <summary>
        /// Dimensione file in byte
        /// </summary>
        public long SizeBytes;

        /// <summary>
        /// Data modifica formattata
        /// </summary>
        public string ModifiedText = "";

        /// <summary>
        /// Data ultima modifica
        /// </summary>
        public DateTime LastModified;

        /// <summary>
        /// Tipo entry
        /// </summary>
        public string TypeText = "";

        /// <summary>
        /// Flag: true se directory, false se file
        /// </summary>
        public bool IsDirectory = true;
    }

    #endregion

    #region Ciclo di vita

    /// <summary>
    /// Inizializza il dialog con il percorso iniziale (solo al primo caricamento)
    /// </summary>
    protected override void OnParametersSet()
    {
        // Evita reinizializzazione su ogni re-render del parent
        if (this._loaded)
            return;

        this._loaded = true;
        this.LoadRootEntries();

        if (!string.IsNullOrEmpty(this.InitialPath))
        {
            if (System.IO.Directory.Exists(this.InitialPath))
            {
                this._currentPath = this.InitialPath;
            }
            else if (System.IO.File.Exists(this.InitialPath))
            {
                // Percorso file: usa la cartella parent
                string dir = System.IO.Path.GetDirectoryName(this.InitialPath);
                if (!string.IsNullOrEmpty(dir))
                {
                    this._currentPath = dir;
                }
                else
                {
                    this.LoadDefaultRoot();
                    return;
                }
            }
            else
            {
                this.LoadDefaultRoot();
                return;
            }
        }
        else
        {
            this.LoadDefaultRoot();
            return;
        }

        this._editPath = this._currentPath;
        this.LoadDirectory(this._currentPath);
    }

    #endregion

    #region Navigazione directory

    /// <summary>
    /// Carica il contenuto della cartella specificata
    /// </summary>
    /// <param name="path">Percorso cartella</param>
    private void LoadDirectory(string path, bool recordHistory = true)
    {
        string previousPath = this._currentPath;

        this._errorMessage = "";
        this._filterText = "";
        this._allEntries.Clear();
        this._entries.Clear();

        try
        {
            System.IO.DirectoryInfo dirInfo = new System.IO.DirectoryInfo(path);

            if (!dirInfo.Exists)
            {
                this._errorMessage = AppText.F("web.folder.folderNotFound", path);
                return;
            }

            this._currentPath = dirInfo.FullName;
            this._editPath = this._currentPath;
            this._showingDriveRoots = false;
            this._canNavigateToDriveRoots = System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows) && dirInfo.Parent == null;

            // Percorso parent
            if (dirInfo.Parent != null)
            {
                this._parentPath = dirInfo.Parent.FullName;
            }
            else
            {
                this._parentPath = "";
            }

            // Elenca sottocartelle
            System.IO.DirectoryInfo[] subDirs = dirInfo.GetDirectories();
            for (int i = 0; i < subDirs.Length; i++)
            {
                // Nascondi cartelle di sistema/nascoste
                if ((subDirs[i].Attributes & System.IO.FileAttributes.Hidden) != 0)
                    continue;

                if ((subDirs[i].Attributes & System.IO.FileAttributes.System) != 0)
                    continue;

                DirEntry entry = new DirEntry();
                entry.Name = subDirs[i].Name;
                entry.FullPath = subDirs[i].FullName;
                entry.SizeText = "";
                entry.ModifiedText = subDirs[i].LastWriteTime.ToString("yyyy-MM-ddTHH:mm:ss");
                entry.LastModified = subDirs[i].LastWriteTime;
                entry.TypeText = AppText.T("web.folder.directory");
                entry.IsDirectory = true;

                this._allEntries.Add(entry);
            }

            // Elenca file (solo se ShowFiles è attivo)
            if (this.ShowFiles)
            {
                System.IO.FileInfo[] files = dirInfo.GetFiles();
                for (int i = 0; i < files.Length; i++)
                {
                    if ((files[i].Attributes & System.IO.FileAttributes.Hidden) != 0)
                        continue;

                    if ((files[i].Attributes & System.IO.FileAttributes.System) != 0)
                        continue;

                    if (!this.IsAllowedFile(files[i]))
                        continue;

                    DirEntry fileEntry = new DirEntry();
                    fileEntry.Name = files[i].Name;
                    fileEntry.FullPath = files[i].FullName;
                    fileEntry.SizeText = FormatFileSize(files[i].Length);
                    fileEntry.SizeBytes = files[i].Length;
                    fileEntry.ModifiedText = files[i].LastWriteTime.ToString("yyyy-MM-ddTHH:mm:ss");
                    fileEntry.LastModified = files[i].LastWriteTime;
                    fileEntry.TypeText = !string.IsNullOrEmpty(files[i].Extension) ? files[i].Extension : AppText.T("web.folder.fileType");
                    fileEntry.IsDirectory = false;

                    this._allEntries.Add(fileEntry);
                }
            }

            // La selezione vale nella cartella corrente: un'altra cartella la azzera, Aggiorna tiene i file ancora presenti
            if (!string.Equals(previousPath, this._currentPath, StringComparison.Ordinal))
            {
                this._selectedPaths.Clear();
                this._anchorPath = "";
            }
            else
            {
                this._selectedPaths.RemoveWhere(selectedPath => !this._allEntries.Exists(entry => string.Equals(entry.FullPath, selectedPath, StringComparison.Ordinal)));
            }

            // Ordina
            this.SortEntries();
            this._entries = new List<DirEntry>(this._allEntries);
            if (recordHistory)
                this.RecordHistory(this._currentPath);
        }
        catch (UnauthorizedAccessException)
        {
            this._errorMessage = AppText.F("web.folder.accessDenied", path);
        }
        catch (Exception ex)
        {
            this._errorMessage = AppText.F("cli.error", ex.Message);
        }
    }

    /// <summary>
    /// Naviga alla cartella parent o all'elenco drive Windows
    /// </summary>
    private void NavigateToParent()
    {
        if (!string.IsNullOrEmpty(this._parentPath))
        {
            this.LoadDirectory(this._parentPath);
        }
        else if (this._canNavigateToDriveRoots)
        {
            this.LoadDriveRoots();
        }
    }

    /// <summary>
    /// Torna alla posizione precedente nella cronologia valida
    /// </summary>
    private void NavigateBack()
    {
        while (this._historyIndex > 0)
        {
            string target = this._history[this._historyIndex - 1];
            if (string.IsNullOrEmpty(target) || System.IO.Directory.Exists(target))
            {
                this._historyIndex--;
                if (string.IsNullOrEmpty(target))
                    this.LoadDriveRoots(false);
                else
                    this.LoadDirectory(target, false);
                return;
            }

            this._history.RemoveAt(this._historyIndex - 1);
            this._historyIndex--;
        }
    }

    /// <summary>
    /// Indica se la cronologia contiene una posizione precedente
    /// </summary>
    /// <returns>True quando il comando Indietro è disponibile</returns>
    private bool CanNavigateBack()
    {
        return this._historyIndex > 0;
    }

    /// <summary>
    /// Ricarica la posizione corrente senza cambiare percorso.
    /// </summary>
    private void RefreshDirectory()
    {
        this.LoadRootEntries();
        if (this._showingDriveRoots)
        {
            this.LoadDriveRoots(false);
            return;
        }

        this.LoadDirectory(this._currentPath, false);
    }

    /// <summary>
    /// Indica se è disponibile una posizione superiore.
    /// </summary>
    /// <returns>True quando il comando Su è disponibile.</returns>
    private bool CanNavigateUp()
    {
        return !string.IsNullOrEmpty(this._parentPath) || this._canNavigateToDriveRoots;
    }

    /// <summary>
    /// Gestisce l'attivazione da tastiera della cartella superiore.
    /// </summary>
    /// <param name="args">Evento tastiera.</param>
    private void HandleParentKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            this.NavigateToParent();
    }

    /// <summary>
    /// Gestisce selezione e attivazione da tastiera di una entry.
    /// </summary>
    /// <param name="args">Evento tastiera.</param>
    /// <param name="index">Indice della entry.</param>
    private void HandleEntryKeyDown(KeyboardEventArgs args, int index)
    {
        if (args.Key == "Enter")
        {
            this.ActivateEntry(index);
        }
        else if (args.Key == " ")
        {
            // Con la selezione multipla Spazio aggiunge o toglie la riga, come la casella
            this.SelectEntry(index, this.AllowMultipleFiles, false);
        }
        else if (this.AllowMultipleFiles && (args.CtrlKey || args.MetaKey) && string.Equals(args.Key, "a", StringComparison.OrdinalIgnoreCase))
        {
            // Seleziona tutti i file visibili e lascia selezionati quelli che «Trova» nasconde
            foreach (DirEntry entry in this._entries)
            {
                if (!entry.IsDirectory)
                    this._selectedPaths.Add(entry.FullPath);
            }
        }
    }

    /// <summary>
    /// Seleziona una entry nella lista con i modificatori di un file explorer
    /// </summary>
    /// <param name="index">Indice nella lista filtrata</param>
    /// <param name="ctrl">True per aggiungere o togliere la riga (Ctrl o Cmd)</param>
    /// <param name="shift">True per selezionare l'intervallo dall'ancora (Maiuscolo)</param>
    private void SelectEntry(int index, bool ctrl, bool shift)
    {
        DirEntry entry = this._entries[index];
        int anchor = this._entries.FindIndex(candidate => string.Equals(candidate.FullPath, this._anchorPath, StringComparison.Ordinal));

        // Le cartelle si aprono con il doppio clic ma con la selezione multipla non entrano nella selezione, neppure dentro un intervallo
        if (this.AllowMultipleFiles && entry.IsDirectory)
            return;

        if (this.AllowMultipleFiles && shift && anchor >= 0)
        {
            // Intervallo fra l'ancora visibile e la riga; con Ctrl si aggiunge al resto della selezione
            if (!ctrl)
                this._selectedPaths.Clear();
            for (int i = Math.Min(anchor, index); i <= Math.Max(anchor, index); i++)
            {
                if (!this._entries[i].IsDirectory)
                    this._selectedPaths.Add(this._entries[i].FullPath);
            }
            return;
        }

        if (this.AllowMultipleFiles && ctrl)
        {
            if (!this._selectedPaths.Remove(entry.FullPath))
                this._selectedPaths.Add(entry.FullPath);
        }
        else
        {
            this._selectedPaths.Clear();
            this._selectedPaths.Add(entry.FullPath);
        }
        this._anchorPath = entry.FullPath;
    }

    /// <summary>
    /// Attiva una entry (doppio click) - naviga nella cartella o conferma file
    /// </summary>
    /// <param name="index">Indice nella lista filtrata</param>
    private void ActivateEntry(int index)
    {
        if (index >= 0 && index < _entries.Count)
        {
            if (_entries[index].IsDirectory)
            {
                this.LoadDirectory(_entries[index].FullPath);
            }
            else if (this.AllowMultipleFiles)
            {
                // Invio su un file: il file entra nella selezione e si conferma tutta. Il doppio clic conferma solo il file
                // cliccato, perché il suo primo clic ha già sostituito la selezione con quel file
                this._selectedPaths.Add(_entries[index].FullPath);
                this.ConfirmFiles();
            }
            else
            {
                // Doppio click su file: conferma selezione
                this.CloseDialog(_entries[index].FullPath);
            }
        }
    }

    /// <summary>
    /// Conferma selezione e notifica il parent
    /// </summary>
    private void ConfirmFile()
    {
        if (this.CanSelectFile())
        {
            this.CloseDialog(this._selectedPaths.First());
        }
        else
        {
            _errorMessage = AppText.T("web.folder.selectFileError");
        }
    }

    /// <summary>
    /// Conferma i file selezionati nell'ordine della lista, compresi quelli che «Trova» nasconde
    /// </summary>
    private void ConfirmFiles()
    {
        List<string> paths = new List<string>();
        foreach (DirEntry entry in this._allEntries)
        {
            if (this._selectedPaths.Contains(entry.FullPath))
                paths.Add(entry.FullPath);
        }

        this.CloseDialog(paths);
    }

    /// <summary>
    /// Conferma la cartella corrente
    /// </summary>
    private void ConfirmFolder()
    {
        if (!this._showingDriveRoots && (!this.ShowFiles || this.AllowCurrentFolderSelection))
        {
            this.CloseDialog(this._currentPath);
        }
    }

    /// <summary>
    /// Verifica se è selezionato un file confermabile
    /// </summary>
    /// <returns>True se la selezione corrente è un file</returns>
    private bool CanSelectFile()
    {
        return this.ShowFiles && this._selectedPaths.Count == 1 && this._allEntries.Exists(entry => !entry.IsDirectory && this._selectedPaths.Contains(entry.FullPath));
    }

    /// <summary>
    /// Restituisce il titolo del dialog in base alla modalità
    /// </summary>
    /// <param name="showFiles">True se il browser seleziona file</param>
    /// <param name="allowCurrentFolderSelection">True se il browser conferma anche la cartella corrente</param>
    /// <returns>Titolo dialog</returns>
    public static string GetTitle(bool showFiles, bool allowCurrentFolderSelection)
    {
        if (showFiles && allowCurrentFolderSelection)
            return AppText.T("web.folder.selectFileOrFolderTitle");

        if (showFiles)
            return AppText.T("web.folder.selectFileTitle");

        return AppText.T("web.folder.selectFolderTitle");
    }

    #endregion

    #region Ordinamento e filtro

    /// <summary>
    /// Ordina le entries secondo la colonna corrente
    /// </summary>
    private void SortEntries()
    {
        this._allEntries.Sort(this.CompareEntries);
    }

    /// <summary>
    /// Imposta o inverte l'ordinamento della colonna selezionata
    /// </summary>
    /// <param name="column">Colonna selezionata</param>
    private void ToggleSort(BrowserSortColumn column)
    {
        if (this._sortColumn == column)
        {
            this._sortAsc = !this._sortAsc;
        }
        else
        {
            this._sortColumn = column;
            this._sortAsc = true;
        }

        this.SortEntries();
        this.ApplyFilterInternal();
    }

    /// <summary>
    /// Restituisce l'indicatore della colonna ordinata
    /// </summary>
    /// <param name="column">Colonna</param>
    /// <returns>Indicatore corrente o stringa vuota</returns>
    private string GetSortIndicator(BrowserSortColumn column)
    {
        if (this._sortColumn != column)
            return "";

        return this._sortAsc ? "(▲)" : "(▼)";
    }

    /// <summary>
    /// Confronta due entries secondo l'ordinamento corrente
    /// </summary>
    /// <param name="left">Prima entry</param>
    /// <param name="right">Seconda entry</param>
    /// <returns>Risultato confronto</returns>
    private int CompareEntries(DirEntry left, DirEntry right)
    {
        int result;
        int direction = this._sortAsc ? 1 : -1;

        if (this._sortColumn == BrowserSortColumn.Type)
        {
            result = right.IsDirectory.CompareTo(left.IsDirectory) * direction;
            if (result != 0)
                return result;

            return string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase) * direction;
        }

        if (this._sortColumn == BrowserSortColumn.Size)
        {
            result = left.SizeBytes.CompareTo(right.SizeBytes) * direction;
        }
        else if (this._sortColumn == BrowserSortColumn.Modified)
        {
            result = left.LastModified.CompareTo(right.LastModified) * direction;
        }
        else
        {
            result = string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase) * direction;
        }

        if (result == 0 && this._sortColumn != BrowserSortColumn.Name)
            result = string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase);

        return result;
    }

    /// <summary>
    /// Gestisce input nel campo Find
    /// </summary>
    /// <param name="value">Testo digitato</param>
    private void HandleFilterInput(string value)
    {
        _filterText = value ?? "";
        this.ApplyFilterInternal();
    }

    /// <summary>
    /// Filtra la lista entries in base al testo Find
    /// </summary>
    private void ApplyFilterInternal()
    {
        if (string.IsNullOrEmpty(_filterText))
        {
            _entries = new List<DirEntry>(_allEntries);
            return;
        }

        _entries = new List<DirEntry>();
        string filter = _filterText.ToLowerInvariant();

        for (int i = 0; i < _allEntries.Count; i++)
        {
            if (_allEntries[i].Name.ToLowerInvariant().Contains(filter))
            {
                _entries.Add(_allEntries[i]);
            }
        }
    }

    #endregion

    #region Autocomplete percorso (pattern Bivium)

    /// <summary>
    /// Gestisce input testo nella barra percorso
    /// </summary>
    /// <param name="args">Evento change</param>
    private void HandlePathInput(ChangeEventArgs args)
    {
        _editPath = args.Value != null ? args.Value.ToString() : "";

        // Azzera autocomplete quando l'utente digita
        _autocompleteMatches.Clear();
        _autocompleteIndex = 0;
    }

    /// <summary>
    /// Gestisce pressione tasti nella barra percorso
    /// </summary>
    /// <param name="args">Evento tastiera</param>
    private void HandlePathKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            // Naviga al percorso digitato
            _autocompleteMatches.Clear();
            string path = _editPath.Trim();

            if (!string.IsNullOrEmpty(path) && System.IO.Directory.Exists(path))
            {
                this.LoadDirectory(path);
            }
            else
            {
                _errorMessage = AppText.F("web.folder.invalidPath", path);
            }
        }
        else if (args.Key == "Tab")
        {
            // Autocomplete
            this.HandlePathAutocomplete();
        }
        else if (args.Key == "Escape")
        {
            // Azzera autocomplete
            _autocompleteMatches.Clear();
            _autocompleteIndex = 0;
        }
    }

    /// <summary>
    /// Gestisce Tab per autocomplete percorso
    /// </summary>
    private void HandlePathAutocomplete()
    {
        // Cicla match esistenti
        if (_autocompleteMatches.Count > 1)
        {
            _autocompleteIndex = (_autocompleteIndex + 1) % _autocompleteMatches.Count;
            string selected = _autocompleteMatches[_autocompleteIndex];
            _editPath = _autocompleteParentDir + selected + System.IO.Path.DirectorySeparatorChar;
            return;
        }

        // Parsa input: separa directory parent e prefisso
        string input = _editPath.TrimEnd('/', '\\');
        string parentDir;
        string prefix;
        int lastSep = input.LastIndexOfAny(new char[] { '/', '\\' });

        if (lastSep >= 0)
        {
            parentDir = input.Substring(0, lastSep + 1);
            prefix = input.Substring(lastSep + 1);
        }
        else
        {
            parentDir = _currentPath;
            if (!parentDir.EndsWith(System.IO.Path.DirectorySeparatorChar))
            {
                parentDir += System.IO.Path.DirectorySeparatorChar;
            }
            prefix = input;
        }

        if (!System.IO.Directory.Exists(parentDir))
            return;

        // Cerca sottocartelle che matchano il prefisso
        List<string> matches = new List<string>();

        try
        {
            System.IO.DirectoryInfo[] subDirs = new System.IO.DirectoryInfo(parentDir).GetDirectories();
            string prefixLower = prefix.ToLowerInvariant();

            for (int i = 0; i < subDirs.Length; i++)
            {
                if ((subDirs[i].Attributes & System.IO.FileAttributes.Hidden) != 0)
                    continue;

                if ((subDirs[i].Attributes & System.IO.FileAttributes.System) != 0)
                    continue;

                if (subDirs[i].Name.ToLowerInvariant().StartsWith(prefixLower))
                {
                    matches.Add(subDirs[i].Name);
                }
            }
        }
        catch
        {
            return;
        }

        if (matches.Count == 0)
            return;

        // Salva parent per il cycling
        _autocompleteParentDir = parentDir;

        if (matches.Count == 1)
        {
            // Match singolo: completa e chiudi dropdown
            _editPath = parentDir + matches[0] + System.IO.Path.DirectorySeparatorChar;
            _autocompleteMatches.Clear();
            _autocompleteIndex = 0;
        }
        else
        {
            // Match multipli: completa prefisso comune, mostra dropdown
            string commonPrefix = this.GetCommonPrefix(matches);
            _autocompleteMatches = matches;
            _autocompleteIndex = 0;
            _editPath = parentDir + commonPrefix;
        }
    }

    /// <summary>
    /// Trova il prefisso comune più lungo tra una lista di stringhe
    /// </summary>
    /// <param name="strings">Lista stringhe</param>
    /// <returns>Prefisso comune</returns>
    private string GetCommonPrefix(List<string> strings)
    {
        string result = strings[0];

        for (int i = 1; i < strings.Count; i++)
        {
            int len = Math.Min(result.Length, strings[i].Length);
            int j = 0;
            while (j < len && char.ToLowerInvariant(result[j]) == char.ToLowerInvariant(strings[i][j]))
            {
                j++;
            }

            result = result.Substring(0, j);
        }

        return result;
    }

    /// <summary>
    /// Seleziona un item dall'autocomplete dropdown
    /// </summary>
    /// <param name="index">Indice item selezionato</param>
    private void SelectAutocompleteItem(int index)
    {
        if (index >= 0 && index < _autocompleteMatches.Count)
        {
            string selected = _autocompleteMatches[index];
            _editPath = _autocompleteParentDir + selected + System.IO.Path.DirectorySeparatorChar;
            _autocompleteMatches.Clear();
            _autocompleteIndex = 0;

            // Naviga direttamente
            string path = _editPath.Trim();
            if (!string.IsNullOrEmpty(path) && System.IO.Directory.Exists(path))
            {
                this.LoadDirectory(path);
            }
        }
    }

    #endregion

    #region Utility

    /// <summary>
    /// Carica la vista iniziale appropriata al sistema operativo
    /// </summary>
    private void LoadDefaultRoot()
    {
        if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows))
        {
            this.LoadDriveRoots();
        }
        else
        {
            this._currentPath = "/";
            this._editPath = this._currentPath;
            this.LoadDirectory(this._currentPath);
        }
    }

    /// <summary>
    /// Carica l'elenco dei drive Windows disponibili
    /// </summary>
    /// <param name="recordHistory">True per registrare la posizione nella cronologia</param>
    private void LoadDriveRoots(bool recordHistory = true)
    {
        this._errorMessage = "";
        this._selectedPaths.Clear();
        this._anchorPath = "";
        this._filterText = "";
        this._parentPath = "";
        this._currentPath = "";
        this._editPath = AppText.T("web.folder.computer");
        this._showingDriveRoots = true;
        this._canNavigateToDriveRoots = false;
        this._allEntries.Clear();
        this._entries.Clear();

        for (int i = 0; i < this._rootEntries.Count; i++)
        {
            this._allEntries.Add(this._rootEntries[i]);
        }

        this.SortEntries();
        this._entries = new List<DirEntry>(this._allEntries);
        if (recordHistory)
            this.RecordHistory("");
    }

    /// <summary>
    /// Aggiorna le root disponibili per il sistema operativo corrente
    /// </summary>
    private void LoadRootEntries()
    {
        this._rootEntries.Clear();

        if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows))
        {
            System.IO.DriveInfo[] drives = System.IO.DriveInfo.GetDrives();
            for (int i = 0; i < drives.Length; i++)
            {
                if (!drives[i].IsReady)
                    continue;

                DirEntry entry = new DirEntry();
                entry.Name = drives[i].Name;
                entry.FullPath = drives[i].RootDirectory.FullName;
                entry.TypeText = AppText.T("web.folder.drive");
                entry.IsDirectory = true;
                this._rootEntries.Add(entry);
            }
        }
        else if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.OSX))
        {
            DirEntry entry = new DirEntry();
            entry.Name = "/";
            entry.FullPath = "/";
            entry.TypeText = AppText.T("web.folder.directory");
            entry.IsDirectory = true;
            this._rootEntries.Add(entry);

            try
            {
                System.IO.DirectoryInfo volumesDirectory = new System.IO.DirectoryInfo("/Volumes");
                System.IO.DirectoryInfo[] volumes = volumesDirectory.Exists ? volumesDirectory.GetDirectories() : Array.Empty<System.IO.DirectoryInfo>();
                Array.Sort(volumes, (left, right) => string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase));
                for (int i = 0; i < volumes.Length; i++)
                {
                    if ((volumes[i].Attributes & System.IO.FileAttributes.Hidden) != 0 ||
                        (volumes[i].Attributes & System.IO.FileAttributes.System) != 0 ||
                        (volumes[i].Attributes & System.IO.FileAttributes.ReparsePoint) != 0)
                    {
                        continue;
                    }

                    DirEntry volumeEntry = new DirEntry();
                    volumeEntry.Name = volumes[i].Name;
                    volumeEntry.FullPath = volumes[i].FullName;
                    volumeEntry.TypeText = AppText.T("web.folder.drive");
                    volumeEntry.IsDirectory = true;
                    this._rootEntries.Add(volumeEntry);
                }
            }
            catch
            {
                // La root resta utilizzabile anche se macOS nega l'enumerazione dei volumi
            }
        }
        else
        {
            DirEntry entry = new DirEntry();
            entry.Name = "/";
            entry.FullPath = "/";
            entry.TypeText = AppText.T("web.folder.directory");
            entry.IsDirectory = true;
            this._rootEntries.Add(entry);
        }
    }

    /// <summary>
    /// Naviga alla root selezionata nella sidebar
    /// </summary>
    /// <param name="index">Indice della root</param>
    private void NavigateToRoot(int index)
    {
        if (index < 0 || index >= this._rootEntries.Count)
            return;

        this.LoadDirectory(this._rootEntries[index].FullPath);
    }

    /// <summary>
    /// Registra una posizione visitata eliminando l'eventuale ramo futuro
    /// </summary>
    /// <param name="location">Percorso o stringa vuota per l'elenco drive</param>
    private void RecordHistory(string location)
    {
        if (this._historyIndex >= 0 && string.Equals(this._history[this._historyIndex], location, StringComparison.OrdinalIgnoreCase))
            return;

        if (this._historyIndex + 1 < this._history.Count)
            this._history.RemoveRange(this._historyIndex + 1, this._history.Count - this._historyIndex - 1);

        this._history.Add(location);
        this._historyIndex = this._history.Count - 1;
    }

    /// <summary>
    /// Indica se la root rappresenta la posizione corrente
    /// </summary>
    /// <param name="root">Root da confrontare</param>
    /// <returns>True quando la posizione corrente appartiene alla root</returns>
    private bool IsCurrentRoot(DirEntry root)
    {
        if (this._showingDriveRoots || string.IsNullOrEmpty(this._currentPath))
            return false;

        DirEntry currentRoot = null;
        for (int i = 0; i < this._rootEntries.Count; i++)
        {
            if (!IsPathInsideRoot(this._currentPath, this._rootEntries[i].FullPath))
                continue;

            if (currentRoot == null || this._rootEntries[i].FullPath.Length > currentRoot.FullPath.Length)
                currentRoot = this._rootEntries[i];
        }

        return object.ReferenceEquals(currentRoot, root);
    }

    /// <summary>
    /// Verifica se un percorso appartiene a una root del browser
    /// </summary>
    /// <param name="path">Percorso corrente</param>
    /// <param name="rootPath">Percorso root</param>
    /// <returns>True quando il percorso coincide con la root o e' un suo discendente</returns>
    private static bool IsPathInsideRoot(string path, string rootPath)
    {
        string normalizedPath = System.IO.Path.GetFullPath(path).TrimEnd(System.IO.Path.DirectorySeparatorChar);
        string normalizedRoot = System.IO.Path.GetFullPath(rootPath).TrimEnd(System.IO.Path.DirectorySeparatorChar);
        if (string.IsNullOrEmpty(normalizedPath))
            normalizedPath = System.IO.Path.DirectorySeparatorChar.ToString();
        if (string.IsNullOrEmpty(normalizedRoot))
            normalizedRoot = System.IO.Path.DirectorySeparatorChar.ToString();

        if (string.Equals(normalizedPath, normalizedRoot, StringComparison.OrdinalIgnoreCase))
            return true;

        string prefix = normalizedRoot == System.IO.Path.DirectorySeparatorChar.ToString()
            ? normalizedRoot
            : normalizedRoot + System.IO.Path.DirectorySeparatorChar;
        return normalizedPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Restituisce l'icona per una root del filesystem
    /// </summary>
    /// <param name="root">Root da rappresentare</param>
    /// <returns>Nome icona Material</returns>
    private static string GetRootIcon(DirEntry root)
    {
        return root.TypeText == AppText.T("web.folder.drive") ? "hard_drive" : "folder_open";
    }

    /// <summary>
    /// Verifica se un file rispetta il filtro estensioni
    /// </summary>
    /// <param name="file">File da verificare</param>
    /// <returns>True se il file è ammesso</returns>
    private bool IsAllowedFile(System.IO.FileInfo file)
    {
        if (this.AllowedExtensions == null)
            return true;

        string extension = file.Extension.TrimStart('.');
        for (int i = 0; i < this.AllowedExtensions.Count; i++)
        {
            string allowed = this.AllowedExtensions[i] != null ? this.AllowedExtensions[i].Trim().TrimStart('.') : "";
            if (!string.IsNullOrEmpty(allowed) && string.Equals(extension, allowed, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    /// <summary>
    /// Restituisce l'icona appropriata per una entry del browser.
    /// </summary>
    /// <param name="entry">Entry da rappresentare.</param>
    /// <returns>Nome icona Material.</returns>
    private static string GetEntryIcon(DirEntry entry)
    {
        return entry.IsDirectory ? "folder" : "description";
    }

    /// <summary>
    /// Formatta dimensione file in formato leggibile
    /// </summary>
    /// <param name="bytes">Dimensione in byte</param>
    /// <returns>Stringa formattata</returns>
    private static string FormatFileSize(long bytes)
    {
        string result;

        if (bytes >= 1073741824)
        {
            result = (bytes / 1073741824.0).ToString("0.0") + " GB";
        }
        else if (bytes >= 1048576)
        {
            result = (bytes / 1048576.0).ToString("0.0") + " MB";
        }
        else if (bytes >= 1024)
        {
            result = (bytes / 1024.0).ToString("0.0") + " KB";
        }
        else
        {
            result = bytes + " B";
        }

        return result;
    }

