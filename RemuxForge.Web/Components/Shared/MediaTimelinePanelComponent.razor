@implements IAsyncDisposable

@* Pannello di una timeline su canvas: barra audio, commutazione della visualizzazione e wiring dell'interop. *@

<section class="media-timeline-pane">
    <div class="media-timeline-toolbar" role="group" aria-label="@ToolbarLabel" style="@GetToolbarColumns()">
        @if (Tools.Count > 0)
        {
            <div class="media-timeline-tools" role="group" aria-label="@ToolsLabel">
                @foreach (TimelineTool tool in Tools)
                {
                    <RadzenButton class="media-timeline-tool-button" Icon="@tool.Icon" Size="ButtonSize.Small" Variant="@GetToolVariant(tool.Key)" ButtonStyle="@GetToolStyle(tool.Key)" title="@tool.Label" aria-label="@tool.Label" aria-pressed="@(string.Equals(ActiveTool, tool.Key, StringComparison.Ordinal) ? "true" : "false")" Click="@(() => ChangeToolAsync(tool.Key))" />
                }
            </div>
        }
        @if (Actions != null)
        {
            <div class="media-timeline-actions" role="group" aria-label="@ActionsLabel">@Actions</div>
        }
        @foreach (AudioLane lane in AudioLanes)
        {
            <RadzenLabel class="media-audio-label" Text="@lane.Label" Component="@lane.ElementId" />
            <RadzenDropDown TValue="int?" Name="@lane.ElementId" class="media-audio-control" Data="@lane.Tracks" ValueProperty="Id" Value="@lane.SelectedTrackId" Change="@(value => ChangeTrackAsync(lane, value))" Disabled="@(lane.Tracks.Count == 0)">
                <Template Context="track">@GetTrackLabel(track)</Template>
                <ValueTemplate Context="track">@GetTrackLabel(track)</ValueTemplate>
            </RadzenDropDown>
        }
        <RadzenSelectBar TValue="string" class="media-audio-mode" Size="ButtonSize.Small" Value="@AudioMode" Change="ChangeModeAsync" AriaLabel="@(WaveformText + " / " + SpectrogramText)">
            <Items>
                <RadzenSelectBarItem Text="@WaveformText" Value="@AUDIO_MODE_WAVEFORM" />
                <RadzenSelectBarItem Text="@SpectrogramText" Value="@AUDIO_MODE_SPECTROGRAM" />
            </Items>
        </RadzenSelectBar>
        <span class="media-waveform-height-label">@WaveformHeightText</span>
        <RadzenSlider TValue="double" Value="@WaveformGain" Change="ChangeGainAsync" Min="1" Max="12" Step="0.25" Disabled="@IsSpectrogram" aria-label="@WaveformHeightText" />
        <output>@WaveformGain.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)×</output>
    </div>
    <div @ref="_host" class="media-timeline-host" aria-label="@HostAlternative">
        <div class="timeline-scroll-range"></div>
        <canvas @ref="_canvas" class="media-timeline-canvas" role="img" aria-label="@CanvasAlternative"></canvas>
    </div>
</section>

@code {

    #region Costanti

    /// <summary>Modalità di visualizzazione a forma d'onda</summary>
    public const string AUDIO_MODE_WAVEFORM = "waveform";

    /// <summary>Modalità di visualizzazione a spettrogramma</summary>
    public const string AUDIO_MODE_SPECTROGRAM = "spectrogram";

    #endregion

    #region Fields

    private ElementReference _host;
    private ElementReference _canvas;
    private IJSObjectReference _timeline;

    #endregion

    #region Properties

    /// <summary>Corsie audio mostrate nella barra degli strumenti.</summary>
    [Parameter] public List<AudioLane> AudioLanes { get; set; } = new List<AudioLane>();

    /// <summary>Etichetta del gruppo di controlli, per la lettura assistita.</summary>
    [Parameter] public string ToolbarLabel { get; set; } = string.Empty;

    /// <summary>Etichetta del pulsante della forma d'onda.</summary>
    [Parameter] public string WaveformText { get; set; } = string.Empty;

    /// <summary>Etichetta del pulsante dello spettrogramma.</summary>
    [Parameter] public string SpectrogramText { get; set; } = string.Empty;

    /// <summary>Etichetta dell'ingrandimento verticale della forma d'onda.</summary>
    [Parameter] public string WaveformHeightText { get; set; } = string.Empty;

    /// <summary>Modalità di visualizzazione attiva.</summary>
    [Parameter] public string AudioMode { get; set; } = AUDIO_MODE_WAVEFORM;

    /// <summary>Invocata quando l'utente commuta la modalità di visualizzazione.</summary>
    [Parameter] public EventCallback<string> AudioModeChanged { get; set; }

    /// <summary>Ingrandimento verticale della forma d'onda.</summary>
    [Parameter] public double WaveformGain { get; set; } = 1.0;

    /// <summary>Invocata quando l'utente cambia l'ingrandimento verticale.</summary>
    [Parameter] public EventCallback<double> WaveformGainChanged { get; set; }

    /// <summary>Strumenti che decidono il gesto del tasto sinistro; vuoto per non mostrare la barra.</summary>
    [Parameter] public List<TimelineTool> Tools { get; set; } = new List<TimelineTool>();

    /// <summary>Etichetta del gruppo di strumenti, per la lettura assistita.</summary>
    [Parameter] public string ToolsLabel { get; set; } = string.Empty;

    /// <summary>Chiave dello strumento attivo.</summary>
    [Parameter] public string ActiveTool { get; set; } = string.Empty;

    /// <summary>Invocata quando l'utente sceglie un altro strumento.</summary>
    [Parameter] public EventCallback<string> ActiveToolChanged { get; set; }

    /// <summary>Pulsanti della pagina mostrati all'inizio della barra, dopo gli strumenti; null per nessuno.</summary>
    [Parameter] public RenderFragment Actions { get; set; }

    /// <summary>Etichetta del gruppo di pulsanti della pagina, per la lettura assistita.</summary>
    [Parameter] public string ActionsLabel { get; set; } = string.Empty;

    /// <summary>Testo alternativo dell'area scorrevole.</summary>
    [Parameter] public string HostAlternative { get; set; } = string.Empty;

    /// <summary>Testo alternativo del canvas, per chi non vede la timeline.</summary>
    [Parameter] public string CanvasAlternative { get; set; } = string.Empty;

    /// <summary>Indica se la timeline è già stata creata lato JavaScript.</summary>
    public bool IsAttached { get { return this._timeline != null; } }

    private bool IsSpectrogram { get { return string.Equals(this.AudioMode, AUDIO_MODE_SPECTROGRAM, StringComparison.Ordinal); } }

    #endregion

    #region Metodi pubblici

    /// <summary>
    /// Crea la timeline JavaScript sul canvas del pannello
    /// </summary>
    /// <param name="module">Modulo che esporta createTimeline</param>
    /// <param name="dotNetReference">Riferimento .NET su cui la timeline richiama le callback</param>
    /// <param name="model">Modello opaco costruito dalla pagina</param>
    public async Task AttachAsync(IJSObjectReference module, object dotNetReference, object model)
    {
        if (this._timeline != null || module == null)
            return;
        this._timeline = await module.InvokeAsync<IJSObjectReference>("createTimeline", this._host, this._canvas, dotNetReference, model);
    }

    /// <summary>
    /// Ridisegna la timeline con un modello aggiornato
    /// </summary>
    /// <param name="model">Modello opaco costruito dalla pagina</param>
    /// <param name="centerPlayhead">Se true riporta la vista sul playhead</param>
    public async Task UpdateAsync(object model, bool centerPlayhead)
    {
        if (this._timeline != null)
            await this._timeline.InvokeVoidAsync("update", model, centerPlayhead);
    }

    #endregion

    #region Metodi privati

    private ButtonStyle GetToolStyle(string tool)
    {
        return string.Equals(this.ActiveTool, tool, StringComparison.Ordinal) ? ButtonStyle.Primary : ButtonStyle.Base;
    }

    private Variant GetToolVariant(string tool)
    {
        return string.Equals(this.ActiveTool, tool, StringComparison.Ordinal) ? Variant.Filled : Variant.Outlined;
    }

    private string GetToolbarColumns()
    {
        return "grid-template-columns: " + (this.Tools.Count > 0 ? "max-content " : "") + (this.Actions != null ? "max-content " : "") + "repeat(" + this.AudioLanes.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + ", max-content minmax(6.5rem, 1fr)) minmax(13rem, 2fr) max-content minmax(6rem, 1fr) max-content;";
    }

    private async Task ChangeModeAsync(string mode)
    {
        if (string.Equals(this.AudioMode, mode, StringComparison.Ordinal))
            return;
        await this.AudioModeChanged.InvokeAsync(mode);
    }

    private async Task ChangeToolAsync(string tool)
    {
        if (string.Equals(this.ActiveTool, tool, StringComparison.Ordinal))
            return;
        await this.ActiveToolChanged.InvokeAsync(tool);
    }

    private static string GetTrackLabel(object track)
    {
        return track is TrackInfo info ? Utils.FormatTrackCompact(info) : "";
    }

    private async Task ChangeTrackAsync(AudioLane lane, object value)
    {
        if (value is int trackId)
            await lane.OnTrackChanged.InvokeAsync(trackId);
    }

    private async Task ChangeGainAsync(double value)
    {
        double gain = Math.Max(1.0, Math.Min(12.0, value));
        if (this._timeline != null)
            await this._timeline.InvokeVoidAsync("setWaveformGain", gain);
        await this.WaveformGainChanged.InvokeAsync(gain);
    }

    #endregion

    #region IAsyncDisposable

    /// <summary>
    /// Distrugge la timeline JavaScript
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (this._timeline == null)
            return;
        IJSObjectReference timeline = this._timeline;
        this._timeline = null;
        try { await timeline.InvokeVoidAsync("dispose"); } catch { }
        try { await timeline.DisposeAsync(); } catch { }
    }

    #endregion

    #region Tipi annidati

    /// <summary>
    /// Contratto di una corsia audio mostrata dalla barra della timeline
    /// </summary>
    public class AudioLane
    {
        /// <summary>Costruttore</summary>
        public AudioLane()
        {
            this.Label = "";
            this.ElementId = "";
            this.Tracks = new List<TrackInfo>();
        }

        /// <summary>Etichetta mostrata accanto al selettore</summary>
        public string Label { get; set; }

        /// <summary>Identificativo HTML del selettore</summary>
        public string ElementId { get; set; }

        /// <summary>Tracce audio selezionabili</summary>
        public List<TrackInfo> Tracks { get; set; }

        /// <summary>Identificativo della traccia selezionata</summary>
        public int? SelectedTrackId { get; set; }

        /// <summary>Callback invocata quando cambia la traccia</summary>
        public EventCallback<int> OnTrackChanged { get; set; }
    }

    /// <summary>
    /// Strumento della timeline mostrato come pulsante con icona
    /// </summary>
    public class TimelineTool
    {
        /// <summary>Costruttore</summary>
        public TimelineTool()
        {
            this.Key = "";
            this.Icon = "";
            this.Label = "";
        }

        /// <summary>Chiave passata alla timeline JavaScript</summary>
        public string Key { get; set; }

        /// <summary>Icona Material del pulsante</summary>
        public string Icon { get; set; }

        /// <summary>Nome e uso dello strumento, mostrati nel tooltip</summary>
        public string Label { get; set; }
    }

    #endregion

}
