@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
    <div class="rf-dialog-body">
        <div class="form-row">
            <span class="form-label">mkvmerge:</span>
            <RadzenTextBox aria-label="mkvmerge" @bind-Value="_mkvPath" />
            <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="mkvmerge" Click="@(() => BrowseFolder(0))" />
            <span style="margin-left: 0.5ch; color: @(_mkvFound ? "var(--rz-success)" : "var(--rz-danger)");">@(_mkvFound ? AppText.T("web.common.statusOk") : AppText.T("web.common.statusNotFound"))</span>
        </div>
        <div class="form-row">
            <span class="form-label">mkvextract:</span>
            <RadzenTextBox aria-label="mkvextract" @bind-Value="_mkvExtractPath" />
            <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="mkvextract" Click="@(() => BrowseFolder(4))" />
            <span style="margin-left: 0.5ch; color: @(_mkvExtractFound ? "var(--rz-success)" : "var(--rz-danger)");">@(_mkvExtractFound ? AppText.T("web.common.statusOk") : AppText.T("web.common.statusNotFound"))</span>
        </div>
        <div class="form-row">
            <span class="form-label">mkvpropedit:</span>
            <RadzenTextBox aria-label="mkvpropedit" @bind-Value="_mkvPropEditPath" />
            <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="mkvpropedit" Click="@(() => BrowseFolder(5))" />
            <span style="margin-left: 0.5ch; color: @(_mkvPropEditFound ? "var(--rz-success)" : "var(--rz-danger)");">@(_mkvPropEditFound ? AppText.T("web.common.statusOk") : AppText.T("web.common.statusNotFound"))</span>
        </div>
        <div class="form-row">
            <span class="form-label">ffmpeg:</span>
            <RadzenTextBox aria-label="ffmpeg" @bind-Value="_ffmpegPath" />
            <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="ffmpeg" Click="@(() => BrowseFolder(1))" />
            <span style="margin-left: 0.5ch; color: @(_ffmpegFound ? "var(--rz-success)" : "var(--rz-danger)");">@(_ffmpegStatusText)</span>
            @if (!_ffmpegFound && !_ffmpegDownloading)
            {
                <RadzenButton class="btn-browse" Text="@AppText.T("web.common.downloadButton")" Icon="download" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@DownloadFfmpeg" />
            }
        </div>
        <div class="form-row">
            <span class="form-label">ffprobe:</span>
            <RadzenTextBox aria-label="ffprobe" @bind-Value="_ffprobePath" />
            <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="ffprobe" Click="@(() => BrowseFolder(6))" />
            <span style="margin-left: 0.5ch; color: @(_ffprobeFound ? "var(--rz-success)" : "var(--rz-danger)");">@(_ffprobeFound ? AppText.T("web.common.statusOk") : AppText.T("web.common.statusNotFound"))</span>
        </div>
        <div class="form-row">
            <span class="form-label">mediainfo:</span>
            <RadzenTextBox aria-label="mediainfo" @bind-Value="_mediaInfoPath" />
            <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="mediainfo" Click="@(() => BrowseFolder(2))" />
            <span style="margin-left: 0.5ch; color: @(_mediaInfoFound ? "var(--rz-success)" : "var(--rz-danger)");">@(_mediaInfoFound ? AppText.T("web.common.statusOk") : AppText.T("web.common.statusCliNotFound"))</span>
        </div>
        <div class="form-row" style="margin-top: 0.5em;">
            <span class="form-label">temp:</span>
            <RadzenTextBox aria-label="temp" @bind-Value="_tempFolder" />
            <RadzenButton class="btn-browse" Icon="folder_open" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" aria-label="temp" Click="@(() => BrowseFolder(3))" />
        </div>
    </div>
    <div class="rf-dialog-footer">
        @if (!string.IsNullOrEmpty(_validationError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rf-dialog-message">@_validationError</RadzenAlert>
        }
        <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Save" />
        <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
    </div>
</div>


@code {
    /// <summary>
    /// Percorso mkvmerge
    /// </summary>
    private string _mkvPath = "";

    /// <summary>
    /// Percorso mkvextract
    /// </summary>
    private string _mkvExtractPath = "";

    /// <summary>
    /// Percorso mkvpropedit
    /// </summary>
    private string _mkvPropEditPath = "";

    /// <summary>
    /// Percorso ffmpeg
    /// </summary>
    private string _ffmpegPath = "";

    /// <summary>
    /// Percorso ffprobe
    /// </summary>
    private string _ffprobePath = "";

    /// <summary>
    /// Percorso mediainfo
    /// </summary>
    private string _mediaInfoPath = "";

    /// <summary>
    /// Flag: mkvmerge trovato
    /// </summary>
    private bool _mkvFound;

    /// <summary>
    /// Flag: mkvextract trovato
    /// </summary>
    private bool _mkvExtractFound;

    /// <summary>
    /// Flag: mkvpropedit trovato
    /// </summary>
    private bool _mkvPropEditFound;

    /// <summary>
    /// Flag: ffmpeg trovato
    /// </summary>
    private bool _ffmpegFound;

    /// <summary>
    /// Flag: ffprobe trovato
    /// </summary>
    private bool _ffprobeFound;

    /// <summary>
    /// Flag: download ffmpeg in corso
    /// </summary>
    private bool _ffmpegDownloading;

    /// <summary>
    /// Testo stato ffmpeg
    /// </summary>
    private string _ffmpegStatusText = AppText.T("web.common.statusNotFound");

    /// <summary>
    /// Flag: mediainfo trovato
    /// </summary>
    private bool _mediaInfoFound;

    /// <summary>
    /// Percorso cartella file temporanei
    /// </summary>
    private string _tempFolder = "";

    /// <summary>
    /// Risolutore centralizzato per i tool path
    /// </summary>
    private ToolPathResolverService _toolPathResolver;

    /// <summary>
    /// Messaggio errore validazione
    /// </summary>
    private string _validationError = "";

    /// <summary>
    /// Carica valori correnti da AppSettings (auto-find già fatto all'avvio)
    /// </summary>
    protected override void OnInitialized()
    {
        this._toolPathResolver = new ToolPathResolverService(AppSettingsService.Instance.ConfigFolder);

        // mkvmerge
        this._mkvPath = this._toolPathResolver.ResolveMkvMergePath(false);
        if (string.IsNullOrEmpty(this._mkvPath))
            this._mkvPath = AppSettingsService.Instance.Settings.Tools.MkvMergePath;

        this._mkvFound = !string.IsNullOrEmpty(this._mkvPath) && this._mkvPath != "mkvmerge" && System.IO.File.Exists(this._mkvPath);

        // mkvextract / mkvpropedit
        this._mkvExtractPath = this._toolPathResolver.ResolveMkvExtractPath(this._mkvPath, false);
        if (string.IsNullOrEmpty(this._mkvExtractPath))
            this._mkvExtractPath = AppSettingsService.Instance.Settings.Tools.MkvExtractPath;

        this._mkvExtractFound = !string.IsNullOrEmpty(this._mkvExtractPath) && System.IO.File.Exists(this._mkvExtractPath);

        this._mkvPropEditPath = this._toolPathResolver.ResolveMkvPropEditPath(this._mkvPath, false);
        if (string.IsNullOrEmpty(this._mkvPropEditPath))
            this._mkvPropEditPath = AppSettingsService.Instance.Settings.Tools.MkvPropEditPath;

        this._mkvPropEditFound = !string.IsNullOrEmpty(this._mkvPropEditPath) && System.IO.File.Exists(this._mkvPropEditPath);

        // ffmpeg
        this._ffmpegPath = this._toolPathResolver.ResolveFfmpegPath(false, false);
        if (string.IsNullOrEmpty(this._ffmpegPath))
            this._ffmpegPath = AppSettingsService.Instance.Settings.Tools.FfmpegPath;

        this._ffmpegFound = !string.IsNullOrEmpty(this._ffmpegPath) && System.IO.File.Exists(this._ffmpegPath);
        this._ffmpegStatusText = this._ffmpegFound ? AppText.T("web.common.statusOk") : AppText.T("web.common.statusNotFound");

        // ffprobe
        this._ffprobePath = this._toolPathResolver.ResolveFfprobePath(this._ffmpegPath, false);
        if (string.IsNullOrEmpty(this._ffprobePath))
            this._ffprobePath = AppSettingsService.Instance.Settings.Tools.FfprobePath;

        this._ffprobeFound = !string.IsNullOrEmpty(this._ffprobePath) && System.IO.File.Exists(this._ffprobePath);

        // mediainfo
        this._mediaInfoPath = this._toolPathResolver.ResolveMediaInfoPath(false);
        if (string.IsNullOrEmpty(this._mediaInfoPath))
            this._mediaInfoPath = AppSettingsService.Instance.Settings.Tools.MediaInfoPath;

        this._mediaInfoFound = !string.IsNullOrEmpty(this._mediaInfoPath) && System.IO.File.Exists(this._mediaInfoPath) && this._toolPathResolver.IsMediaInfoCliPath(this._mediaInfoPath);

        // cartella temp
        this._tempFolder = AppSettingsService.Instance.Settings.Tools.TempFolder;
    }

    /// <summary>
    /// Salva percorsi con validazione, non chiude se errore
    /// </summary>
    private void Save()
    {
        string errorMessage;

        // Aggiorna model
        AppSettingsService.Instance.Settings.Tools.MkvMergePath = this._mkvPath;
        AppSettingsService.Instance.Settings.Tools.MkvExtractPath = this._mkvExtractPath;
        AppSettingsService.Instance.Settings.Tools.MkvPropEditPath = this._mkvPropEditPath;
        AppSettingsService.Instance.Settings.Tools.FfmpegPath = this._ffmpegPath;
        AppSettingsService.Instance.Settings.Tools.FfprobePath = this._ffprobePath;
        AppSettingsService.Instance.Settings.Tools.MediaInfoPath = this._mediaInfoPath;
        AppSettingsService.Instance.Settings.Tools.TempFolder = this._tempFolder;

        // Valida percorsi
        if (!AppSettingsService.Instance.ValidateToolPaths(out errorMessage))
        {
            this._validationError = errorMessage;
            return;
        }

        this._validationError = "";
        AppSettingsService.Instance.Save();
        this.CloseDialog();
    }

    /// <summary>
    /// Apre il browser file per il campo specificato e applica il percorso scelto
    /// </summary>
    /// <param name="fieldIndex">Indice campo: 0=mkvmerge, 1=ffmpeg, 2=mediainfo, 3=temp, 4=mkvextract, 5=mkvpropedit, 6=ffprobe</param>
    private async Task BrowseFolder(int fieldIndex)
    {
        string initialPath = "";
        string selectedPath;

        if (fieldIndex == 0)
            initialPath = this._mkvPath;
        else if (fieldIndex == 1)
            initialPath = this._ffmpegPath;
        else if (fieldIndex == 2)
            initialPath = this._mediaInfoPath;
        else if (fieldIndex == 3)
            initialPath = this._tempFolder;
        else if (fieldIndex == 4)
            initialPath = this._mkvExtractPath;
        else if (fieldIndex == 5)
            initialPath = this._mkvPropEditPath;
        else if (fieldIndex == 6)
            initialPath = this._ffprobePath;

        selectedPath = await AppDialogs.BrowseAsync(this.DialogService, this.JsModule, initialPath, true, true, null);
        if (string.IsNullOrEmpty(selectedPath))
            return;

        if (fieldIndex == 0)
            this._mkvPath = selectedPath;
        else if (fieldIndex == 1)
            this._ffmpegPath = selectedPath;
        else if (fieldIndex == 2)
            this._mediaInfoPath = selectedPath;
        else if (fieldIndex == 3)
            this._tempFolder = selectedPath;
        else if (fieldIndex == 4)
            this._mkvExtractPath = selectedPath;
        else if (fieldIndex == 5)
            this._mkvPropEditPath = selectedPath;
        else if (fieldIndex == 6)
            this._ffprobePath = selectedPath;
    }

    /// <summary>
    /// Scarica ffmpeg su thread background e aggiorna lo stato
    /// </summary>
    private void DownloadFfmpeg()
    {
        this._ffmpegDownloading = true;
        this._ffmpegStatusText = AppText.T("web.common.downloading");

        Thread dlThread = new Thread(() =>
        {
            bool dlResult = !string.IsNullOrEmpty(this._toolPathResolver.ResolveFfmpegPath(true, true));

            this.InvokeAsync(() =>
            {
                this._ffmpegDownloading = false;
                if (dlResult)
                {
                    this._ffmpegPath = this._toolPathResolver.ResolveFfmpegPath(false, false);
                    this._ffmpegFound = true;
                    this._ffmpegStatusText = AppText.T("web.common.statusOk");
                }
                else
                {
                    this._ffmpegStatusText = AppText.T("web.common.statusError");
                }

                this.StateHasChanged();
            });
        });
        dlThread.IsBackground = true;
        dlThread.Start();
    }
}
