<div class="rf-panel">
    <div class="rf-panel-title episode-panel-title">
        <span>@AppText.T("web.episode.title")</span>
        <span class="episode-match-count">@AppText.F("web.episode.matched", Records != null ? Records.Count : 0, ScannedFileCount)</span>
    </div>
    <div class="rf-panel-body rf-grid-host">
        <RadzenDataGrid TItem="FileProcessingRecord"
                        Data="@Records"
                        class="rf-data-grid episode-grid"
                        AllowAlternatingRows="false"
                        AllowColumnResize="true"
                        AllowPaging="false"
                        AllowRowSelectOnRowClick="false"
                        AllowSorting="false"
                        CellContextMenu="HandleContextMenu"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Both"
                        RowClick="HandleRowClick"
                        RowRender="RenderRow">
            <Columns>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.dashboard.file")" Width="30%" MinWidth="2.5rem" MaxWidth="480px">
                    <Template Context="record"><span title="@record.SourceFileName">@record.SourceFileName</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.episode.status")" Width="12%" MinWidth="2.5rem" MaxWidth="200px">
                    <Template Context="record"><span title="@Utils.GetStatusText(record.Status)">@Utils.GetStatusText(record.Status)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.episode.audio")" Width="9%" MinWidth="2.5rem" MaxWidth="160px">
                    <Template Context="record"><span title="@Utils.FormatLangs(record.ResultAudioLangs)">@Utils.FormatLangs(record.ResultAudioLangs)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.episode.sub")" Width="9%" MinWidth="2.5rem" MaxWidth="160px">
                    <Template Context="record"><span title="@Utils.FormatLangs(record.ResultSubLangs)">@Utils.FormatLangs(record.ResultSubLangs)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.episode.delay")" Width="10%" MinWidth="2.5rem" MaxWidth="160px">
                    <Template Context="record"><span title="@Utils.FormatDelay(record.AudioDelayApplied)">@Utils.FormatDelay(record.AudioDelayApplied)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.episode.stretch")" Width="10%" MinWidth="2.5rem" MaxWidth="160px">
                    <Template Context="record"><span title="@(!string.IsNullOrEmpty(record.StretchFactor) ? record.StretchFactor : "-")">@(!string.IsNullOrEmpty(record.StretchFactor) ? record.StretchFactor : "-")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.episode.deep")" Width="10%" MinWidth="2.5rem" MaxWidth="160px">
                    <Template Context="record"><span title="@(record.DeepAnalysisMap != null ? AppText.Count(record.DeepAnalysisApplied ? "cli.report.deepOps" : "web.episode.deepCandidateOps", record.DeepAnalysisMap.Operations.Count) : "-")">@(record.DeepAnalysisMap != null ? AppText.Count(record.DeepAnalysisApplied ? "cli.report.deepOps" : "web.episode.deepCandidateOps", record.DeepAnalysisMap.Operations.Count) : "-")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FileProcessingRecord" Title="@AppText.T("web.episode.size")" Width="10%" MinWidth="2.5rem" MaxWidth="160px">
                    <Template Context="record"><span title="@Utils.FormatSize(record.SourceSize)">@Utils.FormatSize(record.SourceSize)</span></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    /// <summary>
    /// Lista record episodi
    /// </summary>
    [Parameter] public List<FileProcessingRecord> Records { get; set; }

    /// <summary>
    /// File sorgente trovati dall'ultimo scan, comprese le righe scartate perche' senza file lingua
    /// </summary>
    [Parameter] public int ScannedFileCount { get; set; }

    /// <summary>
    /// Indice riga selezionata
    /// </summary>
    [Parameter] public int SelectedIndex { get; set; }

    /// <summary>
    /// Indici righe selezionate
    /// </summary>
    [Parameter] public List<int> SelectedIndices { get; set; }

    /// <summary>
    /// Evento selezione riga
    /// </summary>
    [Parameter] public EventCallback<(int Index, bool Ctrl, bool Shift)> OnRowSelected { get; set; }

    /// <summary>
    /// Evento context menu su riga (right-click) - passa (indice, clientX, clientY)
    /// </summary>
    [Parameter] public EventCallback<(int Index, double X, double Y)> OnContextMenu { get; set; }

    /// <summary>
    /// Restituisce la classe CSS per lo stato
    /// </summary>
    /// <param name="status">Stato file</param>
    /// <returns>Nome classe CSS</returns>
    private string GetStatusCss(FileStatus status)
    {
        string result = "";
        if (status == FileStatus.Done) result = "status-done";
        else if (status == FileStatus.Error) result = "status-error";
        else if (status == FileStatus.Skipped) result = "status-skipped";
        return result;
    }

    /// <summary>
    /// Gestisce selezione mouse con modifier stile file explorer
    /// </summary>
    /// <param name="args">Argomenti mouse</param>
    private void HandleRowClick(DataGridRowMouseEventArgs<FileProcessingRecord> args)
    {
        int index = this.Records.IndexOf(args.Data);
        if (index < 0)
            return;

        this.OnRowSelected.InvokeAsync((index, args.CtrlKey || args.MetaKey, args.ShiftKey));
    }

    /// <summary>
    /// Apre il menu contestuale per la riga della cella selezionata
    /// </summary>
    /// <param name="args">Argomenti del menu contestuale</param>
    private void HandleContextMenu(DataGridCellMouseEventArgs<FileProcessingRecord> args)
    {
        int index = this.Records.IndexOf(args.Data);
        if (index < 0)
            return;

        this.OnContextMenu.InvokeAsync((index, args.ClientX, args.ClientY));
    }

    /// <summary>
    /// Applica alla riga gli attributi posseduti dal modello di selezione
    /// </summary>
    /// <param name="args">Argomenti rendering riga</param>
    private void RenderRow(RowRenderEventArgs<FileProcessingRecord> args)
    {
        int index = this.Records.IndexOf(args.Data);
        string cssClass = this.GetStatusCss(args.Data.Status);
        if (this.IsIndexSelected(index))
            cssClass += " selected";
        if (index == this.SelectedIndex)
            cssClass += " focused";

        if (!string.IsNullOrWhiteSpace(cssClass))
            args.Attributes["class"] = "rz-data-row " + cssClass.Trim();
        args.Attributes["data-episode-row-index"] = index;
        args.Attributes["tabindex"] = index == this.SelectedIndex ? 0 : -1;
        args.Attributes["aria-selected"] = this.IsIndexSelected(index) ? "true" : "false";
    }

    /// <summary>
    /// True se la riga è selezionata
    /// </summary>
    /// <param name="index">Indice riga</param>
    /// <returns>True se selezionata</returns>
    private bool IsIndexSelected(int index)
    {
        bool result = false;

        if (this.SelectedIndices != null)
        {
            for (int i = 0; i < this.SelectedIndices.Count; i++)
            {
                if (this.SelectedIndices[i] == index)
                {
                    result = true;
                    break;
                }
            }
        }

        return result;
    }
}
