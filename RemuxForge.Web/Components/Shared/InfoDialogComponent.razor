@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
    <div class="rf-dialog-body">
        <RadzenTable GridLines="DataGridGridLines.None" AllowAlternatingRows="false" class="info-table">
            <RadzenTableBody>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.name")</RadzenTableCell>
                    <RadzenTableCell><img src="favicon-32x32.png" alt="icon" style="vertical-align: middle; margin-right: 0.5ch;" />RemuxForge</RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.version")</RadzenTableCell>
                    <RadzenTableCell>@_version</RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.license")</RadzenTableCell>
                    <RadzenTableCell>GNU General Public License v3.0</RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.repository")</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/simonefil/RemuxForge" target="_blank">https://github.com/simonefil/RemuxForge</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.website")</RadzenTableCell>
                    <RadzenTableCell><a href="https://remuxforge.app" target="_blank">https://remuxforge.app</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.discord")</RadzenTableCell>
                    <RadzenTableCell><a href="https://discord.gg/JpHWKGyaqF" target="_blank">https://discord.gg/JpHWKGyaqF</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.runtime")</RadzenTableCell>
                    <RadzenTableCell>@_runtime</RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell class="info-label">@AppText.T("web.info.platform")</RadzenTableCell>
                    <RadzenTableCell>@_platform</RadzenTableCell>
                </RadzenTableRow>
            </RadzenTableBody>
        </RadzenTable>
    </div>
    <div class="rf-dialog-footer">
        <RadzenButton Text="@AppText.T("web.common.close")" Icon="close" Click="@(() => CloseDialog())" />
    </div>
</div>

<style>
    .info-table .info-label {
        font-weight: bold;
        width: 14ch;
    }
    .info-table a {
        color: var(--accent);
    }
</style>

@code {
    /// <summary>
    /// Versione applicazione
    /// </summary>
    private string _version;

    /// <summary>
    /// Descrizione runtime
    /// </summary>
    private string _runtime;

    /// <summary>
    /// Descrizione piattaforma
    /// </summary>
    private string _platform;

    /// <summary>
    /// Inizializza informazioni di sistema
    /// </summary>
    protected override void OnInitialized()
    {
        // Versione dall'assembly
        System.Reflection.Assembly assembly = System.Reflection.Assembly.GetEntryAssembly();
        System.Reflection.CustomAttributeData infoAttr = null;
        Version assemblyVersion;

        if (assembly != null)
        {
            foreach (System.Reflection.CustomAttributeData attr in assembly.CustomAttributes)
            {
                if (attr.AttributeType == typeof(System.Reflection.AssemblyInformationalVersionAttribute))
                {
                    infoAttr = attr;
                    break;
                }
            }
        }

        if (infoAttr != null && infoAttr.ConstructorArguments.Count > 0 && infoAttr.ConstructorArguments[0].Value != null)
        {
            this._version = infoAttr.ConstructorArguments[0].Value.ToString();
        }
        else if (assembly != null)
        {
            assemblyVersion = assembly.GetName().Version;
            this._version = assemblyVersion != null ? assemblyVersion.ToString() : "";
        }
        else
        {
            this._version = "";
        }

        // Runtime e piattaforma
        this._runtime = System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription;
        this._platform = System.Runtime.InteropServices.RuntimeInformation.OSDescription;
    }
}
