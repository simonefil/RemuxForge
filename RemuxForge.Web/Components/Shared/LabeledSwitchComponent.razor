<div class="ui-switch @CssClass" @attributes="Attributes">
    <RadzenSwitch TValue="bool" Name="@_name" Value="@Value" Change="@ValueChanged" Disabled="@Disabled" />
    <RadzenLabel Text="@Label" Component="@_name" />
</div>

@code {
    /// <summary>
    /// Etichetta associata allo switch: un click sull'etichetta cambia lo stato
    /// </summary>
    [Parameter] public string Label { get; set; } = "";

    /// <summary>
    /// Stato dello switch
    /// </summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>
    /// Callback cambio stato
    /// </summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// True quando lo switch non accetta modifiche
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Classe CSS aggiuntiva del contenitore
    /// </summary>
    [Parameter] public string CssClass { get; set; } = "";

    /// <summary>
    /// Attributi aggiuntivi del contenitore, come gli eventi del mouse
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> Attributes { get; set; }

    /// <summary>
    /// Nome univoco che collega switch ed etichetta
    /// </summary>
    private readonly string _name = "rf-switch-" + Guid.NewGuid().ToString("N");
}
