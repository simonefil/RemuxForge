<div class="status-bar" role="toolbar" aria-label="@AppText.T("web.status.shortcuts")">
    @foreach (UiCommandDefinition command in GetCommands())
    {
        <button type="button"
                class="cmd-key"
                disabled="@command.Disabled"
                @onclick="() => ExecuteCommandAsync(command)">
            <span class="key-label">@command.Shortcut</span>@command.GetStatusLabel()
        </button>
    }
</div>

@code {
    /// <summary>
    /// Comandi contestuali condivisi
    /// </summary>
    [Parameter] public IReadOnlyList<UiCommandDefinition> Commands { get; set; }

    /// <summary>
    /// Evento invocazione comando condiviso
    /// </summary>
    [Parameter] public EventCallback<UiCommandDefinition> OnCommand { get; set; }

    /// <summary>
    /// Filtra e ordina i comandi per status bar
    /// </summary>
    /// <returns>Comandi renderizzabili</returns>
    private List<UiCommandDefinition> GetCommands()
    {
        List<UiCommandDefinition> result = new List<UiCommandDefinition>();

        if (this.Commands != null)
        {
            for (int i = 0; i < this.Commands.Count; i++)
            {
                UiCommandDefinition command = this.Commands[i];
                if ((command.Placement & UiCommandPlacement.Status) != 0)
                {
                    result.Add(command);
                }
            }
        }

        result.Sort((left, right) => left.StatusOrder.CompareTo(right.StatusOrder));
        return result;
    }

    /// <summary>
    /// Invoca un comando condiviso
    /// </summary>
    /// <param name="command">Comando richiesto</param>
    private async Task ExecuteCommandAsync(UiCommandDefinition command)
    {
        await this.OnCommand.InvokeAsync(command);
    }
}
