<nav class="menu-bar" aria-label="@AppText.T("web.navigation.menu")">
    @for (int i = 0; i < _menus.Count; i++)
    {
        int idx = i;
        MenuDef menu = _menus[i];
        int mnemonicIndex = FindMnemonicIndex(menu.Label, menu.Mnemonic);
        <div class="menu-bar-entry">
            <button type="button"
                    class="menu-bar-item @(_activeIndex == idx ? "active" : "")"
                    aria-haspopup="menu"
                    aria-expanded="@(_activeIndex == idx)"
                    @onclick="() => ToggleMenu(idx)"
                    @onmouseenter="() => HoverMenu(idx)">
                @if (mnemonicIndex >= 0)
                {
                    @menu.Label.Substring(0, mnemonicIndex)<span class="menu-mnemonic">@menu.Label.Substring(mnemonicIndex, 1)</span>@menu.Label.Substring(mnemonicIndex + 1)
                }
                else
                {
                    @menu.Label
                }
            </button>

            @if (_activeIndex == idx)
            {
                <div class="menu-dropdown" role="menu">
                    @for (int itemIndex = 0; itemIndex < menu.Items.Count; itemIndex++)
                    {
                        int currentItemIndex = itemIndex;
                        MenuItemDef item = menu.Items[itemIndex];
                        if (item.IsSeparator)
                        {
                            <hr role="separator" />
                        }
                        else
                        {
                            <button type="button"
                                    role="menuitem"
                                    disabled="@item.Disabled"
                                    tabindex="@(_activeItemIndex == currentItemIndex ? 0 : -1)"
                                    class="menu-dropdown-item @(_activeItemIndex == currentItemIndex ? "active" : "")"
                                    @onclick="() => InvokeItemAsync(item)"
                                    @onmouseenter="() => SetActiveItem(currentItemIndex)">
                                <span>@item.Label</span>
                                @if (!string.IsNullOrEmpty(item.Shortcut))
                                {
                                    <span class="shortcut">@item.Shortcut</span>
                                }
                            </button>
                        }
                    }
                </div>
            }
        </div>
    }
</nav>

@if (_activeIndex >= 0)
{
    <div class="menu-overlay" aria-hidden="true" @onclick="CloseMenu"></div>
}

@code {
    /// <summary>
    /// Definizione menu
    /// </summary>
    private class MenuDef
    {
        /// <summary>
        /// Etichetta del menu
        /// </summary>
        public string Label;

        /// <summary>
        /// Voci del menu
        /// </summary>
        public List<MenuItemDef> Items;

        /// <summary>
        /// Mnemonico tastiera per apertura con Option/Alt
        /// </summary>
        public string Mnemonic;
    }

    /// <summary>
    /// Definizione voce menu
    /// </summary>
    private class MenuItemDef
    {
        /// <summary>
        /// Etichetta della voce
        /// </summary>
        public string Label;

        /// <summary>
        /// Scorciatoia tastiera
        /// </summary>
        public string Shortcut;

        /// <summary>
        /// Callback azione
        /// </summary>
        public Func<Task> Callback;

        /// <summary>
        /// Flag separatore
        /// </summary>
        public bool IsSeparator;

        /// <summary>
        /// Flag voce disabilitata durante un'operazione
        /// </summary>
        public bool Disabled;
    }

    /// <summary>
    /// Comandi contestuali condivisi
    /// </summary>
    [Parameter] public IReadOnlyList<UiCommandDefinition> Commands { get; set; }

    /// <summary>
    /// Evento invocazione comando condiviso
    /// </summary>
    [Parameter] public EventCallback<UiCommandDefinition> OnCommand { get; set; }

    /// <summary>
    /// Evento cambio tema
    /// </summary>
    [Parameter] public EventCallback<string> OnThemeChanged { get; set; }

    /// <summary>
    /// Evento cambio lingua
    /// </summary>
    [Parameter] public EventCallback<string> OnLanguageChanged { get; set; }

    /// <summary>
    /// Tema corrente
    /// </summary>
    [Parameter] public string CurrentTheme { get; set; }

    /// <summary>
    /// Lingua corrente
    /// </summary>
    [Parameter] public string CurrentLanguage { get; set; }

    /// <summary>
    /// Indice menu attualmente aperto (-1 = nessuno)
    /// </summary>
    private int _activeIndex = -1;

    /// <summary>
    /// Indice voce attiva nel menu aperto
    /// </summary>
    private int _activeItemIndex = -1;

    /// <summary>
    /// Lista definizioni menu
    /// </summary>
    private List<MenuDef> _menus;

    /// <summary>
    /// Inizializzazione definizioni menu
    /// </summary>
    protected override void OnParametersSet()
    {
        this._menus = new List<MenuDef>
        {
            this.CreateMenu(AppText.T("web.menu.file"), AppText.T("web.menu.file.mnemonic"), UiCommandMenuSection.File),
            this.CreateMenu(AppText.T("web.menu.actions"), AppText.T("web.menu.actions.mnemonic"), UiCommandMenuSection.Actions),
            this.CreateMenu(AppText.T("web.menu.settings"), AppText.T("web.menu.settings.mnemonic"), UiCommandMenuSection.Settings),
            new MenuDef { Label = AppText.T("web.menu.theme"), Mnemonic = AppText.T("web.menu.theme.mnemonic"), Items = this.CreateThemeMenuItems() },
            new MenuDef { Label = AppText.T("web.menu.language"), Mnemonic = AppText.T("web.menu.language.mnemonic"), Items = new List<MenuItemDef>
            {
                new MenuItemDef { Label = FormatLanguageLabel(AppText.T("web.language.english"), AppText.LANG_EN), Shortcut = "", Callback = () => OnLanguageChanged.InvokeAsync(AppText.LANG_EN), Disabled = this.IsCommandMenuBusy() },
                new MenuItemDef { Label = FormatLanguageLabel(AppText.T("web.language.italian"), AppText.LANG_IT), Shortcut = "", Callback = () => OnLanguageChanged.InvokeAsync(AppText.LANG_IT), Disabled = this.IsCommandMenuBusy() },
            }},
            this.CreateMenu(AppText.T("web.menu.help"), AppText.T("web.menu.help.mnemonic"), UiCommandMenuSection.Help)
        };

        this.NormalizeActiveMenu();
    }

    /// <summary>
    /// Crea una sezione menu dai comandi condivisi
    /// </summary>
    /// <param name="label">Etichetta sezione</param>
    /// <param name="mnemonic">Mnemonico sezione</param>
    /// <param name="section">Sezione richiesta</param>
    /// <returns>Definizione menu pronta per il renderer</returns>
    private MenuDef CreateMenu(string label, string mnemonic, UiCommandMenuSection section)
    {
        List<MenuItemDef> items = new List<MenuItemDef>();

        if (this.Commands != null)
        {
            for (int i = 0; i < this.Commands.Count; i++)
            {
                UiCommandDefinition command = this.Commands[i];
                if ((command.Placement & UiCommandPlacement.Menu) == 0 || command.MenuSection != section)
                {
                    continue;
                }

                if (command.SeparatorBefore && items.Count > 0)
                {
                    items.Add(new MenuItemDef { Label = "", Shortcut = "", Callback = null, IsSeparator = true });
                }

                items.Add(new MenuItemDef
                {
                    Label = command.Label,
                    Shortcut = command.Shortcut,
                    Callback = () => this.OnCommand.InvokeAsync(command),
                    Disabled = command.Disabled
                });
            }
        }

        return new MenuDef { Label = label, Mnemonic = mnemonic, Items = items };
    }

    /// <summary>
    /// Gestisce navigazione tastiera della menu bar
    /// </summary>
    /// <param name="key">Tasto premuto</param>
    /// <param name="ctrl">Flag Ctrl</param>
    /// <param name="shift">Flag Shift</param>
    /// <param name="alt">Flag Alt</param>
    /// <returns>True se il tasto è stato gestito dal menu</returns>
    public async Task<bool> HandleKeyboardKeyAsync(string key, bool ctrl, bool shift, bool alt)
    {
        bool result = false;
        int mnemonicIndex;

        if (this._menus == null || this._menus.Count == 0 || ctrl)
        {
            return result;
        }

        if (this._activeIndex >= 0)
        {
            result = true;
            if (key == "Escape" || key == "Alt")
            {
                this.CloseMenu();
            }
            else if (key == "ArrowRight")
            {
                this.MoveMenu(1);
            }
            else if (key == "ArrowLeft")
            {
                this.MoveMenu(-1);
            }
            else if (key == "ArrowDown")
            {
                this.MoveMenuItem(1);
            }
            else if (key == "ArrowUp")
            {
                this.MoveMenuItem(-1);
            }
            else if (key == "Home")
            {
                this.SetFirstSelectableItem();
            }
            else if (key == "End")
            {
                this.SetLastSelectableItem();
            }
            else if (key == "Enter" || key == " ")
            {
                await this.InvokeActiveItemAsync();
            }
            else if (alt && this.TryFindMenuMnemonic(key, out mnemonicIndex))
            {
                this.OpenMenu(mnemonicIndex);
            }
            else
            {
                result = false;
            }
        }
        else if (key == "Alt")
        {
            this.OpenMenu(0);
            result = true;
        }
        else if (alt && this.TryFindMenuMnemonic(key, out mnemonicIndex))
        {
            this.OpenMenu(mnemonicIndex);
            result = true;
        }

        return result;
    }

    /// <summary>
    /// Apre/chiude un menu per click
    /// </summary>
    /// <param name="index">Indice del menu</param>
    private void ToggleMenu(int index)
    {
        if (this._activeIndex == index)
        {
            this._activeIndex = -1;
            this._activeItemIndex = -1;
        }
        else
        {
            this.OpenMenu(index);
        }
    }

    /// <summary>
    /// Commuta menu al passaggio del mouse (solo se un menu è già aperto)
    /// </summary>
    /// <param name="index">Indice del menu</param>
    private void HoverMenu(int index)
    {
        if (this._activeIndex >= 0)
        {
            this.OpenMenu(index);
        }
    }

    /// <summary>
    /// Chiude il menu attivo
    /// </summary>
    private void CloseMenu()
    {
        this._activeIndex = -1;
        this._activeItemIndex = -1;
    }

    /// <summary>
    /// Invoca callback voce menu e chiude
    /// </summary>
    /// <param name="item">Voce menu</param>
    private async Task InvokeItemAsync(MenuItemDef item)
    {
        this.CloseMenu();
        if (!item.Disabled && item.Callback != null)
        {
            await item.Callback.Invoke();
        }
    }

    /// <summary>
    /// Apre il menu indicato e seleziona la prima voce utile
    /// </summary>
    /// <param name="index">Indice menu</param>
    private void OpenMenu(int index)
    {
        if (index < 0 || index >= this._menus.Count)
        {
            return;
        }

        this._activeIndex = index;
        this.SetFirstSelectableItem();
    }

    /// <summary>
    /// Cambia menu attivo
    /// </summary>
    /// <param name="delta">Spostamento relativo</param>
    private void MoveMenu(int delta)
    {
        int index = this._activeIndex + delta;

        if (index < 0)
            index = this._menus.Count - 1;
        if (index >= this._menus.Count)
            index = 0;
        this.OpenMenu(index);
    }

    /// <summary>
    /// Cambia voce attiva nel menu aperto saltando separatori
    /// </summary>
    /// <param name="delta">Spostamento relativo</param>
    private void MoveMenuItem(int delta)
    {
        List<MenuItemDef> items;
        int index;
        int attempts = 0;

        if (this._activeIndex < 0 || this._activeIndex >= this._menus.Count)
        {
            return;
        }

        items = this._menus[this._activeIndex].Items;
        if (items.Count == 0)
        {
            this._activeItemIndex = -1;
            return;
        }

        index = this._activeItemIndex;
        if (index < 0)
        {
            index = delta >= 0 ? -1 : items.Count;
        }

        do
        {
            index += delta;
            if (index < 0)
                index = items.Count - 1;
            if (index >= items.Count)
                index = 0;
            attempts++;
        }
        while (attempts <= items.Count && (items[index].IsSeparator || items[index].Disabled));

        if (attempts <= items.Count)
        {
            this._activeItemIndex = index;
        }
    }

    /// <summary>
    /// Seleziona prima voce attivabile
    /// </summary>
    private void SetFirstSelectableItem()
    {
        this._activeItemIndex = this.FindSelectableItem(0, 1);
    }

    /// <summary>
    /// Seleziona ultima voce attivabile
    /// </summary>
    private void SetLastSelectableItem()
    {
        if (this._activeIndex < 0 || this._activeIndex >= this._menus.Count)
        {
            this._activeItemIndex = -1;
            return;
        }

        this._activeItemIndex = this.FindSelectableItem(this._menus[this._activeIndex].Items.Count - 1, -1);
    }

    /// <summary>
    /// Imposta voce attiva da hover mouse
    /// </summary>
    /// <param name="itemIndex">Indice voce</param>
    private void SetActiveItem(int itemIndex)
    {
        if (this._activeIndex >= 0 && this._activeIndex < this._menus.Count &&
            itemIndex >= 0 && itemIndex < this._menus[this._activeIndex].Items.Count &&
            !this._menus[this._activeIndex].Items[itemIndex].Disabled)
        {
            this._activeItemIndex = itemIndex;
        }
    }

    /// <summary>
    /// Invoca la voce attiva
    /// </summary>
    private async Task InvokeActiveItemAsync()
    {
        if (this._activeIndex < 0 || this._activeIndex >= this._menus.Count)
        {
            return;
        }

        if (this._activeItemIndex < 0 || this._activeItemIndex >= this._menus[this._activeIndex].Items.Count)
        {
            return;
        }

        if (this._menus[this._activeIndex].Items[this._activeItemIndex].IsSeparator || this._menus[this._activeIndex].Items[this._activeItemIndex].Disabled)
        {
            return;
        }

        await this.InvokeItemAsync(this._menus[this._activeIndex].Items[this._activeItemIndex]);
    }

    /// <summary>
    /// Cerca una voce selezionabile nel menu attivo
    /// </summary>
    private int FindSelectableItem(int startIndex, int direction)
    {
        int result = -1;
        List<MenuItemDef> items;

        if (this._activeIndex < 0 || this._activeIndex >= this._menus.Count)
        {
            return result;
        }

        items = this._menus[this._activeIndex].Items;
        for (int i = startIndex; i >= 0 && i < items.Count; i += direction)
        {
            if (!items[i].IsSeparator && !items[i].Disabled)
            {
                result = i;
                break;
            }
        }

        return result;
    }

    /// <summary>
    /// Trova menu tramite mnemonico
    /// </summary>
    private bool TryFindMenuMnemonic(string key, out int index)
    {
        bool result = false;
        string normalizedKey = key != null ? key.ToUpperInvariant() : "";
        index = -1;

        if (normalizedKey.Length == 1)
        {
            for (int i = 0; i < this._menus.Count; i++)
            {
                if (string.Equals(this._menus[i].Mnemonic, normalizedKey, StringComparison.OrdinalIgnoreCase))
                {
                    index = i;
                    result = true;
                    break;
                }
            }
        }

        return result;
    }

    /// <summary>
    /// Trova posizione del mnemonico nella label
    /// </summary>
    /// <param name="label">Label menu</param>
    /// <param name="mnemonic">Mnemonico</param>
    /// <returns>Indice carattere, -1 se non trovato</returns>
    private int FindMnemonicIndex(string label, string mnemonic)
    {
        int result = -1;

        if (!string.IsNullOrEmpty(label) && !string.IsNullOrEmpty(mnemonic))
        {
            result = label.IndexOf(mnemonic, StringComparison.OrdinalIgnoreCase);
        }

        return result;
    }

    /// <summary>
    /// Normalizza indici attivi dopo rebuild menu
    /// </summary>
    private void NormalizeActiveMenu()
    {
        if (this._activeIndex >= this._menus.Count)
        {
            this.CloseMenu();
            return;
        }

        if (this._activeIndex >= 0 && this._activeItemIndex < 0)
        {
            this.SetFirstSelectableItem();
        }
    }

    /// <summary>
    /// Format label lingua con indicatore di selezione
    /// </summary>
    /// <param name="label">Label lingua</param>
    /// <param name="language">Codice lingua</param>
    /// <returns>Label con stato selezionato</returns>
    private string FormatLanguageLabel(string label, string language)
    {
        string current = AppText.NormalizeLanguage(this.CurrentLanguage);
        string prefix = string.Equals(current, language, StringComparison.OrdinalIgnoreCase) ? "✓ " : "";
        return prefix + label;
    }

    /// <summary>
    /// Crea le voci per tutti i temi gratuiti inclusi in Radzen
    /// </summary>
    /// <returns>Voci del menu temi</returns>
    private List<MenuItemDef> CreateThemeMenuItems()
    {
        string[] labels =
        {
            "Default",
            "Dark",
            "Humanistic",
            "Humanistic Dark",
            "Material",
            "Material Dark",
            "Software",
            "Software Dark",
            "Standard",
            "Standard Dark"
        };
        List<MenuItemDef> items = new List<MenuItemDef>();

        for (int i = 0; i < AppSettingsModel.VALID_THEMES.Length; i++)
        {
            string theme = AppSettingsModel.VALID_THEMES[i];
            string prefix = string.Equals(this.CurrentTheme, theme, StringComparison.Ordinal) ? "✓ " : "";
            items.Add(new MenuItemDef
            {
                Label = prefix + labels[i],
                Shortcut = "",
                Callback = () => this.OnThemeChanged.InvokeAsync(theme),
                Disabled = this.IsCommandMenuBusy()
            });
        }

        return items;
    }

    /// <summary>
    /// Verifica lo stato busy dalla definizione condivisa del comando Stop
    /// </summary>
    /// <returns>True se Stop è attivo</returns>
    private bool IsCommandMenuBusy()
    {
        if (this.Commands != null)
        {
            for (int i = 0; i < this.Commands.Count; i++)
            {
                if (this.Commands[i].Shortcut == "F12")
                {
                    return !this.Commands[i].Disabled;
                }
            }
        }

        return false;
    }
}
