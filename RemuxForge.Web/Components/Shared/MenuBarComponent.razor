<div class="rf-menu-bar">
    <UpdateBadgeComponent />
    <RadzenMenu @key="_menuKey" ClickToOpen="true" Responsive="false" AriaLabel="@AppText.T("web.navigation.menu")">
        @foreach (MenuDef menu in _menus)
        {
            <RadzenMenuItem Text="@menu.Label">
                @foreach (MenuItemDef item in menu.Items)
                {
                    <RadzenMenuItem Text="@item.Label"
                                    Icon="@item.Icon"
                                    Disabled="@item.Disabled"
                                    Click="@(args => InvokeItemAsync(item))">
                        <Template>
                            @if (menu.HasIcons && string.IsNullOrEmpty(item.Icon))
                            {
                                @* Segnaposto che mantiene allineate le voci senza icona *@
                                <i class="notranslate rzi rz-navigation-item-icon" aria-hidden="true"></i>
                            }
                            <span class="rz-navigation-item-text">@item.Label</span>
                            @if (!string.IsNullOrEmpty(item.Shortcut))
                            {
                                <span class="rf-menu-shortcut">@item.Shortcut</span>
                            }
                        </Template>
                    </RadzenMenuItem>
                }
            </RadzenMenuItem>
        }
    </RadzenMenu>
</div>

@code {
    /// <summary>
    /// Definizione menu
    /// </summary>
    private class MenuDef
    {
        /// <summary>
        /// Etichetta del menu
        /// </summary>
        public string Label;

        /// <summary>
        /// Voci del menu
        /// </summary>
        public List<MenuItemDef> Items;

        /// <summary>
        /// Flag almeno una voce con icona, per allineare le voci senza icona
        /// </summary>
        public bool HasIcons;
    }

    /// <summary>
    /// Definizione voce menu
    /// </summary>
    private class MenuItemDef
    {
        /// <summary>
        /// Etichetta della voce
        /// </summary>
        public string Label;

        /// <summary>
        /// Scorciatoia tastiera mostrata a destra
        /// </summary>
        public string Shortcut;

        /// <summary>
        /// Icona Material della voce
        /// </summary>
        public string Icon;

        /// <summary>
        /// Callback azione
        /// </summary>
        public Func<Task> Callback;

        /// <summary>
        /// Flag voce disabilitata durante un'operazione
        /// </summary>
        public bool Disabled;
    }

    /// <summary>
    /// Comandi contestuali condivisi
    /// </summary>
    [Parameter] public IReadOnlyList<UiCommandDefinition> Commands { get; set; }

    /// <summary>
    /// Evento invocazione comando condiviso
    /// </summary>
    [Parameter] public EventCallback<UiCommandDefinition> OnCommand { get; set; }

    /// <summary>
    /// Evento cambio tema
    /// </summary>
    [Parameter] public EventCallback<string> OnThemeChanged { get; set; }

    /// <summary>
    /// Evento cambio lingua
    /// </summary>
    [Parameter] public EventCallback<string> OnLanguageChanged { get; set; }

    /// <summary>
    /// Tema corrente
    /// </summary>
    [Parameter] public string CurrentTheme { get; set; }

    /// <summary>
    /// Lingua corrente
    /// </summary>
    [Parameter] public string CurrentLanguage { get; set; }

    /// <summary>
    /// Lista definizioni menu
    /// </summary>
    private List<MenuDef> _menus;

    /// <summary>
    /// Chiave della struttura voci: RadzenMenu non deregistra le voci rimosse, quindi il menu si ricrea quando la struttura cambia
    /// </summary>
    private string _menuKey;

    /// <summary>
    /// Inizializzazione definizioni menu
    /// </summary>
    protected override void OnParametersSet()
    {
        this._menus = new List<MenuDef>
        {
            this.CreateMenu(AppText.T("web.menu.file"), UiCommandMenuSection.File),
            this.CreateMenu(AppText.T("web.menu.actions"), UiCommandMenuSection.Actions),
            this.CreateMenu(AppText.T("web.menu.settings"), UiCommandMenuSection.Settings),
            this.CreateMenuDef(AppText.T("web.menu.theme"), this.CreateThemeMenuItems()),
            this.CreateMenuDef(AppText.T("web.menu.language"), new List<MenuItemDef>
            {
                this.CreateLanguageMenuItem(AppText.T("web.language.english"), AppText.LANG_EN),
                this.CreateLanguageMenuItem(AppText.T("web.language.italian"), AppText.LANG_IT)
            }),
            this.CreateMenu(AppText.T("web.menu.help"), UiCommandMenuSection.Help)
        };

        this._menuKey = this.BuildMenuKey();
    }

    /// <summary>
    /// Crea una sezione menu dai comandi condivisi
    /// </summary>
    /// <param name="label">Etichetta sezione</param>
    /// <param name="section">Sezione richiesta</param>
    /// <returns>Definizione menu pronta per il renderer</returns>
    private MenuDef CreateMenu(string label, UiCommandMenuSection section)
    {
        List<MenuItemDef> items = new List<MenuItemDef>();

        if (this.Commands != null)
        {
            for (int i = 0; i < this.Commands.Count; i++)
            {
                UiCommandDefinition command = this.Commands[i];
                if ((command.Placement & UiCommandPlacement.Menu) == 0 || command.MenuSection != section)
                {
                    continue;
                }

                items.Add(new MenuItemDef
                {
                    Label = command.Label,
                    Shortcut = command.Shortcut,
                    Icon = command.Icon,
                    Callback = () => this.OnCommand.InvokeAsync(command),
                    Disabled = command.Disabled
                });
            }
        }

        return this.CreateMenuDef(label, items);
    }

    /// <summary>
    /// Crea la definizione menu calcolando la presenza di icone
    /// </summary>
    /// <param name="label">Etichetta sezione</param>
    /// <param name="items">Voci della sezione</param>
    /// <returns>Definizione menu</returns>
    private MenuDef CreateMenuDef(string label, List<MenuItemDef> items)
    {
        bool hasIcons = false;

        for (int i = 0; i < items.Count; i++)
        {
            if (!string.IsNullOrEmpty(items[i].Icon))
            {
                hasIcons = true;
                break;
            }
        }

        return new MenuDef { Label = label, Items = items, HasIcons = hasIcons };
    }

    /// <summary>
    /// Costruisce la chiave della struttura corrente delle voci
    /// </summary>
    /// <returns>Chiave testuale della struttura</returns>
    private string BuildMenuKey()
    {
        System.Text.StringBuilder builder = new System.Text.StringBuilder();

        for (int i = 0; i < this._menus.Count; i++)
        {
            builder.Append(this._menus[i].Label).Append('\u001f');
            for (int j = 0; j < this._menus[i].Items.Count; j++)
            {
                builder.Append(this._menus[i].Items[j].Label).Append('\u001e');
            }
        }

        return builder.ToString();
    }

    /// <summary>
    /// Invoca callback voce menu
    /// </summary>
    /// <param name="item">Voce menu</param>
    private async Task InvokeItemAsync(MenuItemDef item)
    {
        if (!item.Disabled && item.Callback != null)
        {
            await item.Callback.Invoke();
        }
    }

    /// <summary>
    /// Crea la voce di una lingua con l'icona di selezione sulla lingua corrente
    /// </summary>
    /// <param name="label">Label lingua</param>
    /// <param name="language">Codice lingua</param>
    /// <returns>Voce menu lingua</returns>
    private MenuItemDef CreateLanguageMenuItem(string label, string language)
    {
        string current = AppText.NormalizeLanguage(this.CurrentLanguage);
        bool selected = string.Equals(current, language, StringComparison.OrdinalIgnoreCase);

        return new MenuItemDef
        {
            Label = label,
            Shortcut = "",
            Icon = selected ? "check" : "",
            Callback = () => this.OnLanguageChanged.InvokeAsync(language),
            Disabled = this.IsCommandMenuBusy()
        };
    }

    /// <summary>
    /// Crea le voci per tutti i temi gratuiti inclusi in Radzen
    /// </summary>
    /// <returns>Voci del menu temi</returns>
    private List<MenuItemDef> CreateThemeMenuItems()
    {
        string[] labels =
        {
            "Default",
            "Dark",
            "Humanistic",
            "Humanistic Dark",
            "Material",
            "Material Dark",
            "Software",
            "Software Dark",
            "Standard",
            "Standard Dark"
        };
        List<MenuItemDef> items = new List<MenuItemDef>();

        for (int i = 0; i < AppSettingsModel.VALID_THEMES.Length; i++)
        {
            string theme = AppSettingsModel.VALID_THEMES[i];
            bool selected = string.Equals(this.CurrentTheme, theme, StringComparison.Ordinal);
            items.Add(new MenuItemDef
            {
                Label = labels[i],
                Shortcut = "",
                Icon = selected ? "check" : "",
                Callback = () => this.OnThemeChanged.InvokeAsync(theme),
                Disabled = this.IsCommandMenuBusy()
            });
        }

        return items;
    }

    /// <summary>
    /// Verifica lo stato busy dalla definizione condivisa del comando Stop
    /// </summary>
    /// <returns>True se Stop è attivo</returns>
    private bool IsCommandMenuBusy()
    {
        if (this.Commands != null)
        {
            for (int i = 0; i < this.Commands.Count; i++)
            {
                if (this.Commands[i].Shortcut == "F12")
                {
                    return !this.Commands[i].Disabled;
                }
            }
        }

        return false;
    }
}
