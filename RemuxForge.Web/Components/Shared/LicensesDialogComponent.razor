@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
    <div class="rf-dialog-body">
        <p class="licenses-intro">@AppText.T("web.licenses.intro")</p>
        <RadzenTable GridLines="DataGridGridLines.Horizontal" AllowAlternatingRows="false" class="licenses-table">
            <RadzenTableHeader>
                <RadzenTableHeaderRow>
                    <RadzenTableHeaderCell>@AppText.T("web.licenses.component")</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell>@AppText.T("web.licenses.license")</RadzenTableHeaderCell>
                </RadzenTableHeaderRow>
            </RadzenTableHeader>
            <RadzenTableBody>
                <RadzenTableRow>
                    <RadzenTableCell>RemuxForge</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/simonefil/RemuxForge/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">GNU GPL v3.0 or later</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>.NET / ASP.NET Core</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/dotnet/runtime/blob/main/LICENSE.TXT" target="_blank" rel="noopener noreferrer">MIT</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>Radzen Blazor</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/radzenhq/radzen-blazor/blob/master/LICENSE" target="_blank" rel="noopener noreferrer">MIT</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>OpenCvSharp</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/shimat/opencvsharp/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">Apache License 2.0</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>OpenCV</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/opencv/opencv/blob/4.x/LICENSE" target="_blank" rel="noopener noreferrer">Apache License 2.0</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>SkiaSharp</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/mono/SkiaSharp/blob/main/LICENSE.md" target="_blank" rel="noopener noreferrer">MIT</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>Skia</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/google/skia/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">BSD 3-Clause</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>ZstdSharp.Port</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/oleg-st/ZstdSharp/blob/master/LICENSE" target="_blank" rel="noopener noreferrer">MIT</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>Vortice.Vulkan</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/amerkoleci/Vortice.Vulkan/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>Tauri</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/tauri-apps/tauri#license" target="_blank" rel="noopener noreferrer">MIT OR Apache License 2.0</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>Tauri plugins</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/tauri-apps/plugins-workspace/blob/v2/LICENSE_MIT" target="_blank" rel="noopener noreferrer">MIT OR Apache License 2.0</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>Serde</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/serde-rs/serde#license" target="_blank" rel="noopener noreferrer">MIT OR Apache License 2.0</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>serde_json</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/serde-rs/json#license" target="_blank" rel="noopener noreferrer">MIT OR Apache License 2.0</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>ArrayFire</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/arrayfire/arrayfire/blob/v3.10.0/LICENSE" target="_blank" rel="noopener noreferrer">BSD 3-Clause</a></RadzenTableCell>
                </RadzenTableRow>
                <RadzenTableRow>
                    <RadzenTableCell>OpenSIFT</RadzenTableCell>
                    <RadzenTableCell><a href="https://github.com/simonefil/RemuxForge/blob/main/RemuxForge.Vulkan/THIRD-PARTY-NOTICES.md" target="_blank" rel="noopener noreferrer">BSD 3-Clause</a></RadzenTableCell>
                </RadzenTableRow>
            </RadzenTableBody>
        </RadzenTable>
        <p class="licenses-note">@AppText.T("web.licenses.note")</p>
    </div>
    <div class="rf-dialog-footer">
        <RadzenButton Text="@AppText.T("web.common.close")" Icon="close" Click="@(() => CloseDialog())" />
    </div>
</div>

<style>
    .licenses-intro {
        margin-top: 0;
    }

    .licenses-table th:last-child,
    .licenses-table td:last-child {
        width: 44%;
    }

    .licenses-table a {
        color: var(--accent);
    }

    .licenses-note {
        margin-bottom: 0;
        color: var(--rz-text-secondary-color);
        font-size: 0.9rem;
    }
</style>
