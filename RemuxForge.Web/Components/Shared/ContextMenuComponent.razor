<div class="ctx-menu-overlay" @onclick="OnClose">
    <div class="ctx-menu-popup" role="menu" aria-label="@AppText.T("web.menu.actions")" style="left: @(X)px; top: @(Y)px;" @onclick:stopPropagation="true">
        @for (int i = 0; i < Commands.Count; i++)
        {
            int idx = i;
            <button type="button"
                    role="menuitem"
                    tabindex="@(idx == SelectedIndex ? 0 : -1)"
                    class="ctx-menu-item @(idx == SelectedIndex ? "active" : "")"
                    @onclick="() => SelectItem(idx)"
                    @onmouseenter="() => SetActiveItem(idx)">@Commands[i].Label</button>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Comandi del context menu
    /// </summary>
    [Parameter] public IReadOnlyList<UiCommandDefinition> Commands { get; set; }

    /// <summary>
    /// Coordinata X posizione menu (pixel)
    /// </summary>
    [Parameter] public double X { get; set; }

    /// <summary>
    /// Coordinata Y posizione menu (pixel)
    /// </summary>
    [Parameter] public double Y { get; set; }

    /// <summary>
    /// Indice voce attiva per navigazione tastiera
    /// </summary>
    [Parameter] public int SelectedIndex { get; set; }

    /// <summary>
    /// Evento chiusura menu (click esterno o Esc)
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Evento selezione voce (indice voce selezionata)
    /// </summary>
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    /// <summary>
    /// Evento cambio voce attiva da hover mouse
    /// </summary>
    [Parameter] public EventCallback<int> OnActiveChanged { get; set; }

    /// <summary>
    /// Gestisce click su voce del menu
    /// </summary>
    /// <param name="index">Indice voce selezionata</param>
    private void SelectItem(int index)
    {
        OnSelect.InvokeAsync(index);
    }

    /// <summary>
    /// Imposta voce attiva da hover mouse
    /// </summary>
    /// <param name="index">Indice voce attiva</param>
    private void SetActiveItem(int index)
    {
        OnActiveChanged.InvokeAsync(index);
    }
}
