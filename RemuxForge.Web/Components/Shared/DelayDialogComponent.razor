@inherits AppDialogContentBase

<div class="rf-dialog" @ref="DialogContent">
    <div class="rf-dialog-body">
        <div style="color: var(--rz-text-disabled-color);">@AppText.F("web.delay.syncOffset", Record.SyncOffsetMs)</div>
        <br />
        <div class="form-row">
            <RadzenLabel class="form-label" Text="@AppText.T("web.delay.audio")" Component="DelayAudio" />
            <RadzenNumeric TValue="int" Name="DelayAudio" @bind-Value="_audioDelay" />
        </div>
        <br />
        <div class="form-row">
            <RadzenLabel class="form-label" Text="@AppText.T("web.delay.sub")" Component="DelaySub" />
            <RadzenNumeric TValue="int" Name="DelaySub" @bind-Value="_subDelay" />
        </div>
        <br />
        <div style="color: var(--rz-text-disabled-color);">@AppText.F("web.delay.effective", Record.AudioDelayApplied, Record.SubDelayApplied)</div>
    </div>
    <div class="rf-dialog-footer">
        <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Apply" />
        <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
    </div>
</div>

@code {
    /// <summary>
    /// Record episodio per delay
    /// </summary>
    [Parameter] public FileProcessingRecord Record { get; set; }

    /// <summary>
    /// Delay audio in ms
    /// </summary>
    private int _audioDelay;

    /// <summary>
    /// Delay sottotitoli in ms
    /// </summary>
    private int _subDelay;

    /// <summary>
    /// Precompila campi dal record corrente
    /// </summary>
    protected override void OnInitialized()
    {
        if (Record != null)
        {
            _audioDelay = Record.ManualAudioDelayMs;
            _subDelay = Record.ManualSubDelayMs;
        }
    }

    /// <summary>
    /// Chiude il dialog restituendo i delay (audio, sottotitoli)
    /// </summary>
    private void Apply()
    {
        CloseDialog((_audioDelay, _subDelay));
    }
}
