<div class="dialog-overlay visible" @onclick="OnClose">
    <div class="dialog-box dialog-box-compact" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="delay-dialog-title" @onclick:stopPropagation="true">
        <div id="delay-dialog-title" class="dialog-title">@AppText.F("web.delay.title", Record.EpisodeId)</div>
        <div class="dialog-body">
            <div style="color: var(--rz-text-disabled-color);">@AppText.F("web.delay.syncOffset", Record.SyncOffsetMs)</div>
            <br />
            <div class="form-row">
                <span class="form-label">@AppText.T("web.delay.audio")</span>
                <RadzenTextBox class="form-input" Style="width: 10rem" @bind-Value="_audioDelay" />
            </div>
            <br />
            <div class="form-row">
                <span class="form-label">@AppText.T("web.delay.sub")</span>
                <RadzenTextBox class="form-input" Style="width: 10rem" @bind-Value="_subDelay" />
            </div>
            <br />
            <div style="color: var(--rz-text-disabled-color);">@AppText.F("web.delay.effective", Record.AudioDelayApplied, Record.SubDelayApplied)</div>
        </div>
        <div class="dialog-footer">
            <RadzenButton Text="@AppText.T("web.common.ok")" Icon="check" Click="@Apply" />
            <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@OnClose" />
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Record episodio per delay
    /// </summary>
    [Parameter] public FileProcessingRecord Record { get; set; }

    /// <summary>
    /// Evento chiusura dialog
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Evento applicazione delay (audioDelay, subDelay)
    /// </summary>
    [Parameter] public EventCallback<(int, int)> OnApply { get; set; }

    /// <summary>
    /// Delay audio in ms (stringa per binding input)
    /// </summary>
    private string _audioDelay = "0";

    /// <summary>
    /// Delay sottotitoli in ms (stringa per binding input)
    /// </summary>
    private string _subDelay = "0";

    /// <summary>
    /// Precompila campi dal record corrente
    /// </summary>
    protected override void OnInitialized()
    {
        if (Record != null)
        {
            _audioDelay = Record.ManualAudioDelayMs.ToString();
            _subDelay = Record.ManualSubDelayMs.ToString();
        }
    }

    /// <summary>
    /// Applica delay e notifica il parent
    /// </summary>
    private void Apply()
    {
        int audioVal;
        int subVal;

        int.TryParse(_audioDelay, out audioVal);
        int.TryParse(_subDelay, out subVal);

        OnApply.InvokeAsync((audioVal, subVal));
    }
}
