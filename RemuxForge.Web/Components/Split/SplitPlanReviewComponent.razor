@* Revisione dei piani Split: l'elenco scorre, le azioni restano sempre visibili in fondo. *@
<section class="split-plan-review" aria-labelledby="split-plan-review-title">
    <div class="split-plan-review-head">
        <h2 id="split-plan-review-title">@AppText.T("web.splitMontage.review")</h2>
        <div role="status" aria-live="polite">@AppText.T("web.splitMontage.reviewStage." + Stage)</div>
        @if (Stage == "ready")
        {
            <p>@AppText.T("web.splitMontage.reviewConcreteHelp")</p>
        }
    </div>
    @if (Stage == "ready")
    {
        <RadzenAccordion Multiple="true" class="split-plan-review-files">
            <Items>
            @foreach (MkvSplitRecord record in Records)
            {
                <RadzenAccordionItem @key="record.RecordId" Text="@(System.IO.Path.GetFileName(record.InputFile) + " · " + Utils.GetSplitStatusText(record.Status) + (record.IsOverride ? " · " + AppText.T("web.split.overrideBadge") : ""))">
                    @if (record.MontageProjection != null)
                    {
                        @foreach (MkvSplitOutputProjection output in record.MontageProjection.Outputs)
                        {
                            <div class="split-plan-review-output">
                                <strong>@output.FileName</strong> · @Utils.SecsToTs(output.DurationSeconds) · @AppText.Count("web.splitMontage.clipCount", output.Clips.Count)
                                <div>@output.FullPath</div>
                                @foreach (MkvSplitClipProjection clip in output.Clips)
                                {
                                    <div>@AppText.T("web.splitMontage.source"): @AppText.F("web.splitMontage.clipLabel", output.Clips.IndexOf(clip) + 1, Utils.SecsToTs(clip.SourceStartSeconds), Utils.SecsToTs(clip.SourceEndSeconds))</div>
                                    <div>@AppText.T("web.splitMontage.result"): @Utils.SecsToTs(clip.ResultStartSeconds)–@Utils.SecsToTs(clip.ResultEndSeconds)</div>
                                }
                            </div>
                        }
                        @* Errori e avvisi separati come nel dettaglio del file: un avviso (es. GOP aperto) non è un errore *@
                        @foreach (MkvSplitDiagnosticSeverity severity in new[] { MkvSplitDiagnosticSeverity.Error, MkvSplitDiagnosticSeverity.Warning })
                        {
                            List<MkvSplitDiagnostic> diagnostics = record.MontageProjection.Diagnostics.Where(d => d.Severity == severity).ToList();
                            if (diagnostics.Count > 0)
                            {
                                <RadzenAlert AlertStyle="@(severity == MkvSplitDiagnosticSeverity.Error ? AlertStyle.Danger : AlertStyle.Warning)" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="split-plan-review-alert">
                                    @foreach (MkvSplitDiagnostic diagnostic in diagnostics) { <div class="split-plan-review-alert-row">@diagnostic.Message</div> }
                                </RadzenAlert>
                            }
                        }
                    }
                    else if (record.Plan != null)
                    {
                        @foreach (MkvSplitSegment output in record.Plan.Segments) { <div>@output.File · @Utils.SecsToTs(output.EndTs - output.StartTs)</div> }
                    }
                    @if (!string.IsNullOrEmpty(record.ErrorMessage)) { <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="split-plan-review-alert"><div class="split-plan-review-alert-row">@record.ErrorMessage</div></RadzenAlert> }
                    @* Con il montaggio gli avvisi del piano sono le sue diagnostiche, già mostrate sopra *@
                    @if (record.Plan != null && record.MontageProjection == null) { @foreach (MkvSplitWarning warning in record.Plan.Warnings) { <div>@warning.Message</div> } }
                    <RadzenButton Text="@AppText.T("web.split.openEditor")" Icon="content_cut" Disabled="@Busy" Click="@(() => OnOpenEditor.InvokeAsync(Records.IndexOf(record)))" />
                </RadzenAccordionItem>
            }
            </Items>
        </RadzenAccordion>
    }
    <div class="split-plan-review-actions">
        @if (Stage == "ready")
        {
            <RadzenButton Text="@AppText.T("web.splitMontage.reviewAcknowledge")" Disabled="@(Busy || Records.Count == 0)" Click="@OnContinue" />
        }
        <RadzenButton Text="@AppText.T("web.splitMontage.changeConfiguration")" Variant="Variant.Outlined" Disabled="@Busy" Click="@OnConfigure" />
        @if (Stage == "empty" || Stage == "failed")
        {
            <RadzenButton Text="@AppText.T("web.splitMontage.reviewClose")" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@Busy" Click="@OnClose" />
        }
    </div>
</section>

@code {
    #region Parametri

    /// <summary>
    /// Record Split da rivedere
    /// </summary>
    [Parameter] public List<MkvSplitRecord> Records { get; set; } = new List<MkvSplitRecord>();

    /// <summary>
    /// Fase corrente della revisione
    /// </summary>
    [Parameter] public string Stage { get; set; } = "scan";

    /// <summary>
    /// Indica che la pipeline Split è occupata
    /// </summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>
    /// Evento apertura editor sul record indicato
    /// </summary>
    [Parameter] public EventCallback<int> OnOpenEditor { get; set; }

    /// <summary>
    /// Evento conferma della revisione
    /// </summary>
    [Parameter] public EventCallback OnContinue { get; set; }

    /// <summary>
    /// Evento ritorno alla configurazione
    /// </summary>
    [Parameter] public EventCallback OnConfigure { get; set; }

    /// <summary>
    /// Evento chiusura della revisione quando la scansione non ha trovato file o non è riuscita
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    #endregion
}
