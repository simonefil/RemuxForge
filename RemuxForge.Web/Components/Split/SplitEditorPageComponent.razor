@inject IJSRuntime JsRuntime
@inject SplitOrchestrator SplitOrchestrator
@inject DialogService DialogService
@implements IAsyncDisposable

<section @ref="_root" class="edit-map-page split-montage" tabindex="-1" aria-label="@T("title")">
    <header class="edit-map-page-header">
        <div>@T("title") <div class="edit-map-page-subtitle">@System.IO.Path.GetFileName(Record?.InputFile)</div></div>
        <div class="split-montage-actions">
            <RadzenButton Text="@T("undo")" Icon="undo" Disabled="@(_undo.Count == 0 || _busy)" Click="@(() => HistoryAsync(false))" />
            <RadzenButton Text="@T("redo")" Icon="redo" Disabled="@(_redo.Count == 0 || _busy)" Click="@(() => HistoryAsync(true))" />
            <RadzenButton Icon="close" aria-label="@AppText.T("web.common.close")" title="@(_busy && _snapshot != null ? T("applying") : AppText.T("web.common.close"))" Disabled="@(_busy && _snapshot != null)" Click="CloseAsync" />
        </div>
    </header>
    <main class="split-montage-body">
        @if (_snapshot == null)
        {
            <div role="status">@(_busy ? T("preparing") : _error)</div>
            <RadzenButton Text="@T("retry")" Disabled="@_busy" Click="OpenAsync" />
        }
        else
        {
            @if (_busy) { <div role="status" aria-live="polite">@T("applying")</div> }
            <div class="split-montage-top">
                <FramePreviewPaneComponent @ref="_preview" Title="@T(_sourcePreview ? "source" : "result")" CanvasAlternative="@T("preview")" OverlayMessage="@_previewMessage" Meta="@PreviewMeta()" RetryText="@(_previewMessage == T("previewError") ? T("retryPreview") : "")" OnRetry="RetryPreviewAsync">
                    <Controls>
                        <RadzenButton Text="@T("source")" Variant="@(_sourcePreview ? Variant.Filled : Variant.Outlined)" aria-pressed="@(_sourcePreview ? "true" : "false")" Click="@(() => SetPreviewSideAsync(true))" />
                        <RadzenButton Text="@T("result")" Variant="@(!_sourcePreview ? Variant.Filled : Variant.Outlined)" aria-pressed="@(!_sourcePreview ? "true" : "false")" Click="@(() => SetPreviewSideAsync(false))" />
                        <RadzenButton Icon="chevron_left" aria-label="@T("previousFrame")" data-frame-side="active" data-frame-delta="-1" />
                        <RadzenButton Icon="chevron_right" aria-label="@T("nextFrame")" data-frame-side="active" data-frame-delta="1" />
                    </Controls>
                </FramePreviewPaneComponent>
                <section class="split-montage-output-list">
                    <div class="split-montage-actions">
                        <strong>@T("outputs")</strong>
                        <RadzenButton Text="@T("newOutput")" Click="@(() => EditAsync(MkvSplitEditKind.CreateEmptyOutput))" Disabled="@_busy" />
                    </div>
                    @foreach (MkvSplitOutputProjection output in _projection.Outputs)
                    {
                        <RadzenButton @key="output.OutputId" Text="@(output.FileName + " · " + Time(output.DurationSeconds) + " · " + output.Clips.Count + " " + T("clips") + (output.Clips.Count == 0 ? " · " + T("empty") : ""))" Variant="@(output.OutputId == _outputId ? Variant.Filled : Variant.Outlined)" aria-pressed="@(output.OutputId == _outputId ? "true" : "false")" Click="@(() => SelectOutputAsync(output.OutputId))" />
                    }
                    @if (Output != null)
                    {
                        <label>@T("name") <input class="form-input" @bind="_name" /></label>
                        <div class="split-montage-actions">
                            <RadzenButton Text="@T("rename")" Click="RenameAsync" Disabled="@_busy" />
                            <RadzenButton Text="@T("automaticName")" Click="@(() => EditAsync(MkvSplitEditKind.RenameOutput, nameMode: MkvSplitNameMode.Automatic))" Disabled="@_busy" />
                            <RadzenButton Text="@T("up")" Click="@(() => ReorderOutputAsync(-1))" Disabled="@_busy" />
                            <RadzenButton Text="@T("down")" Click="@(() => ReorderOutputAsync(1))" Disabled="@_busy" />
                            <RadzenButton Text="@T("removeOutput")" ButtonStyle="ButtonStyle.Danger" Click="@(() => EditAsync(MkvSplitEditKind.RemoveOutputs))" Disabled="@_busy" />
                        </div>
                    }
                </section>
            </div>
            <details class="split-montage-source" open>
                <summary>@T("source")</summary>
                <div class="split-montage-actions">
                    <label>@T("sourceIn") <input class="form-input" type="number" min="0" max="@_snapshot.Analysis.SourcePts.Length" @bind="_sourceIn" @bind:after="SelectionChangedAsync" /></label>
                    <label>@T("sourceOut") <input class="form-input" type="number" min="0" max="@_snapshot.Analysis.SourcePts.Length" @bind="_sourceOut" @bind:after="SelectionChangedAsync" /></label>
                    <RadzenButton Text="@T("markIn")" Click="@(() => MarkSourceAsync(true))" />
                    <RadzenButton Text="@T("markOut")" Click="@(() => MarkSourceAsync(false))" />
                    <RadzenButton Text="@T("fromSelection")" Click="@(() => EditAsync(MkvSplitEditKind.CreateOutputFromSource))" Disabled="@_busy" />
                    <RadzenButton Text="@T("append")" Click="@(() => EditAsync(MkvSplitEditKind.AppendSource))" Disabled="@(Output == null || _busy)" />
                    <RadzenButton Text="@T("insert")" Click="@(() => EditAsync(MkvSplitEditKind.InsertSource))" Disabled="@(Output == null || _busy)" />
                </div>
                <MediaTimelinePanelComponent @ref="_sourceTimeline" AudioLanes="@AudioLanes("source")" AudioMode="@_audioMode" AudioModeChanged="AudioModeAsync" WaveformGain="@_gain" WaveformGainChanged="GainAsync" WaveformText="@T("waveform")" SpectrogramText="@T("spectrogram")" WaveformHeightText="@T("gain")" HostAlternative="@T("source")" CanvasAlternative="@T("source")" />
            </details>
            <section class="split-montage-result">
                <div class="split-montage-actions">
                    <strong>@T("result")</strong>
                    <label>@T("resultIn") <input class="form-input" type="number" min="0" max="@(Result?.FrameCount ?? 0)" @bind="View.In" @bind:after="SelectionChangedAsync" /></label>
                    <label>@T("resultOut") <input class="form-input" type="number" min="0" max="@(Result?.FrameCount ?? 0)" @bind="View.Out" @bind:after="SelectionChangedAsync" /></label>
                    <RadzenButton Text="@T("markIn")" Click="@(() => MarkResultAsync(true))" />
                    <RadzenButton Text="@T("markOut")" Click="@(() => MarkResultAsync(false))" />
                    <RadzenButton Text="@T("splitClip")" Click="@(() => EditAsync(MkvSplitEditKind.SplitClip))" Disabled="@(Output == null || _busy)" />
                    <RadzenButton Text="@T("splitOutput")" Click="@(() => EditAsync(MkvSplitEditKind.SplitOutput))" Disabled="@(Output == null || _busy)" />
                    <RadzenButton Text="@T("removeRange")" Click="@(() => EditAsync(MkvSplitEditKind.RemoveResultRange))" Disabled="@(Output == null || _busy)" />
                </div>
                <MediaTimelinePanelComponent @ref="_resultTimeline" AudioLanes="@AudioLanes("result")" AudioMode="@_audioMode" AudioModeChanged="AudioModeAsync" WaveformGain="@_gain" WaveformGainChanged="GainAsync" WaveformText="@T("waveform")" SpectrogramText="@T("spectrogram")" WaveformHeightText="@T("gain")" HostAlternative="@T("result")" CanvasAlternative="@T("result")" />
                <div class="split-montage-clips">
                    @if (Output != null)
                    {
                        @foreach (MkvSplitClip clip in Output.Clips)
                        {
                            <label><input type="checkbox" checked="@View.Selected.Contains(clip.Id)" aria-label="@(T("selectClip") + " " + (Output.Clips.IndexOf(clip) + 1))" @onchange="@(e => ToggleClipSelection(clip.Id, e))" /></label>
                            <RadzenButton @key="clip.Id" Text="@($"{Output.Clips.IndexOf(clip) + 1}: [{clip.StartFrame}, {clip.EndFrameExclusive})")" Variant="@(clip.Id == View.ClipId ? Variant.Filled : Variant.Outlined)" aria-pressed="@(clip.Id == View.ClipId ? "true" : "false")" Click="@(() => SelectClipAsync(clip.Id))" />
                        }
                    }
                </div>
                @if (Clip != null)
                {
                    <div class="split-montage-actions">
                        <label>@T("sourceIn") <input class="form-input" type="number" @bind="_trimIn" /></label>
                        <label>@T("sourceOut") <input class="form-input" type="number" @bind="_trimOut" /></label>
                        <RadzenButton Text="@T("trim")" Click="TrimAsync" Disabled="@_busy" />
                        <RadzenButton Text="@T("snapStart")" title="@AppText.T("web.splitEditor.snapStartHelp")" Click="SnapStartAsync" Disabled="@(_busy || _snapshot.Options.Snap == MkvSplitSnapMode.Off)" />
                        <RadzenButton Text="@T("sharedBoundary")" Click="@(() => EditAsync(MkvSplitEditKind.MoveSharedBoundary))" Disabled="@(!Contiguous || _busy)" />
                        <RadzenButton Text="@T("removeDivision")" Click="@(() => EditAsync(MkvSplitEditKind.RemoveDivision))" Disabled="@(!Contiguous || _busy)" />
                        <RadzenButton Text="@T("up")" Click="@(() => ReorderClipAsync(-1))" Disabled="@_busy" />
                        <RadzenButton Text="@T("down")" Click="@(() => ReorderClipAsync(1))" Disabled="@_busy" />
                        <RadzenButton Text="@T("removeClip")" ButtonStyle="ButtonStyle.Danger" Click="@(() => EditAsync(MkvSplitEditKind.RemoveClips))" Disabled="@_busy" />
                    </div>
                }
                <div class="split-montage-actions">
                    <label>@T("destination") <select class="form-input" @bind="_destinationId">@foreach (MkvSplitOutputProjection output in _projection.Outputs.Where(o => o.OutputId != _outputId)) { <option value="@output.OutputId">@output.FileName</option> }</select></label>
                    <RadzenButton Text="@T("copy")" Click="@(() => EditAsync(MkvSplitEditKind.CopyClips))" Disabled="@(Clip == null || _destinationId == Guid.Empty || _busy)" />
                    <RadzenButton Text="@T("move")" Click="@(() => EditAsync(MkvSplitEditKind.MoveClips))" Disabled="@(Clip == null || _destinationId == Guid.Empty || _busy)" />
                    <RadzenButton Text="@T("merge")" Click="@(() => EditAsync(MkvSplitEditKind.MergeOutputs))" Disabled="@(Output == null || _destinationId == Guid.Empty || _busy)" />
                </div>
            </section>
            <div class="split-montage-diagnostics" role="status">
                @if (!string.IsNullOrEmpty(_error)) { <div>@_error</div> }
                @foreach (MkvSplitDiagnostic diagnostic in _projection.Diagnostics) { <div>@diagnostic.Message</div> }
            </div>
        }
    </main>
    <footer class="edit-map-page-footer">
        <span>@(_projection == null ? "" : _projection.Outputs.Count + " " + T("outputs") + " · " + Time(_projection.DurationSeconds))</span>
        <span class="edit-map-footer-spacer"></span>
        @if (_snapshot != null) { <RadzenButton Text="@T(_snapshot.Document.OriginMode == MkvSplitMode.Manual ? "restoreSource" : "reapplyRule")" Click="ResetAsync" Disabled="@_busy" /> }
        <RadzenButton Text="@AppText.T("web.common.cancel")" title="@(_busy && _snapshot != null ? T("applying") : AppText.T("web.common.cancel"))" Disabled="@(_busy && _snapshot != null)" Click="CloseAsync" />
        <RadzenButton Text="@T("apply")" Click="ApplyAsync" Disabled="@(_busy || _gestureToken != null || _projection?.IsValid != true)" />
    </footer>
</section>
