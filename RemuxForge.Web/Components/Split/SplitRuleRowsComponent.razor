@* Righe della regola Split: conserva la sintassi del core senza far scrivere elenchi separati da virgole. *@
<div class="rf-split-rule-rows">
    @for (int i = 0; i < _rows.Count; i++)
    {
        int index = i;
        SplitRuleRow row = _rows[i];
        bool invalid = ShowErrors && SplitRuleSyntax.RowError(Mode, row.Start, row.End).Length > 0;
        <div class="rf-split-rule-row" role="group" aria-label="@AppText.F("web.splitWizard.rule.row", index + 1)" @key="row">
            <span class="rf-split-rule-number" aria-hidden="true">@(index + 1)</span>
            <div class="rf-split-rule-cell">
                <RadzenLabel Component="@(Name + index)" Text="@StartLabel" />
                <RadzenTextBox Name="@(Name + index)" Value="@row.Start" Disabled="@Disabled" Placeholder="@StartPlaceholder" aria-invalid="@(invalid ? "true" : null)"
                               Change="@(v => ChangeAsync(row, true, v))" Style="width:100%" />
            </div>
            @if (Mode == SplitRuleSyntax.RANGES)
            {
                <div class="rf-split-rule-cell">
                    <RadzenLabel Component="@(Name + "End" + index)" Text="@AppText.T("web.splitWizard.rule.end")" />
                    <RadzenTextBox Name="@(Name + "End" + index)" Value="@row.End" Disabled="@Disabled" aria-invalid="@(invalid ? "true" : null)"
                                   Change="@(v => ChangeAsync(row, false, v))" Style="width:100%" />
                </div>
            }
            <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@Disabled"
                          aria-label="@AppText.F("web.splitWizard.rule.remove", index + 1)" title="@AppText.F("web.splitWizard.rule.remove", index + 1)" Click="@(() => RemoveAsync(row))" />
        </div>
    }
    <RadzenButton Text="@AppText.T("web.splitWizard.rule.add")" Icon="add" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@Disabled" Click="AddAsync" class="rf-split-rule-add" />
</div>

@code {
    #region Parametri

    /// <summary>
    /// Tipo di righe: pattern, ranges o points
    /// </summary>
    [Parameter] public string Mode { get; set; } = SplitRuleSyntax.RANGES;

    /// <summary>
    /// Prefisso dei Name dei controlli: il primo campo è Name0, così l'etichetta del campo lo raggiunge
    /// </summary>
    [Parameter] public string Name { get; set; } = "";

    /// <summary>
    /// Regola nella sintassi del core, separata da virgole
    /// </summary>
    [Parameter] public string Value { get; set; } = "";

    /// <summary>
    /// Evento cambio della regola
    /// </summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// True quando il campo ha errori: le righe non valide vengono marcate
    /// </summary>
    [Parameter] public bool ShowErrors { get; set; }

    /// <summary>
    /// Disabilita le righe
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    #endregion

    #region Variabili di classe

    /// <summary>
    /// Ultimo valore ricevuto o pubblicato
    /// </summary>
    private string _seen;

    /// <summary>
    /// Ultimo tipo di righe ricevuto
    /// </summary>
    private string _seenMode;

    /// <summary>
    /// Righe della regola
    /// </summary>
    private List<SplitRuleRow> _rows = new List<SplitRuleRow>();

    #endregion

    #region Proprietà

    /// <summary>
    /// Etichetta del primo campo della riga
    /// </summary>
    private string StartLabel => AppText.T(Mode switch
    {
        SplitRuleSyntax.PATTERN => "web.splitWizard.rule.chapters",
        SplitRuleSyntax.POINTS => "web.splitWizard.rule.point",
        _ => "web.splitWizard.rule.start"
    });

    /// <summary>
    /// Esempio nel primo campo della riga
    /// </summary>
    private string StartPlaceholder => Mode == SplitRuleSyntax.PATTERN ? "5" : "21:40";

    #endregion

    #region Metodi protetti

    /// <summary>
    /// Ricostruisce le righe soltanto quando valore o tipo cambiano dall'esterno
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_seen == Value && _seenMode == Mode)
            return;
        _seenMode = Mode;
        _seen = Value;
        _rows = SplitRuleSyntax.Parse(Mode, Value);
    }

    #endregion

    #region Metodi privati

    /// <summary>
    /// Aggiorna inizio o fine di una riga e pubblica la regola
    /// </summary>
    /// <param name="row">Riga modificata</param>
    /// <param name="start">True per il primo campo, false per la fine</param>
    /// <param name="value">Valore scritto</param>
    private async Task ChangeAsync(SplitRuleRow row, bool start, string value)
    {
        if (start)
            row.Start = value ?? "";
        else
            row.End = value ?? "";
        await PublishAsync();
    }

    /// <summary>
    /// Aggiunge una riga e pubblica la regola
    /// </summary>
    private async Task AddAsync()
    {
        _rows.Add(new SplitRuleRow
        {
            Start = Mode == SplitRuleSyntax.PATTERN ? "1" : Mode == SplitRuleSyntax.RANGES ? "0" : "",
            End = Mode == SplitRuleSyntax.RANGES ? SplitRuleSyntax.END : ""
        });
        await PublishAsync();
    }

    /// <summary>
    /// Rimuove una riga e pubblica la regola
    /// </summary>
    /// <param name="row">Riga da rimuovere</param>
    private async Task RemoveAsync(SplitRuleRow row)
    {
        _rows.Remove(row);
        await PublishAsync();
    }

    /// <summary>
    /// Pubblica la regola: la validazione la fa il wizard, che possiede gli errori del campo
    /// </summary>
    private async Task PublishAsync()
    {
        _seen = SplitRuleSyntax.Format(Mode, _rows);
        await ValueChanged.InvokeAsync(_seen);
    }

    #endregion
}
