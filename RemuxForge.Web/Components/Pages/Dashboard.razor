@page "/"
@inject MergeOrchestrator Orchestrator
@inject SplitOrchestrator SplitOrchestrator
@inject MetadataOrchestrator MetadataOrchestrator
@inject ThemeService ThemeService
@implements IAsyncDisposable

<div class="rf-layout @(_navigationCollapsed ? "rf-navigation-collapsed" : "")">
    <ModeNavigationComponent CurrentMode="@_currentMode"
                             Collapsed="@_navigationCollapsed"
                             IsBusy="@IsAnyBusy()"
                             OnModeChanged="SwitchMode"
                             OnCollapsedChanged="SetNavigationCollapsed"
                             OnShowInfo="ShowInfo" />

    <section class="rf-app-stage">
        <header class="rf-app-header">
            <div class="rf-app-title">
                <span class="rf-app-title-mode">@GetCurrentModeTitle()</span>
                <span class="rf-app-title-description">@GetCurrentModeDescription()</span>
            </div>

            <MenuBarComponent @ref="_menuBar"
                       Commands="@BuildUiCommands()"
                       OnCommand="ExecuteUiCommandAsync"
                       OnThemeChanged="ChangeThemeAsync"
                       OnLanguageChanged="ChangeLanguageAsync"
                       CurrentTheme="@_currentTheme"
                       CurrentLanguage="@_currentLanguage" />
        </header>

        <CommandToolbarComponent Commands="@BuildUiCommands()"
                                 OnCommand="ExecuteUiCommandAsync" />

        <RadzenSplitter Orientation="Orientation.Vertical" class="rf-workspace-log-splitter">
            <RadzenSplitterPane Size="78%" Min="210px">
                <div class="rf-workspace-host">
                @* Area Pannelli *@
                @if (_currentMode == RemuxForge.Core.Models.Options.MODE_METADATA)
                {
                    <MetadataWorkspaceComponent Options="@MetadataOrchestrator.CurrentOptions"
                                    PresetFiles="@_metadataPresetFiles"
                                    Records="@_metadataRecords"
                                    SelectedRecord="@_selectedMetadataRecord"
                                    SelectedIndex="@MetadataOrchestrator.SelectedIndex"
                                    TrackSummaryBuilder="BuildMetadataTrackSummary"
                                    VideoSummaryBuilder="BuildMetadataVideoSummary"
                                    OutputPolicyValueProvider="GetMetadataOutputPolicyValue"
                                    OnPresetChanged="ChangeMetadataPreset"
                                    OnSourcePathChanged="ChangeMetadataSourcePath"
                                    OnOutputPolicyChanged="ChangeMetadataOutputPolicy"
                                    OnOutputPathChanged="ChangeMetadataOutputDir"
                                    OnBrowseSource="@(() => BrowseMetadataPath(0, true, true))"
                                    OnBrowseOutput="@(() => BrowseMetadataPath(1, false, true))"
                                    OnToggleRecursive="ToggleMetadataRecursive"
                                    OnTogglePreserveFolders="ToggleMetadataPreserveFolderStructure"
                                    OnRowSelected="SelectMetadataRow"
                                                OnShowMappedInfo="ShowMetadataMappedInfo" />
                }
                else if (_currentMode == RemuxForge.Core.Models.Options.MODE_SPLIT)
                {
                    <SplitWorkspaceComponent Records="@_splitRecords"
                                 SelectedRecord="@_selectedSplitRecord"
                                 SelectedIndex="@SplitOrchestrator.SelectedIndex"
                                 OnRowSelected="SelectSplitRow" />
                }
                else
                {
                    <RemuxWorkspaceComponent Records="@_records"
                                 SelectedRecord="@_selectedRecord"
                                 SelectedIndex="@Orchestrator.SelectedIndex"
                                 SelectedIndices="@_selectedIndices"
                                 Options="@Orchestrator.CurrentOptions"
                                 JsModule="@_jsModule"
                                 IsBusy="@Orchestrator.IsBusy"
                                 OnRowSelected="SelectRow"
                                 OnContextMenu="ShowContextMenu"
                                 OnChangeEditMap="ShowEditMapEditor" />
                }
                </div>
            </RadzenSplitterPane>
            <RadzenSplitterPane Size="22%" Min="56px" Max="55%">
                <div class="rf-log-host">
                    <LogPanelComponent LogText="@GetCurrentLogText()" JsModule="@_jsModule" />
                </div>
            </RadzenSplitterPane>
        </RadzenSplitter>

    @* Avanzamento *@
    <ProgressPanelComponent Progress="@GetCurrentProgress()" />

    @* Barra di Stato *@
    <StatusBarComponent Commands="@BuildUiCommands()"
                        OnCommand="ExecuteUiCommandAsync" />
    </section>
</div>

@* Dialog Configurazione *@
@if (_showConfig)
{
    <ConfigDialogComponent Options="@(_currentMode == RemuxForge.Core.Models.Options.MODE_SPLIT ? SplitOrchestrator.CurrentOptions : Orchestrator.CurrentOptions)"
                            OnClose="CloseConfig"
                            OnApply="ApplyConfig" />
}

@* Dialog Preset Metadata *@
@if (_showMetadataPreset)
{
    <MetadataPresetDialogComponent Options="@MetadataOrchestrator.CurrentOptions"
                                   Records="@_metadataRecords"
                                   OnClose="CloseMetadataPreset" />
}

@if (_showMetadataMappedInfo)
{
    <MetadataMappedInfoDialogComponent Record="@_selectedMetadataRecord"
                                       Simulated="@_metadataMappedInfoSimulated"
                                       JsModule="@_jsModule"
                                       OnClose="CloseMetadataMappedInfo" />
}

@if (_showMetadataManualEdit)
{
    <MetadataMappedInfoDialogComponent Record="@_selectedMetadataRecord"
                                       Editable="true"
                                       JsModule="@_jsModule"
                                       OnClose="CloseMetadataManualEdit"
                                       OnApply="ApplyMetadataManualEdit" />
}

@* Dialog Rename Metadata *@
@if (_showMetadataPathBrowse)
{
    <FolderBrowserDialog InitialPath="@_metadataBrowseInitialPath"
                         ShowFiles="@_metadataBrowseShowFiles"
                         AllowCurrentFolderSelection="@_metadataBrowseAllowCurrentFolderSelection"
                         AllowedExtensions="@_metadataBrowseAllowedExtensions"
                         OnClose="CloseMetadataPathBrowse"
                         OnSelect="ApplyMetadataPathBrowse" />
}

@* Dialog Percorsi Tool *@
@if (_showToolPaths)
{
    <ToolPathsDialogComponent OnClose="CloseToolPaths" />
}

@* Dialog Impostazioni Audio *@
@if (_showAudioSettings)
{
    <AudioSettingsDialogComponent OnClose="CloseAudioSettings" />
}

@* Dialog Impostazioni Avanzate *@
@if (_showAdvancedSettings)
{
    <AdvancedSettingsDialogComponent OnClose="CloseAdvancedSettings" />
}

@* Dialog Delay *@
@if (_showDelay && _selectedRecord != null)
{
    <DelayDialogComponent Record="@_selectedRecord"
                           OnClose="CloseDelay"
                           OnApply="ApplyDelay" />
}

@* Editor visuale EditMap *@
@if (_showEditMapEditor && _editMapRecord != null)
{
    <EditMapEditorDialogComponent RecordIndex="@_editMapRecordIndex"
                                  Record="@_editMapRecord"
                                  OnClose="CloseEditMapEditor"
                                  OnApply="ApplyEditMap" />
}

@* Dialog Profili Encoding *@
@if (_showEncodingProfiles)
{
    <EncodingProfilesDialog OnClose="CloseEncodingProfiles" />
}

@* Dialog Info *@
@if (_showInfo)
{
    <InfoDialogComponent OnClose="CloseInfo" />
}

@* Context Menu Episodio *@
@if (_showContextMenu && _contextMenuCommands != null)
{
    <ContextMenuComponent Commands="@_contextMenuCommands"
                           X="@_contextMenuX"
                           Y="@_contextMenuY"
                           SelectedIndex="@_contextMenuSelectedIndex"
                           OnClose="CloseContextMenu"
                           OnActiveChanged="SetContextMenuActiveIndex"
                           OnSelect="HandleContextMenuSelect" />
}

@* Dialog MediaInfo *@
@if (_showMediaInfo)
{
    <MediaInfoDialogComponent Title="@_mediaInfoTitle"
                               Report="@_mediaInfoReport"
                               JsModule="@_jsModule"
                               OnClose="CloseMediaInfo" />
}
