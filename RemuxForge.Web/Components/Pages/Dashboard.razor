@page "/"
@inject MergeOrchestrator Orchestrator
@inject SplitOrchestrator SplitOrchestrator
@inject MetadataOrchestrator MetadataOrchestrator
@inject RemuxForge.Core.Ai.AiCredentialService AiCredentialService
@inject AiAuthService AiAuthService
@inject ThemeService ThemeService
@implements IAsyncDisposable

@if (_showSplitEditor && _splitEditorRecord != null)
{
    <SplitEditorPageComponent RecordIndex="@_splitEditorIndex"
                              Record="@_splitEditorRecord"
                              OnClose="CloseSplitEditor" />
}
else if (_showEditMapEditor && _editMapRecord != null)
{
    <EditMapEditorPageComponent RecordIndex="@_editMapRecordIndex"
                                 Record="@_editMapRecord"
                                 CurrentOptions="@Orchestrator.CurrentOptions"
                                 VerificationOnly="@(Orchestrator.CurrentOptions != null && Orchestrator.CurrentOptions.FrameSync && !Orchestrator.CurrentOptions.DeepAnalysis)"
                                 OnClose="CloseEditMapEditor"
                                 OnApply="ApplyEditMap" />
}
else
{
<div class="rf-layout @(_navigationCollapsed ? "rf-navigation-collapsed" : "")">
    <ModeNavigationComponent CurrentMode="@_currentMode"
                             Collapsed="@_navigationCollapsed"
                             IsBusy="@IsAnyBusy()"
                             CurrentLanguage="@_currentLanguage"
                             OnModeChanged="SwitchMode"
                             OnCollapsedChanged="SetNavigationCollapsed"
                             OnShowInfo="ShowInfoAsync" />

    <section class="rf-app-stage">
        <header class="rf-app-header">
            <div class="rf-app-title">
                <span class="rf-app-title-mode">@GetCurrentModeTitle()</span>
                <span class="rf-app-title-description">@GetCurrentModeDescription()</span>
            </div>

            <MenuBarComponent Commands="@BuildUiCommands()"
                       OnCommand="ExecuteUiCommandAsync"
                       OnThemeChanged="ChangeThemeAsync"
                       OnLanguageChanged="ChangeLanguageAsync"
                       CurrentTheme="@_currentTheme"
                       CurrentLanguage="@_currentLanguage" />
        </header>

        <CommandToolbarComponent Commands="@BuildUiCommands()"
                                 Note="@(_currentMode == RemuxForge.Core.Models.Options.MODE_SPLIT && _splitReviewStage != null ? AppText.T("web.splitMontage.reviewExportNote") : "")"
                                 OnCommand="ExecuteUiCommandAsync" />

        <RadzenSplitter Orientation="Orientation.Vertical" class="rf-workspace-log-splitter">
            <RadzenSplitterPane Size="78%" Min="210px">
                <div class="rf-workspace-host">
                @* Area Pannelli *@
                @if (_currentMode == RemuxForge.Core.Models.Options.MODE_METADATA)
                {
                    <MetadataWorkspaceComponent Options="@MetadataOrchestrator.CurrentOptions"
                                    PresetFiles="@_metadataPresetFiles"
                                    Records="@_metadataRecords"
                                    SelectedRecord="@_selectedMetadataRecord"
                                    SelectedIndex="@MetadataOrchestrator.SelectedIndex"
                                    TrackSummaryBuilder="BuildMetadataTrackSummary"
                                    VideoSummaryBuilder="BuildMetadataVideoSummary"
                                    OutputPolicyValueProvider="GetMetadataOutputPolicyValue"
                                    OnPresetChanged="ChangeMetadataPreset"
                                    OnSourcePathChanged="ChangeMetadataSourcePath"
                                    OnOutputPolicyChanged="ChangeMetadataOutputPolicy"
                                    OnOutputPathChanged="ChangeMetadataOutputDir"
                                    OnBrowseSource="@(() => BrowseMetadataPathAsync(0, true, true))"
                                    OnBrowseOutput="@(() => BrowseMetadataPathAsync(1, false, true))"
                                    OnToggleRecursive="ToggleMetadataRecursive"
                                    OnTogglePreserveFolders="ToggleMetadataPreserveFolderStructure"
                                    OnToggleOverwriteOutput="ToggleMetadataOverwriteOutput"
                                    OnRowSelected="SelectMetadataRow"
                                                OnShowMappedInfo="ShowMetadataMappedInfoAsync" />
                }
                else if (_currentMode == RemuxForge.Core.Models.Options.MODE_SPLIT)
                {
                    <div @ref="_splitWorkspaceRoot" class="split-guided-workspace" tabindex="-1" aria-label="@AppText.T("web.splitMontage.outputs")">
                    @if (!SplitOrchestrator.HasSource && _splitRecords.Count == 0 && _splitReviewStage == null)
                    {
                        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" class="split-empty-state">
                            <RadzenText TextStyle="TextStyle.H4">@AppText.T("web.split.emptyTitle")</RadzenText>
                            <RadzenText>@AppText.T("web.split.emptyDescription")</RadzenText>
                            <RadzenButton Text="@AppText.T("web.split.configure")" Icon="add" Disabled="@SplitOrchestrator.IsBusy" Click="ShowConfig" />
                        </RadzenStack>
                    }
                    else
                    {
                    @if (_splitReviewStage != null)
                    {
                        <SplitPlanReviewComponent Records="@_splitRecords" Stage="@_splitReviewStage" Busy="@SplitOrchestrator.IsBusy" OnOpenEditor="OpenSplitReviewEditor" OnContinue="AcknowledgeSplitReview" OnConfigure="ShowConfig" OnClose="CloseSplitReview" />
                    }
                    <SplitWorkspaceComponent Records="@_splitRecords"
                                 ModeLabel="@SplitCutModes.ConfiguredLabel(SplitOrchestrator.CurrentOptions)"
                                 SelectedRecord="@_selectedSplitRecord"
                                 SelectedIndex="@SplitOrchestrator.SelectedIndex"
                                 SelectedIndices="@_splitSelection.Indices"
                                 IsBusy="@SplitOrchestrator.IsBusy"
                                 OnRowSelected="SelectSplitRowWithModifiers"
                                 OnContextMenu="ShowSplitContextMenu"
                                 OnAnalyze="DoAnalyzeSplitSelected" />
                    }
                    </div>
                }
                else
                {
                    @if (_records.Count == 0)
                    {
                        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" Style="height:100%">
                            <RadzenText TextStyle="TextStyle.H4">@AppText.T("web.remux.emptyTitle")</RadzenText>
                            <RadzenText>@AppText.T("web.remux.emptyDescription")</RadzenText>
                            <RadzenButton Text="@AppText.T("web.remux.configure")" Icon="add" Disabled="@Orchestrator.IsBusy" Click="ShowConfig" />
                        </RadzenStack>
                    }
                    else
                    {
                    <RemuxWorkspaceComponent Records="@_records"
                                 ScannedFileCount="@Orchestrator.ScannedFileCount"
                                 SelectedRecord="@_selectedRecord"
                                 SelectedIndex="@Orchestrator.SelectedIndex"
                                 SelectedIndices="@_selection.Indices"
                                 Options="@Orchestrator.CurrentOptions"
                                 JsModule="@_jsModule"
                                 IsBusy="@Orchestrator.IsBusy"
                                 OnRowSelected="SelectRow"
                                 OnContextMenu="ShowContextMenu"
                                  OnChangeEditMap="ShowEditMapEditor" />
                    }
                }
                </div>
            </RadzenSplitterPane>
            <RadzenSplitterPane Size="22%" Min="56px" Max="55%">
                <div class="rf-log-host">
                    <LogPanelComponent LogText="@GetCurrentLogText()" JsModule="@_jsModule" />
                </div>
            </RadzenSplitterPane>
        </RadzenSplitter>

    @* Avanzamento *@
    <ProgressPanelComponent Progress="@GetCurrentProgress()" />

    @* Barra di Stato *@
    <StatusBarComponent Commands="@BuildUiCommands()"
                        OnCommand="ExecuteUiCommandAsync" />
    </section>
</div>


}
