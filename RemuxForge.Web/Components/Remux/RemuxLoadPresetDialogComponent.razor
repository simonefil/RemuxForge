@inherits AppDialogContentBase

<div class="rf-remux-preset-dialog" @ref="DialogContent">
<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Subtitle1" Style="overflow-wrap:anywhere;min-width:0">@PresetName</RadzenText>
    <RadzenText>@(string.IsNullOrEmpty(Message) ? AppText.T("web.remux.loadConfirm") : Message)</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Wrap="FlexWrap.Wrap" Gap="0.75rem">
        <RadzenButton ButtonType="ButtonType.Button" Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => DialogService.Close(false))" />
        <RadzenButton ButtonType="ButtonType.Button" Text="@(string.IsNullOrEmpty(ConfirmText) ? AppText.T("web.remux.load") : ConfirmText)"
                      ButtonStyle="@(Danger ? ButtonStyle.Danger : ButtonStyle.Primary)" Click="@(() => DialogService.Close(true))" />
    </RadzenStack>
</RadzenStack>
</div>

@code {
    [Parameter] public string PresetName { get; set; } = "";
    /// <summary>Testo della conferma; vuoto per il caricamento del preset</summary>
    [Parameter] public string Message { get; set; } = "";
    /// <summary>Etichetta del pulsante di conferma; vuota per il caricamento del preset</summary>
    [Parameter] public string ConfirmText { get; set; } = "";
    /// <summary>True per un'azione distruttiva come l'eliminazione</summary>
    [Parameter] public bool Danger { get; set; }
}
