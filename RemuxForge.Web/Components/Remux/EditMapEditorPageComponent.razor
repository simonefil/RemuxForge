    private void UpdateSourceFrameText(ChangeEventArgs args) => this._sourceFrameText = args.Value != null ? args.Value.ToString() : "";
    private void UpdateLanguageFrameText(ChangeEventArgs args) => this._languageFrameText = args.Value != null ? args.Value.ToString() : "";
    private void UpdateSourceTimestampText(ChangeEventArgs args) => this._sourceTimestampText = args.Value != null ? args.Value.ToString() : "";
    private void UpdateLanguageTimestampText(ChangeEventArgs args) => this._languageTimestampText = args.Value != null ? args.Value.ToString() : "";

    private async Task CommitSourceFrameAsync()
    {
        if (!int.TryParse(this._sourceFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._sourceIndex.FrameCount)
        {
            this.WarnInvalidValue();
            this.RefreshNavigationFields();
            return;
        }
        VideoFrameIndexEntry frame = this._sourceIndex.Frames[frameNumber - 1];
        if (this._sourceFrame != null && frame.PresentationIndex == this._sourceFrame.PresentationIndex)
            return;
        this.NavigateFromSourceFrame(frame);
        await this.RefreshAfterNavigationAsync(true);
    }

    private async Task CommitLanguageFrameAsync()
    {
        if (!int.TryParse(this._languageFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._languageIndex.FrameCount)
        {
            this.WarnInvalidValue();
            this.RefreshNavigationFields();
            return;
        }
        VideoFrameIndexEntry frame = this._languageIndex.Frames[frameNumber - 1];
        if (this._languageFrame != null && frame.PresentationIndex == this._languageFrame.PresentationIndex)
            return;
        this.NavigateFromLanguageFrame(frame);
        await this.RefreshAfterNavigationAsync(true);
    }

    private async Task CommitSourceTimestampAsync()
    {
        if (!TryParseTimestamp(this._sourceTimestampText, out double ptsMs))
        {
            this.WarnInvalidValue();
            this.RefreshNavigationFields();
            return;
        }
        VideoFrameIndexEntry frame = this._sourceIndex.FindNearestFrame(ptsMs);
        if (frame == null || (this._sourceFrame != null && frame.PresentationIndex == this._sourceFrame.PresentationIndex))
        {
            this.RefreshNavigationFields();
            return;
        }
        this.NavigateFromSourceFrame(frame);
        await this.RefreshAfterNavigationAsync(true);
    }

    private async Task CommitLanguageTimestampAsync()
    {
        if (!TryParseTimestamp(this._languageTimestampText, out double ptsMs))
        {
            this.WarnInvalidValue();
            this.RefreshNavigationFields();
            return;
        }
        VideoFrameIndexEntry frame = this._languageIndex.FindNearestFrame(ptsMs);
        if (frame == null || (this._languageFrame != null && frame.PresentationIndex == this._languageFrame.PresentationIndex))
        {
            this.RefreshNavigationFields();
            return;
        }
        this.NavigateFromLanguageFrame(frame);
        await this.RefreshAfterNavigationAsync(true);
    }

    private bool CanStepSource(int delta) => this.IndexesReady && this._sourceFrame != null && this._sourceFrame.PresentationIndex + delta >= 0 && this._sourceFrame.PresentationIndex + delta < this._sourceIndex.FrameCount;

    private bool CanStepLanguage(int delta) => this.IndexesReady && this._languageFrame != null && this._languageFrame.PresentationIndex + delta >= 0 && this._languageFrame.PresentationIndex + delta < this._languageIndex.FrameCount;

    private async Task StepSourceAsync(int delta)
    {
        if (!this.IndexesReady || this._sourceFrame == null)
            return;
        int index = Math.Max(0, Math.Min(this._sourceIndex.FrameCount - 1, this._sourceFrame.PresentationIndex + delta));
        if (index == this._sourceFrame.PresentationIndex)
            return;
        VideoFrameIndexEntry frame = this._sourceIndex.Frames[index];
        this.NavigateFromSourceFrame(frame);
        await this.RefreshAfterNavigationAsync(true);
    }

    private async Task StepLanguageAsync(int delta)
    {
        if (!this.IndexesReady || this._languageFrame == null)
            return;
        int index = Math.Max(0, Math.Min(this._languageIndex.FrameCount - 1, this._languageFrame.PresentationIndex + delta));
        if (index == this._languageFrame.PresentationIndex)
            return;
        VideoFrameIndexEntry frame = this._languageIndex.Frames[index];
        this.NavigateFromLanguageFrame(frame);
        await this.RefreshAfterNavigationAsync(true);
    }

    private Task HandleSourceFrameKeyAsync(KeyboardEventArgs args) => string.Equals(args.Key, "Enter", StringComparison.Ordinal) ? this.CommitSourceFrameAsync() : Task.CompletedTask;
    private Task HandleLanguageFrameKeyAsync(KeyboardEventArgs args) => string.Equals(args.Key, "Enter", StringComparison.Ordinal) ? this.CommitLanguageFrameAsync() : Task.CompletedTask;
    private Task HandleSourceTimestampKeyAsync(KeyboardEventArgs args) => string.Equals(args.Key, "Enter", StringComparison.Ordinal) ? this.CommitSourceTimestampAsync() : Task.CompletedTask;
    private Task HandleLanguageTimestampKeyAsync(KeyboardEventArgs args) => string.Equals(args.Key, "Enter", StringComparison.Ordinal) ? this.CommitLanguageTimestampAsync() : Task.CompletedTask;

    private Task SelectOperationRowAsync(DataGridRowMouseEventArgs<EditOperation> args) => this.SelectOperationAsync(this._workingMap.Operations.IndexOf(args.Data), true);

    private void RenderOperationRow(RowRenderEventArgs<EditOperation> args)
    {
        if (object.ReferenceEquals(args.Data, this._selectedOperation))
            args.Attributes["class"] = "rz-data-row selected focused";
    }

    /// <summary>Aggiorna entrambe le viste della lista operazioni quando presenti</summary>
    private async Task ReloadOperationGridsAsync()
    {
        if (this._operationGrid != null)
            await this._operationGrid.Reload();
        if (this._precisionOperationGrid != null)
            await this._precisionOperationGrid.Reload();
    }

    private async Task SelectOperationAsync(int index, bool center)
    {
        if (index < 0 || index >= this._workingMap.Operations.Count)
            return;
        this.ClearTimelineSelection();
        this._selectedOperation = this._workingMap.Operations[index];
        this.RefreshOperationFields();
        if (string.Equals(this._selectedOperation.Type, EditOperation.CUT_SEGMENT, StringComparison.Ordinal))
            this.NavigateFromLanguage(Math.Min(this._languageIndex.EndPtsMs, this._selectedOperation.LangTimestampMs + this._selectedOperation.DurationMs));
        else
        {
            this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
            this._languageFrame = null;
            this._languagePreviewMessage = AppText.T("web.editMap.noLanguageFrame");
            this.RefreshNavigationFields();
        }
        await this.ReloadOperationGridsAsync();
        await this.RefreshAfterNavigationAsync(center);
    }

    private async Task CommitSelectedOperationAsync()
    {
        if (this._selectedOperation == null || (string.IsNullOrEmpty(this._timestampEditAuthority) && string.IsNullOrEmpty(this._durationEditAuthority) && !this._gainEditPending))
            return;
        if (!this.TryResolveEditedLanguageTimestamp(out int languageTimestamp) || !this.TryResolveEditedLanguageDuration(languageTimestamp, out int languageDuration))
        {
            this.WarnInvalidValue();
            this.RefreshOperationFields();
            return;
        }
        double gainDb = this._selectedOperation.GainDb;
        if (this._gainEditPending &&
            (!double.TryParse(this._operationGainText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out gainDb) || !double.IsFinite(gainDb)))
        {
            this.WarnInvalidValue();
            this.RefreshOperationFields();
            return;
        }

        EditOperation operation = this._selectedOperation;
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        operation.LangTimestampMs = languageTimestamp;
        operation.DurationMs = languageDuration;
        operation.GainDb = string.Equals(operation.Type, EditOperation.INSERT_SILENCE, StringComparison.Ordinal) ? gainDb : 0.0;
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.EndPtsMs, this._languageIndex.EndPtsMs, this._sourceIndex.MedianFrameDurationMs);
        if (!candidate.Validation.IsValid)
        {
            int index = this._workingMap.Operations.IndexOf(operation);
            EditOperation restored = index >= 0 && index < backup.Operations.Count ? backup.Operations[index] : null;
            string restoredType = restored != null ? restored.Type : operation.Type;
            int restoredTimestamp = restored != null ? restored.LangTimestampMs : operation.LangTimestampMs;
            int restoredDuration = restored != null ? restored.DurationMs : operation.DurationMs;
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = FindOperation(this._workingMap.Operations, restoredType, restoredTimestamp, restoredDuration);
            this._timestampEditAuthority = "";
            this._durationEditAuthority = "";
            this._gainEditPending = false;
            this.WarnInvalidValue();
            this.RefreshOperationFields();
            await this.ReloadOperationGridsAsync();
            return;
        }

        string type = operation.Type;
        this._projection = candidate;
        this._workingMap = candidate.Map;
        this._selectedOperation = FindOperation(this._workingMap.Operations, type, languageTimestamp, languageDuration);
        this._timestampEditAuthority = "";
        this._durationEditAuthority = "";
        this._gainEditPending = false;
        await this.FinishMapMutationAsync();
    }

    private bool TryResolveEditedLanguageTimestamp(out int timestampMs)
    {
        timestampMs = this._selectedOperation != null ? this._selectedOperation.LangTimestampMs : 0;
        if (this._selectedOperation == null || string.IsNullOrEmpty(this._timestampEditAuthority))
            return this._selectedOperation != null;

        VideoFrameIndexEntry languageFrame = null;
        if (string.Equals(this._timestampEditAuthority, "language-time", StringComparison.Ordinal))
        {
            if (!TryParseTimestamp(this._operationLanguageText, out double ptsMs))
                return false;
            languageFrame = this._languageIndex.FindNearestFrame(ptsMs);
        }
        else if (string.Equals(this._timestampEditAuthority, "language-frame", StringComparison.Ordinal))
        {
            if (!int.TryParse(this._operationLanguageFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._languageIndex.FrameCount)
                return false;
            languageFrame = this._languageIndex.Frames[frameNumber - 1];
        }
        else
        {
            VideoFrameIndexEntry sourceFrame;
            if (string.Equals(this._timestampEditAuthority, "source-time", StringComparison.Ordinal))
            {
                if (!TryParseTimestamp(this._operationSourceText, out double ptsMs))
                    return false;
                sourceFrame = this._sourceIndex.FindNearestFrame(ptsMs);
            }
            else
            {
                if (!int.TryParse(this._operationSourceFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._sourceIndex.FrameCount)
                    return false;
                sourceFrame = this._sourceIndex.Frames[frameNumber - 1];
            }
            if (sourceFrame == null)
                return false;
            EditMapMappingResult mapping = this.MapSourceBoundaryExcludingSelectedOperation(sourceFrame.PtsMs);
            if (!mapping.IsMapped)
                return false;
            languageFrame = this._languageIndex.FindNearestFrame(mapping.LanguageTimestampMs);
        }

        if (languageFrame == null)
            return false;
        timestampMs = Math.Max(0, (int)Math.Round(languageFrame.PtsMs));
        return true;
    }

    private bool TryResolveEditedLanguageDuration(int timestampMs, out int durationMs)
    {
        durationMs = this._selectedOperation != null ? this._selectedOperation.DurationMs : 0;
        if (this._selectedOperation == null || string.IsNullOrEmpty(this._durationEditAuthority))
            return this._selectedOperation != null;

        int requestedDuration;
        if (string.Equals(this._durationEditAuthority, "rendered-duration", StringComparison.Ordinal))
        {
            if (!int.TryParse(this._operationRenderedDurationText, out int renderedDuration) || renderedDuration <= 0)
                return false;
            requestedDuration = Math.Max(1, (int)Math.Round(renderedDuration / this._projection.StretchRatio));
        }
        else if (!int.TryParse(this._operationLanguageDurationText, out requestedDuration) || requestedDuration <= 0)
        {
            return false;
        }

        durationMs = string.Equals(this._selectedOperation.Type, EditOperation.INSERT_SILENCE, StringComparison.Ordinal)
            ? this.SnapInsertDuration(requestedDuration)
            : this.SnapLanguageDuration(timestampMs, requestedDuration);
        return true;
    }

    /// <summary>Aggancia la fine di un Insert alla timeline Source/finale</summary>
    private int SnapInsertDuration(int requestedLanguageDurationMs)
    {
        double stretchRatio = this._projection != null ? this._projection.StretchRatio : 1.0;
        double sourceStartMs = this._selectedOperation != null ? this._selectedOperation.SourceTimestampMs : 0.0;
        double requestedSourceEndMs = sourceStartMs + EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(requestedLanguageDurationMs, stretchRatio);
        double snappedSourceEndMs = this.SnapToFrameBoundary(this._sourceIndex, requestedSourceEndMs);
        if (!double.IsFinite(snappedSourceEndMs))
            return requestedLanguageDurationMs;

        double renderedDurationMs = Math.Max(1.0, snappedSourceEndMs - sourceStartMs);
        return Math.Max(1, (int)Math.Round(renderedDurationMs / stretchRatio));
    }

    private bool CanCreateOperation()
    {
        if (!this.IndexesReady || this._projection == null)
            return false;
        return this._projection.MapSourceToLanguage(this._sourcePlayheadMs).IsMapped;
    }

    /// <summary>True quando la selezione corrente può diventare un singolo CUT_SEGMENT</summary>
    private bool CanCreateCutFromSelection()
    {
        if (!this.HasTimelineSelection || this._projection == null)
            return false;
        int startMs = Math.Max(0, (int)Math.Round(this._selectionLanguageStartMs));
        int durationMs = Math.Max(0, (int)Math.Round(this._selectionLanguageEndMs - this._selectionLanguageStartMs));
        return durationMs > 0 && startMs + durationMs <= this._languageIndex.EndPtsMs;
    }

    /// <summary>Indica se il Cut può essere creato dalla selezione o dal playhead</summary>
    private bool CanAddCut()
    {
        return this.CanCreateCutFromSelection() || this.CanCreateOperation();
    }

    /// <summary>Crea il Cut dalla selezione corrente oppure dal playhead</summary>
    private async Task AddCutAsync()
    {
        if (this.CanCreateCutFromSelection())
        {
            await this.CreateCutFromSelectionAsync();
            return;
        }
        await this.AddOperationAsync(EditOperation.CUT_SEGMENT);
    }

    /// <summary>Crea un taglio esatto dall'intervallo Language selezionato</summary>
    private async Task CreateCutFromSelectionAsync()
    {
        if (!this.CanCreateCutFromSelection())
            return;
        EditOperation operation = new EditOperation
        {
            Type = EditOperation.CUT_SEGMENT,
            LangTimestampMs = Math.Max(0, (int)Math.Round(this._selectionLanguageStartMs)),
            DurationMs = Math.Max(1, (int)Math.Round(this._selectionLanguageEndMs - this._selectionLanguageStartMs)),
            SourceTimestampMs = Math.Max(0, (int)Math.Round(this._selectionSourceStartMs)),
            VisualSourceTimestampMs = Math.Max(0, (int)Math.Round(this._selectionSourceStartMs)),
            Scope = EditOperation.SCOPE_BODY
        };
        this._workingMap.Operations.Add(operation);
        this.ClearTimelineSelection();
        await this.NormalizeWorkingMapAsync(operation);
    }

    /// <summary>Rimuove l'intervallo selezionato dalla sola UI</summary>
    private void ClearTimelineSelection()
    {
        this._selectionSourceStartMs = double.NaN;
        this._selectionSourceEndMs = double.NaN;
        this._selectionLanguageStartMs = double.NaN;
        this._selectionLanguageEndMs = double.NaN;
    }

    private async Task AddOperationAsync(string type)
    {
        EditMapMappingResult mapping = this._projection.MapSourceToLanguage(this._sourcePlayheadMs);
        if (!mapping.IsMapped)
            return;
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindContainingFrame(mapping.LanguageTimestampMs) ?? this._languageIndex.FindNearestFrame(mapping.LanguageTimestampMs);
        if (languageFrame == null)
            return;
        EditOperation operation = new EditOperation
        {
            Type = type,
            LangTimestampMs = Math.Max(0, (int)Math.Round(languageFrame.PtsMs)),
            DurationMs = Math.Max(1, (int)Math.Round(languageFrame.DurationMs)),
            SourceTimestampMs = Math.Max(0, (int)Math.Round(this._sourcePlayheadMs)),
            VisualSourceTimestampMs = Math.Max(0, (int)Math.Round(this._sourcePlayheadMs)),
            Scope = EditOperation.SCOPE_BODY
        };
        this._workingMap.Operations.Add(operation);
        await this.NormalizeWorkingMapAsync(operation);
    }

    private async Task DeleteSelectedOperationAsync()
    {
        if (this._selectedOperation == null)
            return;
        this.ClearTimelineSelection();
        this._workingMap.Operations.Remove(this._selectedOperation);
        this._selectedOperation = null;
        this.RebuildProjection();
        this.UpdateDirtyState();
        this.NavigateFromSource(this._sourcePlayheadMs);
        await this.ReloadOperationGridsAsync();
        await this.RefreshAfterNavigationAsync();
    }

    private void RefreshOperationFields()
    {
        if (this._selectedOperation == null)
            return;
        this._operationSourceText = FormatTimestamp(this._selectedOperation.SourceTimestampMs);
        this._operationLanguageText = FormatTimestamp(this._selectedOperation.LangTimestampMs);
        this._operationLanguageDurationText = this._selectedOperation.DurationMs.ToString();
        this._operationRenderedDurationText = EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(this._selectedOperation.DurationMs, this._projection.StretchRatio).ToString();
        this._operationGainText = this._selectedOperation.GainDb.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
        this._gainEditPending = false;
        VideoFrameIndexEntry sourceFrame = this._sourceIndex.FindNearestFrame(this._selectedOperation.SourceTimestampMs);
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindNearestFrame(this._selectedOperation.LangTimestampMs);
        this._operationSourceFrameText = sourceFrame != null ? (sourceFrame.PresentationIndex + 1).ToString() : "";
        this._operationLanguageFrameText = languageFrame != null ? (languageFrame.PresentationIndex + 1).ToString() : "";
    }

    private int GetRenderedDurationMs(EditOperation operation) => EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(operation.DurationMs, this._projection != null ? this._projection.StretchRatio : 1.0);

    private string GetOperationTypeLabel(EditOperation operation) => AppText.T(string.Equals(operation.Type, EditOperation.CUT_SEGMENT, StringComparison.Ordinal) ? "web.editMap.cut" : "web.editMap.insert");

    private void UpdateOperationSourceText(ChangeEventArgs args) { this._operationSourceText = GetEventText(args); this._timestampEditAuthority = "source-time"; }
    private void UpdateOperationLanguageText(ChangeEventArgs args) { this._operationLanguageText = GetEventText(args); this._timestampEditAuthority = "language-time"; }
    private void UpdateOperationLanguageDurationText(ChangeEventArgs args) { this._operationLanguageDurationText = GetEventText(args); this._durationEditAuthority = "language-duration"; }
    private void UpdateOperationRenderedDurationText(ChangeEventArgs args) { this._operationRenderedDurationText = GetEventText(args); this._durationEditAuthority = "rendered-duration"; }
    private void UpdateOperationSourceFrameText(ChangeEventArgs args) { this._operationSourceFrameText = GetEventText(args); this._timestampEditAuthority = "source-frame"; }
    private void UpdateOperationLanguageFrameText(ChangeEventArgs args) { this._operationLanguageFrameText = GetEventText(args); this._timestampEditAuthority = "language-frame"; }
    private void UpdateOperationGainText(ChangeEventArgs args) { this._operationGainText = GetEventText(args); this._gainEditPending = true; }

    private async Task NormalizeWorkingMapAsync(EditOperation selected)
    {
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.EndPtsMs, this._languageIndex.EndPtsMs, this._sourceIndex.MedianFrameDurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap.Operations.Remove(selected);
            this.RebuildProjection();
            this.WarnInvalidValue();
            return;
        }
        this._projection = candidate;
        this._workingMap = candidate.Map;
        this._selectedOperation = FindOperation(this._workingMap.Operations, selected.Type, selected.LangTimestampMs, selected.DurationMs);
        await this.FinishMapMutationAsync();
    }

    private async Task FinishMapMutationAsync()
    {
        this.ClearTimelineSelection();
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        await this.ReloadOperationGridsAsync();
        if (this._selectedOperation != null)
            await this.SelectOperationAsync(this._workingMap.Operations.IndexOf(this._selectedOperation), true);
        else
            await this.UpdateTimelineAsync();
        this.StateHasChanged();
    }

    private int SnapLanguageDuration(int startMs, int requestedDurationMs)
    {
        VideoFrameIndexEntry start = this._languageIndex.FindNearestFrame(startMs);
        if (start == null)
            return requestedDurationMs;
        double snappedEndMs = this.SnapToFrameBoundary(this._languageIndex, start.PtsMs + requestedDurationMs);
        if (!double.IsFinite(snappedEndMs))
            return requestedDurationMs;
        if (snappedEndMs <= start.PtsMs && start.PresentationIndex + 1 < this._languageIndex.FrameCount)
            snappedEndMs = this._languageIndex.Frames[start.PresentationIndex + 1].PtsMs;
        if (snappedEndMs <= start.PtsMs)
            snappedEndMs = this._languageIndex.EndPtsMs;
        return Math.Max(1, (int)Math.Round(snappedEndMs - start.PtsMs));
    }

    /// <summary>Aggancia un estremo a un PTS frame o alla fine dell'ultimo intervallo</summary>
    private double SnapToFrameBoundary(VideoFrameIndex index, double requestedEndMs)
    {
        if (index == null || index.FrameCount == 0 || !double.IsFinite(requestedEndMs))
            return double.NaN;
        VideoFrameIndexEntry last = index.Frames[index.FrameCount - 1];
        double terminalToleranceMs = Math.Max(1.0, last.DurationMs * 0.5);
        if (requestedEndMs >= index.EndPtsMs - terminalToleranceMs)
            return index.EndPtsMs;
        VideoFrameIndexEntry frame = index.FindNearestFrame(requestedEndMs);
        return frame != null ? frame.PtsMs : double.NaN;
    }

    /// <summary>Mappa un boundary Source senza far influenzare il risultato dall'operazione spostata</summary>
    private EditMapMappingResult MapSourceBoundaryExcludingSelectedOperation(double sourceTimestampMs)
    {
        if (this._selectedOperation == null)
            return this._projection.MapSourceToLanguage(sourceTimestampMs);
        int selectedIndex = this._workingMap.Operations.IndexOf(this._selectedOperation);
        if (selectedIndex < 0)
            return this._projection.MapSourceToLanguage(sourceTimestampMs);

        EditMap mapWithoutSelected = EditMapTimelineHelper.Clone(this._workingMap);
        mapWithoutSelected.Operations.RemoveAt(selectedIndex);
        EditMapProjection projectionWithoutSelected = EditMapTimelineHelper.BuildProjection(mapWithoutSelected, this._sourceIndex.EndPtsMs, this._languageIndex.EndPtsMs, this._sourceIndex.MedianFrameDurationMs);
        return projectionWithoutSelected.Validation.IsValid ? projectionWithoutSelected.MapSourceToLanguage(sourceTimestampMs) : new EditMapMappingResult { Kind = EditMapMappingKind.OutsideTimeline, SourceTimestampMs = sourceTimestampMs, LanguageTimestampMs = double.NaN };
    }

    private void WarnInvalidValue() => this.NotificationService.Notify(NotificationSeverity.Warning, AppText.T("web.editMap.invalidValue"), AppText.T("web.editMap.valueRestored"), 5000);

    private void UpdateDirtyState() => this._dirty = !MapsEqual(this._originalMap, this._workingMap);

    private bool CanApply() => this.IndexesReady && !this._isApplying && this._workingMap.Operations.Count > 0 && this._projection != null && this._projection.Validation.IsValid;

    private async Task ApplyAsync()
    {
        if (!this.CanApply())
            return;
        this._isApplying = true;
        try
        {
            await this.OnApply.InvokeAsync((EditMapTimelineHelper.Clone(this._workingMap), this._sourceIndex.EndPtsMs, this._languageIndex.EndPtsMs, this._sourceIndex.MedianFrameDurationMs));
        }
        finally
        {
            this._isApplying = false;
        }
    }

    /// <summary>Sposta il playhead Source dalla timeline JavaScript</summary>
    /// <param name="sourceMs">Timestamp Source relativo</param>
    [JSInvokable]
    public async Task OnTimelineSeek(double sourceMs)
    {
        this.NavigateFromSource(sourceMs);
        this.SelectOperationAtPlayhead();
        await this.InvokeAsync(async () => await this.RefreshAfterNavigationAsync());
    }

    /// <summary>Conferma una selezione trascinata nella lane Language</summary>
    /// <param name="sourceStartMs">Inizio selezione nel dominio Source/finale</param>
    /// <param name="sourceEndMs">Fine selezione nel dominio Source/finale</param>
    [JSInvokable]
    public async Task OnTimelineSelectionChanged(double sourceStartMs, double sourceEndMs)
    {
        this.ClearTimelineSelection();
        if (!this._precisionEditorOpen || this._projection == null || sourceEndMs <= sourceStartMs)
        {
            await this.InvokeAsync(async () => await this.UpdateTimelineAsync());
            return;
        }

        EditMapTimelineSegment mappedSegment = null;
        for (int i = 0; i < this._projection.Segments.Count; i++)
        {
            EditMapTimelineSegment segment = this._projection.Segments[i];
            if (segment.Kind == EditMapTimelineSegmentKind.Mapped && sourceStartMs >= segment.SourceStartMs - 0.5 && sourceEndMs <= segment.SourceEndMs + 0.5)
            {
                mappedSegment = segment;
                break;
            }
        }
        if (mappedSegment == null)
        {
            await this.InvokeAsync(async () => await this.UpdateTimelineAsync());
            return;
        }

        double sourceSpanMs = Math.Max(1.0, mappedSegment.SourceEndMs - mappedSegment.SourceStartMs);
        double languageSpanMs = mappedSegment.LanguageEndMs - mappedSegment.LanguageStartMs;
        double languageStartMs = mappedSegment.LanguageStartMs + (sourceStartMs - mappedSegment.SourceStartMs) / sourceSpanMs * languageSpanMs;
        double languageEndMs = mappedSegment.LanguageStartMs + (sourceEndMs - mappedSegment.SourceStartMs) / sourceSpanMs * languageSpanMs;
        VideoFrameIndexEntry startFrame = this._languageIndex.FindNearestFrame(languageStartMs);
        VideoFrameIndexEntry endFrame = this._languageIndex.FindNearestFrame(languageEndMs);
        if (startFrame == null || endFrame == null)
        {
            await this.InvokeAsync(async () => await this.UpdateTimelineAsync());
            return;
        }
        if (endFrame.PresentationIndex <= startFrame.PresentationIndex)
        {
            if (startFrame.PresentationIndex + 1 >= this._languageIndex.FrameCount)
            {
                await this.InvokeAsync(async () => await this.UpdateTimelineAsync());
                return;
            }
            endFrame = this._languageIndex.Frames[startFrame.PresentationIndex + 1];
        }

        this._selectionLanguageStartMs = startFrame.PtsMs;
        this._selectionLanguageEndMs = endFrame.PtsMs;
        double languageOffsetStart = (this._selectionLanguageStartMs - mappedSegment.LanguageStartMs) / Math.Max(1.0, languageSpanMs);
        double languageOffsetEnd = (this._selectionLanguageEndMs - mappedSegment.LanguageStartMs) / Math.Max(1.0, languageSpanMs);
        this._selectionSourceStartMs = mappedSegment.SourceStartMs + languageOffsetStart * sourceSpanMs;
        this._selectionSourceEndMs = mappedSegment.SourceStartMs + languageOffsetEnd * sourceSpanMs;
        this._selectedOperation = null;
        this.NavigateFromSource(this._selectionSourceStartMs);
        await this.InvokeAsync(async () =>
        {
            await this.ReloadOperationGridsAsync();
            this.StateHasChanged();
            await this.UpdateTimelineAsync();
            await this.RefreshPreviewAsync();
        });
    }

    /// <summary>Naviga rapidamente i frame da tastiera o pressione prolungata</summary>
    /// <param name="side">Lato Source o Language</param>
    /// <param name="delta">Numero di frame da percorrere</param>
    [JSInvokable]
    public async Task OnFrameStep(string side, int delta)
    {
        if (string.Equals(side, "language", StringComparison.Ordinal))
            await this.StepLanguageAsync(delta);
        else
            await this.StepSourceAsync(delta);
        if (this.SelectOperationAtPlayhead())
        {
            this.StateHasChanged();
            await this.UpdateTimelineAsync();
        }
    }

    private bool SelectOperationAtPlayhead()
    {
        EditOperation selected = null;
        double tolerance = this._sourceIndex != null ? Math.Max(1.0, this._sourceIndex.MedianFrameDurationMs) : 40.0;
        for (int i = 0; i < this._workingMap.Operations.Count; i++)
        {
            EditOperation operation = this._workingMap.Operations[i];
            bool isInsert = string.Equals(operation.Type, EditOperation.INSERT_SILENCE, StringComparison.Ordinal);
            double end = isInsert ? operation.SourceTimestampMs + Math.Max(tolerance, Math.Abs(GetRenderedDurationMs(operation))) : operation.SourceTimestampMs + tolerance * 0.5;
            if (this._sourcePlayheadMs >= operation.SourceTimestampMs - tolerance * 0.5 && this._sourcePlayheadMs <= end)
            {
                selected = operation;
                break;
            }
        }
        if (object.ReferenceEquals(selected, this._selectedOperation))
            return false;
        this._selectedOperation = selected;
        this.RefreshOperationFields();
        return true;
    }

    /// <summary>Seleziona una operazione dal marker della timeline</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    [JSInvokable]
    public async Task OnTimelineOperationSelected(int operationIndex)
    {
        await this.InvokeAsync(async () => await this.SelectOperationAsync(operationIndex, false));
    }

    /// <summary>Aggiorna il boundary di una operazione durante o al termine del drag</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    /// <param name="sourceMs">Nuovo boundary Source</param>
    /// <param name="final">True al rilascio del puntatore</param>
    [JSInvokable]
    public async Task OnTimelineOperationDrag(int operationIndex, double sourceMs, bool final)
    {
        if (operationIndex < 0 || operationIndex >= this._workingMap.Operations.Count)
            return;
        this.ClearTimelineSelection();
        this._selectedOperation = this._workingMap.Operations[operationIndex];
        VideoFrameIndexEntry sourceFrame = this._sourceIndex.FindNearestFrame(sourceMs);
        EditMapMappingResult mapping = sourceFrame != null ? this.MapSourceBoundaryExcludingSelectedOperation(sourceFrame.PtsMs) : null;
        if (mapping == null || !mapping.IsMapped)
            return;
        VideoFrameIndexEntry languageFrame = this._languageIndex.FindNearestFrame(mapping.LanguageTimestampMs);
        int timestamp = Math.Max(0, (int)Math.Round(languageFrame.PtsMs));
        string originalType = this._selectedOperation.Type;
        int originalTimestamp = this._selectedOperation.LangTimestampMs;
        int originalDuration = this._selectedOperation.DurationMs;
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        this._selectedOperation.LangTimestampMs = timestamp;
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.EndPtsMs, this._languageIndex.EndPtsMs, this._sourceIndex.MedianFrameDurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, originalDuration);
            return;
        }
        string type = this._selectedOperation.Type;
        int duration = this._selectedOperation.DurationMs;
        this._projection = candidate;
        this._workingMap = candidate.Map;
        this._selectedOperation = FindOperation(this._workingMap.Operations, type, timestamp, duration);
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
        await this.InvokeAsync(async () =>
        {
            await this.ReloadOperationGridsAsync();
            this.StateHasChanged();
            if (final)
            {
                await this.UpdateTimelineAsync();
                await this.RefreshPreviewAsync();
            }
        });
    }

    /// <summary>Aggiorna la durata renderizzata durante o al termine del drag</summary>
    /// <param name="operationIndex">Indice corrente dell'operazione</param>
    /// <param name="renderedDurationMs">Durata nel dominio Source renderizzato</param>
    /// <param name="final">True al rilascio del puntatore</param>
    [JSInvokable]
    public async Task OnTimelineDurationDrag(int operationIndex, double renderedDurationMs, bool final)
    {
        if (operationIndex < 0 || operationIndex >= this._workingMap.Operations.Count)
            return;
        this.ClearTimelineSelection();
        if (this._selectedOperation == null)
            this._selectedOperation = this._workingMap.Operations[operationIndex];

        string originalType = this._selectedOperation.Type;
        int originalTimestamp = this._selectedOperation.LangTimestampMs;
        int originalDuration = this._selectedOperation.DurationMs;
        EditMap backup = EditMapTimelineHelper.Clone(this._workingMap);
        int languageDuration = Math.Max(1, (int)Math.Round(renderedDurationMs / this._projection.StretchRatio));
        this._selectedOperation.DurationMs = string.Equals(this._selectedOperation.Type, EditOperation.INSERT_SILENCE, StringComparison.Ordinal)
            ? this.SnapInsertDuration(languageDuration)
            : this.SnapLanguageDuration(this._selectedOperation.LangTimestampMs, languageDuration);
        EditMapProjection candidate = EditMapTimelineHelper.BuildProjection(this._workingMap, this._sourceIndex.EndPtsMs, this._languageIndex.EndPtsMs, this._sourceIndex.MedianFrameDurationMs);
        if (!candidate.Validation.IsValid)
        {
            this._workingMap = backup;
            this.RebuildProjection();
            this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, originalDuration);
            return;
        }

        int duration = this._selectedOperation.DurationMs;
        this._projection = candidate;
        this._workingMap = candidate.Map;
        this._selectedOperation = FindOperation(this._workingMap.Operations, originalType, originalTimestamp, duration);
        this.UpdateDirtyState();
        this.RefreshOperationFields();
        this.NavigateFromSource(this._selectedOperation.SourceTimestampMs);
        await this.InvokeAsync(async () =>
        {
            await this.ReloadOperationGridsAsync();
            this.StateHasChanged();
            if (final)
            {
                await this.UpdateTimelineAsync();
                await this.RefreshPreviewAsync();
            }
        });
    }

    /// <summary>Gestisce le scorciatoie locali dell'editor prima della tastiera globale</summary>
    /// <param name="key">Tasto normalizzato dal browser</param>
    /// <param name="shift">True quando Shift è premuto</param>
    /// <param name="editing">True quando il focus è in un campo editabile</param>
    [JSInvokable]
    public async Task OnEditorKey(string key, bool shift, bool editing)
    {
        if (editing)
        {
            if (string.Equals(key, "Escape", StringComparison.Ordinal))
            {
                this.RefreshNavigationFields();
                this.RefreshOperationFields();
                this.StateHasChanged();
            }
            return;
        }

        if (string.Equals(key, "ArrowLeft", StringComparison.Ordinal))
            await this.StepSourceAsync(shift ? -10 : -1);
        else if (string.Equals(key, "ArrowRight", StringComparison.Ordinal))
            await this.StepSourceAsync(shift ? 10 : 1);
        else if (string.Equals(key, "Home", StringComparison.Ordinal) && this.IndexesReady)
        {
            this.NavigateFromSourceFrame(this._sourceIndex.Frames[0]);
            await this.RefreshAfterNavigationAsync(true);
        }
        else if (string.Equals(key, "End", StringComparison.Ordinal) && this.IndexesReady)
        {
            VideoFrameIndexEntry frame = this._sourceIndex.Frames[this._sourceIndex.FrameCount - 1];
            this.NavigateFromSourceFrame(frame);
            await this.RefreshAfterNavigationAsync(true);
        }
        else if (string.Equals(key, "Delete", StringComparison.Ordinal))
            await this.DeleteSelectedOperationAsync();
        else if (string.Equals(key, "Escape", StringComparison.Ordinal))
        {
            if (this._precisionEditorOpen)
                await this.ClosePrecisionEditorAsync();
            else
                await this.CloseAsync();
        }
    }

    private static string GetEventText(ChangeEventArgs args) => args.Value != null ? args.Value.ToString() : "";

    private static EditOperation FindOperation(List<EditOperation> operations, string type, int timestamp, int duration)
    {
        for (int i = 0; i < operations.Count; i++)
        {
            if (string.Equals(operations[i].Type, type, StringComparison.Ordinal) && operations[i].LangTimestampMs == timestamp && operations[i].DurationMs == duration)
                return operations[i];
        }
        return null;
    }

    private static bool MapsEqual(EditMap left, EditMap right)
    {
        if (left == null || right == null || left.InitialDelayMs != right.InitialDelayMs || !string.Equals(left.StretchFactor ?? "", right.StretchFactor ?? "", StringComparison.Ordinal) || left.Operations.Count != right.Operations.Count)
            return false;
        for (int i = 0; i < left.Operations.Count; i++)
        {
            EditOperation a = left.Operations[i];
            EditOperation b = right.Operations[i];
            if (!string.Equals(a.Type, b.Type, StringComparison.Ordinal) || a.LangTimestampMs != b.LangTimestampMs || a.DurationMs != b.DurationMs || a.GainDb != b.GainDb || a.SourceTimestampMs != b.SourceTimestampMs || !string.Equals(a.Scope, b.Scope, StringComparison.Ordinal))
                return false;
        }
        return true;
    }

    private static bool TryParseTimestamp(string text, out double milliseconds)
    {
        milliseconds = 0.0;
        if (string.IsNullOrWhiteSpace(text))
            return false;
        if (!TimeSpan.TryParse(text.Trim(), System.Globalization.CultureInfo.InvariantCulture, out TimeSpan value) || value < TimeSpan.Zero)
            return false;
        milliseconds = value.TotalMilliseconds;
        return double.IsFinite(milliseconds);
    }

    private static string FormatTimestamp(double timestampMs)
    {
        if (!double.IsFinite(timestampMs) || timestampMs < 0.0)
            return "—";
        TimeSpan value = TimeSpan.FromMilliseconds(timestampMs);
        return ((int)value.TotalHours).ToString("00") + ":" + value.Minutes.ToString("00") + ":" + value.Seconds.ToString("00") + "." + value.Milliseconds.ToString("000");
    }

    private static string FormatDuration(int durationMs)
    {
        return durationMs.ToString(System.Globalization.CultureInfo.InvariantCulture) + " ms";
    }

    private async Task CloseAsync()
    {
        if (this._dirty && this._module != null)
        {
            bool confirmed = await this._module.InvokeAsync<bool>("confirmDiscard", AppText.T("web.editMap.discardConfirm"));
            if (!confirmed)
                return;
        }
        this._cancellation.Cancel();
        await this.OnClose.InvokeAsync();
    }

    /// <summary>Cancella indicizzazione e decode ancora in corso</summary>
    public async ValueTask DisposeAsync()
    {
        this._cancellation.Cancel();
        if (this._previewPair != null)
        {
            try { await this._previewPair.InvokeVoidAsync("dispose"); } catch { }
            try { await this._previewPair.DisposeAsync(); } catch { }
        }
        if (this._keyboard != null)
        {
            try { await this._keyboard.InvokeVoidAsync("dispose"); } catch { }
            try { await this._keyboard.DisposeAsync(); } catch { }
        }
        if (this._module != null)
        {
            try { await this._module.DisposeAsync(); } catch { }
        }
        if (this._dotNetReference != null)
            this._dotNetReference.Dispose();
        this._cancellation.Dispose();
    }
}
