    private async Task CommitSourceFrameAsync()
    {
        if (!int.TryParse(this._sourceFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._sourceIndex.FrameCount)
        {
            this.WarnInvalidValue();
            this.RefreshNavigationFields();
            return;
        }
        VideoFrameIndexEntry frame = this._sourceIndex.Frames[frameNumber - 1];
        if (this._sourceFrame != null && frame.PresentationIndex == this._sourceFrame.PresentationIndex)
            return;
        this.NavigateFromSource(frame.PtsMs);
        await this.RefreshAfterNavigationAsync(true);
    }

    private async Task CommitLanguageFrameAsync()
    {
        if (!int.TryParse(this._languageFrameText, out int frameNumber) || frameNumber < 1 || frameNumber > this._languageIndex.FrameCount)
        {
            this.WarnInvalidValue();
            this.RefreshNavigationFields();
            return;
        }
        VideoFrameIndexEntry frame = this._languageIndex.Frames[frameNumber - 1];
        if (this._languageFrame != null && frame.PresentationIndex == this._languageFrame.PresentationIndex)
            return;
        this.NavigateFromLanguage(frame.PtsMs);
        await this.RefreshAfterNavigationAsync(true);
    }

    private async Task CommitSourceTimestampAsync()
    {
        if (!TryParseTimestamp(this._sourceTimestampText, out double ptsMs))
        {
            this.WarnInvalidValue();
            this.RefreshNavigationFields();
            return;
        }
        VideoFrameIndexEntry frame = this._sourceIndex.FindNearestFrame(ptsMs);
        if (frame == null || (this._sourceFrame != null && frame.PresentationIndex == this._sourceFrame.PresentationIndex))
        {
            this.RefreshNavigationFields();
            return;
        }
        this.NavigateFromSource(frame.PtsMs);
        await this.RefreshAfterNavigationAsync(true);
    }

    private async Task CommitLanguageTimestampAsync()
    {
        if (!TryParseTimestamp(this._languageTimestampText, out double ptsMs))
        {
            this.WarnInvalidValue();
