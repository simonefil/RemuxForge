    {
        if (!this.IndexesReady || this._languageFrame == null)
            return;
        int index = Math.Max(0, Math.Min(this._languageIndex.FrameCount - 1, this._languageFrame.PresentationIndex + delta));
        if (index == this._languageFrame.PresentationIndex)
            return;
        VideoFrameIndexEntry frame = this._languageIndex.Frames[index];
        this.NavigateFromLanguage(frame.PtsMs);
        await this.RefreshAfterNavigationAsync(true);
    }

