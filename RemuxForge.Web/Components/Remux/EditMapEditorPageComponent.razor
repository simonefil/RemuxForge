        this._workingMap = this._projection.Map;
    }

    private void NavigateFromSource(double sourceTimeMs)
    {
        this._sourcePlayheadMs = Math.Max(0.0, Math.Min(this._sourceIndex.EndPtsMs, sourceTimeMs));
        this._sourceFrame = this._sourceIndex.FindContainingFrame(this._sourcePlayheadMs);
        EditMapMappingResult mapping = this._projection.MapSourceToLanguage(this._sourcePlayheadMs);
        if (mapping.IsMapped)
        {
            this._languageCursorMs = mapping.LanguageTimestampMs;
            this._languageFrame = this._languageIndex.FindContainingFrame(this._languageCursorMs);
            this._languagePreviewMessage = this._languageFrame != null ? "" : AppText.T("web.editMap.noLanguageFrame");
        }
        else
        {
            this._languageCursorMs = double.NaN;
            this._languageFrame = null;
            this._languagePreviewMessage = AppText.T("web.editMap.noLanguageFrame");
        }
        this._sourcePreviewMessage = this._sourceFrame != null ? "" : AppText.T("web.editMap.noSourceFrame");
        this.RefreshNavigationFields();
    }

    /// <summary>Naviga da un frame Source preservandone l'ordinale anche con PTS duplicato</summary>
    private void NavigateFromSourceFrame(VideoFrameIndexEntry frame)
    {
        if (frame == null)
            return;
        this.NavigateFromSource(frame.PtsMs);
        this._sourceFrame = frame;
        this._sourcePreviewMessage = "";
        this.RefreshNavigationFields();
    }

    private void NavigateFromLanguage(double languageTimeMs)
    {
        this._languageCursorMs = Math.Max(0.0, Math.Min(this._languageIndex.EndPtsMs, languageTimeMs));
        this._languageFrame = this._languageIndex.FindContainingFrame(this._languageCursorMs);
        EditMapMappingResult mapping = this._projection.MapLanguageToSource(this._languageCursorMs);
        this._sourcePlayheadMs = double.IsFinite(mapping.SourceTimestampMs) ? mapping.SourceTimestampMs : 0.0;
        if (mapping.IsMapped)
        {
            this._sourceFrame = this._sourceIndex.FindContainingFrame(this._sourcePlayheadMs);
            this._sourcePreviewMessage = this._sourceFrame != null ? "" : AppText.T("web.editMap.noSourceFrame");
        }
        else
        {
            this._sourceFrame = null;
            this._sourcePreviewMessage = AppText.T("web.editMap.noSourceFrame");
        }
        this._languagePreviewMessage = this._languageFrame != null ? "" : AppText.T("web.editMap.noLanguageFrame");
        this.RefreshNavigationFields();
    }

    /// <summary>Naviga da un frame Language preservandone l'ordinale anche con PTS duplicato</summary>
    private void NavigateFromLanguageFrame(VideoFrameIndexEntry frame)
    {
        if (frame == null)
            return;
        this.NavigateFromLanguage(frame.PtsMs);
        this._languageFrame = frame;
        this._languagePreviewMessage = "";
        this.RefreshNavigationFields();
    }

    private void RefreshNavigationFields()
    {
        this._sourceFrameText = this._sourceFrame != null ? (this._sourceFrame.PresentationIndex + 1).ToString() : "";
        this._languageFrameText = this._languageFrame != null ? (this._languageFrame.PresentationIndex + 1).ToString() : "";
        this._sourceTimestampText = this._sourceFrame != null ? FormatTimestamp(this._sourceFrame.PtsMs) : "";
        this._languageTimestampText = this._languageFrame != null ? FormatTimestamp(this._languageFrame.PtsMs) : "";
    }

    private async Task RefreshPreviewAsync()
    {
        if (this._previewPair == null)
            return;
        string sourceUrl = this._sourceFrame != null ? "/api/edit-map-preview/" + this.RecordIndex.ToString() + "/source/" + this._sourceFrame.PresentationIndex.ToString() : null;
        string languageUrl = this._languageFrame != null ? "/api/edit-map-preview/" + this.RecordIndex.ToString() + "/language/" + this._languageFrame.PresentationIndex.ToString() : null;
        this._previewFailed = false;
        if (sourceUrl != null)
            this._sourcePreviewMessage = AppText.F("web.editMap.loadingFrame", this._sourceFrame.PresentationIndex + 1);
        if (languageUrl != null)
            this._languagePreviewMessage = AppText.F("web.editMap.loadingFrame", this._languageFrame.PresentationIndex + 1);
        this.StateHasChanged();
        try
        {
            await this._previewPair.InvokeAsync<bool>("loadPair", sourceUrl, languageUrl);
            if (sourceUrl != null)
                this._sourcePreviewMessage = "";
            if (languageUrl != null)
                this._languagePreviewMessage = "";
        }
        catch (JSException exception)
        {
            if (exception.Message.IndexOf("abort", StringComparison.OrdinalIgnoreCase) < 0)
            {
                this._previewFailed = true;
                if (exception.Message.IndexOf("Source:", StringComparison.OrdinalIgnoreCase) >= 0)
                    this._sourcePreviewMessage = AppText.T("web.editMap.previewError");
                else if (exception.Message.IndexOf("Language:", StringComparison.OrdinalIgnoreCase) >= 0)
                    this._languagePreviewMessage = AppText.T("web.editMap.previewError");
                else
                {
                    this._sourcePreviewMessage = AppText.T("web.editMap.previewError");
                    this._languagePreviewMessage = AppText.T("web.editMap.previewError");
                }
                this.NotificationService.Notify(NotificationSeverity.Error, AppText.T("web.editMap.previewError"), exception.Message, 8000);
            }
        }
        this.StateHasChanged();
    }

    private object BuildTimelineModel()
    {
        List<object> segments = new List<object>();
        List<object> operations = new List<object>();
        AudioTrackProcessingPlan languagePlan = this.GetSelectedLanguageAudioPlan();
        if (this._projection != null)
        {
            for (int i = 0; i < this._projection.Segments.Count; i++)
            {
                EditMapTimelineSegment segment = this._projection.Segments[i];
                bool sourceFilled = this.TryResolveSourceFillRange(segment, languagePlan, out double fillSourceStartMs, out double fillSourceEndMs, out double gainDb);
                segments.Add(new { kind = segment.Kind.ToString(), sourceStartMs = segment.SourceStartMs, sourceEndMs = segment.SourceEndMs, languageStartMs = segment.LanguageStartMs, languageEndMs = segment.LanguageEndMs, sourceFilled = sourceFilled, fillSourceStartMs = fillSourceStartMs, fillSourceEndMs = fillSourceEndMs, gainDb = gainDb });
            }
        }
        for (int i = 0; i < this._workingMap.Operations.Count; i++)
        {
            EditOperation operation = this._workingMap.Operations[i];
            operations.Add(new { index = i, type = operation.Type, sourceMs = operation.SourceTimestampMs, durationMs = EditMapTimelineHelper.GetRenderedOperationDeltaMs(operation, this._projection != null ? this._projection.StretchRatio : 1.0), selected = object.ReferenceEquals(operation, this._selectedOperation) });
        }
        object labels = new
        {
            source = AppText.T("web.editMap.source").ToUpperInvariant(),
            language = AppText.T("web.editMap.language").ToUpperInvariant(),
            cut = AppText.T("web.editMap.cut").ToUpperInvariant(),
            insert = AppText.T("web.editMap.insert").ToUpperInvariant()
        };
        double sourceDurationMs = this._sourceIndex != null ? this._sourceIndex.EndPtsMs : 0.0;
        double languageDurationMs = this._languageIndex != null ? this._languageIndex.EndPtsMs : 0.0;
        string sourceAudioUrl = this.BuildAudioTimelineUrl("source", this._selectedSourceAudioTrackId, sourceDurationMs);
        string languageAudioUrl = this.BuildAudioTimelineUrl("language", this._selectedLanguageAudioTrackId, languageDurationMs);
        string sourceFillAudioUrl = languagePlan != null && languagePlan.SourceFillTrack != null ? this.BuildAudioTimelineUrl("source", languagePlan.SourceFillTrack.Id, sourceDurationMs) : null;
        double sourceNyquistHz = GetNyquistFrequency(this.Record?.SourceAudioTracks, this._selectedSourceAudioTrackId);
        double languageNyquistHz = GetNyquistFrequency(this.Record?.ImportedAudioTracks, this._selectedLanguageAudioTrackId);
        return new { durationMs = sourceDurationMs, frameDurationMs = this._sourceIndex != null ? this._sourceIndex.MedianFrameDurationMs : 40.0, sourceAudioUrl = sourceAudioUrl, languageAudioUrl = languageAudioUrl, sourceFillAudioUrl = sourceFillAudioUrl, audioMode = this._audioMode, sourceNyquistHz = sourceNyquistHz, languageNyquistHz = languageNyquistHz, waveformGain = this._waveformGain, playheadMs = this._sourcePlayheadMs, precisionMode = this._precisionEditorOpen, selectionEnabled = this._precisionEditorOpen, selectionStartMs = this.HasTimelineSelection ? (double?)this._selectionSourceStartMs : null, selectionEndMs = this.HasTimelineSelection ? (double?)this._selectionSourceEndMs : null, labels = labels, segments = segments, operations = operations };
    }

    /// <summary>Restituisce il piano audio della traccia Language visualizzata</summary>
    private AudioTrackProcessingPlan GetSelectedLanguageAudioPlan()
    {
        if (!this._selectedLanguageAudioTrackId.HasValue || this.Record?.AudioProcessingPreview == null)
            return null;

        return this.Record.AudioProcessingPreview.FindLangTrack(this._selectedLanguageAudioTrackId.Value);
    }

    /// <summary>Determina se un gap della proiezione verrà riempito con audio Source</summary>
    private bool TryResolveSourceFillRange(EditMapTimelineSegment segment, AudioTrackProcessingPlan languagePlan, out double sourceStartMs, out double sourceEndMs, out double gainDb)
    {
        sourceStartMs = 0.0;
        sourceEndMs = 0.0;
        gainDb = 0.0;
        if (segment.Kind != EditMapTimelineSegmentKind.InsertedGap || languagePlan?.SourceFillPlan == null || languagePlan.SourceFillTrack == null)
            return false;

        AudioSourceFillPlan fillPlan = languagePlan.SourceFillPlan;
        EditOperation operation = this.FindInsertOperation(segment);
        if (operation != null)
        {
            if (!this.ShouldSourceFillOperation(operation))
                return false;

            sourceStartMs = operation.SourceTimestampMs;
            sourceEndMs = sourceStartMs + EditMapTimelineHelper.GetRenderedOperationDeltaMs(operation, this._projection != null ? this._projection.StretchRatio : 1.0);
            gainDb = operation.GainDb;
            return sourceEndMs > sourceStartMs;
        }

        if (segment.SourceStartMs <= 0.5 && fillPlan.StartFillMs > 0)
        {
            sourceStartMs = 0.0;
            sourceEndMs = Math.Min(segment.SourceEndMs, fillPlan.StartFillMs);
            return sourceEndMs > sourceStartMs;
        }

        double sourceDurationMs = this._sourceIndex != null ? this._sourceIndex.EndPtsMs : 0.0;
        if (sourceDurationMs > 0.0 && segment.SourceEndMs >= sourceDurationMs - 0.5 && fillPlan.EndFillMs > 0)
        {
            sourceStartMs = Math.Max(0.0, sourceDurationMs - fillPlan.EndFillMs);
            sourceEndMs = sourceDurationMs;
            return sourceEndMs > sourceStartMs;
        }

        return false;
    }

    /// <summary>Trova l'operazione INSERT_SILENCE che ha prodotto un gap della proiezione</summary>
    private EditOperation FindInsertOperation(EditMapTimelineSegment segment)
    {
        double stretchRatio = this._projection != null ? this._projection.StretchRatio : 1.0;
        for (int i = 0; i < this._workingMap.Operations.Count; i++)
        {
            EditOperation operation = this._workingMap.Operations[i];
            if (!string.Equals(operation.Type, EditOperation.INSERT_SILENCE, StringComparison.Ordinal))
                continue;

            double renderedDurationMs = EditMapTimelineHelper.GetRenderedOperationDeltaMs(operation, stretchRatio);
            if (Math.Abs(operation.SourceTimestampMs - segment.SourceStartMs) <= 0.5 && Math.Abs(renderedDurationMs - (segment.SourceEndMs - segment.SourceStartMs)) <= 0.5)
                return operation;
        }

        return null;
    }

    /// <summary>Applica alla mappa modificata le stesse regole source-fill del planner audio</summary>
    private bool ShouldSourceFillOperation(EditOperation operation)
    {
        if (this.CurrentOptions == null || this.CurrentOptions.AudioSourceFillThresholdMs <= 0 || string.IsNullOrEmpty(this.CurrentOptions.AudioSourceFillLanguage))
            return false;

        double stretchRatio = this._projection != null ? this._projection.StretchRatio : 1.0;
        if (EditMapTimelineHelper.LanguageDurationToRenderedDurationMs(operation.DurationMs, stretchRatio) <= this.CurrentOptions.AudioSourceFillThresholdMs)
            return false;

        if (string.Equals(operation.Scope, EditOperation.SCOPE_HEAD, StringComparison.Ordinal))
            return this.CurrentOptions.AudioSourceFillStart;
        if (string.Equals(operation.Scope, EditOperation.SCOPE_TAIL, StringComparison.Ordinal))
            return this.CurrentOptions.AudioSourceFillEnd;
        return this.CurrentOptions.AudioSourceFillInsertSilence;
    }

    /// <summary>Costruisce l'endpoint stateless per traccia e modalità selezionate</summary>
    private string BuildAudioTimelineUrl(string side, int? trackId, double durationMs)
    {
        if (!trackId.HasValue)
            return null;
        return "/api/edit-map-audio/" + this.RecordIndex.ToString() + "/" + side + "?trackId=" + trackId.Value.ToString() + "&durationMs=" + durationMs.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "&mode=" + this._audioMode + "&quality=" + (this._precisionEditorOpen ? "high" : "low");
    }

    /// <summary>Restituisce la prima traccia, che è l'autorità predefinita della timeline</summary>
    private static int? GetFirstTrackId(List<TrackInfo> tracks)
    {
        return tracks != null && tracks.Count > 0 ? tracks[0].Id : null;
    }

    /// <summary>Calcola la frequenza di Nyquist della traccia selezionata</summary>
    private static double GetNyquistFrequency(List<TrackInfo> tracks, int? trackId)
    {
        if (tracks == null || !trackId.HasValue)
            return 0.0;
        TrackInfo track = tracks.Find(candidate => candidate.Id == trackId.Value);
        return track != null && track.SamplingFrequency > 0 ? track.SamplingFrequency / 2.0 : 0.0;
    }

    /// <summary>Valida il cambio traccia contro l'elenco del record corrente</summary>
    private async Task ChangeAudioTrackAsync(ChangeEventArgs args, bool source)
    {
        List<TrackInfo> tracks = source ? this.Record?.SourceAudioTracks : this.Record?.ImportedAudioTracks;
        if (!int.TryParse(args.Value != null ? args.Value.ToString() : "", out int trackId) || tracks == null || tracks.Find(track => track.Id == trackId) == null)
            return;
        if (source)
            this._selectedSourceAudioTrackId = trackId;
        else
            this._selectedLanguageAudioTrackId = trackId;
        await this.UpdateTimelineAsync();
    }

    /// <summary>Descrive le due corsie audio, sorgente e lingua, per la barra del pannello timeline</summary>
    private List<MediaTimelinePanelComponent.AudioLane> GetAudioLanes()
    {
        List<MediaTimelinePanelComponent.AudioLane> lanes = new List<MediaTimelinePanelComponent.AudioLane>();
        lanes.Add(new MediaTimelinePanelComponent.AudioLane
        {
            Label = AppText.T("web.editMap.sourceAudio"),
            ElementId = "edit-map-source-audio",
            Tracks = this.Record?.SourceAudioTracks ?? new List<TrackInfo>(),
            SelectedTrackId = this._selectedSourceAudioTrackId,
            OnTrackChanged = EventCallback.Factory.Create<ChangeEventArgs>(this, args => this.ChangeAudioTrackAsync(args, true))
        });
        lanes.Add(new MediaTimelinePanelComponent.AudioLane
        {
            Label = AppText.T("web.editMap.languageAudio"),
            ElementId = "edit-map-language-audio",
            Tracks = this.Record?.ImportedAudioTracks ?? new List<TrackInfo>(),
            SelectedTrackId = this._selectedLanguageAudioTrackId,
            OnTrackChanged = EventCallback.Factory.Create<ChangeEventArgs>(this, args => this.ChangeAudioTrackAsync(args, false))
        });
        return lanes;
    }

