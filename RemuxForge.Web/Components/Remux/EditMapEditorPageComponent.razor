@inject VideoFrameAccessService FrameAccess
@inject IJSRuntime JsRuntime
@inject NotificationService NotificationService
@implements IAsyncDisposable

<section @ref="_pageRoot" class="edit-map-page" data-keyboard-owner="edit-map" tabindex="-1" aria-labelledby="edit-map-page-title">
    <header class="edit-map-page-header">
        <div>
            <div id="edit-map-page-title">@AppText.T("web.editMap.title")</div>
            <div class="edit-map-page-subtitle">@Record?.EpisodeId · @AppText.T("web.detail.stretchLabel") @GetStretchLabel()</div>
        </div>
        <div class="edit-map-page-title-actions">
            <RadzenBadge Text="@GetStateLabel()" BadgeStyle="@GetStateStyle()" />
            <RadzenButton Icon="open_in_full" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.precisionOpenHelp")" aria-label="@AppText.T("web.editMap.precisionOpenHelp")" Disabled="@(!IndexesReady)" Click="OpenPrecisionEditorAsync" />
            <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.common.close")" aria-label="@AppText.T("web.common.close")" Click="CloseAsync" />
        </div>
    </header>

    <main class="edit-map-page-body">
        <RadzenSplitter Orientation="Orientation.Vertical" class="edit-map-main-splitter">
            <RadzenSplitterPane Size="66.6667%" Min="300px">
                <RadzenSplitter class="edit-map-row-splitter">
                    <RadzenSplitterPane Size="66.6667%" Min="540px">
                        <section class="edit-map-preview-section">
                            <div class="edit-map-preview-grid">
                                <FramePreviewPaneComponent @ref="_sourcePreview"
                                                           Title="@AppText.T("web.editMap.source")"
                                                           CanvasAlternative="@GetPreviewAlternative(true)"
                                                           OverlayMessage="@GetPreviewOverlay(true)"
                                                           RetryText="@GetPreviewRetryText(true)"
                                                           OnRetry="RefreshPreviewAsync"
                                                           Meta="@GetIndexMetadata(_sourceIndex)">
                                    <Controls>
                                        <div class="media-frame-control">
                                            <RadzenButton Icon="chevron_left" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.previousSourceFrame")" aria-label="@AppText.T("web.editMap.previousSourceFrame")" data-frame-side="source" data-frame-delta="-1" Disabled="@(!CanStepSource(-1))" />
                                            <label>@AppText.T("web.editMap.frame") <input class="form-input" inputmode="numeric" value="@_sourceFrameText" aria-label="@AppText.T("web.editMap.sourceFrame")" @oninput="UpdateSourceFrameText" @onblur="CommitSourceFrameAsync" @onkeydown="HandleSourceFrameKeyAsync" disabled="@(!IndexesReady)" /></label>
                                            <span>/ @(_sourceIndex?.FrameCount.ToString() ?? "—")</span>
                                            <RadzenButton Icon="chevron_right" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.nextSourceFrame")" aria-label="@AppText.T("web.editMap.nextSourceFrame")" data-frame-side="source" data-frame-delta="1" Disabled="@(!CanStepSource(1))" />
                                        </div>
                                        <label>@AppText.T("web.editMap.pts") <input class="form-input" value="@_sourceTimestampText" aria-label="@AppText.T("web.editMap.sourcePts")" @oninput="UpdateSourceTimestampText" @onblur="CommitSourceTimestampAsync" @onkeydown="HandleSourceTimestampKeyAsync" disabled="@(!IndexesReady)" /></label>
                                    </Controls>
                                </FramePreviewPaneComponent>
                                <FramePreviewPaneComponent @ref="_languagePreview"
                                                           Title="@AppText.T("web.editMap.language")"
                                                           CanvasAlternative="@GetPreviewAlternative(false)"
                                                           OverlayMessage="@GetPreviewOverlay(false)"
                                                           RetryText="@GetPreviewRetryText(false)"
                                                           OnRetry="RefreshPreviewAsync"
                                                           Meta="@GetIndexMetadata(_languageIndex)">
                                    <Controls>
                                        <div class="media-frame-control">
                                            <RadzenButton Icon="chevron_left" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.previousLanguageFrame")" aria-label="@AppText.T("web.editMap.previousLanguageFrame")" data-frame-side="language" data-frame-delta="-1" Disabled="@(!CanStepLanguage(-1))" />
                                            <label>@AppText.T("web.editMap.frame") <input class="form-input" inputmode="numeric" value="@_languageFrameText" aria-label="@AppText.T("web.editMap.languageFrame")" @oninput="UpdateLanguageFrameText" @onblur="CommitLanguageFrameAsync" @onkeydown="HandleLanguageFrameKeyAsync" disabled="@(!IndexesReady)" /></label>
                                            <span>/ @(_languageIndex?.FrameCount.ToString() ?? "—")</span>
                                            <RadzenButton Icon="chevron_right" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.nextLanguageFrame")" aria-label="@AppText.T("web.editMap.nextLanguageFrame")" data-frame-side="language" data-frame-delta="1" Disabled="@(!CanStepLanguage(1))" />
                                        </div>
                                        <label>@AppText.T("web.editMap.pts") <input class="form-input" value="@_languageTimestampText" aria-label="@AppText.T("web.editMap.languagePts")" @oninput="UpdateLanguageTimestampText" @onblur="CommitLanguageTimestampAsync" @onkeydown="HandleLanguageTimestampKeyAsync" disabled="@(!IndexesReady)" /></label>
                                    </Controls>
                                </FramePreviewPaneComponent>
                            </div>
                        </section>
                    </RadzenSplitterPane>
                    <RadzenSplitterPane Min="280px">
                        <section class="edit-map-operations-pane">
                            <div class="edit-map-panel-toolbar">
                                <div class="media-section-title">@AppText.T("web.detail.operationsLabel")</div>
                                <span class="edit-map-toolbar-spacer"></span>
                                <RadzenButton Icon="content_cut" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addCutHelp")" aria-label="@AppText.T("web.editMap.addCutHelp")" Disabled="@(!CanCreateOperation())" Click="@(() => AddOperationAsync(EditOperation.CUT_SEGMENT))" />
                                <RadzenButton Icon="add_to_queue" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addInsertHelp")" aria-label="@AppText.T("web.editMap.addInsertHelp")" Disabled="@(!CanCreateOperation())" Click="@(() => AddOperationAsync(EditOperation.INSERT_SILENCE))" />
                                <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" title="@AppText.T("web.editMap.deleteHelp")" aria-label="@AppText.T("web.editMap.deleteHelp")" Disabled="@(_selectedOperation == null)" Click="DeleteSelectedOperationAsync" />
                            </div>
                            <RadzenDataGrid @ref="_operationGrid" Data="@_workingMap.Operations" TItem="EditOperation" AllowSorting="false" AllowFiltering="false" AllowColumnResize="true" AllowRowSelectOnRowClick="true" GridLines="DataGridGridLines.Both" Density="Density.Compact" RowClick="SelectOperationRowAsync" RowRender="RenderOperationRow" class="edit-map-operation-grid">
                                <Columns>
                                    <RadzenDataGridColumn TItem="EditOperation" Title="#" Width="2rem" Resizable="false"><Template Context="operation">@((_workingMap.Operations.IndexOf(operation) + 1).ToString())</Template></RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.type")" Width="4.25rem"><Template Context="operation">@GetOperationTypeLabel(operation)</Template></RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.source")" Width="6.25rem"><Template Context="operation">@FormatTimestamp(operation.SourceTimestampMs)</Template></RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.language")" Width="6.25rem"><Template Context="operation">@FormatTimestamp(operation.LangTimestampMs)</Template></RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.detail.durationLabel")" Width="5.25rem"><Template Context="operation">@FormatDuration(operation.DurationMs)</Template></RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </section>
                    </RadzenSplitterPane>
                </RadzenSplitter>
            </RadzenSplitterPane>
            <RadzenSplitterPane Min="220px">
                <RadzenSplitter class="edit-map-row-splitter">
                    <RadzenSplitterPane Size="66.6667%" Min="540px">
                        <div class="@GetTimelineOverlayClass()" @onclick="ClosePrecisionEditorAsync">
                            <div class="@GetTimelineBoxClass()" role="@(_precisionEditorOpen ? "dialog" : null)" aria-modal="@(_precisionEditorOpen ? "true" : null)" aria-labelledby="@(_precisionEditorOpen ? "edit-map-precision-title" : null)" tabindex="@(_precisionEditorOpen ? "-1" : null)" @onclick:stopPropagation="true">
                                @if (_precisionEditorOpen)
                                {
                                    <div id="edit-map-precision-title" class="dialog-title edit-map-precision-title">
                                        <div>
                                            <div>@AppText.T("web.editMap.precisionTitle")</div>
                                            <div class="edit-map-page-subtitle">@Record?.EpisodeId · @AppText.T("web.detail.stretchLabel") @GetStretchLabel()</div>
                                        </div>
                                        <div class="edit-map-precision-title-actions">
                                            <span class="edit-map-selection-summary">@GetSelectionSummary()</span>
                                            <RadzenButton Icon="close_fullscreen" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.precisionCloseHelp")" aria-label="@AppText.T("web.editMap.precisionCloseHelp")" Click="ClosePrecisionEditorAsync" />
                                        </div>
                                    </div>
                                }
                                <div class="@GetTimelineBodyClass()">
                                    <div class="edit-map-timeline-stage">
                                        <MediaTimelinePanelComponent @ref="_timelinePanel"
                                                                     AudioLanes="@GetAudioLanes()"
                                                                     ToolbarLabel="@AppText.T("web.editMap.audioVisualization")"
                                                                     WaveformText="@AppText.T("web.editMap.waveform")"
                                                                     SpectrogramText="@AppText.T("web.editMap.spectrogram")"
                                                                     WaveformHeightText="@AppText.T("web.editMap.waveformHeight")"
                                                                     AudioMode="@_audioMode"
                                                                     AudioModeChanged="SetAudioModeAsync"
                                                                     WaveformGain="@_waveformGain"
                                                                     WaveformGainChanged="SetWaveformGainAsync"
                                                                     HostAlternative="@AppText.T("web.editMap.timeline")"
                                                                     CanvasAlternative="@GetTimelineAlternative()" />
                                    </div>
                                    @if (_precisionEditorOpen)
                                    {
                                        <div class="edit-map-precision-details">
                                            <section class="edit-map-operations-pane">
                                                <div class="edit-map-panel-toolbar edit-map-precision-operation-toolbar">
                                                    <div class="media-section-title">@AppText.T("web.detail.operationsLabel")</div>
                                                    <span class="edit-map-toolbar-spacer"></span>
                                                    <RadzenButton Text="@AppText.T("web.editMap.addCut")" Icon="content_cut" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addCutHelp")" aria-label="@AppText.T("web.editMap.addCutHelp")" Disabled="@(!CanAddCut())" Click="AddCutAsync" />
                                                    <RadzenButton Text="@AppText.T("web.editMap.addInsert")" Icon="add_to_queue" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.addInsertHelp")" aria-label="@AppText.T("web.editMap.addInsertHelp")" Disabled="@(!CanCreateOperation())" Click="@(() => AddOperationAsync(EditOperation.INSERT_SILENCE))" />
                                                    <RadzenButton Text="@AppText.T("web.common.delete")" Icon="delete" Size="ButtonSize.Small" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" title="@AppText.T("web.editMap.deleteHelp")" aria-label="@AppText.T("web.editMap.deleteHelp")" Disabled="@(_selectedOperation == null)" Click="DeleteSelectedOperationAsync" />
                                                </div>
                                                <RadzenDataGrid @ref="_precisionOperationGrid" Data="@_workingMap.Operations" TItem="EditOperation" AllowSorting="false" AllowFiltering="false" AllowColumnResize="true" AllowRowSelectOnRowClick="true" GridLines="DataGridGridLines.Both" Density="Density.Compact" RowClick="SelectOperationRowAsync" RowRender="RenderOperationRow" class="edit-map-operation-grid">
                                                    <Columns>
                                                        <RadzenDataGridColumn TItem="EditOperation" Title="#" Width="2rem" Resizable="false"><Template Context="operation">@((_workingMap.Operations.IndexOf(operation) + 1).ToString())</Template></RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.type")" Width="4.25rem"><Template Context="operation">@GetOperationTypeLabel(operation)</Template></RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.source")" Width="6.25rem"><Template Context="operation">@FormatTimestamp(operation.SourceTimestampMs)</Template></RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.editMap.language")" Width="6.25rem"><Template Context="operation">@FormatTimestamp(operation.LangTimestampMs)</Template></RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="EditOperation" Title="@AppText.T("web.detail.durationLabel")" Width="5.25rem"><Template Context="operation">@FormatDuration(operation.DurationMs)</Template></RadzenDataGridColumn>
                                                    </Columns>
                                                </RadzenDataGrid>
                                            </section>
                                            <section class="edit-map-inspector-pane">
                                                <div class="media-section-title">@AppText.T("web.editMap.selectedOperation")</div>
                                                @if (_selectedOperation == null)
                                                {
                                                    <div class="edit-map-inspector-empty">@AppText.T("web.editMap.noOperationSelected")</div>
                                                }
                                                else
                                                {
                                                    <div class="edit-map-inspector-summary">
                                                        <RadzenBadge Text="@GetOperationTypeLabel(_selectedOperation)" BadgeStyle="@(string.Equals(_selectedOperation.Type, EditOperation.CUT_SEGMENT, StringComparison.Ordinal) ? BadgeStyle.Warning : BadgeStyle.Info)" />
                                                        <span>@AppText.T("web.editMap.scope"): @_selectedOperation.Scope</span>
                                                    </div>
                                                    <div class="edit-map-inspector-form">
                                                        <label><span>@AppText.T("web.editMap.source")</span><input class="form-input" aria-label="@AppText.T("web.editMap.source")" value="@_operationSourceText" @oninput="UpdateOperationSourceText" @onblur="CommitSelectedOperationAsync" /></label>
                                                        <label><span>@AppText.T("web.editMap.sourceFrame")</span><input class="form-input" aria-label="@AppText.T("web.editMap.sourceFrame")" inputmode="numeric" value="@_operationSourceFrameText" @oninput="UpdateOperationSourceFrameText" @onblur="CommitSelectedOperationAsync" /></label>
                                                        <label><span>@AppText.T("web.editMap.language")</span><input class="form-input" aria-label="@AppText.T("web.editMap.language")" value="@_operationLanguageText" @oninput="UpdateOperationLanguageText" @onblur="CommitSelectedOperationAsync" /></label>
                                                        <label><span>@AppText.T("web.editMap.languageFrame")</span><input class="form-input" aria-label="@AppText.T("web.editMap.languageFrame")" inputmode="numeric" value="@_operationLanguageFrameText" @oninput="UpdateOperationLanguageFrameText" @onblur="CommitSelectedOperationAsync" /></label>
                                                        <label><span>@AppText.T("web.editMap.languageDurationShort")</span><input class="form-input" aria-label="@AppText.T("web.editMap.languageDurationShort")" inputmode="numeric" value="@_operationLanguageDurationText" @oninput="UpdateOperationLanguageDurationText" @onblur="CommitSelectedOperationAsync" /></label>
                                                        <label><span>@AppText.T("web.editMap.renderedDurationShort")</span><input class="form-input" aria-label="@AppText.T("web.editMap.renderedDurationShort")" inputmode="numeric" value="@_operationRenderedDurationText" @oninput="UpdateOperationRenderedDurationText" @onblur="CommitSelectedOperationAsync" /></label>
                                                        @if (IsSelectedInsert)
                                                        {
                                                            <label><span>@AppText.T("web.editMap.insertGain")</span><input class="form-input" aria-label="@AppText.T("web.editMap.insertGain")" inputmode="decimal" value="@_operationGainText" @oninput="UpdateOperationGainText" @onblur="CommitSelectedOperationAsync" /></label>
                                                        }
                                                    </div>
                                                }
                                            </section>
                                        </div>
                                    }
                                </div>
                                @if (_precisionEditorOpen)
                                {
                                    <div class="dialog-footer edit-map-precision-footer">
                                        <span class="edit-map-validation-summary">@GetValidationSummary()</span>
                                        <span class="edit-map-footer-spacer"></span>
                                        <RadzenButton Text="@AppText.T("web.common.close")" Icon="close_fullscreen" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="ClosePrecisionEditorAsync" />
                                    </div>
                                }
                            </div>
                        </div>
                    </RadzenSplitterPane>
                    <RadzenSplitterPane Min="280px">
                        <section class="edit-map-inspector-pane">
                            <div class="media-section-title">@AppText.T("web.editMap.selectedOperation")</div>
                            @if (_selectedOperation == null)
                            {
                                <div class="edit-map-inspector-empty">@AppText.T("web.editMap.noOperationSelected")</div>
                            }
                            else
                            {
                                <div class="edit-map-inspector-summary">
                                    <RadzenBadge Text="@GetOperationTypeLabel(_selectedOperation)" BadgeStyle="@(string.Equals(_selectedOperation.Type, EditOperation.CUT_SEGMENT, StringComparison.Ordinal) ? BadgeStyle.Warning : BadgeStyle.Info)" />
                                    <span>@AppText.T("web.editMap.scope"): @_selectedOperation.Scope</span>
                                </div>
                                <div class="edit-map-inspector-form">
                                    <label><span>@AppText.T("web.editMap.source")</span><input class="form-input" aria-label="@AppText.T("web.editMap.source")" value="@_operationSourceText" @oninput="UpdateOperationSourceText" @onblur="CommitSelectedOperationAsync" /></label>
                                    <label><span>@AppText.T("web.editMap.sourceFrame")</span><input class="form-input" aria-label="@AppText.T("web.editMap.sourceFrame")" inputmode="numeric" value="@_operationSourceFrameText" @oninput="UpdateOperationSourceFrameText" @onblur="CommitSelectedOperationAsync" /></label>
                                    <label><span>@AppText.T("web.editMap.language")</span><input class="form-input" aria-label="@AppText.T("web.editMap.language")" value="@_operationLanguageText" @oninput="UpdateOperationLanguageText" @onblur="CommitSelectedOperationAsync" /></label>
                                    <label><span>@AppText.T("web.editMap.languageFrame")</span><input class="form-input" aria-label="@AppText.T("web.editMap.languageFrame")" inputmode="numeric" value="@_operationLanguageFrameText" @oninput="UpdateOperationLanguageFrameText" @onblur="CommitSelectedOperationAsync" /></label>
                                    <label><span>@AppText.T("web.editMap.languageDurationShort")</span><input class="form-input" aria-label="@AppText.T("web.editMap.languageDurationShort")" inputmode="numeric" value="@_operationLanguageDurationText" @oninput="UpdateOperationLanguageDurationText" @onblur="CommitSelectedOperationAsync" /></label>
                                    <label><span>@AppText.T("web.editMap.renderedDurationShort")</span><input class="form-input" aria-label="@AppText.T("web.editMap.renderedDurationShort")" inputmode="numeric" value="@_operationRenderedDurationText" @oninput="UpdateOperationRenderedDurationText" @onblur="CommitSelectedOperationAsync" /></label>
                                    @if (IsSelectedInsert)
                                    {
                                        <label><span>@AppText.T("web.editMap.insertGain")</span><input class="form-input" aria-label="@AppText.T("web.editMap.insertGain")" inputmode="decimal" value="@_operationGainText" @oninput="UpdateOperationGainText" @onblur="CommitSelectedOperationAsync" /></label>
                                    }
                                </div>
                            }
                        </section>
                    </RadzenSplitterPane>
                </RadzenSplitter>
            </RadzenSplitterPane>
        </RadzenSplitter>
    </main>

    <footer class="edit-map-page-footer">
        <span class="edit-map-validation-summary">@GetValidationSummary()</span>
        <span class="edit-map-footer-spacer"></span>
        <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" title="@AppText.T("web.editMap.cancelHelp")" Click="CloseAsync" />
        <RadzenButton Text="@AppText.T("web.editMap.apply")" Icon="check" title="@AppText.T("web.editMap.applyHelp")" Disabled="@(!CanApply())" Click="ApplyAsync" />
    </footer>
</section>

@code {
    private const string AUDIO_MODE_WAVEFORM = "waveform";
    private const string AUDIO_MODE_SPECTROGRAM = "spectrogram";

    /// <summary>Indice del record originale</summary>
    [Parameter] public int RecordIndex { get; set; }

    /// <summary>Snapshot del record aperto</summary>
    [Parameter] public FileProcessingRecord Record { get; set; }

    /// <summary>Opzioni correnti usate per determinare il source-fill effettivo</summary>
    [Parameter] public Options CurrentOptions { get; set; }

    /// <summary>Evento chiusura pagina</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Evento applicazione mappa validata</summary>
    [Parameter] public EventCallback<(EditMap Map, double SourceDurationMs, double LanguageDurationMs, double SourceTailToleranceMs)> OnApply { get; set; }

    private readonly CancellationTokenSource _cancellation = new CancellationTokenSource();
    private EditMap _originalMap = new EditMap();
    private EditMap _workingMap = new EditMap();
    private EditMapProjection _projection;
    private EditOperation _selectedOperation;
    private VideoFrameIndex _sourceIndex;
    private VideoFrameIndex _languageIndex;
    private VideoFrameIndexEntry _sourceFrame;
    private VideoFrameIndexEntry _languageFrame;
    private RadzenDataGrid<EditOperation> _operationGrid;
    private RadzenDataGrid<EditOperation> _precisionOperationGrid;
    private ElementReference _pageRoot;
    private FramePreviewPaneComponent _sourcePreview;
    private FramePreviewPaneComponent _languagePreview;
    private MediaTimelinePanelComponent _timelinePanel;
    private IJSObjectReference _module;
    private IJSObjectReference _previewPair;
    private IJSObjectReference _keyboard;
    private DotNetObjectReference<EditMapEditorPageComponent> _dotNetReference;
    private string _sourceError = "";
    private string _languageError = "";
    private string _sourcePreviewMessage = "";
    private string _languagePreviewMessage = "";
    private string _sourceFrameText = "";
    private string _languageFrameText = "";
    private string _sourceTimestampText = "";
    private string _languageTimestampText = "";
    private string _operationSourceText = "";
    private string _operationLanguageText = "";
    private string _operationLanguageDurationText = "";
    private string _operationRenderedDurationText = "";
    private string _operationSourceFrameText = "";
    private string _operationLanguageFrameText = "";
    private string _operationGainText = "";
    private string _timestampEditAuthority = "";
    private string _durationEditAuthority = "";
    private string _audioMode = AUDIO_MODE_WAVEFORM;
    private int? _selectedSourceAudioTrackId;
    private int? _selectedLanguageAudioTrackId;
    private double _sourcePlayheadMs;
    private double _languageCursorMs;
    private double _selectionSourceStartMs = double.NaN;
    private double _selectionSourceEndMs = double.NaN;
    private double _selectionLanguageStartMs = double.NaN;
    private double _selectionLanguageEndMs = double.NaN;
    private double _waveformGain = 1.0;
    private bool _sourceIndexing = true;
    private bool _languageIndexing = true;
    private bool _interactiveInitialized;
    private bool _dirty;
    private bool _isApplying;
    private bool _previewFailed;
    private bool _precisionEditorOpen;
    private bool _gainEditPending;

    private bool IndexesReady { get { return this._sourceIndex != null && this._languageIndex != null && string.IsNullOrEmpty(this._sourceError) && string.IsNullOrEmpty(this._languageError); } }
    private bool IsSpectrogram { get { return string.Equals(this._audioMode, AUDIO_MODE_SPECTROGRAM, StringComparison.Ordinal); } }
    private bool IsSelectedInsert { get { return this._selectedOperation != null && string.Equals(this._selectedOperation.Type, EditOperation.INSERT_SILENCE, StringComparison.Ordinal); } }
    private bool HasTimelineSelection { get { return double.IsFinite(this._selectionSourceStartMs) && double.IsFinite(this._selectionSourceEndMs) && double.IsFinite(this._selectionLanguageStartMs) && double.IsFinite(this._selectionLanguageEndMs) && this._selectionSourceEndMs > this._selectionSourceStartMs && this._selectionLanguageEndMs > this._selectionLanguageStartMs; } }

    /// <summary>Inizializza copia di lavoro e indicizza i due video in parallelo</summary>
    protected override async Task OnInitializedAsync()
    {
        this._workingMap = EditMapTimelineHelper.Clone(this.Record != null ? this.Record.DeepAnalysisMap : null);
        if (this.Record != null && this.Record.DeepAnalysisMap == null)
        {
            this._workingMap.InitialDelayMs = this.Record.SyncOffsetMs;
            this._workingMap.StretchFactor = this.Record.StretchFactor ?? "";
        }
        this._originalMap = EditMapTimelineHelper.Clone(this._workingMap);
        this._selectedSourceAudioTrackId = GetFirstTrackId(this.Record?.SourceAudioTracks);
        this._selectedLanguageAudioTrackId = GetFirstTrackId(this.Record?.ImportedAudioTracks);
        this._sourcePlayheadMs = 0.0;
        this._languageCursorMs = double.NaN;

        Task sourceTask = this.BuildIndexAsync(true);
        Task languageTask = this.BuildIndexAsync(false);
        await Task.WhenAll(sourceTask, languageTask);
        if (this.IndexesReady)
        {
            this.RebuildProjection();
            this._originalMap = EditMapTimelineHelper.Clone(this._workingMap);
            this.NavigateFromSource(0.0);
        }
    }

    /// <summary>Inizializza canvas WebGL e timeline quando gli indici sono pronti</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            this._module = await this.JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/edit-map-timeline.js");
        if (!this.IndexesReady || this._interactiveInitialized || this._module == null)
            return;

        this._interactiveInitialized = true;
        this._dotNetReference = DotNetObjectReference.Create(this);
        this._keyboard = await this._module.InvokeAsync<IJSObjectReference>("captureEditorKeyboard", this._pageRoot, this._dotNetReference);
        try
        {
            this._previewPair = await this._module.InvokeAsync<IJSObjectReference>("createPreviewPair", this._sourcePreview.Canvas, this._languagePreview.Canvas);
        }
        catch (JSException exception)
        {
            this._previewFailed = true;
            this._sourcePreviewMessage = AppText.T("web.editMap.previewUnavailable");
            this._languagePreviewMessage = AppText.T("web.editMap.previewUnavailable");
            this.NotificationService.Notify(NotificationSeverity.Error, AppText.T("web.editMap.previewError"), exception.Message, 8000);
            this.StateHasChanged();
        }
        try
        {
            await this._timelinePanel.AttachAsync(this._module, this._dotNetReference, this.BuildTimelineModel());
        }
        catch (JSException exception)
        {
            this.NotificationService.Notify(NotificationSeverity.Error, AppText.T("web.editMap.timelineError"), exception.Message, 8000);
        }
        if (this._previewPair != null)
            await this.RefreshPreviewAsync();
    }

    /// <summary>Costruisce uno dei due indici senza bloccare il circuito</summary>
    private async Task BuildIndexAsync(bool source)
    {
        try
        {
            string path = source ? this.Record.SourceFilePath : this.Record.LangFilePath;
            VideoFrameIndex index = await Task.Run(() => this.FrameAccess.GetOrBuildIndex(path, 120000, this._cancellation.Token), this._cancellation.Token);
            if (source)
                this._sourceIndex = index;
            else
                this._languageIndex = index;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            if (source)
                this._sourceError = exception.Message;
            else
                this._languageError = exception.Message;
        }
        finally
        {
            if (source)
                this._sourceIndexing = false;
            else
                this._languageIndexing = false;
            await this.InvokeAsync(this.StateHasChanged);
        }
    }

