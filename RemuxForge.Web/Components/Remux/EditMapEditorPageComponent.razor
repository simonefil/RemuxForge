            return;
        }
        VideoFrameIndexEntry frame = this._languageIndex.FindNearestFrame(ptsMs);
        if (frame == null || (this._languageFrame != null && frame.PresentationIndex == this._languageFrame.PresentationIndex))
        {
            this.RefreshNavigationFields();
            return;
        }
        this.NavigateFromLanguage(frame.PtsMs);
        await this.RefreshAfterNavigationAsync(true);
    }

    private bool CanStepSource(int delta) => this.IndexesReady && this._sourceFrame != null && this._sourceFrame.PresentationIndex + delta >= 0 && this._sourceFrame.PresentationIndex + delta < this._sourceIndex.FrameCount;

    private bool CanStepLanguage(int delta) => this.IndexesReady && this._languageFrame != null && this._languageFrame.PresentationIndex + delta >= 0 && this._languageFrame.PresentationIndex + delta < this._languageIndex.FrameCount;

    private async Task StepSourceAsync(int delta)
    {
        if (!this.IndexesReady || this._sourceFrame == null)
            return;
        int index = Math.Max(0, Math.Min(this._sourceIndex.FrameCount - 1, this._sourceFrame.PresentationIndex + delta));
        if (index == this._sourceFrame.PresentationIndex)
            return;
        VideoFrameIndexEntry frame = this._sourceIndex.Frames[index];
        this.NavigateFromSource(frame.PtsMs);
        await this.RefreshAfterNavigationAsync(true);
    }

