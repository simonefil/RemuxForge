    private BadgeStyle GetStateStyle()
    {
        if (!string.IsNullOrEmpty(this._sourceError) || !string.IsNullOrEmpty(this._languageError) || (this._projection != null && !this._projection.Validation.IsValid))
            return BadgeStyle.Danger;
        if (this._sourceIndexing || this._languageIndexing)
            return BadgeStyle.Info;
        return this._dirty ? BadgeStyle.Warning : BadgeStyle.Success;
    }

