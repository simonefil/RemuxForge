@using RemuxForge.Core.Toolbox.SubtitleTranslation
@using RemuxForge.Web.Services.Toolbox
@inherits AppDialogContentBase

@* Modelli e livelli di ragionamento per passo *@
<div class="rf-dialog rf-translation-models" @ref="DialogContent">
    <div class="rf-dialog-body">
        @if (_loading)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        }
        else if (_models.Count > 0)
        {
            <div class="rf-translation-models-grid">
                <span></span>
                <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.models.difficulty")</span>
                <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.models.model")</span>
                <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.models.reasoning")</span>
                @for (int i = 0; i < s_phases.Length; i++)
                {
                    int phase = i;
                    <div class="rf-translation-models-phase">
                        <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.subtitleTranslation.models.phase." + s_phases[phase])" Component="@("TranslationModel" + s_phases[phase])" />
                        <RadzenButton @ref="_infoButtons[phase]" Icon="info" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                                      aria-label="@AppText.T("web.toolbox.subtitleTranslation.models.phase." + s_phases[phase])"
                                      Click="@(() => _infoPopups[phase].ToggleAsync(_infoButtons[phase].Element))" />
                        <RadzenPopup @ref="_infoPopups[phase]" Lazy="true" class="rf-translation-models-info">
                            @AppText.T("web.toolbox.subtitleTranslation.models.info." + s_phases[phase])
                        </RadzenPopup>
                    </div>
                    <RadzenBadge IsPill="true" BadgeStyle="@s_difficultyStyles[phase]" Text="@AppText.T("web.toolbox.subtitleTranslation.models.difficulty." + s_difficulties[phase])" />
                    <RadzenDropDown TValue="string" Name="@("TranslationModel" + s_phases[phase])" Data="@_models" TextProperty="DisplayName" ValueProperty="Id" Value="@_selectedModels[phase]"
                                    Change="@((object value) => ChangeModel(phase, (string)value))" />
                    <RadzenDropDown TValue="string" Data="@(_models.Find(m => m.Id == _selectedModels[phase])?.SupportedReasoningLevels ?? new List<string>())" Value="@_selectedEfforts[phase]"
                                    Disabled="@string.IsNullOrEmpty(_selectedModels[phase])"
                                    aria-label="@(AppText.T("web.toolbox.subtitleTranslation.models.reasoning") + " " + AppText.T("web.toolbox.subtitleTranslation.models.phase." + s_phases[phase]))"
                                    Change="@((object value) => ChangeEffort(phase, (string)value))" />
                }
            </div>
            <div class="rf-translation-models-parallel">
                <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.subtitleTranslation.models.parallelFiles")" Component="TranslationParallelFiles" />
                <RadzenNumeric TValue="int" Name="TranslationParallelFiles" class="rf-translation-models-parallel-input" Value="@_parallelFiles"
                               Min="@TranslationProjectOptions.MIN_PARALLEL_FILES" Max="@TranslationProjectOptions.MAX_PARALLEL_FILES"
                               Change="@((int value) => _parallelFiles = value)" />
            </div>
        }
    </div>
    <div class="rf-dialog-footer">
        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rf-dialog-message">@_error</RadzenAlert>
        }
        <RadzenButton Text="@AppText.T("web.common.cancel")" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Click="@(() => CloseDialog())" />
        <RadzenButton Text="@AppText.T("web.toolbox.subtitleTranslation.models.save")" Icon="check"
                      Disabled="@(_loading || _models.Count == 0 || _parallelFiles < TranslationProjectOptions.MIN_PARALLEL_FILES || _parallelFiles > TranslationProjectOptions.MAX_PARALLEL_FILES)"
                      Click="@Save" />
    </div>
</div>

@code {
    /// <summary>
    /// Posizione della revisione, che segue la traduzione finché non si cambia
    /// </summary>
    private const int REVIEW = 3;

    /// <summary>
    /// Posizione della traduzione
    /// </summary>
    private const int TRANSLATION = 1;

    /// <summary>
    /// Passi con un modello, nell'ordine del dialog: analisi, traduzione, termini nuovi, revisione
    /// </summary>
    private static readonly string[] s_phases = new string[] { "analysis", "translation", "newTerms", "review" };

    /// <summary>
    /// Difficoltà di ciascun passo, nell'ordine di s_phases
    /// </summary>
    private static readonly string[] s_difficulties = new string[] { "high", "medium", "low", "high" };

    /// <summary>
    /// Colore del badge di ciascun passo, nell'ordine di s_phases
    /// </summary>
    private static readonly BadgeStyle[] s_difficultyStyles = new BadgeStyle[] { BadgeStyle.Danger, BadgeStyle.Warning, BadgeStyle.Success, BadgeStyle.Danger };

    /// <summary>
    /// Orchestratore della card
    /// </summary>
    [Parameter] public SubtitleTranslationOrchestrator Orchestrator { get; set; }

    /// <summary>
    /// Modelli dell'accesso
    /// </summary>
    private List<AiModelInfo> _models = new List<AiModelInfo>();

    /// <summary>
    /// Modello scelto per passo
    /// </summary>
    private string[] _selectedModels = new string[4];

    /// <summary>
    /// Livello scelto per passo
    /// </summary>
    private string[] _selectedEfforts = new string[4];

    /// <summary>
    /// Pulsanti delle informazioni per passo, ancore dei popup
    /// </summary>
    private RadzenButton[] _infoButtons = new RadzenButton[4];

    /// <summary>
    /// Popup delle informazioni per passo
    /// </summary>
    private RadzenPopup[] _infoPopups = new RadzenPopup[4];

    /// <summary>
    /// File tradotti in parallelo
    /// </summary>
    private int _parallelFiles = TranslationProjectOptions.DEFAULT_PARALLEL_FILES;

    /// <summary>
    /// True quando la revisione ha un modello suo e non segue più la traduzione
    /// </summary>
    private bool _reviewChosen;

    /// <summary>
    /// True mentre si leggono i modelli
    /// </summary>
    private bool _loading = true;

    /// <summary>
    /// Errore della lettura dei modelli
    /// </summary>
    private string _error = "";

    /// <summary>
    /// Legge i modelli e riempie le tendine coi valori del progetto
    /// </summary>
    /// <returns>Task di inizializzazione</returns>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _models = await Orchestrator.ListModelsAsync();
        }
        catch (AiServiceException ex)
        {
            _error = ex.Message;
            _models = new List<AiModelInfo>();
        }

        TranslationProject project = Orchestrator.Project;
        string[] models = new string[] { project.Models.Analysis, project.Models.Translation, project.Models.NewTerms, project.Models.Review };
        string[] efforts = new string[] { project.ReasoningEfforts.Analysis, project.ReasoningEfforts.Translation, project.ReasoningEfforts.NewTerms, project.ReasoningEfforts.Review };
        _reviewChosen = !string.IsNullOrEmpty(project.Models.Review);
        _parallelFiles = project.Options.MaxParallelFiles;

        // Le tendine partono dai valori del progetto, vuote se il passo non ha ancora un modello
        for (int i = 0; i < s_phases.Length; i++)
        {
            // La revisione senza modello suo mostra quello della traduzione
            int source = i == REVIEW && !_reviewChosen ? TRANSLATION : i;
            AiModelInfo model = _models.Find(m => m.Id == models[source]);
            _selectedModels[i] = string.IsNullOrEmpty(models[source]) ? null : models[source];
            _selectedEfforts[i] = model == null || model.SupportedReasoningLevels.Contains(efforts[source] ?? "") ? efforts[source] : model.DefaultReasoningLevel;
        }

        _loading = false;
    }

    /// <summary>
    /// Cambia il modello di un passo: un livello che il nuovo modello non supporta torna al suo default
    /// </summary>
    /// <param name="phase">Passo</param>
    /// <param name="modelId">Modello scelto</param>
    private void ChangeModel(int phase, string modelId)
    {
        AiModelInfo model = _models.Find(m => m.Id == modelId);
        if (model == null)
            return;

        _selectedModels[phase] = model.Id;
        if (!model.SupportedReasoningLevels.Contains(_selectedEfforts[phase] ?? ""))
            _selectedEfforts[phase] = model.DefaultReasoningLevel;

        if (phase == REVIEW)
            _reviewChosen = true;
        else if (phase == TRANSLATION && !_reviewChosen)
        {
            _selectedModels[REVIEW] = _selectedModels[TRANSLATION];
            _selectedEfforts[REVIEW] = _selectedEfforts[TRANSLATION];
        }
    }

    /// <summary>
    /// Cambia il livello di ragionamento di un passo
    /// </summary>
    /// <param name="phase">Passo</param>
    /// <param name="effort">Livello scelto</param>
    private void ChangeEffort(int phase, string effort)
    {
        _selectedEfforts[phase] = effort;
        if (phase == REVIEW)
            _reviewChosen = true;
        else if (phase == TRANSLATION && !_reviewChosen)
            _selectedEfforts[REVIEW] = effort;
    }

    /// <summary>
    /// Salva le scelte e i file in parallelo nel progetto; la revisione che segue la traduzione resta senza modello suo
    /// </summary>
    private void Save()
    {
        TranslationPhaseModels models = new TranslationPhaseModels
        {
            Analysis = _selectedModels[0] ?? "",
            Translation = _selectedModels[TRANSLATION] ?? "",
            NewTerms = _selectedModels[2] ?? "",
            Review = _reviewChosen ? _selectedModels[REVIEW] : null
        };
        TranslationPhaseModels efforts = new TranslationPhaseModels
        {
            Analysis = _selectedEfforts[0] ?? "",
            Translation = _selectedEfforts[TRANSLATION] ?? "",
            NewTerms = _selectedEfforts[2] ?? "",
            Review = _reviewChosen ? _selectedEfforts[REVIEW] : null
        };

        Orchestrator.SetModels(models, efforts, _parallelFiles);
        CloseDialog(true);
    }
}
