    /// <summary>
    /// Carica un glossario .xlsx e dice l'esito: le voci lette o il primo errore con la sua cella
    /// </summary>
    private async Task ImportGlossaryAsync()
    {
        List<TranslationFileRecord> records = this.Orchestrator.GetRecords();
        string initialPath = records.Count > 0 ? System.IO.Path.GetDirectoryName(records[0].InputPath) : "";
        string path = await AppDialogs.BrowseAsync(this.DialogService, this.JsModule, initialPath, true, false, s_glossaryExtensions);
        if (string.IsNullOrEmpty(path))
            return;

        GlossaryImportResult result = this.Orchestrator.ImportGlossary(path);
        if (result.Glossary != null)
        {
            this.Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifyImported"),
                AppText.Count("web.toolbox.subtitleTranslation.termsCount", this.Orchestrator.Project.ImportedGlossary.TermCount) + " · " +
                AppText.Count("web.toolbox.subtitleTranslation.charactersCount", this.Orchestrator.Project.ImportedGlossary.CharacterCount));
        }
        else if (!string.IsNullOrEmpty(result.Code))
        {
            string keyPrefix = result.Code == GlossaryFile.FILE_INVALID || result.Code == GlossaryFile.LANGUAGE_MISMATCH ? "toolbox.subtitleTranslation.glossaryImport." : "toolbox.subtitleTranslation.validation.";
            this.Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyImportFailed"),
                AppText.F(keyPrefix + result.Code, result.Location, result.Detail, LanguageName(result.SourceLanguage), LanguageName(result.TargetLanguage),
                    LanguageName(this.Orchestrator.Project.SourceLanguage), LanguageName(this.Orchestrator.Project.TargetLanguage)));
        }
    }

