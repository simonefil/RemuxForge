    /// <summary>
    /// Importa un archivio: controlli, conferma della sostituzione di un progetto presente, cartella dei sorgenti; poi apre il
    /// progetto al passo raggiunto
    /// </summary>
    private async Task ImportProjectAsync()
    {
        string zipPath = await AppDialogs.BrowseAsync(DialogService, JsModule, "", true, false, s_archiveExtensions);
        if (string.IsNullOrEmpty(zipPath))
            return;

        TranslationArchiveInspection inspection;
        try
        {
            inspection = await Task.Run(() => Orchestrator.InspectArchive(zipPath));
        }
        catch (Exception ex)
        {
            if (!(ex is IOException || ex is UnauthorizedAccessException || ex is InvalidDataException))
                throw;
            Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyProjectImportFailed"), ex.Message);
            return;
        }

        if (inspection.Existing != null)
        {
            bool replace = await AppDialogs.ConfirmAsync(DialogService, AppText.T("web.toolbox.subtitleTranslation.importReplaceTitle"),
                AppText.F("web.toolbox.subtitleTranslation.importReplaceMessage", SubtitleTranslationOrchestrator.DisplayName(inspection.Existing),
                    inspection.Existing.UpdatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture), SubtitleTranslationOrchestrator.DisplayName(inspection.Project),
                    inspection.Project.UpdatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)),
                AppText.T("web.toolbox.subtitleTranslation.importReplace"), AppText.T("web.common.cancel"));
            if (!replace)
                return;
        }

        string folder = await AppDialogs.BrowseAsync(DialogService, JsModule, System.IO.Path.GetDirectoryName(zipPath), false, true, null);
        if (string.IsNullOrEmpty(folder))
            return;

        TranslationProject project;
        try
        {
            project = await Task.Run(() => Orchestrator.ImportProject(zipPath, folder, inspection.Existing != null));
        }
        catch (Exception ex)
        {
            if (!(ex is IOException || ex is UnauthorizedAccessException || ex is InvalidDataException || ex is InvalidOperationException))
                throw;
            Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyProjectImportFailed"), ex.Message);
            return;
        }

        if (project == null)
            return;

        ReloadProjects();
        Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifyProjectImported"), SubtitleTranslationOrchestrator.DisplayName(project));
        OpenProject(project);
    }

