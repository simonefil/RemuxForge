    /// <summary>
    /// Voci di una scheda con, in fondo, quella nuova in modifica
    /// </summary>
    /// <typeparam name="T">Tipo della voce</typeparam>
    /// <param name="entries">Voci del glossario</param>
    /// <returns>Righe della griglia</returns>
    private List<T> WithDraft<T>(List<T> entries)
    {
        List<T> rows = new List<T>(entries);
        if (_adding && _editing is T draft)
            rows.Add(draft);
        return rows;
    }

    /// <summary>
    /// True se la riga è quella in modifica
    /// </summary>
    /// <param name="entry">Voce della riga</param>
    /// <returns>True in modifica</returns>
    private bool IsEditing(object entry)
    {
        return ReferenceEquals(entry, _editing);
    }

    /// <summary>
    /// Mette una voce in modifica su una copia
    /// </summary>
    /// <param name="entry">Voce della lista o nuova</param>
    /// <param name="adding">True se la voce è nuova</param>
    private void StartEditing(object entry, bool adding)
    {
        _editing = entry;
        _adding = adding;
        if (entry is GlossaryTerm term)
            _termDraft = new GlossaryTerm { Source = term.Source, Target = term.Target, Kind = term.Kind, Invariable = term.Invariable, Note = term.Note, Origin = term.Origin };
        else if (entry is GlossaryCharacter character)
            _characterDraft = new GlossaryCharacter { Name = character.Name, Gender = character.Gender, Role = character.Role, Relationships = character.Relationships, Origin = character.Origin };
        else if (entry is GlossaryAddressing pair)
            _addressingDraft = new GlossaryAddressing { Speaker = pair.Speaker, Addressee = pair.Addressee, Form = pair.Form, Note = pair.Note, Origin = pair.Origin };
    }

    /// <summary>
    /// Lascia la modifica senza salvare
    /// </summary>
    private void CancelEditing()
    {
        _editing = null;
        _adding = false;
    }

    /// <summary>
    /// Salva la voce in modifica: i campi chiave non vuoti e non già presenti in un'altra voce
    /// </summary>
    private void SaveEditing()
    {
        TranslationProject project = Orchestrator.Project;
        Glossary glossary = project.Glossary;
        GlossaryBuilder builder = new GlossaryBuilder(project.SourceLanguage, project.TargetLanguage);
        string error = "";

        if (_editing is GlossaryTerm term)
        {
            string key = builder.TermKey(_termDraft.Source ?? "");
            if (string.IsNullOrWhiteSpace(_termDraft.Source) || string.IsNullOrWhiteSpace(_termDraft.Target))
                error = AppText.T("web.toolbox.subtitleTranslation.editTermEmpty");
            else if (glossary.Terms.Exists(t => !ReferenceEquals(t, term) && builder.TermKey(t.Source) == key))
                error = AppText.F("web.toolbox.subtitleTranslation.editDuplicate", _termDraft.Source.Trim());

            if (error.Length == 0)
            {
                Orchestrator.ChangeGlossary(g =>
                {
                    term.Source = _termDraft.Source.Trim();
                    term.Target = _termDraft.Target.Trim();
                    term.Kind = _termDraft.Kind;
                    term.Invariable = _termDraft.Invariable;
                    term.Note = (_termDraft.Note ?? "").Trim();
                    if (_adding)
                        g.Terms.Add(term);
                });
            }
        }
        else if (_editing is GlossaryCharacter character)
        {
            string key = GlossaryBuilder.CharacterKey(_characterDraft.Name ?? "");
            if (string.IsNullOrWhiteSpace(_characterDraft.Name))
                error = AppText.T("web.toolbox.subtitleTranslation.editCharacterEmpty");
            else if (glossary.Characters.Exists(c => !ReferenceEquals(c, character) && GlossaryBuilder.CharacterKey(c.Name) == key))
                error = AppText.F("web.toolbox.subtitleTranslation.editDuplicate", _characterDraft.Name.Trim());

            if (error.Length == 0)
            {
                Orchestrator.ChangeGlossary(g =>
                {
                    character.Name = _characterDraft.Name.Trim();
                    character.Gender = _characterDraft.Gender;
                    character.Role = (_characterDraft.Role ?? "").Trim();
                    character.Relationships = (_characterDraft.Relationships ?? "").Trim();
                    if (_adding)
                        g.Characters.Add(character);
                });
            }
        }
        else if (_editing is GlossaryAddressing pair)
        {
            string key = GlossaryBuilder.AddressingKey(_addressingDraft.Speaker ?? "", _addressingDraft.Addressee ?? "");
            if (string.IsNullOrWhiteSpace(_addressingDraft.Speaker) || string.IsNullOrWhiteSpace(_addressingDraft.Addressee))
                error = AppText.T("web.toolbox.subtitleTranslation.editAddressingEmpty");
            else if (glossary.Addressing.Exists(a => !ReferenceEquals(a, pair) && GlossaryBuilder.AddressingKey(a.Speaker, a.Addressee) == key))
                error = AppText.F("web.toolbox.subtitleTranslation.editDuplicate", _addressingDraft.Speaker.Trim() + " → " + _addressingDraft.Addressee.Trim());

            if (error.Length == 0)
            {
                Orchestrator.ChangeGlossary(g =>
                {
                    pair.Speaker = _addressingDraft.Speaker.Trim();
                    pair.Addressee = _addressingDraft.Addressee.Trim();
                    pair.Form = _addressingDraft.Form;
                    pair.Note = (_addressingDraft.Note ?? "").Trim();
                    if (_adding)
                        g.Addressing.Add(pair);
                });
            }
        }

        if (error.Length > 0)
        {
            Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyEditInvalid"), error);
            return;
        }

        CancelEditing();
    }

    /// <summary>
    /// Toglie una voce dal glossario
    /// </summary>
    /// <param name="entry">Voce della riga</param>
    private void DeleteEntry(object entry)
    {
        Orchestrator.ChangeGlossary(g =>
        {
            if (entry is GlossaryTerm term)
                g.Terms.Remove(term);
            else if (entry is GlossaryCharacter character)
                g.Characters.Remove(character);
            else if (entry is GlossaryAddressing pair)
                g.Addressing.Remove(pair);
        });
    }

    /// <summary>
    /// Pulsanti di una riga del glossario: modifica e cancella, oppure salva e annulla sulla riga in modifica
    /// </summary>
    private RenderFragment RowActions(object entry, string name) =>
        @<span class="rf-translation-actions">
            @if (IsEditing(entry))
            {
                <RadzenButton Icon="check" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Success"
                              title="@AppText.T("web.toolbox.subtitleTranslation.editSave")" aria-label="@AppText.T("web.toolbox.subtitleTranslation.editSave")" Click="@SaveEditing" />
                <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                              title="@AppText.T("web.common.cancel")" aria-label="@AppText.T("web.common.cancel")" Click="@CancelEditing" />
            }
            else
            {
                <RadzenButton Icon="edit" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@(_editing != null || Orchestrator.IsBusy || Orchestrator.Job != null)"
                              title="@AppText.T("web.toolbox.subtitleTranslation.editEntry")" aria-label="@(AppText.T("web.toolbox.subtitleTranslation.editEntry") + " " + name)"
                              Click="@(() => StartEditing(entry, false))" />
                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Disabled="@(_editing != null || Orchestrator.IsBusy || Orchestrator.Job != null)"
                              title="@AppText.T("web.common.delete")" aria-label="@(AppText.T("web.common.delete") + " " + name)"
                              Click="@(() => DeleteEntry(entry))" />
            }
        </span>;

    /// <summary>
    /// Rilegge i progetti salvati e i loro job; un job illeggibile lascia il progetto nell'elenco senza job, e l'apertura ne dà il motivo
    /// </summary>
    private void ReloadProjects()
    {
        _projects = Orchestrator.ListProjects();
        _jobs = new Dictionary<string, TranslationJob>(StringComparer.Ordinal);
        _jobsToResume = new HashSet<string>(StringComparer.Ordinal);
        foreach (TranslationProject project in _projects)
        {
            try
            {
                TranslationJob job = Orchestrator.LoadJob(project);
                if (job == null)
                    continue;

                _jobs[project.Id] = job;
                if (job.Status == TranslationJobStatus.Paused && (job.Phase == TranslationJobPhase.Applying || job.Phase == TranslationJobPhase.Review ||
                    (job.Phase == TranslationJobPhase.Translation && Orchestrator.HasFilesToTranslate(job))))
                    _jobsToResume.Add(project.Id);
            }
            catch (Exception ex)
            {
                if (!(ex is InvalidDataException || ex is IOException || ex is UnauthorizedAccessException))
                    throw;
            }
        }
    }

    /// <summary>
    /// Passo da mostrare per il progetto aperto: col job il passo della sua fase, Esporta se già raggiunto dalla revisione
    /// dell'utente; Glossario con l'analisi partita, altrimenti Progetto
    /// </summary>
    /// <returns>Indice del passo</returns>
    private int ProjectStep()
    {
        TranslationProject project = Orchestrator.Project;
        if (project == null)
            return 0;
        TranslationJob job = Orchestrator.Job;
        if (job != null && (job.Phase == TranslationJobPhase.NewTerms || job.Phase == TranslationJobPhase.Applying))
            return STEP_NEW_TERMS;
        if (job != null && job.Phase == TranslationJobPhase.Review)
            return STEP_REVIEW;
        if (job != null && job.Phase == TranslationJobPhase.UserReview)
            return project.ReachedStep >= TranslationProjectStep.Export ? STEP_EXPORT : STEP_REVIEW;
        if (job != null)
            return STEP_TRANSLATION;

        return Orchestrator.IsBusy || project.ReachedStep >= TranslationProjectStep.Glossary ? STEP_GLOSSARY : 0;
    }

    /// <summary>
    /// Stato mostrato di un job: in traduzione, nei termini, in revisione AI, in pausa, interrotto, tradotto, da rivedere
    /// </summary>
    /// <param name="job">Job</param>
    /// <returns>Testo del badge</returns>
    private static string JobStateText(TranslationJob job)
    {
        if (job.Status == TranslationJobStatus.Running)
            return AppText.T(job.Phase == TranslationJobPhase.Applying ? "web.toolbox.subtitleTranslation.jobState.applying"
                : job.Phase == TranslationJobPhase.Review ? "web.toolbox.subtitleTranslation.jobState.reviewing" : "web.toolbox.subtitleTranslation.jobState.running");
        if (job.Status == TranslationJobStatus.Paused)
            return AppText.T(job.Pause != null && (job.Pause.Reason == TranslationStopReason.Stop || job.Pause.Reason == TranslationStopReason.Crash)
                ? "web.toolbox.subtitleTranslation.jobState.interrupted" : "web.toolbox.subtitleTranslation.jobState.paused");
        if (job.Phase == TranslationJobPhase.NewTerms || job.Phase == TranslationJobPhase.Review)
            return AppText.T("web.toolbox.subtitleTranslation.jobState.translated");
        if (job.Phase == TranslationJobPhase.UserReview)
            return AppText.T("web.toolbox.subtitleTranslation.jobState.userReview");

        return AppText.T("web.toolbox.subtitleTranslation.steps.translation");
    }

    /// <summary>
    /// True se la battuta è da controllare: da rivedere, col glossario non rispettato, ritentata, corretta dall'AI o modificata a mano
    /// </summary>
    /// <param name="row">Riga della revisione</param>
    /// <returns>True per il filtro «Da controllare»</returns>
    private static bool NeedsCheck(TranslationReviewRow row)
    {
        return row.ToReview || row.Signals.Contains(TranslationCueSignal.Glossary) || row.Signals.Contains(TranslationCueSignal.Retried) ||
            row.Signals.Contains(TranslationCueSignal.CorrectedByAi) || row.Signals.Contains(TranslationCueSignal.EditedByUser);
    }

    /// <summary>
    /// Testo di una battuta con aperture e chiusure dei segni evidenziate
    /// </summary>
    /// <param name="text">Testo con i segni</param>
    /// <returns>Frammento della cella</returns>
    private static RenderFragment MarkedText(string text) => builder =>
    {
        int position = 0;
        int sequence = 0;
        foreach (Match match in s_marks.Matches(text))
        {
            builder.AddContent(sequence++, text.Substring(position, match.Index - position));
            builder.OpenElement(sequence++, "mark");
            builder.AddAttribute(sequence++, "class", "rf-translation-mark");
            builder.AddContent(sequence++, match.Value.TrimEnd());
            builder.CloseElement();
            if (match.Value.EndsWith(" ", StringComparison.Ordinal))
                builder.AddContent(sequence++, " ");
            position = match.Index + match.Length;
        }
        builder.AddContent(sequence, text.Substring(position));
    };

    /// <summary>
    /// Tempo di una battuta come ore, minuti, secondi e millesimi
    /// </summary>
    /// <param name="ms">Millisecondi</param>
    /// <returns>Testo hh:mm:ss.mmm</returns>
    private static string FormatTime(long ms)
    {
        return TimeSpan.FromMilliseconds(ms).ToString(@"hh\:mm\:ss\.fff", CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Token di una colonna, «non disponibile» se il registro non li ha
    /// </summary>
    /// <param name="tokens">Token</param>
    /// <returns>Testo</returns>
    private static string FormatTokens(long? tokens)
    {
        return tokens.HasValue ? tokens.Value.ToString("N0", CultureInfo.CurrentCulture) : AppText.T("web.toolbox.subtitleTranslation.unavailable");
    }

    /// <summary>
    /// Nome di una lingua per l'elenco, il codice se la lingua non ha nome
    /// </summary>
    /// <param name="code">Codice ISO 639-2</param>
    /// <returns>Nome da mostrare</returns>
    private static string LanguageName(string code)
    {
        if (string.IsNullOrEmpty(code))
            return "—";

        string key = "web.remux.language." + code;
        string name = AppText.T(key);
        return name == "[" + key + "]" ? code : name;
    }

    /// <summary>
    /// Battute del file in revisione, il primo del job se non scelto; si rileggono al cambio di stato della card
    /// </summary>
    private List<TranslationReviewRow> ReviewRows
    {
        get
        {
            TranslationJob job = Orchestrator.Job;
            if (_reviewFileId == null || job == null || !job.FileIds.Contains(_reviewFileId))
            {
                _reviewFileId = job != null && job.FileIds.Count > 0 ? job.FileIds[0] : null;
                _reviewRows = null;
            }
            if (_reviewRows == null)
            {
                _reviewRows = Orchestrator.GetReviewRows(_reviewFileId);
                _reviewView = null;
            }
            return _reviewRows;
        }
    }

    /// <summary>
    /// Battute del file in revisione col filtro scelto
    /// </summary>
    private List<TranslationReviewRow> ReviewView
    {
        get
        {
            if (_reviewView == null)
            {
                List<TranslationReviewRow> rows = ReviewRows;
                _reviewView = _reviewFilter == FILTER_TO_CHECK ? rows.FindAll(r => NeedsCheck(r))
                    : _reviewFilter == FILTER_EDITED ? rows.FindAll(r => r.Signals.Contains(TranslationCueSignal.EditedByUser)) : rows;
            }
            return _reviewView;
        }
    }

    /// <summary>
    /// Progetto scelto nell'elenco, null se nessuno
    /// </summary>
    private TranslationProject SelectedProject
    {
        get { return _projects.Find(p => p.Id == _selectedId); }
    }
}
