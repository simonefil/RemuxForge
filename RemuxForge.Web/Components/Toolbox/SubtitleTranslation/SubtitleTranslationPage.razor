    /// <summary>
    /// Voci di una scheda con, in fondo, quella aggiunta a mano non ancora nel glossario
    /// </summary>
    /// <typeparam name="T">Tipo della voce</typeparam>
    /// <param name="entries">Voci del glossario</param>
    /// <returns>Righe della griglia</returns>
    private List<T> WithPending<T>(List<T> entries)
    {
        List<T> rows = new List<T>(entries);
        if (this._pending is T pending)
            rows.Add(pending);
        return rows;
    }

    /// <summary>
    /// Applica la modifica di una cella a una voce: i campi chiave non vuoti e non già presenti in un'altra voce. La voce
    /// aggiunta a mano entra nel glossario quando la modifica la completa; fino ad allora tiene i valori scritti
    /// </summary>
    /// <typeparam name="T">Tipo della voce</typeparam>
    /// <param name="entry">Voce della riga</param>
    /// <param name="change">Modifica della cella</param>
    private void ChangeEntry<T>(T entry, Action<T> change) where T : class
    {
        TranslationProject project = this.Orchestrator.Project;
        Glossary glossary = project.Glossary;
        GlossaryBuilder builder = new GlossaryBuilder(project.SourceLanguage, project.TargetLanguage);
        bool adding = ReferenceEquals(entry, this._pending);
        bool incomplete = false;
        string error = "";
        Action<Glossary> add = null;

        // La modifica si prova su una copia dei campi chiave: la voce cambia solo se resta valida
        object candidate = entry switch
        {
            GlossaryTerm t => new GlossaryTerm { Source = t.Source, Target = t.Target },
            GlossaryCharacter c => new GlossaryCharacter { Name = c.Name },
            GlossaryAddressing a => new GlossaryAddressing { Speaker = a.Speaker, Addressee = a.Addressee },
            _ => null
        };
        change((T)candidate);

        if (candidate is GlossaryTerm term)
        {
            incomplete = string.IsNullOrWhiteSpace(term.Source) || string.IsNullOrWhiteSpace(term.Target);
            if (incomplete)
            {
                error = AppText.T("web.toolbox.subtitleTranslation.editTermEmpty");
            }
            else if (glossary.Terms.Exists(t => !ReferenceEquals(t, entry) && builder.TermKey(t.Source) == builder.TermKey(term.Source)))
            {
                error = AppText.F("web.toolbox.subtitleTranslation.editDuplicate", term.Source);
            }
            add = g => g.Terms.Add(entry as GlossaryTerm);
        }
        else if (candidate is GlossaryCharacter character)
        {
            incomplete = string.IsNullOrWhiteSpace(character.Name);
            if (incomplete)
            {
                error = AppText.T("web.toolbox.subtitleTranslation.editCharacterEmpty");
            }
            else if (glossary.Characters.Exists(c => !ReferenceEquals(c, entry) && GlossaryBuilder.CharacterKey(c.Name) == GlossaryBuilder.CharacterKey(character.Name)))
            {
                error = AppText.F("web.toolbox.subtitleTranslation.editDuplicate", character.Name);
            }
            add = g => g.Characters.Add(entry as GlossaryCharacter);
        }
        else if (candidate is GlossaryAddressing pair)
        {
            incomplete = string.IsNullOrWhiteSpace(pair.Speaker) || string.IsNullOrWhiteSpace(pair.Addressee);
            if (incomplete)
            {
                error = AppText.T("web.toolbox.subtitleTranslation.editAddressingEmpty");
            }
            else if (glossary.Addressing.Exists(a => !ReferenceEquals(a, entry) && GlossaryBuilder.AddressingKey(a.Speaker, a.Addressee) == GlossaryBuilder.AddressingKey(pair.Speaker, pair.Addressee)))
            {
                error = AppText.F("web.toolbox.subtitleTranslation.editDuplicate", pair.Speaker + " → " + pair.Addressee);
            }
            add = g => g.Addressing.Add(entry as GlossaryAddressing);
        }

        // La voce aggiunta a mano non è nel glossario: tiene i valori anche se incompleta
        if (adding)
            change(entry);

        if (!string.IsNullOrEmpty(error))
        {
            if (!adding || !incomplete)
                this.Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyEditInvalid"), error);
            return;
        }

        this.Orchestrator.ChangeGlossary(adding ? add : g => change(entry));
        if (adding)
            this._pending = null;
    }

    /// <summary>
    /// Toglie una voce dal glossario, o lascia quella aggiunta a mano non ancora nel glossario
    /// </summary>
    /// <param name="entry">Voce della riga</param>
    private void DeleteEntry(object entry)
    {
        if (ReferenceEquals(entry, this._pending))
        {
            this._pending = null;
            return;
        }

        this.Orchestrator.ChangeGlossary(g =>
        {
            if (entry is GlossaryTerm term)
            {
                g.Terms.Remove(term);
            }
            else if (entry is GlossaryCharacter character)
            {
                g.Characters.Remove(character);
            }
            else if (entry is GlossaryAddressing pair)
            {
                g.Addressing.Remove(pair);
            }
        });
    }

    /// <summary>
    /// Cella di testo di una voce del glossario: campo che salva al cambio, o testo se la colonna non si modifica sulla riga
    /// </summary>
    /// <typeparam name="T">Tipo della voce</typeparam>
    /// <param name="entry">Voce della riga</param>
    /// <param name="value">Valore della cella</param>
    /// <param name="editable">True se la colonna si modifica sulla riga</param>
    /// <param name="label">Titolo della colonna per l'etichetta accessibile</param>
    /// <param name="assign">Scrittura del valore nella voce</param>
    /// <returns>Frammento della cella</returns>
    private RenderFragment TextCell<T>(T entry, string value, bool editable, string label, Action<T, string> assign) where T : class =>
        @<text>
            @if (editable)
            {
                <RadzenTextBox class="rf-translation-cell-input" Value="@value" Disabled="@(Orchestrator.IsBusy || Orchestrator.Job != null)" aria-label="@label"
                               Change="@((string text) => ChangeEntry(entry, e => assign(e, (text ?? "").Trim())))" />
            }
            else
            {
                <span class="rf-translation-cell">@value</span>
            }
        </text>;

    /// <summary>
    /// Cella con il pulsante che toglie una voce del glossario
    /// </summary>
    /// <param name="entry">Voce della riga</param>
    /// <param name="name">Nome della voce per l'etichetta accessibile</param>
    /// <returns>Frammento della cella</returns>
    private RenderFragment DeleteCell(object entry, string name) =>
        @<RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Disabled="@(Orchestrator.IsBusy || Orchestrator.Job != null)"
                       title="@AppText.T("web.common.delete")" aria-label="@(AppText.T("web.common.delete") + " " + name)" Click="@(() => DeleteEntry(entry))" />;

    /// <summary>
    /// Rilegge i progetti salvati e i loro job; un job illeggibile lascia il progetto nell'elenco senza job, e l'apertura ne dà il motivo
    /// </summary>
    private void ReloadProjects()
    {
        this._projects = this.Orchestrator.ListProjects();
        this._jobs = new Dictionary<string, TranslationJob>(StringComparer.Ordinal);
        this._jobsToResume = new HashSet<string>(StringComparer.Ordinal);
        foreach (TranslationProject project in this._projects)
        {
            try
            {
                TranslationJob job = this.Orchestrator.LoadJob(project);
                if (job == null)
                    continue;

                this._jobs[project.Id] = job;
                if (job.Status == TranslationJobStatus.Paused && (job.Phase == TranslationJobPhase.Applying || job.Phase == TranslationJobPhase.Review ||
                    (job.Phase == TranslationJobPhase.Translation && this.Orchestrator.HasFilesToTranslate(job))))
                    this._jobsToResume.Add(project.Id);
            }
            catch (Exception ex)
            {
                if (!(ex is InvalidDataException || ex is IOException || ex is UnauthorizedAccessException))
                    throw;
            }
        }
    }

    /// <summary>
    /// Passo da mostrare per il progetto aperto: col job Traduzione se un file è bloccato, poi il passo della sua fase, Esporta
    /// se già raggiunto dalla revisione dell'utente; Glossario con l'analisi partita, altrimenti Progetto
    /// </summary>
    /// <returns>Indice del passo</returns>
    private int ProjectStep()
    {
        TranslationProject project = this.Orchestrator.Project;
        if (project == null)
            return 0;

        TranslationJob job = this.Orchestrator.Job;
        if (job != null && this.Orchestrator.HasBlockedFiles)
            return STEP_TRANSLATION;
        if (job != null && (job.Phase == TranslationJobPhase.NewTerms || job.Phase == TranslationJobPhase.Applying))
            return STEP_NEW_TERMS;
        if (job != null && job.Phase == TranslationJobPhase.Review)
            return STEP_REVIEW;
        if (job != null && job.Phase == TranslationJobPhase.UserReview)
            return project.ReachedStep >= TranslationProjectStep.Export ? STEP_EXPORT : STEP_REVIEW;
        if (job != null)
            return STEP_TRANSLATION;

        return this.Orchestrator.IsBusy || project.ReachedStep >= TranslationProjectStep.Glossary ? STEP_GLOSSARY : 0;
    }

    /// <summary>
    /// Stato mostrato di un job: in traduzione, nei termini, in revisione AI, in pausa, interrotto, tradotto, da rivedere
    /// </summary>
    /// <param name="job">Job</param>
    /// <returns>Testo del badge</returns>
    private static string JobStateText(TranslationJob job)
    {
        if (job.Status == TranslationJobStatus.Running)
            return AppText.T(job.Phase == TranslationJobPhase.Applying ? "web.toolbox.subtitleTranslation.jobState.applying"
                : job.Phase == TranslationJobPhase.Review ? "web.toolbox.subtitleTranslation.jobState.reviewing" : "web.toolbox.subtitleTranslation.jobState.running");
        if (job.Status == TranslationJobStatus.Paused)
            return AppText.T(job.Pause != null && (job.Pause.Reason == TranslationStopReason.Stop || job.Pause.Reason == TranslationStopReason.Crash)
                ? "web.toolbox.subtitleTranslation.jobState.interrupted" : "web.toolbox.subtitleTranslation.jobState.paused");
        if (job.Phase == TranslationJobPhase.NewTerms || job.Phase == TranslationJobPhase.Review)
            return AppText.T("web.toolbox.subtitleTranslation.jobState.translated");
        if (job.Phase == TranslationJobPhase.UserReview)
            return AppText.T("web.toolbox.subtitleTranslation.jobState.userReview");

        return AppText.T("web.toolbox.subtitleTranslation.steps.translation");
    }

    /// <summary>
    /// True se la battuta è da controllare: da rivedere, col glossario non rispettato, ritentata, con un termine nuovo, riscritta coi
    /// termini nuovi, uguale al sorgente o a un'altra battuta, corretta dall'AI o modificata a mano
    /// </summary>
    /// <param name="row">Riga della revisione</param>
    /// <returns>True per il filtro «Da controllare»</returns>
    private static bool NeedsCheck(TranslationReviewRow row)
    {
        return row.ToReview || row.Signals.Contains(TranslationCueSignal.Glossary) || row.Signals.Contains(TranslationCueSignal.Retried) ||
            row.Signals.Contains(TranslationCueSignal.NewTerm) || row.Signals.Contains(TranslationCueSignal.RewrittenByTerms) ||
            row.Signals.Contains(TranslationCueSignal.Echo) || row.Signals.Contains(TranslationCueSignal.Slip) ||
            row.Signals.Contains(TranslationCueSignal.CorrectedByAi) || row.Signals.Contains(TranslationCueSignal.EditedByUser);
    }

    /// <summary>
    /// Testo di una battuta con aperture e chiusure dei segni evidenziate
    /// </summary>
    /// <param name="text">Testo con i segni</param>
    /// <returns>Frammento della cella</returns>
    private static RenderFragment MarkedText(string text) => builder =>
    {
        int position = 0;
        int sequence = 0;
        foreach (Match match in s_marks.Matches(text))
        {
            builder.AddContent(sequence++, text.Substring(position, match.Index - position));
            builder.OpenElement(sequence++, "mark");
            builder.AddAttribute(sequence++, "class", "rf-translation-mark");
            builder.AddContent(sequence++, match.Value.TrimEnd());
            builder.CloseElement();
            if (match.Value.EndsWith(" ", StringComparison.Ordinal))
                builder.AddContent(sequence++, " ");
            position = match.Index + match.Length;
        }
        builder.AddContent(sequence, text.Substring(position));
    };

    /// <summary>
    /// Tempo di una battuta come ore, minuti, secondi e millesimi
    /// </summary>
    /// <param name="ms">Millisecondi</param>
    /// <returns>Testo hh:mm:ss.mmm</returns>
    private static string FormatTime(long ms)
    {
        return TimeSpan.FromMilliseconds(ms).ToString(@"hh\:mm\:ss\.fff", CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Token di una colonna, «non disponibile» se il registro non li ha
    /// </summary>
    /// <param name="tokens">Token</param>
    /// <returns>Testo</returns>
    private static string FormatTokens(long? tokens)
    {
        return tokens.HasValue ? tokens.Value.ToString("N0", CultureInfo.CurrentCulture) : AppText.T("web.toolbox.subtitleTranslation.unavailable");
    }

    /// <summary>
    /// Nome di una lingua per l'elenco, il codice se la lingua non ha nome
    /// </summary>
    /// <param name="code">Codice ISO 639-2</param>
    /// <returns>Nome da mostrare</returns>
    private static string LanguageName(string code)
    {
        if (string.IsNullOrEmpty(code))
            return "—";

        string key = "web.remux.language." + code;
        string name = AppText.T(key);
        return name == "[" + key + "]" ? code : name;
    }

    #endregion

    #region Proprietà

    /// <summary>
    /// Battute del file in revisione, il primo del job se non scelto; si rileggono al cambio di stato della card
    /// </summary>
    private List<TranslationReviewRow> ReviewRows
    {
        get
        {
            TranslationJob job = this.Orchestrator.Job;
            if (this._reviewFileId == null || job == null || !job.FileIds.Contains(this._reviewFileId))
            {
                this._reviewFileId = job != null && job.FileIds.Count > 0 ? job.FileIds[0] : null;
                this._reviewRows = null;
            }

            if (this._reviewRows == null)
            {
                this._reviewRows = this.Orchestrator.GetReviewRows(this._reviewFileId);
                this._reviewView = null;
            }

            return this._reviewRows;
        }
    }

    /// <summary>
    /// Battute del file in revisione col filtro scelto
    /// </summary>
    private List<TranslationReviewRow> ReviewView
    {
        get
        {
            if (this._reviewView == null)
            {
                List<TranslationReviewRow> rows = this.ReviewRows;
                this._reviewView = this._reviewFilter == FILTER_TO_CHECK ? rows.FindAll(r => NeedsCheck(r))
                    : this._reviewFilter == FILTER_EDITED ? rows.FindAll(r => r.Signals.Contains(TranslationCueSignal.EditedByUser)) : rows;
            }

            return this._reviewView;
        }
    }

    /// <summary>
    /// Progetto scelto nell'elenco, null se nessuno
    /// </summary>
    private TranslationProject SelectedProject
    {
        get { return this._projects.Find(p => p.Id == this._selectedId); }
    }

    #endregion
}
