    /// <summary>
    /// Avvia o riprende l'analisi; senza il modello dell'analisi non parte, e la prima volta chiede il consenso dedicato alla traduzione
    /// </summary>
    private async Task AnalyzeAsync()
    {
        if (string.IsNullOrEmpty(Orchestrator.Project.Models.Analysis))
        {
            Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyModelMissing"),
                AppText.F("web.toolbox.subtitleTranslation.modelMissing", AppText.T("web.toolbox.subtitleTranslation.models.phase.analysis")));
            return;
        }

        if (!Orchestrator.ConsentAccepted)
        {
            bool accepted = await AppDialogs.ConfirmAsync(DialogService, AppText.T("web.toolbox.subtitleTranslation.consentTitle"), AppText.T("web.toolbox.subtitleTranslation.consentText"),
                AppText.T("web.toolbox.subtitleTranslation.consentAccept"), AppText.T("web.common.cancel"));
            if (!accepted)
                return;

            Orchestrator.AcceptConsent();
        }

        CancelEditing();
        _step = STEP_GLOSSARY;
        Orchestrator.Start();
    }

    /// <summary>
    /// Avvia o riprende il giro nella fase del job; senza il modello della fase non parte, e senza il consenso dedicato lo chiede
    /// </summary>
    private async Task StartJobAsync()
    {
        TranslationJob job = Orchestrator.Job;
        TranslationJobPhase phase = job != null ? job.Phase : TranslationJobPhase.Translation;
        if (!await CheckModelAsync(phase))
            return;

        _step = phase == TranslationJobPhase.Applying ? STEP_NEW_TERMS : phase == TranslationJobPhase.Review ? STEP_REVIEW : STEP_TRANSLATION;
        Orchestrator.StartJob();
    }

    /// <summary>
    /// Conferma i termini nuovi e prosegue il giro: applicazione coi termini aggiunti, altrimenti la revisione AI
    /// </summary>
    private async Task ConfirmNewTermsAsync()
    {
        TranslationJob job = Orchestrator.Job;
        bool adding = job.NewTerms.Exists(t => t.Decision == NewTermDecisionKind.Add);
        if (!await CheckModelAsync(adding ? TranslationJobPhase.Applying : TranslationJobPhase.Review))
            return;

        _step = adding ? STEP_NEW_TERMS : STEP_REVIEW;
        Orchestrator.ConfirmNewTerms();
    }

    /// <summary>
    /// Controlla il modello della fase che parte e il consenso dedicato, chiedendolo se manca
    /// </summary>
    /// <param name="phase">Fase che parte: traduzione, applicazione dei termini o revisione AI</param>
    /// <returns>True se la fase può partire</returns>
    private async Task<bool> CheckModelAsync(TranslationJobPhase phase)
    {
        TranslationJob job = Orchestrator.Job;
        TranslationPhaseModels models = job != null ? job.Models : Orchestrator.Project.Models;
        string model = phase == TranslationJobPhase.Applying ? models.NewTerms : phase == TranslationJobPhase.Review ? models.ResolveReview() : models.Translation;
        if (string.IsNullOrEmpty(model))
        {
            string name = phase == TranslationJobPhase.Applying ? "newTerms" : phase == TranslationJobPhase.Review ? "review" : "translation";
            Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyModelMissing"),
                AppText.F("web.toolbox.subtitleTranslation.modelMissing", AppText.T("web.toolbox.subtitleTranslation.models.phase." + name)));
            return false;
        }

        if (!Orchestrator.ConsentAccepted)
        {
            bool accepted = await AppDialogs.ConfirmAsync(DialogService, AppText.T("web.toolbox.subtitleTranslation.consentTitle"), AppText.T("web.toolbox.subtitleTranslation.consentText"),
                AppText.T("web.toolbox.subtitleTranslation.consentAcceptTranslation"), AppText.T("web.common.cancel"));
            if (!accepted)
                return false;

            Orchestrator.AcceptConsent();
        }

        return true;
    }

    /// <summary>
    /// Toast dell'esito di una fase del giro e passo della fase in cui il giro aspetta: traduzione conclusa o con file bloccati,
    /// revisione AI conclusa o senza blocchi da rivedere, fermata, pausa per il limite d'uso o errore
    /// </summary>
    /// <param name="result">Fase conclusa o fermata</param>
    private void HandlePhaseFinished(TranslationPhaseResult result)
    {
        InvokeAsync(async () =>
        {
            TranslationJob job = result.Job;
            TranslationStop stop = result.Stop;
            string name = result.Phase == TranslationJobPhase.Applying ? "Terms" : result.Phase == TranslationJobPhase.Review ? "Review" : "Translation";
            if (stop != null && stop.Reason == TranslationStopReason.Stop)
                Notify(NotificationSeverity.Warning, AppText.T("web.toolbox.subtitleTranslation.notify" + name + "Stopped"), AppText.T("web.toolbox.subtitleTranslation.notifyJobResumable"));
            else if (stop != null && stop.Reason == TranslationStopReason.UsageLimit)
                Notify(NotificationSeverity.Warning, AppText.T("web.toolbox.subtitleTranslation.notify" + name + "Paused"), stop.Message);
            else if (stop != null)
                Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notify" + name + "Failed"), stop.Message);
            else if (result.Phase == TranslationJobPhase.Translation && job.Phase == TranslationJobPhase.Translation)
                Notify(NotificationSeverity.Warning, AppText.T("web.toolbox.subtitleTranslation.notifyBlocked"), AppText.T("web.toolbox.subtitleTranslation.notifyBlockedDetail"));
            else if (result.Phase == TranslationJobPhase.Translation)
                Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifyTranslated"), AppText.Count("web.toolbox.subtitleTranslation.filesCount", job.FileIds.Count));
            else if (result.Phase == TranslationJobPhase.Review && result.ReviewBlocks > 0)
                Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifyReviewed"), AppText.Count("web.toolbox.subtitleTranslation.correctedCount", result.Corrected));
            else if (result.Phase == TranslationJobPhase.Review)
                Notify(NotificationSeverity.Info, AppText.T("web.toolbox.subtitleTranslation.notifyReviewed"), AppText.T("web.toolbox.subtitleTranslation.notifyNothingToReview"));

            if (stop == null)
                _step = ProjectStep();
            await OnStateChanged.InvokeAsync();
        });
    }

