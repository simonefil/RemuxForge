@using RemuxForge.Core.Toolbox.SubtitleTranslation
@using RemuxForge.Web.Services.Toolbox
@using System.Globalization
@using System.IO
@using System.Text.RegularExpressions
@inherits ToolboxPageBase
@implements IDisposable

@{
    TranslationProject project = Orchestrator.Project;
    bool busy = Orchestrator.IsBusy;
}
<div class="rf-panel rf-tool-page rf-translation">
    @if (project == null)
    {
        @* Elenco dei progetti salvati *@
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H2" class="rf-translation-heading">@AppText.T("web.toolbox.subtitleTranslation.projectsTitle")</RadzenText>
        @if (_projects.Count == 0)
        {
            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rf-tool-empty">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">@AppText.T("web.toolbox.subtitleTranslation.projectsEmpty")</RadzenText>
            </RadzenStack>
        }
        else
        {
            <RadzenDataGrid TItem="TranslationProject"
                            Data="@_projects"
                            class="rf-data-grid rf-tool-grid"
                            AllowAlternatingRows="false"
                            AllowColumnResize="false"
                            AllowPaging="false"
                            AllowSorting="false"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal"
                            SelectionMode="DataGridSelectionMode.Single"
                            Value="@(SelectedProject != null ? new List<TranslationProject> { SelectedProject } : new List<TranslationProject>())"
                            RowSelect="@((TranslationProject selected) => { _selectedId = selected.Id; OnStateChanged.InvokeAsync(); })"
                            RowDoubleClick="@((DataGridRowMouseEventArgs<TranslationProject> args) => OpenProject(args.Data))">
                <Columns>
                    <RadzenDataGridColumn TItem="TranslationProject" Title="@AppText.T("web.toolbox.subtitleTranslation.project")" Width="30%">
                        <Template Context="item"><CellText Text="@SubtitleTranslationOrchestrator.DisplayName(item)" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TranslationProject" Title="@AppText.T("web.toolbox.subtitleTranslation.languages")" Width="22%">
                        <Template Context="item"><CellText Text="@(LanguageName(item.SourceLanguage) + " → " + LanguageName(item.TargetLanguage))" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TranslationProject" Title="@AppText.T("web.toolbox.subtitleTranslation.episodes")" Width="8%" TextAlign="TextAlign.Right">
                        <Template Context="item"><CellText Text="@item.Files.Count.ToString(CultureInfo.CurrentCulture)" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TranslationProject" Title="@AppText.T("web.toolbox.subtitleTranslation.step")" Width="22%">
                        <Template Context="item">
                            @if (_jobs.TryGetValue(item.Id, out TranslationJob itemJob))
                            {
                                <RadzenBadge IsPill="true" BadgeStyle="@(itemJob.Status == TranslationJobStatus.Paused ? BadgeStyle.Warning : itemJob.Phase == TranslationJobPhase.NewTerms || itemJob.Phase == TranslationJobPhase.UserReview ? BadgeStyle.Success : BadgeStyle.Info)" Text="@JobStateText(itemJob)" />
                            }
                            else if (item.Analysis != null && item.Analysis.Status != TranslationAnalysisStatus.Completed)
                            {
                                <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Warning" Text="@AppText.T("web.toolbox.subtitleTranslation.stepAnalysisStopped")" />
                            }
                            else if (item.Glossary != null && item.Glossary.Status == GlossaryStatus.Approved)
                            {
                                <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Success" Text="@AppText.T("web.toolbox.subtitleTranslation.stepGlossaryApproved")" />
                            }
                            else if (item.Glossary != null)
                            {
                                <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Info" Text="@AppText.T("web.toolbox.subtitleTranslation.steps.glossary")" />
                            }
                            else
                            {
                                <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Base" Text="@AppText.T("web.toolbox.subtitleTranslation.steps.project")" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TranslationProject" Title="@AppText.T("web.toolbox.subtitleTranslation.updatedAt")" Width="18%">
                        <Template Context="item"><CellText Text="@item.UpdatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)" /></Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
    else
    {
        bool languagesLocked = busy || project.Analysis != null || project.Glossary != null;
        bool filesLocked = busy || Orchestrator.FilesLocked;
        List<TranslationFileRecord> files = Orchestrator.GetRecords();
        TranslationAnalysisEstimate estimate = _step == 0 ? Orchestrator.EstimateAnalysis() : null;
        Dictionary<string, string> fileNames = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (TranslationProjectFile projectFile in project.Files)
            fileNames[projectFile.Id] = System.IO.Path.GetFileName(projectFile.Path);

        <RadzenSteps class="rf-translation-steps" ShowStepsButtons="false" AllowStepSelect="@(!busy)" SelectedIndex="@_step" SelectedIndexChanged="@((int index) => { _step = index; _exported = null; CancelCueEditing(); OnStateChanged.InvokeAsync(); })">
            <Steps>
                <RadzenStepsItem Text="@AppText.T("web.toolbox.subtitleTranslation.steps.project")" />
                <RadzenStepsItem Text="@AppText.T("web.toolbox.subtitleTranslation.steps.glossary")" Disabled="@(project.ReachedStep < TranslationProjectStep.Glossary)" />
                <RadzenStepsItem Text="@AppText.T("web.toolbox.subtitleTranslation.steps.translation")" Disabled="@(project.ReachedStep < TranslationProjectStep.Translation)" />
                <RadzenStepsItem Text="@AppText.T("web.toolbox.subtitleTranslation.steps.newTerms")" Disabled="@(project.ReachedStep < TranslationProjectStep.NewTerms)" />
                <RadzenStepsItem Text="@AppText.T("web.toolbox.subtitleTranslation.steps.review")" Disabled="@(project.ReachedStep < TranslationProjectStep.Review)" />
                <RadzenStepsItem Text="@AppText.T("web.toolbox.subtitleTranslation.steps.export")" Disabled="@(project.ReachedStep < TranslationProjectStep.Export)" />
            </Steps>
        </RadzenSteps>

        @if (_step == 0)
        {
            <div class="rf-tool-options">
                <div class="rf-tool-options-row">
                    <div class="rf-tool-field">
                        <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.subtitleTranslation.name")" Component="TranslationName" />
                        <RadzenTextBox Name="TranslationName" class="rf-translation-name" Disabled="@busy" Value="@project.Name"
                                       Change="@((string value) => Orchestrator.SetProjectData(value, project.SourceLanguage, project.TargetLanguage, project.Context))" />
                    </div>
                    <div class="rf-tool-field">
                        <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.source")</span>
                        <div class="rf-translation-language">
                            <LanguageChipsComponent Multiple="false" Value="@project.SourceLanguage" Label="@AppText.T("web.toolbox.subtitleTranslation.source")" Disabled="@languagesLocked"
                                                    Placeholder="@AppText.T("web.toolbox.subtitleTranslation.sourcePlaceholder")"
                                                    ValueChanged="@((string value) => Orchestrator.SetProjectData(project.Name, value, project.TargetLanguage, project.Context))" />
                        </div>
                    </div>
                    <div class="rf-tool-field">
                        <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.target")</span>
                        <div class="rf-translation-language">
                            <LanguageChipsComponent Multiple="false" Value="@project.TargetLanguage" Label="@AppText.T("web.toolbox.subtitleTranslation.target")" Disabled="@languagesLocked"
                                                    Placeholder="@AppText.T("web.toolbox.subtitleTranslation.targetPlaceholder")"
                                                    ValueChanged="@((string value) => Orchestrator.SetProjectData(project.Name, project.SourceLanguage, value, project.Context))" />
                        </div>
                    </div>
                </div>
                <div class="rf-tool-options-row">
                    <div class="rf-tool-field rf-translation-context">
                        <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.subtitleTranslation.context")" Component="TranslationContext" />
                        <RadzenTextArea Name="TranslationContext" Rows="2" Disabled="@busy" Value="@project.Context"
                                        Change="@((string value) => Orchestrator.SetProjectData(project.Name, project.SourceLanguage, project.TargetLanguage, value))" />
                    </div>
                </div>
                <div class="rf-tool-options-row">
                    <div class="rf-tool-field">
                        <span class="rf-tool-label" id="translation-review-label">@AppText.T("web.toolbox.subtitleTranslation.reviewMode")</span>
                        <RadzenRadioButtonList TValue="TranslationReviewMode" Value="@project.Options.ReviewMode" Disabled="@(busy || Orchestrator.Job != null)" Orientation="Orientation.Horizontal"
                                               aria-labelledby="translation-review-label" Change="@((TranslationReviewMode value) => Orchestrator.SetReviewMode(value))">
                            <Items>
                                <RadzenRadioButtonListItem Text="@AppText.T("web.toolbox.subtitleTranslation.reviewTargeted")" Value="@TranslationReviewMode.Targeted" />
                                <RadzenRadioButtonListItem Text="@AppText.T("web.toolbox.subtitleTranslation.reviewFull")" Value="@TranslationReviewMode.Full" />
                            </Items>
                        </RadzenRadioButtonList>
                    </div>
                </div>
                <div class="rf-tool-options-row rf-translation-access">
                    <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.access")</span>
                    <span title="@Orchestrator.CredentialsPath">@AppText.T(_accessMode == AiConnectionMode.ChatGptAccount ? "web.toolbox.subtitleTranslation.accessAccount" : _accessMode == AiConnectionMode.ApiKey ? "web.toolbox.subtitleTranslation.accessApiKey" : "web.toolbox.subtitleTranslation.accessNone")</span>
                    <span class="rf-translation-capabilities">
                        @foreach (KeyValuePair<string, bool> capability in _capabilities)
                        {
                            <RadzenBadge IsPill="true" BadgeStyle="@(capability.Value ? BadgeStyle.Success : BadgeStyle.Base)"
                                         Text="@AppText.T("web.toolbox.subtitleTranslation.capability." + capability.Key)" title="@AppText.T(capability.Value ? "web.toolbox.subtitleTranslation.capabilityOn" : "web.toolbox.subtitleTranslation.capabilityOff")" />
                        }
                    </span>
                </div>
                @if (estimate != null)
                {
                    <div class="rf-tool-options-row rf-translation-estimate">
                        <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.estimate")</span>
                        <span>
                            @AppText.Count("web.toolbox.subtitleTranslation.filesCount", estimate.Files)
                            · @AppText.Count("web.toolbox.subtitleTranslation.cuesCount", estimate.Cues, estimate.Cues.ToString("N0", CultureInfo.CurrentCulture))
                            · @AppText.Count("web.toolbox.subtitleTranslation.callsCount", estimate.Calls)
                            · @AppText.F("web.toolbox.subtitleTranslation.estimateInput", estimate.InputTokens.ToString("N0", CultureInfo.CurrentCulture))
                            · @AppText.T("web.toolbox.subtitleTranslation.estimateOutputUnavailable")
                        </span>
                    </div>
                }
            </div>

            @if (project.ImportedGlossary != null)
            {
                <div class="rf-translation-loaded">
                    <RadzenIcon Icon="menu_book" IconStyle="IconStyle.Primary" aria-hidden="true" />
                    <span>
                        @AppText.T("web.toolbox.subtitleTranslation.loadedGlossary")
                        <strong>@project.ImportedGlossary.FileName</strong>
                        · @AppText.Count("web.toolbox.subtitleTranslation.termsCount", project.ImportedGlossary.TermCount)
                        · @AppText.Count("web.toolbox.subtitleTranslation.charactersCount", project.ImportedGlossary.CharacterCount)
                    </span>
                    <RadzenButton class="rf-translation-loaded-remove" Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                  Disabled="@(busy || !Orchestrator.CanImportGlossary)" title="@AppText.T("web.toolbox.subtitleTranslation.removeGlossary")"
                                  aria-label="@AppText.T("web.toolbox.subtitleTranslation.removeGlossary")" Click="@Orchestrator.RemoveImportedGlossary" />
                </div>
            }

            @if (files.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rf-tool-empty">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">@AppText.T("web.toolbox.subtitleTranslation.filesEmptyTitle")</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">@AppText.T("web.toolbox.subtitleTranslation.filesEmptyDescription")</RadzenText>
                </RadzenStack>
            }
            else
            {
                <RadzenDataGrid TItem="TranslationFileRecord"
                                Data="@files"
                                class="rf-data-grid rf-tool-grid rf-translation-files"
                                AllowAlternatingRows="false"
                                AllowColumnResize="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="TranslationFileRecord" Title="@AppText.T("web.dashboard.file")" Width="34%">
                            <Template Context="file">
                                <span class="rf-translation-file" title="@file.InputPath">@System.IO.Path.GetFileName(file.InputPath)</span>
                                @if (!string.IsNullOrEmpty(file.File.RejectedReason))
                                {
                                    <span class="rf-translation-rejected">@AppText.T("web.toolbox.subtitleTranslation.fileRejected." + file.File.RejectedReason)</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationFileRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.format")" Width="8%">
                            <Template Context="file"><CellText Text="@file.File.Format.ToString().ToUpperInvariant()" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationFileRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.encoding")" Width="22%">
                            <Template Context="file">
                                <RadzenDropDown TValue="string" class="rf-translation-encoding" Data="@AddTracksOrchestrator.CharsetChoices" TextProperty="Value" ValueProperty="Key"
                                                Value="@file.File.Encoding" Disabled="@filesLocked"
                                                aria-label="@(AppText.T("web.toolbox.subtitleTranslation.encoding") + " " + System.IO.Path.GetFileName(file.InputPath))"
                                                Change="@((object value) => Orchestrator.SetEncoding(file, (string)value))" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationFileRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.cues")" Width="9%" TextAlign="TextAlign.Right">
                            <Template Context="file"><CellText Text="@(string.IsNullOrEmpty(file.File.RejectedReason) ? file.File.Preparation.CueCount.ToString(CultureInfo.CurrentCulture) : "—")" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationFileRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.excluded")" Width="9%" TextAlign="TextAlign.Right">
                            <Template Context="file"><CellText Text="@(string.IsNullOrEmpty(file.File.RejectedReason) ? file.File.Preparation.ExcludedCount.ToString(CultureInfo.CurrentCulture) : "—")" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationFileRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.groups")" Width="9%" TextAlign="TextAlign.Right">
                            <Template Context="file"><CellText Text="@(string.IsNullOrEmpty(file.File.RejectedReason) ? file.File.Preparation.GroupCount.ToString(CultureInfo.CurrentCulture) : "—")" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationFileRecord" Width="4rem" TextAlign="TextAlign.Center">
                            <Template Context="file">
                                <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@filesLocked"
                                              title="@AppText.T("web.toolbox.list.remove")" aria-label="@(AppText.T("web.toolbox.list.remove") + " " + System.IO.Path.GetFileName(file.InputPath))"
                                              Click="@(() => Orchestrator.Remove(file))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

                List<TranslationStyleRow> styleRows = Orchestrator.GetStyleRows();
                @if (styleRows.Count > 0)
                {
                    <RadzenDataGrid TItem="TranslationStyleRow"
                                    Data="@styleRows"
                                    class="rf-data-grid rf-tool-grid rf-translation-styles"
                                    AllowAlternatingRows="false"
                                    AllowColumnResize="false"
                                    AllowPaging="false"
                                    AllowSorting="false"
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Horizontal">
                        <Columns>
                            <RadzenDataGridColumn TItem="TranslationStyleRow" Title="@AppText.T("web.toolbox.subtitleTranslation.style")" Width="22%">
                                <Template Context="style"><span class="rf-translation-cell">@style.Name</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TranslationStyleRow" Title="@AppText.T("web.toolbox.subtitleTranslation.styleLines")" Width="9%" TextAlign="TextAlign.Right">
                                <Template Context="style"><CellText Text="@style.Lines.ToString(CultureInfo.CurrentCulture)" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TranslationStyleRow" Title="@AppText.T("web.toolbox.subtitleTranslation.styleExample")" Width="47%">
                                <Template Context="style"><CellText Text="@style.Example" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TranslationStyleRow" Title="@AppText.T("web.toolbox.subtitleTranslation.styleKind")" Width="22%">
                                <Template Context="style">
                                    <RadzenDropDown TValue="TranslationStyleKind" class="rf-translation-cell-input" Data="@s_styleKinds" Value="@style.Kind" Disabled="@filesLocked"
                                                    aria-label="@(AppText.T("web.toolbox.subtitleTranslation.styleKind") + " " + style.Name)"
                                                    Change="@((object value) => Orchestrator.SetStyleKind(style.Name, (TranslationStyleKind)value))">
                                        <Template Context="kind">@AppText.T("web.toolbox.subtitleTranslation.styleKind." + kind)</Template>
                                        <ValueTemplate Context="kind">@AppText.T("web.toolbox.subtitleTranslation.styleKind." + kind)</ValueTemplate>
                                    </RadzenDropDown>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            }
        }
        else if (_step == STEP_TRANSLATION)
        {
            TranslationJob job = Orchestrator.Job;
            @if (job == null)
            {
                TranslationEstimate translationEstimate = Orchestrator.EstimateTranslation();
                @if (translationEstimate != null)
                {
                    <div class="rf-tool-options">
                        <div class="rf-tool-options-row rf-translation-estimate">
                            <span class="rf-tool-label">@AppText.T("web.toolbox.subtitleTranslation.estimate")</span>
                            <span>
                                @AppText.Count("web.toolbox.subtitleTranslation.filesCount", translationEstimate.Files)
                                · @AppText.Count("web.toolbox.subtitleTranslation.cuesCount", translationEstimate.Cues, translationEstimate.Cues.ToString("N0", CultureInfo.CurrentCulture))
                                · @AppText.Count("web.toolbox.subtitleTranslation.blocksCount", translationEstimate.Blocks)
                                · @AppText.F("web.toolbox.subtitleTranslation.estimateInput", translationEstimate.InputTokens.ToString("N0", CultureInfo.CurrentCulture))
                                @AppText.F("web.toolbox.subtitleTranslation.estimateUncached", (translationEstimate.InputTokens - translationEstimate.CachedTokens).ToString("N0", CultureInfo.CurrentCulture))
                                · @AppText.F("web.toolbox.subtitleTranslation.estimateOutput", translationEstimate.OutputTokens.ToString("N0", CultureInfo.CurrentCulture))
                                · @(translationEstimate.ReviewInputTokens.HasValue
                                    ? AppText.F("web.toolbox.subtitleTranslation.estimateReview", translationEstimate.ReviewInputTokens.Value.ToString("N0", CultureInfo.CurrentCulture)) + " "
                                        + AppText.F("web.toolbox.subtitleTranslation.estimateUncached", (translationEstimate.ReviewInputTokens.Value - translationEstimate.ReviewCachedTokens.Value).ToString("N0", CultureInfo.CurrentCulture))
                                        + ", " + AppText.F("web.toolbox.subtitleTranslation.estimateOutput", translationEstimate.ReviewOutputTokens.Value.ToString("N0", CultureInfo.CurrentCulture))
                                    : AppText.T("web.toolbox.subtitleTranslation.estimateReviewTargeted"))
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rf-tool-empty">
                        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">@AppText.T("web.toolbox.subtitleTranslation.translationEmpty")</RadzenText>
                    </RadzenStack>
                }
            }
            else
            {
                <RadzenDataGrid TItem="TranslationJobFileRow"
                                Data="@Orchestrator.GetTranslationRows()"
                                class="rf-data-grid rf-tool-grid rf-translation-job"
                                AllowAlternatingRows="false"
                                AllowColumnResize="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.dashboard.file")" Width="22%">
                            <Template Context="row">
                                <span class="rf-translation-file" title="@row.FileName">@row.FileName</span>
                                @if (row.Status == TranslationFileStatus.Blocked)
                                {
                                    <span class="rf-translation-rejected">@AppText.T("web.toolbox.subtitleTranslation.fileRejected." + row.BlockedReason)</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.toolbox.subtitleTranslation.status")" Width="10%">
                            <Template Context="row"><RadzenBadge IsPill="true" BadgeStyle="@(row.Status == TranslationFileStatus.Completed ? BadgeStyle.Success : row.Status == TranslationFileStatus.Blocked ? BadgeStyle.Danger
                                             : row.Status == TranslationFileStatus.InProgress && job.Status == TranslationJobStatus.Paused ? BadgeStyle.Warning
                                             : row.Status == TranslationFileStatus.InProgress ? BadgeStyle.Info : BadgeStyle.Base)"
                                         Text="@(row.Status == TranslationFileStatus.InProgress && job.Status == TranslationJobStatus.Paused ? JobStateText(job)
                                             : AppText.T("web.toolbox.subtitleTranslation.fileState." + row.Status))" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.toolbox.subtitleTranslation.blocks")" Width="14%">
                            <Template Context="row">
                                <div class="rf-translation-blocks">
                                    <span>@(row.BlocksDone.ToString(CultureInfo.CurrentCulture) + "/" + row.BlocksTotal.ToString(CultureInfo.CurrentCulture))</span>
                                    <RadzenProgressBar class="rf-translation-blocks-bar" ShowValue="false" Value="@(row.BlocksTotal > 0 ? row.BlocksDone * 100.0 / row.BlocksTotal : 0)"
                                                       aria-label="@(AppText.T("web.toolbox.subtitleTranslation.blocks") + " " + row.FileName)" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.toolbox.subtitleTranslation.cues")" Width="9%" TextAlign="TextAlign.Right">
                            <Template Context="row"><CellText Text="@(row.CuesDone.ToString(CultureInfo.CurrentCulture) + "/" + row.CuesTotal.ToString(CultureInfo.CurrentCulture))" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.toolbox.subtitleTranslation.retried")" Width="8%" TextAlign="TextAlign.Right">
                            <Template Context="row"><CellText Text="@row.Retried.ToString(CultureInfo.CurrentCulture)" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.toolbox.subtitleTranslation.toReview")" Width="8%" TextAlign="TextAlign.Right">
                            <Template Context="row"><CellText Text="@row.ToReview.ToString(CultureInfo.CurrentCulture)" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.toolbox.subtitleTranslation.newTerms")" Width="8%" TextAlign="TextAlign.Right">
                            <Template Context="row"><CellText Text="@row.NewTerms.ToString(CultureInfo.CurrentCulture)" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.tokens")" Width="15%" TextAlign="TextAlign.Right">
                            <Template Context="row"><CellText Text="@(FormatTokens(row.InputTokens) + " / " + FormatTokens(row.CachedTokens) + " / " + FormatTokens(row.OutputTokens))" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationJobFileRow" Width="5rem" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                @if (row.Status == TranslationFileStatus.Blocked)
                                {
                                    <span class="rf-translation-actions">
                                        @if (row.BlockedReason == TranslationFilePreparer.REJECTION_SOURCE_CHANGED && job.Phase == TranslationJobPhase.Translation)
                                        {
                                            <RadzenButton Icon="restart_alt" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@busy"
                                                          title="@AppText.T("web.toolbox.subtitleTranslation.restartFile")" aria-label="@(AppText.T("web.toolbox.subtitleTranslation.restartFile") + " " + row.FileName)"
                                                          Click="@(() => RestartFileAsync(row))" />
                                        }
                                        <RadzenButton Icon="remove_circle_outline" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Disabled="@(busy || job.FileIds.Count < 2)"
                                                      title="@AppText.T("web.toolbox.subtitleTranslation.excludeFile")" aria-label="@(AppText.T("web.toolbox.subtitleTranslation.excludeFile") + " " + row.FileName)"
                                                      Click="@(() => { Orchestrator.ExcludeFile(row.FileId); _step = ProjectStep(); })" />
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }

            <SubtitleTranslationCallsPanel Calls="@Orchestrator.GetJobCalls()" FileNames="@fileNames" Discarded="@Orchestrator.GetDiscardedCalls()" />
        }
        else if (_step == STEP_NEW_TERMS)
        {
            TranslationJob job = Orchestrator.Job;
            List<TermApplicationRow> applicationRows = Orchestrator.GetTermApplicationRows();
            @if (job == null || job.NewTerms.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rf-tool-empty">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">@AppText.T("web.toolbox.subtitleTranslation.newTermsEmpty")</RadzenText>
                </RadzenStack>
            }
            else if (job.Phase == TranslationJobPhase.Applying || applicationRows.Exists(r => r.Status != TermApplicationStatus.Pending))
            {
                <RadzenDataGrid TItem="TermApplicationRow"
                                Data="@applicationRows"
                                class="rf-data-grid rf-tool-grid rf-translation-job"
                                AllowAlternatingRows="false"
                                AllowColumnResize="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="TermApplicationRow" Title="@AppText.T("web.dashboard.file")" Width="46%">
                            <Template Context="row"><span class="rf-translation-file" title="@row.FileName">@row.FileName</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TermApplicationRow" Title="@AppText.T("web.toolbox.subtitleTranslation.status")" Width="18%">
                            <Template Context="row">
                                @{
                                    bool waiting = row.Status == TermApplicationStatus.Pending;
                                    bool running = waiting && job.Status == TranslationJobStatus.Running;
                                }
                                <RadzenBadge IsPill="true" BadgeStyle="@(running ? BadgeStyle.Info : waiting && job.Status == TranslationJobStatus.Paused ? BadgeStyle.Warning : waiting ? BadgeStyle.Base : BadgeStyle.Success)"
                                             Text="@(running ? AppText.T("web.toolbox.subtitleTranslation.fileState.InProgress") : waiting && job.Status == TranslationJobStatus.Paused ? JobStateText(job)
                                                 : waiting ? AppText.T("web.toolbox.subtitleTranslation.fileState.Pending") : AppText.T("web.toolbox.subtitleTranslation.fileState.Completed"))" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TermApplicationRow" Title="@AppText.T("web.toolbox.subtitleTranslation.termsInvolved")" Width="18%" TextAlign="TextAlign.Right">
                            <Template Context="row"><CellText Text="@(row.Targets.HasValue ? row.Targets.Value.ToString(CultureInfo.CurrentCulture) : "—")" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TermApplicationRow" Title="@AppText.T("web.toolbox.subtitleTranslation.termsRewritten")" Width="18%" TextAlign="TextAlign.Right">
                            <Template Context="row">
                                <CellText Text="@(row.Rewritten.HasValue ? row.Rewritten.Value.ToString(CultureInfo.CurrentCulture) : "—")" />
                                @if (row.Failed > 0)
                                {
                                    <span class="rf-translation-rejected">@AppText.Count("web.toolbox.subtitleTranslation.termsFailed", row.Failed)</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                bool deciding = !busy && job.Phase == TranslationJobPhase.NewTerms;
                <RadzenDataGrid TItem="NewTermDecision"
                                Data="@job.NewTerms"
                                class="rf-data-grid rf-tool-grid rf-translation-terms"
                                AllowAlternatingRows="false"
                                AllowColumnResize="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="NewTermDecision" Title="@AppText.T("web.toolbox.subtitleTranslation.termSource")" Width="15%">
                            <Template Context="term"><span class="rf-translation-cell">@term.Source</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NewTermDecision" Title="@AppText.T("web.toolbox.subtitleTranslation.termRenderings")" Width="18%">
                            <Template Context="term">
                                <span class="rf-translation-renderings">
                                    @foreach (NewTermRendering rendering in term.Renderings)
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Base" Text="@AppText.F("web.toolbox.subtitleTranslation.renderingCount", rendering.Target, rendering.Count)" />
                                    }
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NewTermDecision" Title="@AppText.T("web.toolbox.subtitleTranslation.episodes")" Width="7%" TextAlign="TextAlign.Right">
                            <Template Context="term">
                                @{
                                    HashSet<string> episodes = new HashSet<string>(StringComparer.Ordinal);
                                    foreach (NewTermRendering rendering in term.Renderings)
                                        episodes.UnionWith(rendering.FileIds);
                                }
                                <CellText Text="@episodes.Count.ToString(CultureInfo.CurrentCulture)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NewTermDecision" Title="@AppText.T("web.toolbox.subtitleTranslation.termChosen")" Width="16%">
                            <Template Context="term">
                                <RadzenTextBox class="@("rf-translation-cell-input" + (term.Decision == NewTermDecisionKind.Add && string.IsNullOrWhiteSpace(term.ChosenTarget) ? " rf-tool-input-invalid" : ""))"
                                               Value="@term.ChosenTarget" Disabled="@(!deciding)" aria-label="@(AppText.T("web.toolbox.subtitleTranslation.termChosen") + " " + term.Source)"
                                               Change="@((string value) => Orchestrator.ChangeNewTerm(term, t => t.ChosenTarget = (value ?? "").Trim()))" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NewTermDecision" Title="@AppText.T("web.toolbox.subtitleTranslation.termKind")" Width="11%">
                            <Template Context="term">
                                <RadzenDropDown TValue="GlossaryTermKind" class="rf-translation-cell-input" Data="@s_termKinds" Value="@term.Kind" Disabled="@(!deciding)"
                                                aria-label="@(AppText.T("web.toolbox.subtitleTranslation.termKind") + " " + term.Source)"
                                                Change="@((object value) => Orchestrator.ChangeNewTerm(term, t => t.Kind = (GlossaryTermKind)value))">
                                    <Template Context="kind">@AppText.T("web.toolbox.subtitleTranslation.kind." + kind)</Template>
                                    <ValueTemplate Context="kind">@AppText.T("web.toolbox.subtitleTranslation.kind." + kind)</ValueTemplate>
                                </RadzenDropDown>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NewTermDecision" Title="@AppText.T("web.toolbox.subtitleTranslation.termInvariable")" Width="9%" TextAlign="TextAlign.Center">
                            <Template Context="term">
                                <RadzenCheckBox TValue="bool" Value="@term.Invariable" Disabled="@(!deciding)" aria-label="@(AppText.T("web.toolbox.subtitleTranslation.termInvariable") + " " + term.Source)"
                                                Change="@((bool value) => Orchestrator.ChangeNewTerm(term, t => t.Invariable = value))" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NewTermDecision" Title="@AppText.T("web.toolbox.subtitleTranslation.termExactCase")" Width="9%" TextAlign="TextAlign.Center">
                            <Template Context="term">
                                <RadzenCheckBox TValue="bool" Value="@(term.ExactCase == true)" Disabled="@(!deciding)" aria-label="@(AppText.T("web.toolbox.subtitleTranslation.termExactCase") + " " + term.Source)"
                                                Change="@((bool value) => Orchestrator.ChangeNewTerm(term, t => t.ExactCase = value))" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NewTermDecision" Width="15%">
                            <Template Context="term">
                                <RadzenRadioButtonList TValue="NewTermDecisionKind" Value="@term.Decision" Disabled="@(!deciding)" Orientation="Orientation.Horizontal" class="rf-translation-decision"
                                                       aria-label="@term.Source" Change="@((NewTermDecisionKind value) => Orchestrator.ChangeNewTerm(term, t => t.Decision = value))">
                                    <Items>
                                        <RadzenRadioButtonListItem Text="@AppText.T("web.toolbox.subtitleTranslation.termAdd")" Value="@NewTermDecisionKind.Add" />
                                        <RadzenRadioButtonListItem Text="@AppText.T("web.toolbox.subtitleTranslation.termIgnore")" Value="@NewTermDecisionKind.Ignore" />
                                    </Items>
                                </RadzenRadioButtonList>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }

            <SubtitleTranslationCallsPanel Calls="@Orchestrator.GetJobCalls()" FileNames="@fileNames" Discarded="@Orchestrator.GetDiscardedCalls()" />
        }
        else if (_step == STEP_REVIEW)
        {
            TranslationJob job = Orchestrator.Job;
            @if (job != null && job.Phase == TranslationJobPhase.UserReview)
            {
                List<TranslationReviewRow> reviewRows = ReviewRows;
                int toCheck = reviewRows.FindAll(r => NeedsCheck(r)).Count;
                int edited = reviewRows.FindAll(r => r.Signals.Contains(TranslationCueSignal.EditedByUser)).Count;
                <div class="rf-tool-options">
                    <div class="rf-tool-options-row">
                        <div class="rf-tool-field">
                            <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.dashboard.file")" Component="TranslationReviewFile" />
                            <RadzenDropDown TValue="string" Name="TranslationReviewFile" class="rf-translation-review-file" Data="@job.FileIds" Value="@_reviewFileId"
                                            Change="@((object value) => { _reviewFileId = (string)value; _reviewRows = null; CancelCueEditing(); })">
                                <Template Context="fileId">@fileNames[(string)fileId]</Template>
                                <ValueTemplate Context="fileId">@fileNames[(string)fileId]</ValueTemplate>
                            </RadzenDropDown>
                        </div>
                        <div class="rf-tool-field">
                            <span class="rf-tool-label" id="translation-review-filter-label">@AppText.T("web.toolbox.subtitleTranslation.reviewShow")</span>
                            <RadzenRadioButtonList TValue="int" Value="@_reviewFilter" Orientation="Orientation.Horizontal" aria-labelledby="translation-review-filter-label"
                                                   Change="@((int value) => { _reviewFilter = value; _reviewView = null; })">
                                <Items>
                                    <RadzenRadioButtonListItem Text="@AppText.T("web.toolbox.subtitleTranslation.reviewAll")" Value="@FILTER_ALL" />
                                    <RadzenRadioButtonListItem Text="@AppText.F("web.toolbox.subtitleTranslation.reviewToCheck", toCheck)" Value="@FILTER_TO_CHECK" />
                                    <RadzenRadioButtonListItem Text="@AppText.F("web.toolbox.subtitleTranslation.reviewEdited", edited)" Value="@FILTER_EDITED" />
                                </Items>
                            </RadzenRadioButtonList>
                        </div>
                    </div>
                </div>
                <RadzenDataGrid TItem="TranslationReviewRow"
                                Data="@ReviewView"
                                class="rf-data-grid rf-tool-grid rf-translation-review"
                                AllowAlternatingRows="false"
                                AllowColumnResize="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                EmptyText="@AppText.T("web.toolbox.subtitleTranslation.reviewEmpty")">
                    <Columns>
                        <RadzenDataGridColumn TItem="TranslationReviewRow" Title="#" Width="5rem" TextAlign="TextAlign.Right">
                            <Template Context="row">
                                @if (row.SharedStretch.HasValue)
                                {
                                    <RadzenIcon Icon="repeat" IconStyle="IconStyle.Info" class="rf-translation-shared"
                                                title="@AppText.F("web.toolbox.subtitleTranslation.sharedStretch", row.SharedStretch.Value)" aria-label="@AppText.F("web.toolbox.subtitleTranslation.sharedStretch", row.SharedStretch.Value)" />
                                }
                                <CellText Text="@row.Id.ToString(CultureInfo.CurrentCulture)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationReviewRow" Title="@AppText.T("web.toolbox.subtitleTranslation.times")" Width="8rem">
                            <Template Context="row"><span class="rf-translation-times">@FormatTime(row.StartMs)<br />@FormatTime(row.EndMs)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationReviewRow" Title="@AppText.T("web.toolbox.subtitleTranslation.original")" Width="36%">
                            <Template Context="row"><span class="rf-translation-cell">@MarkedText(row.Source)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationReviewRow" Title="@AppText.T("web.toolbox.subtitleTranslation.translation")" Width="40%">
                            <Template Context="row">
                                @if (_editingCue == row.Id)
                                {
                                    <div class="rf-translation-cue-edit">
                                        <RadzenTextArea class="rf-translation-cue-input" Rows="@Math.Max(2, (_cueDraft ?? "").Split('\n').Length)" @bind-Value="@_cueDraft"
                                                        aria-label="@AppText.F("web.toolbox.subtitleTranslation.cueEdit", row.Id)" />
                                        <span class="rf-translation-actions">
                                            <RadzenButton Icon="check" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Success"
                                                          title="@AppText.T("web.toolbox.subtitleTranslation.editSave")" aria-label="@AppText.T("web.toolbox.subtitleTranslation.editSave")" Click="@(() => SaveCue(row))" />
                                            <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                                          title="@AppText.T("web.common.cancel")" aria-label="@AppText.T("web.common.cancel")" Click="@CancelCueEditing" />
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="rf-translation-cue">
                                        @if (row.ToReviewReason != null)
                                        {
                                            <span class="rf-translation-cell rf-translation-rejected">@row.ToReviewReason</span>
                                        }
                                        else
                                        {
                                            <span class="rf-translation-cell">@MarkedText(row.Text ?? "")</span>
                                        }
                                        <RadzenButton Icon="edit" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@(busy || !Orchestrator.CanEditCues)"
                                                      title="@AppText.T("web.toolbox.subtitleTranslation.editEntry")" aria-label="@AppText.F("web.toolbox.subtitleTranslation.cueEdit", row.Id)"
                                                      Click="@(() => { _editingCue = row.Id; _cueDraft = row.Text ?? ""; })" />
                                    </div>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationReviewRow" Title="@AppText.T("web.toolbox.subtitleTranslation.warnings")" Width="16%">
                            <Template Context="row">
                                <span class="rf-translation-warnings">
                                    @if (row.ToReview)
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Danger" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.toReview")" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.Glossary))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Warning" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.glossary")" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.Retried))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Info" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.retried")" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.NewTerm))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Info" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.newTerm")" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.RewrittenByTerms))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Secondary" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.rewrittenByTerms")" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.Echo))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Warning" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.echo")" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.Slip))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Warning" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.slip")" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.CorrectedByAi))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Secondary" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.correctedByAi")"
                                                     title="@((row.CorrectionBefore != null ? AppText.F("web.toolbox.subtitleTranslation.correctionBefore", row.CorrectionBefore) : "")
                                                         + (row.CorrectionBefore != null && row.CorrectionReason != null ? "\n" : "")
                                                         + (row.CorrectionReason != null ? AppText.F("web.toolbox.subtitleTranslation.correctionReason", row.CorrectionReason) : ""))" />
                                    }
                                    @if (row.Signals.Contains(TranslationCueSignal.EditedByUser))
                                    {
                                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Primary" Text="@AppText.T("web.toolbox.subtitleTranslation.warning.edited")" />
                                    }
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else if (busy && job != null && job.Phase == TranslationJobPhase.Review)
            {
                <div class="rf-translation-thinking"><AiThinkingComponent Phrase="@Orchestrator.Phrase" Detail="@Orchestrator.Detail" StartedAt="@Orchestrator.CallStartedAt" /></div>
            }
            else if (job != null && job.Phase == TranslationJobPhase.Review)
            {
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rf-tool-empty">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">@JobStateText(job)</RadzenText>
                </RadzenStack>
            }

            @if (job == null || job.Phase != TranslationJobPhase.UserReview)
            {
                <SubtitleTranslationCallsPanel Calls="@Orchestrator.GetJobCalls()" FileNames="@fileNames" Discarded="@Orchestrator.GetDiscardedCalls()" />
            }
        }
        else if (_step == STEP_EXPORT)
        {
            <ToolboxOutputOptions Orchestrator="@Orchestrator" JsModule="@JsModule" Id="translation" />
            @if (_exported != null)
            {
                <RadzenDataGrid TItem="TranslationExportRow"
                                Data="@_exported"
                                class="rf-data-grid rf-tool-grid rf-translation-job"
                                AllowAlternatingRows="false"
                                AllowColumnResize="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="TranslationExportRow" Title="@AppText.T("web.dashboard.file")" Width="30%">
                            <Template Context="row"><span class="rf-translation-file" title="@row.FileName">@row.FileName</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationExportRow" Title="@AppText.T("web.toolbox.subtitleTranslation.writtenFile")" Width="70%">
                            <Template Context="row">
                                @if (row.Written)
                                {
                                    <span class="rf-translation-file" title="@row.OutputPath">@row.OutputPath</span>
                                }
                                else
                                {
                                    <span class="rf-translation-rejected">@row.Error</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <RadzenDataGrid TItem="TranslationExportRow"
                                Data="@Orchestrator.GetExportRows()"
                                class="rf-data-grid rf-tool-grid rf-translation-job"
                                AllowAlternatingRows="false"
                                AllowColumnResize="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="TranslationExportRow" Title="@AppText.T("web.dashboard.file")" Width="34%">
                            <Template Context="row">
                                <span class="rf-translation-file" title="@row.FileName">@row.FileName</span>
                                @if (!string.IsNullOrEmpty(row.Error))
                                {
                                    <span class="rf-translation-rejected">@row.Error</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationExportRow" Title="@AppText.T("web.toolbox.subtitleTranslation.output")" Width="38%">
                            <Template Context="row"><span class="rf-translation-file" title="@row.OutputPath">@System.IO.Path.GetFileName(row.OutputPath)</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationExportRow" Title="@AppText.T("web.toolbox.subtitleTranslation.translatedCues")" Width="14%" TextAlign="TextAlign.Right">
                            <Template Context="row"><CellText Text="@row.Translated.ToString(CultureInfo.CurrentCulture)" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationExportRow" Title="@AppText.T("web.toolbox.subtitleTranslation.toReview")" Width="14%" TextAlign="TextAlign.Right">
                            <Template Context="row">
                                @if (row.Untranslated > 0)
                                {
                                    <strong class="rf-translation-untranslated">@row.Untranslated.ToString(CultureInfo.CurrentCulture)</strong>
                                }
                                else
                                {
                                    <CellText Text="0" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        }
        else
        {
            bool glossaryLocked = Orchestrator.Job != null;
            @if (busy && !glossaryLocked)
            {
                <div class="rf-translation-thinking"><AiThinkingComponent Phrase="@Orchestrator.Phrase" Detail="@Orchestrator.Detail" StartedAt="@Orchestrator.CallStartedAt" /></div>
            }
            else if (project.Glossary != null && project.Analysis != null && project.Analysis.Status == TranslationAnalysisStatus.Completed)
            {
                Glossary glossary = project.Glossary;
                string[] forms = TranslationRequestBuilder.GetAddressForms(project.TargetLanguage);

                <RadzenTabs class="rf-tool-tabs rf-translation-tabs" RenderMode="TabRenderMode.Client" SelectedIndex="@_tab" Change="@((int index) => { _pending = null; _tab = index; })">
                    <Tabs>
                        <RadzenTabsItem Text="@AppText.F("web.toolbox.subtitleTranslation.termsTab", glossary.Terms.Count)">
                            <RadzenDataGrid TItem="GlossaryTerm"
                                            Data="@WithPending(glossary.Terms)"
                                            class="rf-data-grid rf-tool-grid rf-translation-glossary"
                                            AllowAlternatingRows="false"
                                            AllowColumnResize="false"
                                            AllowPaging="false"
                                            AllowSorting="false"
                                            Density="Density.Compact"
                                            GridLines="DataGridGridLines.Horizontal">
                                <Columns>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Title="@AppText.T("web.toolbox.subtitleTranslation.termSource")" Width="18%">
                                        <Template Context="term">
                                            @TextCell(term, term.Source, term.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.termSource"), (t, value) => t.Source = value)
                                            @if (term.Origin == GlossaryOrigin.Import)
                                            {
                                                <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Base" class="rf-translation-origin" Text="@AppText.T("web.toolbox.subtitleTranslation.originImport")" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Title="@AppText.T("web.toolbox.subtitleTranslation.termTarget")" Width="18%">
                                        <Template Context="term">@TextCell(term, term.Target, true, AppText.T("web.toolbox.subtitleTranslation.termTarget"), (t, value) => t.Target = value)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Title="@AppText.T("web.toolbox.subtitleTranslation.termKind")" Width="12%">
                                        <Template Context="term">
                                            @if (term.Origin == GlossaryOrigin.User)
                                            {
                                                <RadzenDropDown TValue="GlossaryTermKind" class="rf-translation-cell-input" Data="@s_termKinds" Value="@term.Kind" Disabled="@(busy || glossaryLocked)"
                                                                aria-label="@AppText.T("web.toolbox.subtitleTranslation.termKind")" Change="@((object value) => ChangeEntry(term, t => t.Kind = (GlossaryTermKind)value))">
                                                    <Template Context="kind">@AppText.T("web.toolbox.subtitleTranslation.kind." + kind)</Template>
                                                    <ValueTemplate Context="kind">@AppText.T("web.toolbox.subtitleTranslation.kind." + kind)</ValueTemplate>
                                                </RadzenDropDown>
                                            }
                                            else
                                            {
                                                <CellText Text="@AppText.T("web.toolbox.subtitleTranslation.kind." + term.Kind)" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Title="@AppText.T("web.toolbox.subtitleTranslation.termInvariable")" Width="9%" TextAlign="TextAlign.Center">
                                        <Template Context="term">
                                            @if (term.Origin == GlossaryOrigin.User)
                                            {
                                                <RadzenCheckBox TValue="bool" Value="@term.Invariable" Disabled="@(busy || glossaryLocked)" aria-label="@AppText.T("web.toolbox.subtitleTranslation.termInvariable")"
                                                                Change="@((bool value) => ChangeEntry(term, t => t.Invariable = value))" />
                                            }
                                            else if (term.Invariable)
                                            {
                                                <RadzenIcon Icon="check" aria-label="@AppText.T("web.toolbox.subtitleTranslation.termInvariable")" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Title="@AppText.T("web.toolbox.subtitleTranslation.termExactCase")" Width="9%" TextAlign="TextAlign.Center">
                                        <Template Context="term">
                                            <RadzenCheckBox TValue="bool" Value="@(term.ExactCase == true)" Disabled="@(busy || glossaryLocked)" aria-label="@AppText.T("web.toolbox.subtitleTranslation.termExactCase")"
                                                            Change="@((bool value) => ChangeEntry(term, t => t.ExactCase = value))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Title="@AppText.T("web.toolbox.subtitleTranslation.episodes")" Width="7%" TextAlign="TextAlign.Right">
                                        <Template Context="term"><CellText Text="@term.Episodes.Count.ToString(CultureInfo.CurrentCulture)" /></Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Title="@AppText.T("web.toolbox.subtitleTranslation.note")" Width="20%">
                                        <Template Context="term">@TextCell(term, term.Note, term.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.note"), (t, value) => t.Note = value)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryTerm" Width="4rem" TextAlign="TextAlign.Center">
                                        <Template Context="term">@DeleteCell(term, term.Source)</Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                            <RadzenButton class="rf-translation-add" Text="@AppText.T("web.toolbox.subtitleTranslation.addTerm")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                                          Disabled="@(_pending != null || busy || glossaryLocked)" Click="@(() => _pending = new GlossaryTerm { Origin = GlossaryOrigin.User })" />
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="@AppText.F("web.toolbox.subtitleTranslation.charactersTab", glossary.Characters.Count)">
                            <RadzenDataGrid TItem="GlossaryCharacter"
                                            Data="@WithPending(glossary.Characters)"
                                            class="rf-data-grid rf-tool-grid rf-translation-glossary"
                                            AllowAlternatingRows="false"
                                            AllowColumnResize="false"
                                            AllowPaging="false"
                                            AllowSorting="false"
                                            Density="Density.Compact"
                                            GridLines="DataGridGridLines.Horizontal">
                                <Columns>
                                    <RadzenDataGridColumn TItem="GlossaryCharacter" Title="@AppText.T("web.toolbox.subtitleTranslation.characterName")" Width="22%">
                                        <Template Context="character">
                                            @TextCell(character, character.Name, character.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.characterName"), (c, value) => c.Name = value)
                                            @if (character.Origin == GlossaryOrigin.Import)
                                            {
                                                <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Base" class="rf-translation-origin" Text="@AppText.T("web.toolbox.subtitleTranslation.originImport")" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryCharacter" Title="@AppText.T("web.toolbox.subtitleTranslation.characterGender")" Width="13%">
                                        <Template Context="character">
                                            <RadzenDropDown TValue="CharacterGender" class="rf-translation-cell-input" Data="@s_genders" Value="@character.Gender" Disabled="@(busy || glossaryLocked)"
                                                            aria-label="@AppText.T("web.toolbox.subtitleTranslation.characterGender")" Change="@((object value) => ChangeEntry(character, c => c.Gender = (CharacterGender)value))">
                                                <Template Context="gender">@AppText.T("web.toolbox.subtitleTranslation.gender." + gender)</Template>
                                                <ValueTemplate Context="gender">@AppText.T("web.toolbox.subtitleTranslation.gender." + gender)</ValueTemplate>
                                            </RadzenDropDown>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryCharacter" Title="@AppText.T("web.toolbox.subtitleTranslation.characterRole")" Width="28%">
                                        <Template Context="character">@TextCell(character, character.Role, character.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.characterRole"), (c, value) => c.Role = value)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryCharacter" Title="@AppText.T("web.toolbox.subtitleTranslation.characterRelationships")" Width="28%">
                                        <Template Context="character">@TextCell(character, character.Relationships, character.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.characterRelationships"), (c, value) => c.Relationships = value)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlossaryCharacter" Width="4rem" TextAlign="TextAlign.Center">
                                        <Template Context="character">@DeleteCell(character, character.Name)</Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                            <RadzenButton class="rf-translation-add" Text="@AppText.T("web.toolbox.subtitleTranslation.addCharacter")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                                          Disabled="@(_pending != null || busy || glossaryLocked)" Click="@(() => _pending = new GlossaryCharacter { Origin = GlossaryOrigin.User, Gender = CharacterGender.Unknown })" />
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="@AppText.T("web.toolbox.subtitleTranslation.registerTab")">
                            <div class="rf-translation-texts">
                                <div class="rf-tool-field">
                                    <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.subtitleTranslation.series")" Component="TranslationSeries" />
                                    <RadzenTextArea Name="TranslationSeries" Rows="2" Disabled="@glossaryLocked" Value="@glossary.Series" Change="@((string value) => Orchestrator.ChangeGlossary(g => g.Series = (value ?? "").Trim()))" />
                                </div>
                                <div class="rf-tool-field">
                                    <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.subtitleTranslation.tone")" Component="TranslationTone" />
                                    <RadzenTextArea Name="TranslationTone" Rows="2" Disabled="@glossaryLocked" Value="@glossary.Tone" Change="@((string value) => Orchestrator.ChangeGlossary(g => g.Tone = (value ?? "").Trim()))" />
                                </div>
                                <div class="rf-tool-field">
                                    <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.subtitleTranslation.registerRules")" Component="TranslationRegisterRules" />
                                    <RadzenTextArea Name="TranslationRegisterRules" Rows="2" Disabled="@glossaryLocked" Value="@glossary.RegisterRules" Change="@((string value) => Orchestrator.ChangeGlossary(g => g.RegisterRules = (value ?? "").Trim()))" />
                                </div>
                            </div>
                            @if (forms != null && forms.Length > 0)
                            {
                                <RadzenDataGrid TItem="GlossaryAddressing"
                                                Data="@WithPending(glossary.Addressing)"
                                                class="rf-data-grid rf-tool-grid rf-translation-glossary"
                                                AllowAlternatingRows="false"
                                                AllowColumnResize="false"
                                                AllowPaging="false"
                                                AllowSorting="false"
                                                Density="Density.Compact"
                                                GridLines="DataGridGridLines.Horizontal">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GlossaryAddressing" Title="@AppText.T("web.toolbox.subtitleTranslation.speaker")" Width="26%">
                                            <Template Context="pair">@TextCell(pair, pair.Speaker, pair.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.speaker"), (a, value) => a.Speaker = value)</Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="GlossaryAddressing" Title="@AppText.T("web.toolbox.subtitleTranslation.addressee")" Width="26%">
                                            <Template Context="pair">@TextCell(pair, pair.Addressee, pair.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.addressee"), (a, value) => a.Addressee = value)</Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="GlossaryAddressing" Title="@AppText.T("web.toolbox.subtitleTranslation.form")" Width="14%">
                                            <Template Context="pair">
                                                <RadzenDropDown TValue="string" class="rf-translation-cell-input" Data="@forms" Value="@pair.Form" Disabled="@(busy || glossaryLocked)"
                                                                aria-label="@AppText.T("web.toolbox.subtitleTranslation.form")" Change="@((object value) => ChangeEntry(pair, a => a.Form = (string)value))" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="GlossaryAddressing" Title="@AppText.T("web.toolbox.subtitleTranslation.note")" Width="26%">
                                            <Template Context="pair">@TextCell(pair, pair.Note, pair.Origin == GlossaryOrigin.User, AppText.T("web.toolbox.subtitleTranslation.note"), (a, value) => a.Note = value)</Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="GlossaryAddressing" Width="4rem" TextAlign="TextAlign.Center">
                                            <Template Context="pair">@DeleteCell(pair, pair.Speaker + " → " + pair.Addressee)</Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                                <RadzenButton class="rf-translation-add" Text="@AppText.T("web.toolbox.subtitleTranslation.addAddressing")" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                                              Disabled="@(_pending != null || busy || glossaryLocked)" Click="@(() => _pending = new GlossaryAddressing { Origin = GlossaryOrigin.User, Form = forms[0] })" />
                            }
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            }

            <SubtitleTranslationCallsPanel Calls="@Orchestrator.GetCalls()" FileNames="@fileNames" />
        }
    }
</div>

@code {
    #region Costanti

    /// <summary>
    /// Passo Glossario
    /// </summary>
    private const int STEP_GLOSSARY = 1;

    /// <summary>
    /// Passo Traduzione
    /// </summary>
    private const int STEP_TRANSLATION = 2;

    /// <summary>
    /// Passo Termini nuovi
    /// </summary>
    private const int STEP_NEW_TERMS = 3;

    /// <summary>
    /// Passo Revisione
    /// </summary>
    private const int STEP_REVIEW = 4;

    /// <summary>
    /// Passo Esporta
    /// </summary>
    private const int STEP_EXPORT = 5;

    /// <summary>
    /// Filtro della revisione: tutte le battute
    /// </summary>
    private const int FILTER_ALL = 0;

    /// <summary>
    /// Filtro della revisione: battute da controllare
    /// </summary>
    private const int FILTER_TO_CHECK = 1;

    /// <summary>
    /// Filtro della revisione: battute modificate a mano
    /// </summary>
    private const int FILTER_EDITED = 2;

    #endregion

    #region Variabili statiche

    /// <summary>
    /// Estensioni dei sottotitoli proposte dal browser
    /// </summary>
    private static readonly List<string> s_extensions = new List<string> { "srt", "ass", "ssa" };

    /// <summary>
    /// Estensione del glossario proposta dal browser
    /// </summary>
    private static readonly List<string> s_glossaryExtensions = new List<string> { "xlsx" };

    /// <summary>
    /// Estensione dell'archivio del progetto proposta dal browser
    /// </summary>
    private static readonly List<string> s_archiveExtensions = new List<string> { "zip" };

    /// <summary>
    /// Aperture e chiusure dei segni nel testo delle battute
    /// </summary>
    private static readonly Regex s_marks = new Regex("⟦[0-9]+ |⟧", RegexOptions.CultureInvariant);

    /// <summary>
    /// Tipi di termine nell'ordine della tendina
    /// </summary>
    private static readonly List<GlossaryTermKind> s_termKinds = new List<GlossaryTermKind>((GlossaryTermKind[])Enum.GetValues(typeof(GlossaryTermKind)));

    /// <summary>
    /// Tipi di uno stile nell'ordine della tendina
    /// </summary>
    private static readonly List<TranslationStyleKind> s_styleKinds = new List<TranslationStyleKind>((TranslationStyleKind[])Enum.GetValues(typeof(TranslationStyleKind)));

    /// <summary>
    /// Generi dei personaggi nell'ordine della tendina
    /// </summary>
    private static readonly List<CharacterGender> s_genders = new List<CharacterGender>((CharacterGender[])Enum.GetValues(typeof(CharacterGender)));

    #endregion

    #region Servizi iniettati

    /// <summary>
    /// Orchestratore della card, singleton che sopravvive alla pagina
    /// </summary>
    [Inject] private SubtitleTranslationOrchestrator Orchestrator { get; set; }

    /// <summary>
    /// Servizio dei dialog
    /// </summary>
    [Inject] private DialogService DialogService { get; set; }

    /// <summary>
    /// Servizio dei toast
    /// </summary>
    [Inject] private NotificationService NotificationService { get; set; }

    #endregion

    #region Variabili di classe

    /// <summary>
    /// Progetti salvati, riletti a ogni ritorno all'elenco
    /// </summary>
    private List<TranslationProject> _projects = new List<TranslationProject>();

    /// <summary>
    /// Job attivo dei progetti dell'elenco, per identificativo del progetto
    /// </summary>
    private Dictionary<string, TranslationJob> _jobs = new Dictionary<string, TranslationJob>(StringComparer.Ordinal);

    /// <summary>
    /// Progetti dell'elenco col job fermato e file da tradurre che non siano bloccati
    /// </summary>
    private HashSet<string> _jobsToResume = new HashSet<string>(StringComparer.Ordinal);

    /// <summary>
    /// Identificativo del progetto scelto nell'elenco, vuoto se nessuno
    /// </summary>
    private string _selectedId = "";

    /// <summary>
    /// Passo mostrato del progetto aperto
    /// </summary>
    private int _step;

    /// <summary>
    /// Scheda mostrata del glossario
    /// </summary>
    private int _tab;

    /// <summary>
    /// Voce aggiunta a mano che non è ancora nel glossario perché incompleta; null se nessuna
    /// </summary>
    private object _pending;

    /// <summary>
    /// Capacità dichiarate dall'accesso, accese o spente
    /// </summary>
    private List<KeyValuePair<string, bool>> _capabilities = new List<KeyValuePair<string, bool>>();

    /// <summary>
    /// Modalità dell'accesso configurato
    /// </summary>
    private AiConnectionMode _accessMode;

    /// <summary>
    /// File mostrato nella revisione, null per il primo del job
    /// </summary>
    private string _reviewFileId;

    /// <summary>
    /// Filtro della revisione
    /// </summary>
    private int _reviewFilter = FILTER_ALL;

    /// <summary>
    /// Battute del file in revisione, rilette quando cambia lo stato della card
    /// </summary>
    private List<TranslationReviewRow> _reviewRows;

    /// <summary>
    /// Battute del file in revisione col filtro scelto
    /// </summary>
    private List<TranslationReviewRow> _reviewView;

    /// <summary>
    /// Battuta in modifica, null se nessuna
    /// </summary>
    private int? _editingCue;

    /// <summary>
    /// Testo della battuta in modifica
    /// </summary>
    private string _cueDraft = "";

    /// <summary>
    /// Esito dell'ultimo export, null prima dell'export o dopo un cambio di passo
    /// </summary>
    private List<TranslationExportRow> _exported;

    #endregion

    #region Metodi pubblici

    /// <inheritdoc />
    public override IReadOnlyList<UiCommandDefinition> BuildUiCommands(bool busy)
    {
        UiCommandPlacement allSurfaces = UiCommandPlacement.Menu | UiCommandPlacement.Toolbar;
        TranslationProject project = this.Orchestrator.Project;
        List<UiCommandDefinition> commands = new List<UiCommandDefinition>();

        if (project == null)
        {
            TranslationProject selected = this.SelectedProject;
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.newProject"), "F5", "add", allSurfaces, UiCommandMenuSection.File, busy,
                () => { this._step = 0; this.Orchestrator.NewProject(); })
            {
                ToolbarOrder = 10
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.openProject"), "", "folder_open", allSurfaces, UiCommandMenuSection.File, busy || selected == null,
                () => this.OpenProject(selected))
            {
                ToolbarOrder = 11
            });
            TranslationJob selectedJob = selected != null && this._jobs.TryGetValue(selected.Id, out TranslationJob found) ? found : null;
            bool analysisStopped = selected != null && selected.Analysis != null && selected.Analysis.Status == TranslationAnalysisStatus.Stopped;
            bool jobStopped = selectedJob != null && this._jobsToResume.Contains(selected.Id);
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.resume"), "F10", "play_arrow", allSurfaces, UiCommandMenuSection.Actions,
                busy || (!analysisStopped && !jobStopped), null)
            {
                Callback = () => this.Resume(selected),
                ToolbarOrder = 12
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.importProject"), "", "unarchive", allSurfaces, UiCommandMenuSection.File, busy, null)
            {
                AsyncCallback = this.ImportProjectAsync,
                SecondaryToolbar = true,
                ToolbarOrder = 13
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.exportProject"), "", "archive", allSurfaces, UiCommandMenuSection.File,
                busy || !this.Orchestrator.CanExportProject(selected, selectedJob), null)
            {
                AsyncCallback = () => this.ExportProjectAsync(selected),
                SecondaryToolbar = true,
                ToolbarOrder = 14
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.deleteProject"), "", "delete", allSurfaces, UiCommandMenuSection.File, busy || selected == null, null)
            {
                AsyncCallback = () => this.DeleteProjectAsync(selected),
                SecondaryToolbar = true,
                DangerToolbar = true,
                ToolbarOrder = 15
            });
            return commands;
        }

        commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.projectsList"), "", "list", allSurfaces, UiCommandMenuSection.File, busy,
            () => { this._pending = null; this.Orchestrator.CloseProject(); this.ReloadProjects(); })
        {
            SecondaryToolbar = true,
            ToolbarOrder = 18
        });

        bool stopped = project.Analysis != null && project.Analysis.Status == TranslationAnalysisStatus.Stopped;
        if (this._step == 0)
        {
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.list.addFiles"), "F5", "add", allSurfaces, UiCommandMenuSection.File, busy || this.Orchestrator.FilesLocked, null)
            {
                AsyncCallback = this.AddFilesAsync,
                ToolbarOrder = 10
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.importGlossary"), "", "upload_file", allSurfaces, UiCommandMenuSection.File, busy || !this.Orchestrator.CanImportGlossary, null)
            {
                AsyncCallback = this.ImportGlossaryAsync,
                ToolbarOrder = 11
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.exportGlossary"), "", "download", allSurfaces, UiCommandMenuSection.File, busy || project.Glossary == null, null)
            {
                AsyncCallback = this.ExportGlossaryAsync,
                SecondaryToolbar = true,
                ToolbarOrder = 15
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.models"), "", "tune", allSurfaces, UiCommandMenuSection.Actions, busy, null)
            {
                AsyncCallback = this.OpenModelsAsync,
                SecondaryToolbar = true,
                ToolbarOrder = 16
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.list.clear"), "Ctrl+L", "clear_all", allSurfaces, UiCommandMenuSection.File, busy || this.Orchestrator.FilesLocked || this.Orchestrator.GetRecords().Count == 0, this.Orchestrator.Clear)
            {
                SecondaryToolbar = true,
                ToolbarOrder = 17
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.next"), "", "arrow_forward", allSurfaces, UiCommandMenuSection.Actions,
                busy || project.ReachedStep < TranslationProjectStep.Glossary,
                () => { this._step = STEP_GLOSSARY; this.OnStateChanged.InvokeAsync(); })
            {
                ToolbarOrder = 13
            });
        }
        else if (this._step == STEP_GLOSSARY)
        {
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.approve"), "", "check", allSurfaces, UiCommandMenuSection.Actions, busy || !this.Orchestrator.CanApprove,
                () =>
                {
                    this._pending = null;
                    this.Orchestrator.ApproveGlossary();
                    this.Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifyApproved"), AppText.F("web.toolbox.subtitleTranslation.revision", this.Orchestrator.Project.Glossary.Revision));
                })
            {
                ToolbarOrder = 10
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.exportGlossary"), "", "download", allSurfaces, UiCommandMenuSection.File,
                busy || project.Glossary == null, null)
            {
                AsyncCallback = this.ExportGlossaryAsync,
                ToolbarOrder = 11
            });
            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.next"), "", "arrow_forward", allSurfaces, UiCommandMenuSection.Actions,
                busy || project.ReachedStep < TranslationProjectStep.Translation,
                () => { this._pending = null; this._step = STEP_TRANSLATION; this.OnStateChanged.InvokeAsync(); })
            {
                ToolbarOrder = 13
            });
        }
        else
        {
            // Avvia traduzione senza job; dopo una fermata Riprova per un errore, Riprendi per Stop, chiusura o limite d'uso, sul
            // passo della fase fermata
            TranslationJob job = this.Orchestrator.Job;
            TranslationJobPhase stepPhase = this._step == STEP_TRANSLATION ? TranslationJobPhase.Translation : this._step == STEP_NEW_TERMS ? TranslationJobPhase.Applying : TranslationJobPhase.Review;
            bool failed = job != null && job.Pause != null && (job.Pause.Reason == TranslationStopReason.AccessError || job.Pause.Reason == TranslationStopReason.ServiceError);
            if (this._step != STEP_EXPORT && (job == null ? this._step == STEP_TRANSLATION : job.Phase == stepPhase && (stepPhase != TranslationJobPhase.Applying || job.Status == TranslationJobStatus.Paused)))
            {
                string label = job == null ? "web.toolbox.subtitleTranslation.startTranslation" : failed ? "web.toolbox.subtitleTranslation.retry" : "web.toolbox.subtitleTranslation.resume";
                commands.Add(new UiCommandDefinition(AppText.T(label), "F10", job == null ? "translate" : failed ? "refresh" : "play_arrow", allSurfaces, UiCommandMenuSection.Actions,
                    busy || !this.Orchestrator.CanStartJob, null)
                {
                    Callback = this.StartJob,
                    ToolbarOrder = 10
                });
            }

            if (this._step == STEP_NEW_TERMS && (job == null || job.Phase == TranslationJobPhase.NewTerms))
            {
                commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.confirmTerms"), "F10", "check", allSurfaces, UiCommandMenuSection.Actions,
                    busy || !this.Orchestrator.CanConfirmNewTerms, null)
                {
                    Callback = this.ConfirmNewTerms,
                    ToolbarOrder = 10
                });
            }

            if (this._step == STEP_REVIEW && job != null && job.Phase == TranslationJobPhase.UserReview)
            {
                commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.next"), "", "arrow_forward", allSurfaces, UiCommandMenuSection.Actions,
                    busy || !this.Orchestrator.CanEditCues,
                    () => { this.CancelCueEditing(); this.Orchestrator.AdvanceToExport(); this._step = STEP_EXPORT; this.OnStateChanged.InvokeAsync(); })
                {
                    ToolbarOrder = 13
                });
            }

            if (this._step == STEP_EXPORT)
            {
                commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.exportSubtitles"), "F10", "save", allSurfaces, UiCommandMenuSection.Actions,
                    busy || !this.Orchestrator.CanEditCues || !string.IsNullOrEmpty(this.Orchestrator.OutputFolderError), null)
                {
                    AsyncCallback = this.ExportSubtitlesAsync,
                    ToolbarOrder = 10
                });
                commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.exportGlossary"), "", "download", allSurfaces, UiCommandMenuSection.File,
                    busy || project.Glossary == null, null)
                {
                    AsyncCallback = this.ExportGlossaryAsync,
                    SecondaryToolbar = true,
                    ToolbarOrder = 12
                });
            }

            commands.Add(new UiCommandDefinition(AppText.T("web.toolbox.subtitleTranslation.exportProject"), "", "archive", allSurfaces, UiCommandMenuSection.File,
                busy || !this.Orchestrator.CanExportProject(project, job), null)
            {
                AsyncCallback = () => this.ExportProjectAsync(project),
                SecondaryToolbar = this._step == STEP_EXPORT,
                ToolbarOrder = 11
            });
        }

        // Analizza sul passo Progetto; dopo una fermata Riprova per un errore, Riprendi per Stop o limite d'uso, sui passi Progetto e Glossario
        if (this._step == 0 || (this._step == STEP_GLOSSARY && stopped))
        {
            bool failed = stopped && project.Analysis.Stop != null &&
                (project.Analysis.Stop.Reason == TranslationStopReason.AccessError || project.Analysis.Stop.Reason == TranslationStopReason.ServiceError);
            string label = failed ? "web.toolbox.subtitleTranslation.retry" : stopped ? "web.toolbox.subtitleTranslation.resume" : "web.toolbox.subtitleTranslation.analyze";
            commands.Add(new UiCommandDefinition(AppText.T(label), "F10", failed ? "refresh" : stopped ? "play_arrow" : "auto_awesome",
                allSurfaces, UiCommandMenuSection.Actions, busy || !this.Orchestrator.CanStart, null)
            {
                Callback = this.Analyze,
                ToolbarOrder = 12
            });
        }

        return commands;
    }

    /// <summary>
    /// Toglie le sottoscrizioni: la pagina rinasce a ogni apertura della card, l'orchestratore resta
    /// </summary>
    public void Dispose()
    {
        this.Orchestrator.OnRecordsChanged -= this.HandleRecordsChanged;
        this.Orchestrator.OnAnalysisFinished -= this.HandleAnalysisFinished;
        this.Orchestrator.OnWebSearchRejected -= this.HandleWebSearchRejected;
        this.Orchestrator.OnPhaseFinished -= this.HandlePhaseFinished;
    }

    #endregion

    #region Metodi protected

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        this.Orchestrator.OnRecordsChanged += this.HandleRecordsChanged;
        this.Orchestrator.OnAnalysisFinished += this.HandleAnalysisFinished;
        this.Orchestrator.OnWebSearchRejected += this.HandleWebSearchRejected;
        this.Orchestrator.OnPhaseFinished += this.HandlePhaseFinished;
        this.ReloadProjects();
        this._accessMode = this.Orchestrator.AccessMode;
        TranslationProviderCapabilities capabilities = this.Orchestrator.GetCapabilities();
        this._capabilities = new List<KeyValuePair<string, bool>>
        {
            new KeyValuePair<string, bool>(TranslationProviderCapabilities.WEB_SEARCH, capabilities.WebSearch),
            new KeyValuePair<string, bool>(TranslationProviderCapabilities.REASONING, capabilities.Reasoning),
            new KeyValuePair<string, bool>(TranslationProviderCapabilities.TEMPERATURE, capabilities.Temperature),
            new KeyValuePair<string, bool>(TranslationProviderCapabilities.MAX_OUTPUT_TOKENS, capabilities.MaxOutputTokens),
            new KeyValuePair<string, bool>(TranslationProviderCapabilities.PROMPT_CACHE_KEY, capabilities.PromptCacheKey)
        };
        this._step = this.ProjectStep();
    }

    #endregion

    #region Metodi privati

    /// <summary>
    /// Ridisegna pagina e comandi quando cambia lo stato della card
    /// </summary>
    private void HandleRecordsChanged()
    {
        this.InvokeAsync(() =>
        {
            this._reviewRows = null;
            this._reviewView = null;
            return this.OnStateChanged.InvokeAsync();
        });
    }

    /// <summary>
    /// Toast dell'esito dell'analisi: glossario proposto, fermata, pausa per il limite d'uso o errore
    /// </summary>
    /// <param name="analysis">Analisi conclusa o fermata</param>
    private void HandleAnalysisFinished(TranslationAnalysis analysis)
    {
        this.InvokeAsync(async () =>
        {
            TranslationProject project = this.Orchestrator.Project;
            if (analysis.Status == TranslationAnalysisStatus.Completed && project != null && project.Glossary != null)
            {
                this.Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifyProposed"),
                    AppText.Count("web.toolbox.subtitleTranslation.termsCount", project.Glossary.Terms.Count) + " · " + AppText.Count("web.toolbox.subtitleTranslation.charactersCount", project.Glossary.Characters.Count));
            }
            else if (analysis.Stop != null && analysis.Stop.Reason == TranslationStopReason.Stop)
            {
                this.Notify(NotificationSeverity.Warning, AppText.T("web.toolbox.subtitleTranslation.notifyStopped"), AppText.T("web.toolbox.subtitleTranslation.notifyResumable"));
            }
            else if (analysis.Stop != null && analysis.Stop.Reason == TranslationStopReason.UsageLimit)
            {
                this.Notify(NotificationSeverity.Warning, AppText.T("web.toolbox.subtitleTranslation.analysisPaused"), analysis.Stop.Message);
            }
            else if (analysis.Stop != null)
            {
                this.Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyFailed"), analysis.Stop.Message);
            }

            await this.OnStateChanged.InvokeAsync();
        });
    }

    /// <summary>
    /// Toast della ricerca web rifiutata dall'accesso: l'analisi prosegue senza
    /// </summary>
    private void HandleWebSearchRejected()
    {
        this.InvokeAsync(() => this.Notify(NotificationSeverity.Info, AppText.T("web.toolbox.subtitleTranslation.notifyWebSearchTitle"), AppText.T("web.toolbox.subtitleTranslation.notifyWebSearch")));
    }

    /// <summary>
    /// Toast in basso a destra, sopra il log
    /// </summary>
    /// <param name="severity">Gravità</param>
    /// <param name="summary">Titolo</param>
    /// <param name="detail">Testo</param>
    private void Notify(NotificationSeverity severity, string summary, string detail)
    {
        this.NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = severity == NotificationSeverity.Success ? 6000 : 8000,
            Style = TOAST_STYLE
        });
    }

    /// <summary>
    /// Apre un progetto dell'elenco sul passo più avanti raggiunto; un progetto che non si legge resta nell'elenco con un toast
    /// </summary>
    /// <param name="project">Progetto della riga</param>
    /// <returns>True se il progetto è aperto</returns>
    private bool OpenProject(TranslationProject project)
    {
        try
        {
            this.Orchestrator.OpenProject(project.Id);
        }
        catch (Exception ex)
        {
            if (!(ex is InvalidDataException || ex is IOException || ex is UnauthorizedAccessException))
                throw;

            this.Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifyOpenFailed"), ex.Message);
            return false;
        }

        this._step = this.ProjectStep();
        this._pending = null;
        return true;
    }

    /// <summary>
    /// Apre il progetto scelto e ne riprende la traduzione o l'analisi fermata
    /// </summary>
    /// <param name="project">Progetto della riga</param>
    private void Resume(TranslationProject project)
    {
        if (!this.OpenProject(project))
            return;

        if (this.Orchestrator.Job != null)
        {
            this.StartJob();
        }
        else
        {
            this.Analyze();
        }
    }

