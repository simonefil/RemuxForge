    /// <summary>
    /// Scrive i sottotitoli tradotti; con battute senza traduzione chiede prima la conferma
    /// </summary>
    private async Task ExportSubtitlesAsync()
    {
        int untranslated = 0;
        foreach (TranslationExportRow row in Orchestrator.GetExportRows())
            untranslated += row.Untranslated;
        if (untranslated > 0)
        {
            bool confirmed = await AppDialogs.ConfirmAsync(DialogService, AppText.T("web.toolbox.subtitleTranslation.exportSubtitles"),
                AppText.Count("web.toolbox.subtitleTranslation.exportUntranslated", untranslated), AppText.T("web.toolbox.subtitleTranslation.exportSubtitles"), AppText.T("web.common.cancel"));
            if (!confirmed)
                return;
        }

        List<TranslationExportRow> rows = await Task.Run(() => Orchestrator.ExportSubtitles());
        if (rows == null)
            return;

        _exported = rows;
        int failed = rows.FindAll(r => !r.Written).Count;
        if (failed == 0)
            Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifySubtitlesExported"), AppText.Count("web.toolbox.subtitleTranslation.filesCount", rows.Count));
        else
            Notify(NotificationSeverity.Error, AppText.T("web.toolbox.subtitleTranslation.notifySubtitlesNotExported"), AppText.Count("web.toolbox.subtitleTranslation.filesCount", failed));
        await OnStateChanged.InvokeAsync();
    }

