    /// Cancella il progetto scelto dopo la conferma
    /// </summary>
    /// <param name="project">Progetto della riga</param>
    private async Task DeleteProjectAsync(TranslationProject project)
    {
        string name = SubtitleTranslationOrchestrator.DisplayName(project);
        bool confirmed = await AppDialogs.ConfirmAsync(this.DialogService, AppText.T("web.toolbox.subtitleTranslation.deleteTitle"), AppText.F("web.toolbox.subtitleTranslation.deleteMessage", name),
            AppText.T("web.common.delete"), AppText.T("web.common.cancel"));
        if (!confirmed)
            return;

        if (!this.Orchestrator.DeleteProject(project))
            return;

        this._selectedId = "";
        this.ReloadProjects();
        this.Notify(NotificationSeverity.Success, AppText.T("web.toolbox.subtitleTranslation.notifyDeleted"), name);
        await this.OnStateChanged.InvokeAsync();
    }

