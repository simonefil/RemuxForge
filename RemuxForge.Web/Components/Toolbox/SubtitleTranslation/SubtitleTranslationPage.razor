    /// <summary>
    /// Scrive l'archivio del progetto nella cartella scelta
    /// </summary>
    /// <param name="project">Progetto aperto o dell'elenco</param>
    private async Task ExportProjectAsync(TranslationProject project)
    {
        string initialPath = project.Files.Count > 0 ? System.IO.Path.GetDirectoryName(project.Files[0].Path) : "";
        string folder = await AppDialogs.BrowseAsync(this.DialogService, this.JsModule, initialPath, false, true, null);
        if (string.IsNullOrEmpty(folder))
            return;

        try
        {
            string path = await Task.Run(() => this.Orchestrator.ExportProject(project, folder));
