@using RemuxForge.Core.Toolbox.SubtitleTranslation
@using System.Globalization

@* Registro delle chiamate del progetto: una riga per tentativo, con il dettaglio di rifiuti ed errori nella riga aperta in parole
   dell'utente; del servizio restano, etichettati, il codice dell'errore e il motivo d'interruzione che l'app non conosce *@
<RadzenPanel class="rf-translation-calls" AllowCollapse="true" Collapsed="@_collapsed" Expand="@(() => _collapsed = false)" Collapse="@(() => _collapsed = true)"
             Text="@AppText.F("web.toolbox.subtitleTranslation.calls.title", Calls.Count)">
    <ChildContent>
        <RadzenDataGrid TItem="TranslationCallRecord"
                        Data="@Calls"
                        class="rf-data-grid rf-tool-grid rf-translation-calls-grid"
                        AllowAlternatingRows="false"
                        AllowColumnResize="false"
                        AllowPaging="false"
                        AllowSorting="false"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Horizontal"
                        ExpandMode="DataGridExpandMode.Multiple"
                        EmptyText="@AppText.T("web.toolbox.subtitleTranslation.calls.empty")"
                        RowRender="@((RowRenderEventArgs<TranslationCallRecord> args) => args.Expandable = args.Data.Rejections.Count > 0 || args.Data.ErrorKind.HasValue || !string.IsNullOrEmpty(args.Data.IncompleteReason))">
            <Template Context="call">
                <div class="rf-translation-calls-detail">
                    @if (call.ErrorKind.HasValue)
                    {
                        <div>@AppText.T("web.toolbox.subtitleTranslation.calls.errorKind." + call.ErrorKind.Value)</div>
                        @if (!string.IsNullOrEmpty(call.ServiceCode))
                        {
                            <div>@AppText.F("web.toolbox.subtitleTranslation.calls.serviceCode", call.ServiceCode)</div>
                        }
                    }
                    @if (!string.IsNullOrEmpty(call.IncompleteReason))
                    {
                        string incompleteKey = "web.toolbox.subtitleTranslation.calls.incomplete." + call.IncompleteReason;
                        string incomplete = AppText.T(incompleteKey);
                        <div>@(incomplete == "[" + incompleteKey + "]" ? AppText.F("web.toolbox.subtitleTranslation.calls.incompleteOther", call.IncompleteReason) : incomplete)</div>
                    }
                    @foreach (TranslationCallRejection rejection in call.Rejections)
                    {
                        string reasons = string.Join(", ", TranslationValidationIssue.ReadCodes(rejection.Reasons).ConvertAll(c => AppText.T(TranslationValidationIssue.REASON_KEY_PREFIX + c)));
                        <div>@(rejection.Id.HasValue ? AppText.F("web.toolbox.subtitleTranslation.calls.rejectedCue", rejection.Id.Value.ToString(CultureInfo.CurrentCulture), reasons) : reasons)</div>
                    }
                </div>
            </Template>
            <Columns>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.time")" Width="6rem">
                    <Template Context="call"><CellText Text="@call.StartedAt.ToLocalTime().ToString("T", CultureInfo.CurrentCulture)" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.kind")" Width="10rem">
                    <Template Context="call"><CellText Text="@(AppText.T("web.toolbox.subtitleTranslation.calls.kind." + call.Kind) + (call.Round.HasValue && call.Round.Value > 1 ? " · " + call.Round.Value.ToString(CultureInfo.CurrentCulture)
                        : call.Attempt.HasValue && call.Attempt.Value > 0 ? " · " + call.Attempt.Value.ToString(CultureInfo.CurrentCulture) : ""))" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.dashboard.file")" Width="20%">
                    <Template Context="call">
                        <CellText Text="@(call.FileId == null ? AppText.T("web.toolbox.subtitleTranslation.calls.allFiles") : FileNames.TryGetValue(call.FileId, out string name) ? name : call.FileId)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.cues")" Width="6rem" TextAlign="TextAlign.Right">
                    <Template Context="call"><CellText Text="@(!call.RequestedIds.HasValue ? "—" : call.FirstId.HasValue && call.LastId.HasValue
                        ? call.RequestedIds.Value.ToString("N0", CultureInfo.CurrentCulture) + " · " + call.FirstId.Value.ToString(CultureInfo.CurrentCulture) + "–" + call.LastId.Value.ToString(CultureInfo.CurrentCulture)
                        : call.RequestedIds.Value.ToString("N0", CultureInfo.CurrentCulture))" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.model")" Width="20%">
                    <Template Context="call"><CellText Text="@(string.IsNullOrEmpty(call.ReasoningEffort) ? call.Model : call.Model + " · " + call.ReasoningEffort)" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.outcome")" Width="11%">
                    <Template Context="call">
                        @* Un errore senza tipo è il tentativo interrotto da Stop; la diagnosi conta i problemi, la correzione le battute col testo cambiato *@
                        <RadzenBadge IsPill="true"
                                     BadgeStyle="@(Discarded.Contains(call.CallSeq) ? BadgeStyle.Base : call.Issues.HasValue && call.Issues.Value > 0 ? BadgeStyle.Warning
                                         : call.Outcome == TranslationCallOutcome.Accepted ? BadgeStyle.Success : call.Outcome == TranslationCallOutcome.Error && call.ErrorKind.HasValue ? BadgeStyle.Danger
                                         : call.Outcome == TranslationCallOutcome.Error ? BadgeStyle.Base : BadgeStyle.Warning)"
                                     Text="@(Discarded.Contains(call.CallSeq) ? AppText.T("web.toolbox.subtitleTranslation.calls.discarded")
                                         : call.Issues.HasValue ? AppText.Count("web.toolbox.subtitleTranslation.calls.issues", call.Issues.Value)
                                         : call.Kind == TranslationCallKind.D1 && call.Outcome == TranslationCallOutcome.PartiallyRejected ? AppText.T("web.toolbox.subtitleTranslation.calls.diagnosisInvalid")
                                         : call.Kind == TranslationCallKind.D2 && call.Outcome == TranslationCallOutcome.Accepted ? AppText.Count("web.toolbox.subtitleTranslation.calls.corrected", call.Corrected ?? 0)
                                         : call.Outcome == TranslationCallOutcome.Accepted ? AppText.T("web.toolbox.subtitleTranslation.calls.accepted")
                                         : call.Outcome == TranslationCallOutcome.PartiallyRejected ? AppText.T("web.toolbox.subtitleTranslation.calls.rejected")
                                         : call.Outcome == TranslationCallOutcome.Reduced ? AppText.T("web.toolbox.subtitleTranslation.calls.reduced")
                                         : !call.ErrorKind.HasValue ? AppText.T("web.toolbox.subtitleTranslation.calls.stopped")
                                         : call.HttpStatus > 0 ? AppText.F("web.toolbox.subtitleTranslation.calls.errorStatus", call.HttpStatus) : AppText.T("web.toolbox.subtitleTranslation.calls.error"))" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.tokens")" Width="15%" TextAlign="TextAlign.Right">
                    <Template Context="call">
                        <CellText Text="@(call.Usage == null ? "—" : FormatTokens(call.Usage.InputTokens) + " / " + FormatTokens(call.Usage.CachedTokens) + " / " + FormatTokens(call.Usage.OutputTokens))" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TranslationCallRecord" Title="@AppText.T("web.toolbox.subtitleTranslation.calls.duration")" Width="6rem" TextAlign="TextAlign.Right">
                    <Template Context="call"><CellText Text="@AppText.F("web.toolbox.subtitleTranslation.calls.seconds", Math.Round(call.DurationMs / 1000.0).ToString(CultureInfo.CurrentCulture))" /></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenPanel>

@code {
    #region Parametri

    /// <summary>
    /// Chiamate del progetto in ordine di registro
    /// </summary>
    [Parameter] public List<TranslationCallRecord> Calls { get; set; } = new List<TranslationCallRecord>();

    /// <summary>
    /// Nome del file per identificativo del progetto
    /// </summary>
    [Parameter] public Dictionary<string, string> FileNames { get; set; } = new Dictionary<string, string>();

    /// <summary>
    /// Chiamate di blocchi scartati, mostrate come «scartata»
    /// </summary>
    [Parameter] public HashSet<int> Discarded { get; set; } = new HashSet<int>();

    #endregion

    #region Variabili di classe

    /// <summary>
    /// True col pannello chiuso, com'è all'apertura
    /// </summary>
    private bool _collapsed = true;

    #endregion

    #region Metodi privati

    /// <summary>
    /// Token di una colonna, trattino se il servizio non li dichiara
    /// </summary>
    /// <param name="tokens">Token</param>
    /// <returns>Testo</returns>
    private static string FormatTokens(long? tokens)
    {
        return tokens.HasValue ? tokens.Value.ToString("N0", CultureInfo.CurrentCulture) : "—";
    }

    #endregion
}
