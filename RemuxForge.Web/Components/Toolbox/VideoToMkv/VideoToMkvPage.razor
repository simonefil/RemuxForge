@using RemuxForge.Core.Toolbox.VideoToMkv
@inherits ToolboxBatchPageBase<VideoToMkvOrchestrator, VideoToMkvRecord>

@{
    List<VideoToMkvRecord> records = Orchestrator.GetRecords();
    bool busy = Orchestrator.IsBusy;
}
<div class="rf-panel rf-tool-page">
    <ToolboxOutputOptions Orchestrator="@Orchestrator" JsModule="@JsModule" Id="video-to-mkv" />

    @if (records.Count == 0)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" class="rf-tool-empty">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2">@AppText.T("web.toolbox.videoToMkv.emptyTitle")</RadzenText>
            <RadzenButton Text="@AppText.T("web.toolbox.list.addFiles")" Icon="add" Disabled="@busy" Click="@AddFilesAsync" />
        </RadzenStack>
    }
    else
    {
        <RadzenDataGrid TItem="VideoToMkvRecord"
                        Data="@records"
                        class="rf-data-grid rf-tool-grid"
                        AllowAlternatingRows="false"
                        AllowColumnResize="true"
                        AllowPaging="false"
                        AllowSorting="false"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Both">
            <Columns>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.dashboard.file")" Width="32%" MinWidth="2.5rem">
                    <Template Context="record"><span title="@record.InputPath">@System.IO.Path.GetFileName(record.InputPath)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.toolbox.list.container")" Width="8%" MinWidth="2.5rem">
                    <Template Context="record"><CellText Text="@System.IO.Path.GetExtension(record.InputPath).TrimStart('.').ToUpperInvariant()" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.toolbox.list.size")" Width="8%" MinWidth="2.5rem">
                    <Template Context="record"><CellText Text="@Utils.FormatSize(record.Size)" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.dashboard.status")" Width="13%" MinWidth="2.5rem">
                    <Template Context="record">
                        <RadzenBadge IsPill="true"
                                     Text="@AppText.T(record.Status switch
                                     {
                                         VideoToMkvStatus.Running => "web.toolbox.videoToMkv.statusRunning",
                                         VideoToMkvStatus.Converted => "web.toolbox.videoToMkv.statusConverted",
                                         VideoToMkvStatus.ConvertedWithWarnings => "web.toolbox.videoToMkv.statusConvertedWithWarnings",
                                         VideoToMkvStatus.Failed => "web.toolbox.videoToMkv.statusFailed",
                                         VideoToMkvStatus.Stopped => "web.toolbox.videoToMkv.statusStopped",
                                         _ => "web.toolbox.videoToMkv.statusPending"
                                     })"
                                     BadgeStyle="@(record.Status switch
                                     {
                                         VideoToMkvStatus.Running => BadgeStyle.Info,
                                         VideoToMkvStatus.Converted => BadgeStyle.Success,
                                         VideoToMkvStatus.Failed => BadgeStyle.Danger,
                                         VideoToMkvStatus.ConvertedWithWarnings or VideoToMkvStatus.Stopped => BadgeStyle.Warning,
                                         _ => BadgeStyle.Base
                                     })" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.toolbox.list.result")" Width="34%" MinWidth="2.5rem">
                    <Template Context="record">
                        @* In riga il MKV scritto o il motivo breve; nel tooltip il percorso completo, gli avvisi o l'errore di mkvmerge per intero *@
                        <span title="@(record.OutputPath.Length > 0 ? (record.Details.Length > 0 ? record.OutputPath + Environment.NewLine + record.Details : record.OutputPath) : (record.Details.Length > 0 ? record.Details : record.Message))">@(record.OutputPath.Length > 0 ? System.IO.Path.GetFileName(record.OutputPath) : record.Message)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Width="5%" MinWidth="3rem" TextAlign="TextAlign.Center">
                    <Template Context="record">
                        <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@busy"
                                      title="@AppText.T("web.toolbox.list.remove")" aria-label="@(AppText.T("web.toolbox.list.remove") + " " + System.IO.Path.GetFileName(record.InputPath))"
                                      Click="@(() => Orchestrator.Remove(record))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</div>

@code {
    /// <summary>
    /// Estensioni proposte dal browser: i contenitori accettati tranne il Matroska, che non ha nulla da convertire
    /// </summary>
    private static readonly List<string> s_extensions = new List<string>(Array.FindAll(MediaContainerFormats.Extensions, e => !MediaContainerFormats.IsMatroska(e)));

    /// <inheritdoc />
    protected override List<string> FileExtensions
    {
        get { return s_extensions; }
    }
}
