@using RemuxForge.Core.Toolbox.VideoToMkv
@inherits ToolboxPageBase
@implements IDisposable
@inject VideoToMkvOrchestrator Orchestrator
@inject DialogService DialogService
@inject NotificationService NotificationService

@{
    List<VideoToMkvRecord> records = Orchestrator.GetRecords();
    bool busy = Orchestrator.IsBusy;
}
<div class="rf-panel rf-tool-page">
    <div class="rf-tool-options">
        <div class="rf-tool-field">
            <span id="video-to-mkv-output-label" class="rf-tool-label">@AppText.T("web.toolbox.videoToMkv.output")</span>
            <RadzenRadioButtonList TValue="bool" Name="VideoToMkvOutput" AriaLabelledBy="video-to-mkv-output-label" Orientation="Orientation.Horizontal" Gap="1.5rem"
                                   Disabled="@busy" Value="@Orchestrator.UseOutputFolder"
                                   Change="@((bool value) => Orchestrator.SetOutput(value, Orchestrator.OutputFolder))">
                <Items>
                    <RadzenRadioButtonListItem TValue="bool" Text="@AppText.T("web.toolbox.videoToMkv.outputNextToSource")" Value="false" />
                    <RadzenRadioButtonListItem TValue="bool" Text="@AppText.T("web.toolbox.videoToMkv.outputFolder")" Value="true" />
                </Items>
            </RadzenRadioButtonList>
        </div>
        @if (Orchestrator.UseOutputFolder)
        {
            <div class="rf-tool-field rf-tool-path-field">
                <RadzenLabel class="rf-tool-label" Text="@AppText.T("web.toolbox.videoToMkv.folder")" Component="VideoToMkvFolder" />
                <RadzenTextBox Name="VideoToMkvFolder" class="rf-tool-path-input" Disabled="@busy" Value="@Orchestrator.OutputFolder"
                               Placeholder="@AppText.T("web.toolbox.videoToMkv.folderPlaceholder")"
                               Change="@((string value) => Orchestrator.SetOutput(true, value))" />
                <RadzenButton Icon="folder_open" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Disabled="@busy"
                              title="@AppText.T("web.toolbox.videoToMkv.chooseFolder")" aria-label="@AppText.T("web.toolbox.videoToMkv.chooseFolder")"
                              Click="@BrowseOutputFolderAsync" />
            </div>
        }
    </div>

    @if (records.Count == 0)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1rem" class="rf-tool-empty">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2">@AppText.T("web.toolbox.videoToMkv.emptyTitle")</RadzenText>
            <RadzenText>@AppText.T("web.toolbox.videoToMkv.emptyDescription")</RadzenText>
            <RadzenButton Text="@AppText.T("web.toolbox.videoToMkv.addFiles")" Icon="add" Disabled="@busy" Click="@AddFilesAsync" />
        </RadzenStack>
    }
    else
    {
        <RadzenDataGrid TItem="VideoToMkvRecord"
                        Data="@records"
                        class="rf-data-grid rf-tool-grid"
                        AllowAlternatingRows="false"
                        AllowColumnResize="true"
                        AllowPaging="false"
                        AllowSorting="false"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Both">
            <Columns>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.dashboard.file")" Width="30%" MinWidth="2.5rem">
                    <Template Context="record"><span title="@record.InputPath">@System.IO.Path.GetFileName(record.InputPath)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.metadata.container")" Width="9%" MinWidth="2.5rem">
                    <Template Context="record"><CellText Text="@System.IO.Path.GetExtension(record.InputPath).TrimStart('.').ToUpperInvariant()" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.toolbox.videoToMkv.size")" Width="10%" MinWidth="2.5rem">
                    <Template Context="record"><CellText Text="@Utils.FormatSize(record.Size)" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.dashboard.status")" Width="12%" MinWidth="2.5rem">
                    <Template Context="record">
                        <RadzenBadge IsPill="true"
                                     Text="@AppText.T(record.Status switch
                                     {
                                         VideoToMkvStatus.Running => "web.toolbox.videoToMkv.statusRunning",
                                         VideoToMkvStatus.Converted => "web.toolbox.videoToMkv.statusConverted",
                                         VideoToMkvStatus.Skipped => "web.toolbox.videoToMkv.statusSkipped",
                                         VideoToMkvStatus.Failed => "web.toolbox.videoToMkv.statusFailed",
                                         VideoToMkvStatus.Stopped => "web.toolbox.videoToMkv.statusStopped",
                                         _ => "web.toolbox.videoToMkv.statusPending"
                                     })"
                                     BadgeStyle="@(record.Status switch
                                     {
                                         VideoToMkvStatus.Running => BadgeStyle.Info,
                                         VideoToMkvStatus.Converted => BadgeStyle.Success,
                                         VideoToMkvStatus.Failed => BadgeStyle.Danger,
                                         VideoToMkvStatus.Skipped or VideoToMkvStatus.Stopped => BadgeStyle.Warning,
                                         _ => BadgeStyle.Base
                                     })" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Title="@AppText.T("web.toolbox.videoToMkv.result")" Width="33%" MinWidth="2.5rem">
                    <Template Context="record">
                        @* Riuscita: il nome del Matroska scritto, con gli eventuali avvisi di mkvmerge; altrimenti il motivo *@
                        <span title="@(record.OutputPath.Length > 0 && record.Message.Length > 0 ? record.OutputPath + Environment.NewLine + record.Message : record.OutputPath.Length > 0 ? record.OutputPath : record.Message)">@(record.OutputPath.Length > 0 && record.Message.Length > 0 ? System.IO.Path.GetFileName(record.OutputPath) + " · " + record.Message : record.OutputPath.Length > 0 ? System.IO.Path.GetFileName(record.OutputPath) : record.Message)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoToMkvRecord" Width="6%" MinWidth="3rem" TextAlign="TextAlign.Center">
                    <Template Context="record">
                        <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@busy"
                                      title="@AppText.T("web.toolbox.videoToMkv.remove")" aria-label="@(AppText.T("web.toolbox.videoToMkv.remove") + " " + System.IO.Path.GetFileName(record.InputPath))"
                                      Click="@(() => Orchestrator.Remove(record))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</div>

@code {
    /// <summary>
    /// Estensioni proposte dal browser: i contenitori accettati tranne il Matroska, che non ha nulla da convertire
    /// </summary>
    private static readonly List<string> s_extensions = new List<string>(Array.FindAll(MediaContainerFormats.Extensions, e => !MediaContainerFormats.IsMatroska(e)));

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Orchestrator.OnRecordsChanged += HandleRecordsChanged;
        Orchestrator.OnBatchCompleted += HandleBatchCompleted;
    }

    /// <inheritdoc />
    public override IReadOnlyList<UiCommandDefinition> BuildUiCommands(bool busy)
    {
        UiCommandPlacement allSurfaces = UiCommandPlacement.Menu | UiCommandPlacement.Toolbar | UiCommandPlacement.Status;
        bool empty = Orchestrator.GetRecords().Count == 0;

        return new List<UiCommandDefinition>
        {
            new UiCommandDefinition(AppText.T("web.toolbox.videoToMkv.addFilesMenu"), "F5", "add", allSurfaces, UiCommandMenuSection.File, busy, null)
            {
                AsyncCallback = AddFilesAsync,
                ToolbarLabel = AppText.T("web.toolbox.videoToMkv.addFiles"),
                StatusLabel = AppText.T("web.toolbox.videoToMkv.addFiles"),
                ToolbarOrder = 10,
                StatusOrder = 10
            },
            new UiCommandDefinition(AppText.T("web.toolbox.videoToMkv.convert"), "F10", "play_arrow", allSurfaces, UiCommandMenuSection.Actions, busy || !Orchestrator.CanStart, Orchestrator.Start)
            {
                ToolbarOrder = 20,
                StatusOrder = 20
            },
            new UiCommandDefinition(AppText.T("web.toolbox.videoToMkv.clear"), "Ctrl+L", "clear_all", allSurfaces, UiCommandMenuSection.File, busy || empty, Orchestrator.Clear)
            {
                SecondaryToolbar = true,
                ToolbarOrder = 15,
                StatusOrder = 100
            }
        };
    }

    /// <summary>
    /// Accoda i file scelti nel browser, partendo dalla cartella dell'ultimo file dell'elenco
    /// </summary>
    private async Task AddFilesAsync()
    {
        List<VideoToMkvRecord> records = Orchestrator.GetRecords();
        string initialPath = records.Count > 0 ? System.IO.Path.GetDirectoryName(records[records.Count - 1].InputPath) : "";
        List<string> paths = await AppDialogs.BrowseFilesAsync(DialogService, JsModule, initialPath, s_extensions);

        if (paths.Count > 0)
            Orchestrator.AddFiles(paths);
    }

    /// <summary>
    /// Sceglie la cartella di uscita nel browser
    /// </summary>
    private async Task BrowseOutputFolderAsync()
    {
        string path = await AppDialogs.BrowseAsync(DialogService, JsModule, Orchestrator.OutputFolder, false, true, null);

        if (!string.IsNullOrEmpty(path))
            Orchestrator.SetOutput(true, path);
    }

    /// <summary>
    /// Ridisegna pagina e comandi della dashboard quando cambia l'elenco o l'uscita
    /// </summary>
    private void HandleRecordsChanged()
    {
        InvokeAsync(() => OnStateChanged.InvokeAsync());
    }

    /// <summary>
    /// Riassume in un toast l'esito del lotto
    /// </summary>
    private void HandleBatchCompleted(int converted, int failed, int skipped, bool stopped)
    {
        InvokeAsync(async () =>
        {
            NotificationSeverity severity = failed > 0 ? NotificationSeverity.Error : stopped || skipped > 0 ? NotificationSeverity.Warning : NotificationSeverity.Success;
            NotificationService.Notify(severity, AppText.T(stopped ? "web.toolbox.videoToMkv.notifyStoppedTitle" : "web.toolbox.videoToMkv.notifyTitle"),
                AppText.F("web.toolbox.videoToMkv.notifyBody", converted, failed, skipped), failed > 0 ? 12000 : 8000);
            await OnStateChanged.InvokeAsync();
        });
    }

    /// <summary>
    /// Toglie le sottoscrizioni: la pagina rinasce a ogni apertura della card, l'orchestratore resta
    /// </summary>
    public void Dispose()
    {
        Orchestrator.OnRecordsChanged -= HandleRecordsChanged;
        Orchestrator.OnBatchCompleted -= HandleBatchCompleted;
    }
}
